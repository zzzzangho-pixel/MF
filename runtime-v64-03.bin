    if (!saved || !saved.family)
      throw new Error("유효한 가족 저장 파일이 아닙니다");
    const [rules, text] = data(),
      s = OrigSession.Load(rules, text, familyRestore(saved.family)),
      ui = saved.webUi || {};
    for (const k of [
      "pending",
      "cur",
      "pages",
      "page",
      "stages",
      "endStage",
      "heavenWait",
      "heavenCur",
      "heavenPage",
      "EndMenu",
      "millenniumQueued",
      "BookmarkAskPending",
      "lineageQueued",
      "bookmarkQueued",
      "lineageShown",
      "lineageEnded",
      "replaying",
