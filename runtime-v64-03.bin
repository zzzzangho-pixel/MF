      return OrigSession.OwnRooms(this.Game.Vm);
    }
    static OwnRooms(vm) {
      const m = vm.Mem,
        h = (m.R8(0x0202c6af) & 15) + 4 * m.R8(0x0202c692);
      m.W32(OrigSession.RoomScene + 0x180, 0x08581768 + 716 * h);
