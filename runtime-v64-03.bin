        p.PlannedTitle = t === 65535 ? "" : this.Text.InterestTitle(t, i);
        const g = SK.OrigMem.Gene + SK.OrigMem.GeneSize * id;
        p.FatherId = rel(m.R16(g + 0x10));
        p.MotherId = rel(m.R16(g + 0x12));
        p.SpouseId = rel(m.R16(g + 0x14));
        p.Alive = true;
        p.Name = this.NameOf(id, p.Gender);
