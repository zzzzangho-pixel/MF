        pet.lastCareDay = context.today; ++pet.careCount;
        for (const effect of policy.stats) this._stat(result, caretakerId, effect.index, effect.delta);
        this._event(result, pet, 'care', context.today, '함께 보낸 시간',
          pet.name + (action === 'walk' ? '와(과) 산책했어요.' : '와(과) 놀아주었어요.'),
          [], {action, personId: caretakerId});
      });
    }
    resolve(id, choice, context) {
      const bad = this._context(context);
      if (bad) return this._reject(...bad);
      const event = this.state.pending.find(e => e.id === id);
      if (!event || !event.choices.includes(choice))
        return this._reject('event-stale', '이미 처리했거나 선택할 수 없는 반려동물 사건이에요.');
      const pet = this.state.pets.find(p => p.id === event.petId);
      if (event.kind === 'illness' && (!pet || pet.status !== 'alive' || pet.illness?.episodeId !== id))
        return this._reject('event-stale', '현재 치료할 질병 사건이 아니에요.');
      const cost = pet ? this.config.species[pet.species].treatmentCost : 0;
      if (choice === 'treat' && context.money < cost)
        return this._reject('treatment-cash', '치료비를 낼 실제 소지금이 부족해요.');
      return this._transaction(result => {
        if (choice === 'later') {
          event.acknowledged = true; event.choices = ['treat'];
          pet.illness.acknowledged = true;
          const history = this.state.history.find(e => e.id === id);
          if (history) { history.acknowledged = true; history.choices = ['treat']; }
        } else {
          this.state.pending = this.state.pending.filter(e => e.id !== id);
          const history = this.state.history.find(e => e.id === id);
          if (history) { history.acknowledged = true; history.choices = []; }
          if (choice === 'treat') {
            result.effects.moneyDelta -= cost; pet.health = 100; pet.illness = null;
            this._event(result, pet, 'treatment', context.today, '치료를 받았어요', pet.name + '의 건강이 회복되었어요.');
          }
        }
      });
    }
    _depart(pet, cause, day, context, result) {
      if (pet.status !== 'alive') return;
      const caregiver = this._caregiver(pet, context);
      pet.status = 'dead'; pet.cause = cause; pet.deathDay = day;
      if (cause === 'disease') pet.health = 0;
      pet.illness = null;
      this.state.pending = this.state.pending.filter(e => !(e.petId === pet.id && e.kind === 'illness'));
      result.effects.moodDelta += this.config.departureMood;
      this._stat(result, caregiver?.id, 1, this.config.departureCaregiverStamina);
      this._event(result, pet, 'departure', day, '가족의 추억',
        pet.name + '가(이) 무지개다리를 건넜어요.', ['ack'], {cause});
    }
    _owner(pet, day, context, result) {
      const people = this._living(context);
      if (people.some(p => p.id === pet.ownerId)) return;
      if (!people.length) {
        pet.status = 'rehomed'; pet.cause = 'household-extinct'; pet.rehomedDay = day; pet.illness = null;
        this.state.pending = this.state.pending.filter(e => e.petId !== pet.id);
        this._event(result, pet, 'rehomed', day, '새로운 보금자리', pet.name + '가(이) 보호소로 안전하게 인계되었어요.');
        return;
      }
      const successor = people.find(p => p.id === context.headId) || people[0], previousOwnerId = pet.ownerId;
      pet.ownerId = successor.id;
      this._event(result, pet, 'inheritance', day, '가족이 이어 돌봐요',
        pet.name + '의 보호자가 ' + (successor.name || '가족') + '(으)로 이어졌어요.',
        [], {previousOwnerId, ownerId: successor.id});
    }
    advance(context) {
      const bad = this._context(context, false);
      if (bad) return this._reject(...bad);
      if (context.today === this.state.throughDay) {
        // A native death/event may finish after this date was already synced.
        // Reconcile changed ownership exactly once without a day/RNG advance.
        return this._transaction(result => {
          for (const pet of this.state.pets)
            if (pet.status === 'alive') this._owner(pet, context.today, context, result);
        });
      }
      return this._transaction(result => {
        for (let day = this.state.throughDay + 1; day <= context.today; ++day) {
          for (const pet of this.state.pets) {
            if (pet.status !== 'alive') continue;
            this._owner(pet, day, context, result);
            if (pet.status !== 'alive') continue;
            const c = this.config;
            if (day >= anniversary(pet.birthDay, Math.max(20, c.oldAgeFloorYears, pet.lifespanYears))) {
              this._depart(pet, 'old-age', day, context, result); continue;
            }
            if (pet.illness) {
              pet.health = Math.max(0, pet.health - c.illnessDailyHealthLoss);
              if (!pet.health) { this._depart(pet, 'disease', day, context, result); continue; }
            } else if (c.illnessChance > 0 && this._random() < c.illnessChance) {
              pet.health = Math.max(0, pet.health - c.illnessOnsetHealthLoss);
              const caregiver = this._caregiver(pet, context);
              this._stat(result, caregiver?.id, 1, c.illnessCaregiverStamina);
              const episode = this._event(result, pet, 'illness', day, '반려동물이 아파요',
                pet.name + '가(이) 치료와 휴식이 필요해요.', ['treat', 'later']);
              pet.illness = {episodeId: episode.id, onsetDay: day, acknowledged: false};
              if (!pet.health) { this._depart(pet, 'disease', day, context, result); continue; }
            }
            const currentMonth = month(day);
            while (pet.lastChargedMonth < currentMonth) {
              ++pet.lastChargedMonth;
              const due = c.species[pet.species].monthlyCost + pet.arrears;
              const available = Math.max(0, context.money + result.effects.moneyDelta);
              const paid = Math.min(due, available);
              result.effects.moneyDelta -= paid;
              pet.arrears = due - paid;
              if (pet.arrears > 0) result.effects.moodDelta += c.monthlyUnpaidMood;
              this._event(result, pet, 'maintenance', day, '한 달의 돌봄 비용',
                pet.name + '의 이번 달 유지비를 기록했어요.', [],
                {month: pet.lastChargedMonth, due, paid, arrears: pet.arrears});
            }
          }
        }
        this.state.throughDay = context.today;
      });
    }
  }
  SK.PetRules = PetRules;
})(typeof window !== 'undefined' ? window : globalThis);

</script>
<script>
/* Local pet extension. Native cartridge layout/rules stay untouched. */
(function (g) {
  'use strict';
  const SK = g.SK = g.SK || {};
  const MONEY = 0x0202c6b8;
  const clone = value => JSON.parse(JSON.stringify(value));
  const zero = () => ({moneyDelta:0,moodDelta:0,stats:[]});
  const fail = reason => ({ok:false,reason,effects:zero(),events:[]});
  const integer = value => Number.isSafeInteger(value);
  const clamp = (n,a,b) => Math.max(a,Math.min(b,n));

  function seedFor(family) {
    let seed = (Math.imul(Number(family.StartDay) || 1,2654435761) ^ 0x70657431) >>> 0;
    for (const c of String(family.Name || '')) seed = (Math.imul(seed,33) ^ c.codePointAt(0)) >>> 0;
    return seed || 1;
  }

  function context(game) {
    const session = game.session, family = session.Family;
    let monthlyIncome = 0;
    const people = family.Members.map(person => {
      const detail = session.PersonDetailFields(person);
      const salary = Number(detail.salaryBase);
      if (person.Alive !== false && Number.isFinite(salary) && salary >= 0 && integer(salary)) monthlyIncome += salary;
      return {id:person.Id,name:person.Name,age:person.Age(family.Today),alive:person.Alive !== false,
        stats:person.Stats.slice(),personalityCode:person.PersonalityCode,salaryBase:detail.salaryBase};
    });
    return {today:family.Today,money:session.Game.Mem.R32(MONEY) | 0,monthlyIncome,
      headId:family.HeadId,mood:family.Mood,people};
  }

  function busy(game, originalState, options = {}) {
    const session = game.session;
    if (options.betweenEvents === true) {
      // Only the presentation scheduler can borrow this boundary. Waiting
      // ordinary native events are retained, not treated as an active scene.
      // Heaven/offline/report/terminal/replay flows still have full priority.
      if (session.cur || session.heavenCur || session.heavenWait?.length || session.memo ||
          session.Paused || session.EndMenu || session.Ended || session.BookmarkAskPending ||
          session.replaying || game._offline?.active || game._offline?.pending?.length) return true;
    } else if (session.memo || session.Paused || session.HasPending || session.EndMenu || session.BookmarkAskPending) return true;
    return Boolean(originalState.call(game).event);
  }

  function validateEffects(effects, ctx) {
    if (!effects || !integer(effects.moneyDelta) || !integer(effects.moodDelta) || !Array.isArray(effects.stats))
      throw Error('반려동물 효과 형식이 올바르지 않습니다.');
    if (effects.moneyDelta > 0 || effects.moneyDelta < -Math.max(0,ctx.money))
      throw Error('반려동물 비용이 현재 지출 가능한 살림을 넘었습니다.');
    for (const item of effects.stats) {
      if (!item || !integer(item.personId) || !integer(item.index) || item.index < 0 || item.index > 3 || !integer(item.delta))
        throw Error('반려동물 능력치 효과가 올바르지 않습니다.');
      if (!ctx.people.some(person => person.id === item.personId && person.alive))
        throw Error('양육 담당자가 현재 가족에 없습니다.');
    }
  }

  function commit(game, effects, ctx) {
    validateEffects(effects,ctx);
    const session = game.session, family = session.Family, memory = session.Game.Mem;
    if (effects.moneyDelta === 0 && effects.moodDelta === 0 && !effects.stats.some(item => item.delta !== 0)) return;
    const banks = ['Ewram','Iwram','Frames','Io'];
    const before = banks.map(name => memory[name].slice());
    const statsBefore = family.Members.map(person => [person,person.Stats.slice()]);
    const moodBefore = family.Mood, assetsBefore = family.Assets;
    const seedBefore = memory.R32(SK.OrigMem.Seed);
    try {
      for (const item of effects.stats) family.Get(item.personId).AddStat(item.index,item.delta);
      family.Mood = clamp(family.Mood + effects.moodDelta,0,255);
      // Existing adapter is the verified actual native stat/mood write seam.
      session.SyncIn();
      if (effects.moneyDelta) {
        const after = ctx.money + effects.moneyDelta;
        if (!integer(after) || after < 0 || after > 1000000000) throw Error('지출 후 살림 범위가 올바르지 않습니다.');
        // Proven RNG-free native balance leaf uses exactly this signed field.
        memory.W32(MONEY,after >>> 0);
        family.Assets = after;
      }
      if (memory.R32(SK.OrigMem.Seed) !== seedBefore) throw Error('반려동물 효과가 원작 난수 상태를 변경했습니다.');
      // Do not call Project/VM here: Family fields already match committed
      // values. Original forward operations keep their normal Project calls.
    } catch (error) {
      banks.forEach((name,index) => memory[name].set(before[index]));
      for (const [person,stats] of statsBefore) person.Stats = stats;
      family.Mood = moodBefore; family.Assets = assetsBefore;
      throw error;
    }
  }

  function attach(game, savedPetState) {
    if (game.__petBridgeAttached) return game;
    if (typeof SK.PetRules !== 'function' || !SK.PET_CONFIG) throw Error('반려동물 규칙 자료가 준비되지 않았습니다.');
    const originalState = game.state, originalSave = game.save;
    const initial = {today:game.session.Family.Today,seed:seedFor(game.session.Family),config:SK.PET_CONFIG};
    game.pets = new SK.PetRules(savedPetState == null ? null : savedPetState,initial);
    Object.defineProperty(game,'__petBridgeAttached',{value:true});
    let lastSyncedDay = game.pets.serialize().throughDay;
    let lastRoster = '';
    let syncing = false;

    game.petContext = function () {return context(this);};
    game.petBusy = function (options = {}) {return busy(this,originalState,options) || Boolean(this.session.Ended);};

    function transaction(method, input) {
      const ctx = context(game);
      const previous = game.pets.serialize();
      let result;
      try {
        if (method === 'advance') result = game.pets.advance(ctx);
        else if (method === 'adopt') result = game.pets.adopt(input,ctx);
        else if (method === 'care') result = game.pets.care(input.petId,input.kind,input.personId,ctx);
        else if (method === 'resolve') result = game.pets.resolve(input.eventId,input.choice,ctx);
        else return fail('알 수 없는 반려동물 행동입니다.');
        if (!result || typeof result.ok !== 'boolean') throw Error('반려동물 처리 결과가 올바르지 않습니다.');
        if (!result.ok) {
          if (JSON.stringify(previous) !== JSON.stringify(game.pets.serialize()))
            throw Error('거절된 행동이 반려동물 상태를 변경했습니다.');
          return result;
        }
        commit(game,result.effects || zero(),ctx);
        result.changed = JSON.stringify(previous) !== JSON.stringify(game.pets.serialize());
        lastSyncedDay = game.pets.serialize().throughDay;
        result.pets = game.pets.view(context(game));
        return result;
      } catch (error) {
        game.pets = new SK.PetRules(previous,{...initial,today:ctx.today});
        throw error;
      }
    }

    game.syncPets = function (options = {}) {
      const family = this.session.Family;
      // Household-extinction bookkeeping has no native effects and must not
      // strand immortal pets behind a terminal native ending menu.
      const hasLivingFamily = family.Members.some(person => person.Alive !== false);
      if (syncing || (hasLivingFamily && busy(this,originalState,options))) return {ok:true,deferred:true,changed:false,effects:zero(),events:[]};
      const roster = family.HeadId + ':' + family.Members.map(person => person.Id + '/' + Number(person.Alive !== false)).join(',');
      if (family.Today === lastSyncedDay && roster === lastRoster) return {ok:true,changed:false,effects:zero(),events:[]};
      syncing = true;
      try {
        const result = transaction('advance',{});
        if (result.ok) lastRoster = roster;
        return result;
      } finally {syncing = false;}
    };

    game.petAction = function (action,input={},options={}) {
      if (!['adopt','care','resolve'].includes(action) || !input || typeof input !== 'object') return fail('반려동물 행동을 확인해 주세요.');
      if (this.petBusy(options)) return fail('원작 사건을 읽은 뒤 반려동물을 돌볼 수 있어요.');
      this.syncPets(options);
      return transaction(action,input);
    };

    game.state = function () {
      const value = originalState.call(this);
      value.pets = this.pets.view(context(this));
      return value;
    };

    game.save = function () {
      const saved = originalSave.call(this);
      saved.webUi = saved.webUi || {};
      saved.webUi.petState = this.pets.serialize();
      return saved;
    };

    for (const name of ['tickDay','advanceEvent','choose','showDue','queueOfflineElapsed']) {
      if (typeof game[name] !== 'function') continue;
      const original = game[name];
      game[name] = function (...args) {
        const result = original.apply(this,args);
        const update = this.syncPets();
        if (['tickDay','advanceEvent','choose'].includes(name)) return this.state();
        if (name === 'showDue') return Boolean(result || update.changed);
        return result;
      };
    }
    return game;
  }

  SK.PetBridge = {attach,context,nativeMoneyAddress:MONEY};
  const create = SK.createGame, restore = SK.restoreGame;
  SK.createGame = function (options={}) {return attach(create.call(this,options));};
  SK.restoreGame = function (saved) {
    const value = typeof saved === 'string' ? JSON.parse(saved) : saved;
    return attach(restore.call(this,value),value?.webUi?.petState);
  };
})(globalThis);

</script>
<script>
/* CharacterParts.cs / ArtLibrary.cs browser port. Pixel payloads remain unchanged.
 * Editing guide: original palette/parts -> PartsLibrary/Composer;
 * age/time variants -> AgeSlots/HouseClock; image and sprite cache -> ArtLibrary. */
(function (root) {
  "use strict";
  const SK = (root.SK = root.SK || {});
  const mod = (n, m) => ((n % m) + m) % m;
  const pickValue = (o, k, d = 0) =>
    o &&
    (o[k] !== undefined
      ? o[k]
      : o[k[0].toUpperCase() + k.slice(1)] !== undefined
        ? o[k[0].toUpperCase() + k.slice(1)]
        : d);
  function normalLook(o) {
    if (!o) return null;
    const l = {};
    ["body", "face", "hair", "eyes", "nose", "mouth", "outfit"].forEach(
      (k) => (l[k] = Number(pickValue(o, k))),
    );
    [
      "hairColor",
      "skinColor",
      "outfitColor",
      "extra",
      "gender",
      "outfitBody",
    ].forEach((k) => (l[k] = Number(pickValue(o, k, -1))));
    ["eyesFlip", "noseFlip", "mouthFlip"].forEach(
      (k) => (l[k] = Boolean(pickValue(o, k, false))),
    );
    l.palette = pickValue(o, "palette", pickValue(o, "presetPalette", null));
    l.preset = pickValue(o, "preset", "");
    if (!pickValue(o, "noseRes", true)) l.nose += 1 + (l.nose >= 20 ? 1 : 0);
    if (l.body >= 48) l.body -= 48;
    return l;
  }
  const AgeSlots = {
    forAge(years) {
      const cls =
        years <= 0
          ? 0
          : years <= 3
            ? 1
            : years <= 6
              ? 2
              : years <= 12
                ? 3
                : years <= 34
                  ? 4
                  : years <= 60
                    ? 5
                    : 6;
      return years < 13
        ? { body: 0, face: 0, hair: 0, feat: 0, cls }
        : years >= 35
          ? { body: 2, face: 1, hair: 1, feat: 2, cls }
          : { body: 1, face: 1, hair: 1, feat: 1, cls };
    },
    adult: { body: 1, face: 1, hair: 1, feat: 1, cls: -1 },
  };
  class PartsLibrary {
    constructor(json, pixels) {
      this.categories = json.categories || {};
      this.pixels = pixels || new Uint8Array();
      this.palettes = json.palettes || {};
      this.presets = json.presets || {};
    }
    count(cat) {
      return (this.categories[cat] || []).length;
    }
    get available() {
      return (
        this.count("body") > 0 &&
        this.count("face") > 0 &&
        this.count("hairfront") > 0
      );
    }
    group(cat, i) {
      const a = this.categories[cat] || [];
      return a.length ? a[mod(i, a.length)] : null;
    }
    part(cat, i, ages, slot) {
      return this.pick(this.group(cat, i), ages, slot);
    }
    pick(g, a, slot) {
      if (!g || !g.parts || !g.parts.length) return null;
      if (g.hdr && g.hdr[0] >= 0 && a.cls >= 3)
        slot =
          a.cls === 3
            ? g.hdr[0] & 15
            : a.cls === 4
              ? g.hdr[0] >> 4
              : a.cls === 5
                ? g.hdr[1] & 15
                : g.hdr[1] >> 4;
      return g.parts[Math.max(0, Math.min(slot, g.parts.length - 1))];
    }
    palette(look) {
      const p = Array.from(
        { length: 16 },
        (_, i) => (this.palettes.base || [])[i] || 0,
      );
      if (look.palette)
        for (let i = 1; i < 16 && i < look.palette.length; i++)
          if (look.palette[i] >= 0) p[i] = look.palette[i];
      const copy = (list, n, at) => {
        if (!list || !list.length || n < 0) return;
        const c = list[mod(n, list.length)];
        c.forEach((v, k) => {
          if (at + k < 16) p[at + k] = v;
        });
      };
      copy(this.palettes.hair, look.hairColor, 3);
      copy(this.palettes.skin, look.skinColor, 6);
      copy(
        this.palettes.outfitTable,
        look.outfitColor < 0
          ? -1
          : 1 + 48 * (look.outfitColor & 3) + 4 * mod(look.body, 4),
        11,
      );
      return p;
    }
  }
  const Composer = {
    width: 32,
    height: 64,
    compose(
      lib,
      raw,
      ages = AgeSlots.adult,
      pose = 2,
      outfitSet = 0,
      mirror = false,
    ) {
      const c = new Uint8Array(32 * 64),
        l = normalLook(raw);
      if (!l || !lib.available) return c;
      const put = (p, axAbs, ayAbs, flip = false) => {
        if (!p || !p.w || !p.h) return;
        const ax = flip ? p.w - p.ax : p.ax,
          x0 = axAbs - ax,
          y0 = ayAbs - p.ay;
        for (let y = 0; y < p.h; y++)
          for (let x = 0; x < p.w; x++) {
            const v =
                lib.pixels[p.off + y * p.w + (flip ? p.w - 1 - x : x)] || 0,
              X = x0 + x,
              Y = y0 + y;
            if (v && X >= 0 && X < 32 && Y >= 0 && Y < 64) c[Y * 32 + X] = v;
          }
      };
      const part = (cat, i, slot) => lib.part(cat, i, ages, slot);
      const back = pose === 0 || pose === 1;
      if (ages.cls >= 0 && ages.cls <= 2 && lib.count("child") >= 24) {
        const gender = l.gender >= 0 ? l.gender : l.body >= 12 ? 1 : 0;
        const g = lib.group(
          "child",
          gender * 12 +
            (ages.cls === 0 ? 1 : ages.cls === 1 ? 3 : 5) +
            (back ? 1 : 0),
        );
        put(lib.pick(g, { cls: -1 }, pose === 1 || pose === 3 ? 1 : 0), 16, 64);
      } else {
        const ox = 16 - (back ? 1 : 0),
          oy = 64,
          block = ((outfitSet & 3) * 4 + pose) * 24;
        const bg =
          l.outfitBody >= 24 &&
          l.outfitBody < 84 &&
          lib.count("outfit") >= (block / 24 + 1) * 60
            ? lib.group("outfit", (block / 24) * 60 + l.outfitBody - 24)
            : lib.group("body", block + mod(l.body, 24));
        const b = lib.pick(bg, ages, ages.body),
          f = part("face", l.face, ages.face);
        if (!b || !f || (f.ext || []).length < 7 || (b.ext || []).length < 2)
          return c;
        const m = [f.ax, f.ay, ...f.ext],
          nx = ox + b.ext[0] - 16,
          ny = oy + b.ext[1] - 32,
          refY = ny - m[0];
        if (back) {
          const fb = part("faceB", l.face, ages.face);
          if (fb && fb.ext.length)
            put(fb, nx - fb.ext[0] + fb.ax, refY + m[1] - 2 + fb.ay);
          put(b, ox, oy - 16);
          const bh = part("hairback", 104 + l.hair, ages.hair);
          if (bh && bh.ext.length >= 2)
            put(bh, nx, refY + m[2] + 16 - bh.ext[1]);
        } else {
          const hb = part("hairback", l.hair, ages.hair);
          if (hb && hb.ext.length >= 2)
            put(hb, nx, refY + m[2] + 16 - hb.ext[1]);
          put(b, ox, oy - 16);
