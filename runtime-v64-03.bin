          Hair: m.R8(a + 1),
          Mouth: m.R8(a + 2),
          Nose: m.R8(a + 4),
          Extra: m.R8(a + 3) === 255 ? -1 : m.R8(a + 3),
          Eyes: m.R8(a + 5),
