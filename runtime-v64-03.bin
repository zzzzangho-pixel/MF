        "결과 스크립트가 끝나지 않음 (" +
          hx(record) +
          ") 마지막 명령 " +
          hist.join(" "),
      );
    },
  };

  class DayEvent {
    constructor() {
      this.Person =
        this.Data =
        this.Code =
        this.Type =
        this.PersonId =
        this.Date =
        this.Time =
          0;
      this.Max = false;
      this.Slots = Array(28).fill(0);
      this.Points0 = this.Points1 = this.Rank0 = this.Rank1 = 0;
      this.Inv0 = new Uint8Array(32);
      this.Inv1 = new Uint8Array(32);
      this.Result = [0, 0, 0];
      this.Shown = [];
      this.Help = [];
    }
  }
  class OrigGame {
    constructor(mem, rules) {
      this.Mem = mem;
      this.Rules = rules;
      this.Vm = rules.CreateVm(mem);
      this.TodayEvent = Array(8).fill(0);
      this.Announced = Array(8).fill(false);
      this.Schedule = Array(8).fill(0);
      this.EventTime = Array(8).fill(0);
      this.TextOverride = null;
      this.SceneEndedDay = false;
      this.EndCodes = [];
    }
    static Present(m, n) {
      return m.R16(OrigMem.PersonAddr(n) + 0x3c) !== 65535;
    }
    TickDay() {
      const m = this.Mem,
        vm = this.Vm,
        evs = [],
        codes = Array(8).fill(0),
        { day: d } = OrigDate.Get(m, OrigMem.Date),
        head = m.R16(0x0202c67c),
        resumed = this.SceneEndedDay;
      this.SceneEndedDay = false;
      if (!resumed) {
        if (this.Years() === 1000) this.PushSpecial(2, 3, 4, head);
        if (d === 1) this.PushSpecial(2, 0, 1, head);
        m.W16(OrigGame.TimeOfDay, 900);
        const dv = vm.Call("0802A640") | 0;
        if (dv >= 0 && dv < 8 && m.R8(OrigMem.PersonAddr(dv) + 0x61) & 4)
          m.W8(
            OrigMem.PersonAddr(dv) + 0x61,
            vm.Call("0802A7DC", this.Years()) + 8,
          );
      }
      m.W16(OrigGame.TimeOfDay, 0x708);
      for (let n = 0; n < 8; n++)
        if (OrigGame.Present(m, n)) codes[n] = this.Morning(n);
      evs.push(...this.RunQueue(codes));
      if (this.SceneEndedDay) return evs;
      const todo = [],
        own = SK.OrigSession.OwnRooms(vm);
      for (let n = 0; n < 8; n++)
        if (OrigGame.Present(m, n) && this.TodayEvent[n]) {
          const pt = this.PushTime(n, own);
          if (pt >= 0) todo.push([pt, n]);
        }
      todo.sort((a, b) => a[0] - b[0] || a[1] - b[1]);
      let ti = 0;
      const until = (limit) => {
        for (; ti < todo.length && todo[ti][0] < limit; ti++) {
          const n = todo[ti][1];
          if (!OrigGame.Present(m, n) || !this.TodayEvent[n]) continue;
          m.W16(OrigGame.TimeOfDay, todo[ti][0]);
          this.Push(0, 6, m.R16(OrigMem.PersonAddr(n) + 0x3c));
          evs.push(...this.RunQueue(codes));
          if (this.SceneEndedDay) return false;
        }
        return true;
      };
      if (!until(6000)) return evs;
      m.W16(OrigGame.TimeOfDay, 6000);
      const doy = vm.Call("08027D0C", this.DateArg());
      for (let guard = 0; guard < OrigGame.QueueSize; guard++) {
        for (let i = 0; i < 12; i += 4) m.W32(OrigGame.OutBuf + i, 0);
        if (!vm.Call("08027BE4", doy, OrigGame.OutBuf)) break;
        const who = m.R32(OrigGame.OutBuf) & 65535,
          ev = m.R32(OrigGame.OutBuf + 8);
        vm.Call("slots", who, 0);
        this.Push(
          this.Rules.Events.get(ev).Data[
            OrigEvents.PickVariant(vm, this.Rules, ev)
          ],
          3,
          who,
        );
      }
      evs.push(...this.RunQueue(codes));
      if (this.SceneEndedDay) return evs;
      if (!until(6600)) return evs;
      m.W16(OrigGame.TimeOfDay, 6600);
      const last = this.DateArg();
      vm.Call("08095CD0", last);
      if (d === m.R8(last + 3)) this.PushSpecial(2, 1, 2, m.R16(0x0202c67c));
      evs.push(...this.RunQueue(codes));
      if (this.SceneEndedDay) return evs;
      until(Number.MAX_SAFE_INTEGER);
      return evs;
    }
    Years() {
      return this.Vm.Call("0802B2A4", this.DateArg());
    }
    DateArg() {
      const {
          year: y,
          month: mo,
          day: d,
        } = OrigDate.Get(this.Mem, OrigMem.Date),
        a = OrigGame.OutBuf + 0x20;
      this.Mem.W16(a, y);
      this.Mem.W8(a + 2, mo);
      this.Mem.W8(a + 3, d);
      return a;
    }
    PushSpecial(a, b, type, who) {
      const ev = this.Vm.Call("08119B8C", this.Table(a, b));
      this.Vm.Call("slots", who, 0);
      this.Push(
        this.Rules.Events.get(ev).Data[
          OrigEvents.PickVariant(this.Vm, this.Rules, ev)
        ],
        type,
        who,
      );
    }
    Morning(n) {
      const m = this.Mem,
        vm = this.Vm,
        p = OrigMem.PersonAddr(n),
        id = m.R16(p + 0x3c);
      this.TodayEvent[n] = 0;
      this.Announced[n] = false;
      if (this.IsBirthday(p)) {
        const ev = vm.Call("08119B8C", this.Table(2, 2));
        vm.Call("slots", id, 0);
        this.Push(
          this.Rules.Events.get(ev).Data[
            OrigEvents.PickVariant(vm, this.Rules, ev)
          ],
          0,
          id,
        );
      }
      const code = vm.Call("08027E78", p, 0) | 0;
      let sched = m.R8(p + 0x5f) ? vm.Call("08119E10", 0x6c) : 0;
      this.EventTime[n] = -1;
      if (code) {
        const se = this.Dispatch(n, code);
        if (se) sched = m.R32(se + 0x20);
      }
      if (!sched) {
        const job = m.R8(p + 0x58),
          mask = vm.Call("0811A19C", job) & 255,
          wd = this.Weekday();
        if ((1 << wd) & mask) sched = vm.Call("08119E78", p + 0x80);
        if (!sched) sched = vm.Call("08119E34", job, m.R8(OrigMem.Fam + 0x682));
      }
      this.Schedule[n] = this.HeadSchedule(sched);
      this.PlanDay(n);
      if (vm.Call("0802A6C4", id)) m.W8(p + 0x61, 4);
      return code;
    }
    Weekday() {
      const {
          year: y,
          month: mo,
          day: d,
        } = OrigDate.Get(this.Mem, OrigMem.Date),
        a = OrigGame.OutBuf + 0x50;
      this.Mem.W16(a, y);
      this.Mem.W8(a + 2, mo);
      this.Mem.W8(a + 3, d);
      return this.Vm.Call("08095C18", a);
    }
    Table(a, b) {
      this.Mem.W16(OrigGame.OutBuf + 0x40, a);
      this.Mem.W16(OrigGame.OutBuf + 0x42, b);
      return OrigGame.OutBuf + 0x40;
    }
    IsBirthday(p) {
      const {
          year: y,
          month: mo,
          day: d,
        } = OrigDate.Get(this.Mem, OrigMem.Date),
        { month: bm, day: bd } = OrigDate.Get(this.Mem, p + 0x2e);
      return (
        (bd === d && bm === mo) ||
        (bd === 29 &&
          bm === 2 &&
          !this.Vm.Call("08096010", y) &&
          d === 1 &&
          mo === 3)
      );
    }
    static HouseDef(m) {
      return (
        0x08581768 + 716 * ((m.R8(0x0202c6af) & 15) + 4 * m.R8(0x0202c692))
      );
    }
    static ResolveRoom(m, kind, own) {
      const def = this.HouseDef(m);
      return kind === 2
        ? m.R32(def + 0x10) | 0
        : kind === 4
          ? m.R32(def + 0x14) | 0
          : kind === 3
            ? m.R32(def + 0x18) | 0
            : kind <= 1
              ? own
              : 0;
    }
    PushTime(n, own) {
      const sched = this.Schedule[n],
        dcc = this.EventTime[n],
        m = this.Mem;
      if (!sched || sched === 0xffffffff || !this.TodayEvent[n]) return -1;
      const c = m.R32(sched),
        kinds = [],
        ends = [];
      let t = 0;
      for (let k = 0; k < 32; k++) {
        const kd = m.R8(c + 4 * k);
        if (kd === 255) break;
        kinds.push(kd);
        t += 300 * m.R8(c + 4 * k + 1);
        ends.push(t);
      }
      for (let k = 0; k < kinds.length; k++) {
        if (!kinds[k] || u(dcc) >= u(ends[k])) continue;
        let start = k > 0 ? ends[k - 1] : 0;
        if (kinds[k] !== 5) {
          const room = OrigGame.ResolveRoom(m, kinds[k], own[n]);
          for (
            let j = k - 1;
            j >= 1 &&
            kinds[j] !== 0 &&
            kinds[j] !== 5 &&
            OrigGame.ResolveRoom(m, kinds[j], own[n]) === room;
            j--
          )
            start = ends[j - 1];
        }
        return 0x708 + start;
      }
      return -1;
    }
    HeadSchedule(sched) {
      if (sched !== 0xffffffff) return sched;
      const h = this.Vm.Call("0800E524", this.Mem.R16(OrigMem.Fam + 0x66c));
      return h < 8 ? this.Schedule[h] : 0;
    }
    PlanDay(n) {
      const ev = this.TodayEvent[n],
        sched = this.Schedule[n],
        m = this.Mem;
      if (this.EventTime[n] !== -1 || !ev) return;
      if (m.R32(ev + 0x20)) {
        this.EventTime[n] =
          ((300 * m.R32(0x08584610 + 4 * m.R8(ev + 4))) | 0) - 1790;
        return;
      }
      if (!sched || sched === 0xffffffff) return;
      const c = m.R8(ev + 2) === 2 ? m.R32(sched + 8) : m.R32(sched + 4),
        cnt = m.R8(c),
        r = m.Rand();
      if (!cnt) return;
      this.EventTime[n] = 300 * m.R8(c + 1 + (r % cnt)) - 1790;
    }
    Dispatch(n, code) {
      const m = this.Mem,
        vm = this.Vm,
        p = OrigMem.PersonAddr(n),
        out = OrigGame.OutBuf;
      switch (code) {
        case 1:
          return (this.TodayEvent[n] = OrigEvents.EventOf(m, n, true));
        case 2:
          return (this.TodayEvent[n] = OrigEvents.EventOf(m, n, false));
        case 3:
          for (let i = 0; i < 12; i += 4) m.W32(out + i, 0);
          vm.Call("08026D74", p, out, 0);
          this.TodayEvent[n] = m.R32(out + 8);
          m.W8(p + 0x5f, m.R32(out + 4));
          return this.TodayEvent[n];
        case 4: {
          for (let i = 0; i < 12; i += 4) m.W32(out + i, 0);
          vm.Call("08027090", 0, out, 0x08014398);
          const se = (this.TodayEvent[n] = m.R32(out + 8)),
            who = m.R32(out),
            mine =
              who !== 0xffffffff
                ? who === n
                : m.R16(p + 0x3c) === m.R16(0x0202c67c);
          if (who !== 0xffffffff && !mine) {
            this.TodayEvent[n] = 0;
            return se;
          }
          if (!mine) this.TodayEvent[n] = 0;
          m.W8(p + 0x5f, m.R32(out + 4));
          return se;
        }
        case 6:
          return (this.TodayEvent[n] = vm.Call("08119C5C", 4, m.R16(p + 0x4a)));
        case 7:
          return (this.TodayEvent[n] = vm.Call("08119C5C", 5, m.R16(p + 0x4c)));
        case 8:
          return (this.TodayEvent[n] = vm.Call("08119C5C", 3, m.R16(p + 0x4e)));
      }
      return 0;
    }
    Push(data, type, id) {
      let w = this.Mem.R16(OrigGame.Queue + 8),
        e = OrigGame.QueueEntries + 8 * w;
      this.Mem.W32(e, data);
      this.Mem.W16(e + 4, type);
      this.Mem.W16(e + 6, id);
      if (++w === OrigGame.QueueSize) w = 0;
      this.Mem.W16(OrigGame.Queue + 8, w);
    }
    RunQueue(codes) {
      const m = this.Mem,
        vm = this.Vm,
        evs = [];
      for (
        let guard = 0;
        guard < OrigGame.QueueSize &&
        m.R16(OrigGame.Queue + 8) !== m.R16(OrigGame.Queue + 0xa);
        guard++
      ) {
        let r = m.R16(OrigGame.Queue + 0xa);
        const e = OrigGame.QueueEntries + 8 * r,
          type = m.R16(e + 4),
          id = m.R16(e + 6),
          n = vm.Call("0800E524", id) | 0;
        if (type === 6) {
          m.W16(e + 4, 0);
          const ev = n >= 0 && n < 8 ? this.TodayEvent[n] : 0;
          if (!ev) throw new OrigUnmodeled("큐의 인물 사건에 그날 사건이 없음");
          vm.Call("slots", id, ev);
          m.W32(
            e,
            this.Rules.Events.get(ev).Data[
              OrigEvents.PickVariant(vm, this.Rules, ev)
            ],
          );
        }
        const data = m.R32(e);
        if (++r === OrigGame.QueueSize) r = 0;
        m.W16(OrigGame.Queue + 0xa, r);
        const kind = m.R8(data);
        if (kind > 5 && kind !== 0xb && n >= 0 && n < 8 && this.Announced[n])
          continue;
        m.W16(OrigGame.Queue + 0xe, this.FamilyKey());
        m.W16(OrigGame.Queue + 6, vm.Call("08015BC4"));
        const date0 = m.R32(OrigMem.Date) & 0xffffff,
          de = Object.assign(new DayEvent(), {
            Person: n,
            Data: data,
            Type: type,
            Code: n >= 0 && n < 8 ? codes[n] : 0,
            Max: n >= 0 && n < 8 && codes[n] === 1,
            PersonId: id,
            Date: date0,
            Time: m.R16(OrigGame.TimeOfDay),
          });
        de.Points0 = m.R32(0x0202c670);
        de.Rank0 = m.R16(0x0202c66e);
        for (let i = 0; i < 32; i++) de.Inv0[i] = m.R8(0x0202c640 + i);
        OrigEvents.RunScene(
          vm,
          this.Rules,
          data,
          id,
          de.Slots,
          de.Result,
          de.Shown,
          this.TextOverride,
        );
        for (let h = OrigEvents.PopHelp(m); h >= 0; h = OrigEvents.PopHelp(m))
          de.Help.push(h);
        if (de.Result[0] >= 1 && de.Result[0] <= 4)
          this.EndCodes.push(de.Result[0] + "@" + hx(data));
        de.Points1 = m.R32(0x0202c670);
        de.Rank1 = m.R16(0x0202c66e);
        for (let i = 0; i < 32; i++) de.Inv1[i] = m.R8(0x0202c640 + i);
        evs.push(de);
        this.AnnouncePending();
        if ((m.R32(OrigMem.Date) & 0xffffff) !== date0) {
          this.SceneEndedDay = true;
          break;
        }
      }
      return evs;
    }
    AnnouncePending() {
      for (let guard = 0; guard < 8; guard++) {
        const k = this.Vm.Call("08028A10");
        if (k === 0xffffffff) return;
        const n =
          this.Vm.Call("0800E524", this.Mem.R16(0x0203bd20 + 2 * k)) | 0;
        if (n >= 0 && n < 8) this.Announced[n] = true;
        this.Vm.Call("08028AAC", u(n), k);
      }
    }
    FamilyKey() {
      return (this.Mem.R8(0x0202c6af) & 15) + (this.Mem.R8(0x0202c692) << 8);
    }
    ResumeMorning() {
      this.SceneEndedDay = true;
    }
    NextDate() {
      if (this.SceneEndedDay) return;
      const {
          year: y,
          month: mo,
          day: d,
        } = OrigDate.Get(this.Mem, OrigMem.Date),
        dt = new Date(0);
      dt.setUTCFullYear(y, mo - 1, d + 1);
      OrigDate.Set(
        this.Mem,
        OrigMem.Date,
        dt.getUTCFullYear(),
        dt.getUTCMonth() + 1,
        dt.getUTCDate(),
      );
    }
  }
  Object.assign(OrigGame, {
    Queue: 0x0203bbc0,
    QueueEntries: 0x0203bbd0,
    TimeOfDay: 0x0202c682,
    QueueSize: 24,
    OutBuf: 0x0f000800,
    DayEvent,
  });
  const OrigJobs = {
    Names: new Map([
      [0, "없음"],
      [1, "없음"],
      [2, "공립 유치원생"],
      [3, "사립 유치원생"],
      [4, "공립 초등학생"],
      [5, "사립 초등학생"],
      [6, "공립 중학생"],
      [7, "사립 중학생"],
      [8, "사립 엘리트 고등학생"],
      [9, "공립 상급 고등학생"],
      [10, "공립 일반 고등학생"],
      [11, "전문학교생"],
      [12, "일류 대학생"],
      [13, "삼류 대학생"],
      [15, "의사"],
      [16, "학자"],
      [17, "아나운서"],
      [18, "대기업 회사원"],
      [19, "저널리스트"],
      [20, "교사"],
      [21, "요리사"],
      [22, "경찰관"],
      [23, "매장 직원"],
      [24, "중소기업 회사원"],
      [25, "프리터"],
      [26, "전업주부"],
      [27, "은거인"],
      [29, "미용사"],
      [30, "정비사"],
    ]),
    PackNames: null,
    Name(id) {
      if (
        this.PackNames &&
        id >= 0 &&
        id < this.PackNames.length &&
        this.PackNames[id].length
      )
        return this.PackNames[id] === "없어" ? "없음" : this.PackNames[id];
      return this.Names.get(id) || "직업 #" + id;
    },
    Relation(r, g) {
      const v = SK.FamilyRole || {};
      return r === v.Grandfather || r === "Grandfather"
        ? 0
        : r === v.Grandmother || r === "Grandmother"
          ? 1
          : r === v.Father || r === "Father"
            ? 2
            : r === v.Mother || r === "Mother"
              ? 4
              : g === 1
                ? 7
                : 6;
    },
    Candidates(rules, startDay, birthDay, gender, relation) {
      const m = new OrigMem(),
        vm = rules.CreateVm(m),
        Buf = 0x0f000600,
        D0 = 0x0f000500,
        D1 = 0x0f000504;
      for (const [a, d] of [
        [D1, startDay],
        [D0, birthDay],
      ]) {
        m.W16(a, SK.GameDate.Year(d));
        m.W8(a + 2, SK.GameDate.Month(d));
        m.W8(a + 3, SK.GameDate.Day(d));
      }
      const age = vm.Call("08095D3C", D0, D1) & 255;
      vm.Call(
        "081114CC",
        Buf,
        age,
        gender,
        [0, 1, 2, 4].includes(relation) ? 0x14 : 0x24,
      );
      const r = [];
      for (let k = 0, n = m.R8(Buf); k < n && k < 44; k++)
        r.push(m.R8(Buf + 4 + 4 * k));
      return r;
    },
  };
  class OrigOffline {
    constructor(vm) {
      this.vm = vm;
      this.m = vm.Mem;
    }
    static Attach(vm) {
      return new OrigOffline(vm);
    }
    get Days() {
      return this.m.R32(OrigOffline.Obj + 0x9944);
    }
    get Done() {
      return this.m.R32(OrigOffline.Obj + 0x9940);
    }
    get Finished() {
      return this.Done >= this.Days;
    }
    static Record(m, now) {
      now = new Date(now);
      const F = OrigMem.Fam;
      m.W8(F + 0x67b, now.getFullYear() % 100);
      m.W8(F + 0x67c, now.getMonth() + 1);
      m.W8(F + 0x67d, now.getDate());
      m.W8(F + 0x67e, now.getHours());
      m.W8(F + 0x67f, now.getMinutes());
      m.W8(F + 0x680, now.getSeconds());
      m.W32(F + 0x20, m.R32(F + 0x20) | 0x1000);
      m.W32(F + 0x68c, m.Rand());
    }
    static Recorded(m) {
      return !!(m.R32(OrigMem.Fam + 0x20) & 0x1000);
    }
    static ElapsedDays(vm, now) {
      now = new Date(now);
      const m = vm.Mem,
        saved = OrigMem.Fam + 0x668,
        a = this.Scratch + 0x40,
        b = this.Scratch + 0x48;
      m.W16(a, m.R8(saved + 0x13));
      m.W8(a + 2, m.R8(saved + 0x14));
      m.W8(a + 3, m.R8(saved + 0x15));
      m.W16(b, now.getFullYear() % 100);
      m.W8(b + 2, now.getMonth() + 1);
      m.W8(b + 3, now.getDate());
      const days = vm.Call("08095EE8", a, b),
        s1 =
          m.R8(saved + 0x16) * 3600 +
          m.R8(saved + 0x17) * 60 +
          m.R8(saved + 0x18),
        s2 = now.getHours() * 3600 + now.getMinutes() * 60 + now.getSeconds();
      return u(Math.imul(days, 86400) + s2 - s1) >>> 3;
    }
    static Reseed(m) {
      m.W32(OrigMem.Seed, m.R32(OrigMem.Fam + 0x68c));
    }
    static Begin(vm, days) {
      const o = new OrigOffline(vm),
        m = o.m,
        O = this.Obj,
        F = OrigMem.Fam,
        S = this.Scratch;
      m.W8(O + 8, 0);
      o.Common();
      m.W8(0x02029ba0, 1);
      m.W16(0x02029ba6, 0);
      m.W32(O + 0x9940, 0);
      m.W32(O + 0x9944, days);
      vm.Call("0800E430", O + 0x5658, OrigMem.Date);
      if (m.R32(O + 0x9944) > this.MaxDays) m.W32(O + 0x9944, this.MaxDays);
      vm.Call("08095DAC", O + 0x5658, O + 0x565c, m.R32(O + 0x9944));
      vm.Call("080D448C", S + 0x60, S + 0x62, O + 0x5658, O + 0x565c);
