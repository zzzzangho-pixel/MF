        m = this.Game.Mem;
      if (m.R8(a) === 255 && m.R8(a + 1) === 255 && m.R8(a + 2) === 255)
        return -1;
      const d = origDate(m, a);
      return safeDay(d.year, d.month, d.day);
    }
    FamilyTypeName(type) {
      return type >= 0 && type < 9
        ? this.Text.UiText(
            349 + type,
            [
              "반짝반짝 가족",
              "느긋한 가족",
              "냉랭한 가족",
              "북적북적 가족",
              "화목한 가족",
              "침울한 가족",
              "노력하는 가족",
              "버티는 가족",
              "밑바닥 가족",
            ][type],
          )
        : "?";
    }
