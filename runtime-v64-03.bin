      r.nativeHelp = { id: v.HelpId, messageId: v.NativeMessageId };
    if (v.Scene) {
      r.scene = { band: v.Scene.Band, back: v.Scene.Back, pic: v.Scene.Pic };
      r.actors = v.Scene.Actors.map((a) => ({
        personId: a.PersonId,
        age: a.Age,
        anim: a.Anim,
        npcKind: a.NpcKind,
        npcAge: a.NpcAge,
        outfit: a.Outfit,
        npcKey: a.NpcKey,
        mirror: a.Mirror,
        back: a.Back,
        zoom: a.Zoom,
        look: lookJson(a.Look),
      }));
      r.scene.actors = r.actors;
    }
    return r;
  }
  const memoFields = ["phase", "pages", "page", "answerMsg", "lastReport",
    "memoPage", "familyShown", "ReplayRequest", "ReportIdsForTest",
    "WantsHeaven", "LineageEnded", "Millennium", "nativeImportantPointers",
    "archiveScope", "archiveSegmentStart"];
  const gameRuntimeFields = ["TodayEvent", "Announced", "Schedule", "EventTime",
    "SceneEndedDay", "EndCodes"];
  function installMemoObservers(memo) {
    memo.nativeImportantPointers = memo.nativeImportantPointers || [];
    if (memo.archiveSegmentStart === undefined)
