          "시대 연출",
          "[원작 시대 연출 화면 — 앱 요약] " +
            (band ? band + " — " : "") +
            this.text.UiText(392 + era, "새 시대가 열렸다!"),
        );
        if (k >= 0 && k < d.EraMsgs.length) this.Say(-2, d.EraMsgs[k], 2);
        this.Run(6);
