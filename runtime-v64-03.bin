          pixels.data[at] = (r << 3) | (r >> 2);
          pixels.data[at + 1] = (g << 3) | (g >> 2);
          pixels.data[at + 2] = (b << 3) | (b >> 2);
          pixels.data[at + 3] = 255;
        }
        ctx.putImageData(pixels, 0, 0);
        // OAM offset(-8,+4) is (+8,+20) from the ordinary bubble's(-16,-16).
        // Keep the existing crop origin, extending only its clipped bottom.
        canvas.skEmotionPlacement = { x: 0, y: 33, width: 37, height: 43 };
        this.emotionImages.set(name, canvas);
        return canvas;
      }
      const image = this.image(name);
      if (!name.startsWith("ev_emo_") || !image?.complete || !image.naturalWidth)
        return image;
      this.emotionImages ||= new Map();
      if (this.emotionImages.has(name)) return this.emotionImages.get(name);
      const canvas = document.createElement("canvas");
      canvas.width = image.naturalWidth;
      canvas.height = image.naturalHeight;
      const ctx = canvas.getContext("2d");
      ctx.drawImage(image, 0, 0);
      const pixels = ctx.getImageData(0, 0, canvas.width, canvas.height);
      let changed = false;
      // The original capture tool uses99,99,99 as the clear background.
      // Its hidden-frame subtraction left that sentinel opaque in11 emo PNGs.
      // Preserve source bytes and every other color; only repair clear alpha.
      for (let i = 0; i < pixels.data.length; i += 4) {
        if (pixels.data[i] === 99 && pixels.data[i + 1] === 99 &&
            pixels.data[i + 2] === 99 && pixels.data[i + 3] !== 0) {
          pixels.data[i + 3] = 0;
          changed = true;
        }
      }
      if (changed) ctx.putImageData(pixels, 0, 0);
      const result = changed ? canvas : image;
      this.emotionImages.set(name, result);
      return result;
    }
    selectHouse(era, grade, slot) {
      let key = "e" + era + "g" + grade,
        h = (this.manifest.houses || {})[key];
      if (!h) {
        key = "";
        h = this.manifest.house || {};
      }
      this.house = h;
      this.houseKey = key;
      this.houseSlot = slot;
      let file = (h.slots || {})[slot];
      if (!file) file = (h.slots || {})[(slot & ~1) % 8] || h.file;
      return this.image(file);
    }
    look(raw, age = 25, pose = 2, outfit = 0, mirror = false) {
      if (!raw || !this.parts.available) return null;
      const l = normalLook(raw),
        a = typeof age === "object" ? age : AgeSlots.forAge(age),
        key = JSON.stringify([l, a, pose, outfit, mirror]);
      if (this.lookCache.has(key)) return this.lookCache.get(key);
      const idx = Composer.compose(this.parts, l, a, pose, outfit, mirror),
        pal = this.parts.palette(l),
        can = document.createElement("canvas");
      can.width = 32;
      can.height = 64;
      const ctx = can.getContext("2d"),
        data = ctx.createImageData(32, 64);
      for (let i = 0; i < idx.length; i++) {
        const v = idx[i],
          c = pal[v] || 0,
          o = i * 4;
