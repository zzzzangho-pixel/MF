  function makeLook(values) {
    const defaults = {
      Body: 0,
      Face: 0,
      Hair: 0,
      Eyes: 0,
      Nose: 0,
      Mouth: 0,
      EyesFlip: false,
      NoseFlip: false,
      MouthFlip: false,
      HairColor: -1,
      SkinColor: -1,
      Outfit: 0,
