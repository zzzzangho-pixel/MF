    "최",
    "정",
    "강",
    "조",
    "윤",
    "장",
    "임",
    "한",
    "오",
    "서",
    "신",
    "권",
    "황",
    "안",
    "송",
    "류",
    "홍",
  ];
  const defaultLookM = [
    0, 0x43, 0x22, 0, 0, 5, 0x43, 1, 0, 2, 3, 0, 0, 0, 0, 0,
  ];
  const defaultLookF = [
    14, 0x12, 0x12, 0, 0x12, 0x22, 0x12, 15, 0, 2, 3, 0, 0, 0, 0, 0,
  ];
  function origDate(m, a) {
    const d = SK.OrigDate.Get(m, a);
    return {
      year: d.year ?? d.Year,
      month: d.month ?? d.Month,
      day: d.day ?? d.Day,
    };
  }
  function safeDay(y, m, d) {
    return SK.GameDate.Make(clamp(y, 1, 9999), clamp(m, 1, 12), Math.max(1, d));
  }
  const rel = (v) => (v === 0xffff ? -1 : v);
  const toolObj = 0x0f038000,
    toolChar = 0x0f038400;
  class OrigSession {
    constructor(rules, text, family, mem) {
      this.Rules = rules;
      this.Text = text || new OrigText();
      this.Family = family;
      this.Game = new SK.OrigGame(mem, rules);
      this.Game.TextOverride = (a) => this.Text.Overrides[a] !== undefined;
      this.LastChanges = [];
      this.pending = [];
      this.cur = null;
      this.pages = [];
      this.page = 0;
      this.stages = [];
      this.endStage = [];
      this.heavenWait = null;
      this.heavenCur = null;
      this.heavenPage = 0;
      this.heavenSong = 2; // Sound-only metadata; never written to rule memory.
      this.LastHeaven = null;
      this.memo = null;
      this.DeferEvents = false;
      this.EndMenu = 0;
      this.millenniumQueued = false;
      this.BookmarkAskPending = false;
      this.lineageQueued = false;
      this.bookmarkQueued = false;
      this.lineageShown = false;
      this.ParadeShown = false;
      this.lineageEnded = false;
      this.replaying = false;
      this.snaps = {};
      this.famSnap = { Mood: 0, Counts: {} };
      this.Project();
    }
    static BootSeed(vcount, steps) {
      let s = (vcount % 228) * 173;
      for (let i = 0; i < steps; i++) s = (Math.imul(s, 109) + 1021) >>> 0;
      return s;
    }
    static NewRecommended(
      rules,
      text,
      surname,
      seed,
      year = 2005,
      month = 1,
      day = 1,
      cartridge = null,
      fresh = true,
    ) {
      const m = new SK.OrigMem(),
        vm = rules.CreateVm(m);
      if (cartridge) SK.OrigNewGame.Cartridge(vm, cartridge);
      else SK.OrigNewGame.BlankCartridge(vm);
      if (fresh) SK.OrigNewGame.TitleFresh(m);
      SK.OrigNewGame.TitleNewGame(vm);
      m.W32(SK.OrigMem.Seed, seed);
      SK.OrigNewGame.Recommended(vm, year, month, day);
      const f = new Family({
        Name: surname || surnames[(seed >>> 0) % surnames.length],
      });
      m.W8(OrigSession.ArrowInv, 5);
      m.W8(OrigSession.ArrowInv + 1, 5);
      SK.OrigNewGame.MainStart(vm);
      const s = new OrigSession(rules, text, f, m);
      s.PrepareSave();
      return s;
    }
    static NewCustom(rules, text, setup, seed, cartridge = null, fresh = true) {
      const ordered = [],
        slots = [];
      let child = 4;
      for (let role = 0; role < 4; role++)
        for (const ms of setup.Members)
          if (ms.Role === role) {
            ordered.push(ms);
            slots.push(role);
          }
      for (const ms of setup.Members)
        if (ms.Role === 4 && child < 8) {
          ordered.push(ms);
          slots.push(child++);
        }
      const cms = ordered.map((ms, k) => {
        const c = SK.OrigNewGame.CustomMember
          ? new SK.OrigNewGame.CustomMember()
          : {};
        Object.assign(c, {
          Slot: slots[k],
          Daughter: ms.Gender === 1,
          Year: SK.GameDate.Year(ms.BirthDay),
          Month: SK.GameDate.Month(ms.BirthDay),
          Day: SK.GameDate.Day(ms.BirthDay),
          Blood: Math.max(0, MemberSetup.Bloods.indexOf(ms.Blood)),
          Personality: ms.Personality,
          RankStats: [0, 0, 0, 0],
          Look: Uint8Array.from(ms.Gender === 1 ? defaultLookF : defaultLookM),
        });
        ms.AbilityRank.forEach((rank, stat) => {
          if (rank >= 1 && rank <= 4) c.RankStats[rank - 1] = stat;
        });
        const cand = SK.OrigJobs.Candidates(
          rules,
          setup.StartDay,
          ms.BirthDay,
          ms.Gender,
          SK.OrigJobs.Relation(ms.Role, ms.Gender),
        );
        c.JobChoice = Math.max(0, cand.indexOf(ms.Job));
        return c;
      });
      const m = new SK.OrigMem(),
        vm = rules.CreateVm(m);
      if (cartridge) SK.OrigNewGame.Cartridge(vm, cartridge);
      else SK.OrigNewGame.BlankCartridge(vm);
      if (fresh) SK.OrigNewGame.TitleFresh(m);
      SK.OrigNewGame.TitleNewGame(vm);
      m.W32(SK.OrigMem.Seed, seed);
      SK.OrigNewGame.Custom(
        vm,
        SK.GameDate.Year(setup.StartDay),
        SK.GameDate.Month(setup.StartDay),
        SK.GameDate.Day(setup.StartDay),
        cms,
      );
      const f = new Family({
        Name: setup.Surname || surnames[(seed >>> 0) % surnames.length],
      });
      m.W8(OrigSession.ArrowInv, 5);
      m.W8(OrigSession.ArrowInv + 1, 5);
      SK.OrigNewGame.MainStart(vm);
      // Original 08049D54 selection-sorts whole child draft blocks by birth
      // date; later house records can also reorder parents. Bind browser
      // names/looks to the final draft's gene ID, never to house ordinal.
      const identityOrder = ordered.slice(),
        firstChild = identityOrder.findIndex((member) => member.Role === 4);
      if (firstChild >= 0)
        for (let i = firstChild; i < identityOrder.length - 1; i++) {
          let earliest = i;
          for (let j = i + 1; j < identityOrder.length; j++)
            if (identityOrder[j].BirthDay < identityOrder[earliest].BirthDay)
              earliest = j;
          if (earliest !== i)
            [identityOrder[i], identityOrder[earliest]] =
              [identityOrder[earliest], identityOrder[i]];
        }
      const identities = identityOrder.map((member, k) => ({
        member,
        id: m.R16(SK.OrigNewGame.Members + k * SK.OrigNewGame.MemberSize + 0x24),
      }));
      const liveIds = new Set();
      for (let n = 0; n < 8; n++)
        if (SK.OrigGame.Present(m, n))
          liveIds.add(m.R16(SK.OrigMem.PersonAddr(n) + 0x3c));
      if (identities.some(({ id }) => !liveIds.has(id)) ||
          new Set(identities.map(({ id }) => id)).size !== identities.length)
        throw new Error("원작 가족 구성원 연결을 확인할 수 없습니다.");
      for (const { id, member } of identities)
        if (member.Name) f.OrigNames[id] = member.Name;
      const s = new OrigSession(rules, text, f, m);
      for (const { id, member } of identities) {
        const p = s.Family.Get(id);
        if (p && member.Look) p.Look = lookClone(member.Look);
      }
      s.PrepareSave();
      return s;
    }
    static Load(rules, text, f) {
      if (!f || !f.IsOriginal) throw new Error("원작 가족 저장이 아님");
      const b = base64ToBytes(f.OrigState),
        m = new SK.OrigMem(),
        n = SK.OrigMem.SaveEnd - SK.OrigMem.SaveStart,
        blk = new Uint8Array(n);
      blk.set(b.subarray(0, Math.min(n, b.length)));
      m.LoadSaveBlock(blk);
      const dv = new DataView(b.buffer, b.byteOffset, b.byteLength);
      if (b.length >= n + 4) m.W32(SK.OrigMem.Seed, dv.getUint32(n, true));
      const s = new OrigSession(rules, text, f, m);
      if (b.length >= n + 5 && b[n + 4]) s.Game.ResumeMorning();
      if (b.length >= n + 37)
        for (let k = 0; k < 8; k++)
          s.Game.Schedule[k] = dv.getUint32(n + 5 + 4 * k, true);
      return s;
    }
    static CartridgeOf(f) {
      if (!f || !f.IsOriginal) return null;
      const b = base64ToBytes(f.OrigState),
        n = SK.OrigMem.SaveEnd - SK.OrigMem.SaveStart;
      return b.length < n ? null : b.slice(0, n);
    }
    PrepareSave() {
      this.SyncIn();
      this.Project();
      const blk = this.Game.Mem.SaveBlock(),
        b = new Uint8Array(blk.length + 37),
        dv = new DataView(b.buffer);
      b.set(blk);
      dv.setUint32(blk.length, this.Game.Mem.R32(SK.OrigMem.Seed), true);
      b[blk.length + 4] = this.Game.SceneEndedDay ? 1 : 0;
      for (let k = 0; k < 8; k++)
        dv.setUint32(blk.length + 5 + 4 * k, this.Game.Schedule[k], true);
      this.Family.OrigState = bytesToBase64(b);
    }
    ReplaceCatalog() {
      /* OrigSession does not use legacy content catalogs. */
    }
    get Paused() {
      return !!(this.cur || this.heavenCur || this.memo);
    }
    get Memo() {
      return this.memo;
    }
    get HasPending() {
      return (
        this.pending.length > 0 || !!(this.heavenWait && this.heavenWait.length)
      );
    }
    get ContinueKind() {
      const f = this.Game.Mem.R32(OrigSession.FamFlags);
      return f & 0x2000 ? 8 : f & 0x40 ? 7 : 1;
    }
    get MillenniumPending() {
      return this.EndMenu === 4;
    }
    get HasBookmark() {
      return !!(this.Game.Mem.R32(0x0202c678) & 0x80);
    }
    ContinuationViability() {
      // This user-requested continuation policy is separate from initial
      // family composition. Do not cancel a native closing scene already in
      // progress, a finished family, or an explicit final-menu boundary.
      if (this.Ended || this.EndMenu || this.lineageShown || this.lineageQueued ||
          this.BookmarkAskPending) return { viable: false, reason: "native-closure" };
      const epoch = this.continuationEpoch || 0;
      if (this.continuationCache?.epoch === epoch) return this.continuationCache.value;
      const result = value => {
        this.continuationCache = { epoch, value };
        return value;
      };
      const m = this.Game.Mem, living = this.Family.Members.filter(p =>
        p.Alive !== false && SK.OrigFamily.Record(m, p.Id));
      if (!living.length) return result({ viable: false, reason: "no-living-person" });
      // Original wedding/pregnancy routines book special{1,16}: master
      //08942010, accepted birth variant089415E0. Read the existing calendar
      // links; owner byte10+n is the native household index (08027090).
      // A widow keeps this booking and the deceased father's real gene.
      const birthOwner = id => living.find(p => p.Id === id && p.Gender === 1);
      for (const event of [this.cur, ...this.pending])
        if (event?.Data === 0x089415e0 && birthOwner(event.PersonId))
          return result({ viable: true, reason: "native-pending-birth", personId: event.PersonId });
      const seen = new Set();
      let node = m.R8(0x02038f70);
      while (node < 75 && !seen.has(node)) {
        seen.add(node);
        const address = 0x02038bec + 12 * node,
          data = 0x08000000 + (m.R32(address + 4) & 0xffffff),
          owner = m.R8(address + 8) - 10;
        if (data === 0x08942010 && owner >= 0 && owner < 8) {
          const personId = m.R16(SK.OrigMem.PersonAddr(owner) + 0x3c);
          if (birthOwner(personId))
            return result({ viable: true, reason: "native-scheduled-birth", personId });
        }
        node = m.R8(address + 9);
      }
      let read = m.R16(SK.OrigGame.Queue + 0xa), write = m.R16(SK.OrigGame.Queue + 8);
      for (let count = 0; count < SK.OrigGame.QueueSize && read !== write; count++) {
        const address = SK.OrigGame.QueueEntries + 8 * read, personId = m.R16(address + 6);
        if (m.R32(address) === 0x089415e0 && birthOwner(personId))
          return result({ viable: true, reason: "native-queued-birth", personId });
        read = (read + 1) % SK.OrigGame.QueueSize;
      }
      // A genuine native-born dependent can grow into a next-generation
      // courtship window. A second person/count alone is not sufficient.
      for (const person of living) {
        const record = SK.OrigFamily.Record(m, person.Id), age = person.Age(this.Family.Today),
          parent = [person.FatherId, person.MotherId].some(id => id >= 0 && id !== person.Id &&
            SK.OrigMem.GeneAddr(id) + SK.OrigMem.GeneSize <= SK.OrigMem.Slots);
        if (parent && age >= 0 && age < 16 && !(m.R8(record + 0x37) & 2))
          return result({ viable: true, reason: "native-born-dependent", personId: person.Id });
      }
      // These indices were derived from the original native call graph:
      // their result/start paths create a real temporary partner08113DFC.
      // Native age-stage lists, gender filters and predicates still decide
      // eligibility; no translated-text matching, blanket age/count rule,
      // native RNG consumption, head promotion or save/terminal-bit write.
      const interests = {
        0: [75,77,79,82,84,85,86,87,94,100,104,109,116,123,130,138,140,152],
        2: [28,36,45,51,53,55,58,69,78,81,93,99,111,113,119,121,122,126,127,131,145,149,162,180,191,194,196,201,206],
      }, memory = new SK.OrigMem();
      memory.ShareRom(m);
      for (const bank of ["Ewram", "Iwram", "Frames", "Io"]) memory[bank].set(m[bank]);
      const query = this.Rules.CreateVm(memory), era = Math.min(3, m.R8(SK.OrigMem.Fam + 0x682));
      for (const person of living) {
        const stage = SK.OrigSelect.Stage(person.Age(this.Family.Today));
        SK.OrigFamily.BuildSlots(memory, person.Id);
        for (const table of [0, 2]) {
          const available = this.Rules.Candidates.get(table)?.[stage]?.[era] || [];
          for (const index of interests[table]) {
            if (!available.includes(index)) continue;
            const interest = this.Rules.Get(table, index);
            if (!interest || interest.Gender !== 2 && interest.Gender !== person.Gender) continue;
            try {
              if (query.Call(interest.Pred, 0))
                return result({ viable: true, reason: "native-courtship", personId: person.Id, table, index });
            } catch (error) {
              // An unsupported native predicate cannot prove eligibility.
              if (!(error instanceof SK.OrigUnmodeled)) throw error;
            }
          }
        }
      }
      return result({ viable: false, reason: "no-native-continuation" });
    }
    get LineageEnded() {
      const missingHead = !this.Family.Members.length || !this.Family.Get(this.Family.HeadId);
      return !!(this.lineageEnded || missingHead) && !this.ContinuationViability().viable;
    }
    get Ended() {
      return !!(this.Game.Mem.R32(SK.OrigMem.Fam + 0x668) & 0x100);
    }
    get PlayerName() {
      return this.Family.OrigNames[-2] || "신님";
    }
    set PlayerName(v) {
      this.Family.OrigNames[-2] = v;
    }
    Record(now = new Date()) {
      this.SyncIn();
      SK.OrigOffline.Record(this.Game.Mem, now);
    }
    StartOffline(now = new Date(), elapsedDays = null, archiveScope = null) {
      if (
        this.Paused ||
        this.ContinueKind !== 1 ||
        !SK.OrigOffline.Recorded(this.Game.Mem)
      )
        return false;
      // Browser callers supply a validated wall-clock delta. Never feed a
      // backwards clock into the original uint32 RTC subtraction.
      now = new Date(now);
      if (!Number.isFinite(now.getTime())) return false;
      if (elapsedDays !== null && (!Number.isSafeInteger(elapsedDays) || elapsedDays < 0))
        return false;
      if (elapsedDays === null) {
        const m = this.Game.Mem, F = SK.OrigMem.Fam,
          recorded = new Date(2000 + m.R8(F + 0x67b), m.R8(F + 0x67c) - 1,
            m.R8(F + 0x67d), m.R8(F + 0x67e), m.R8(F + 0x67f), m.R8(F + 0x680));
        if (now.getTime() < recorded.getTime()) return false;
      }
      this.SyncIn();
      SK.OrigOffline.Reseed(this.Game.Mem);
      const days = elapsedDays === null
        ? SK.OrigOffline.ElapsedDays(this.Game.Vm, now)
        : Math.min(elapsedDays, SK.OrigOffline.MaxDays);
      this.memo = new SK.OrigMemoFlow(
        this.Game.Vm,
        this.Text,
        (id) => this.MarkName(id),
        () => this.PlayerName,
        (id) => this.AgeOf(id),
        days,
      );
      this.memo.FamilyView = () => this.MemoFamilyText();
      this.memo.archiveScope = archiveScope === null
        ? "native:" + hex(this.Game.Mem.R32(SK.OrigOffline.Obj + 0x5658)) + ":" +
          hex(this.Game.Mem.R32(SK.OrigMem.Fam + 0x68c)) : String(archiveScope);
      this.memo.archiveSegmentStart = this.Game.Mem.R32(SK.OrigOffline.Obj + 0x5658);
      installMemoObservers(this.memo);
      return true;
    }
    MemoEntries() {
      if (!this.memo) return [];
      const m = this.Game.Mem, O = SK.OrigOffline.Obj,
        important = new Set([...(this.memo.nativeImportantPointers || []),
          ...Array.from({ length: 20 }, (_, i) => m.R32(O + 0x5684 + 4 * i))]),
        pointers = [];
      let pointer = m.R32(O + 0x566c), guard = 0;
      while (pointer && pointer !== O + 0x5668 && guard++ < 800) {
        if (m.R8(pointer + 8)) pointers.push(pointer);
        pointer = m.R32(pointer + 4);
      }
      return this.memo.Entries().map((entry, i) => ({ ...entry,
        nativeDateCode: m.R32(pointers[i] + 0x14),
        nativeImportant: important.has(pointers[i]) }));
    }
    AgeOf(id) {
      const p = this.Family.Get(id);
      return p ? p.Age(this.Family.Today) : -1;
    }
    MemoFamilyText() {
      this.Project();
      const f = this.Family,
        d = origDate(this.Game.Mem, SK.OrigMem.Date);
      let s =
        d.year + "년 " + d.month + "월 " + d.day + "일 현재의 " + f.Name + "가";
      for (const p of [...f.Members].sort(
        (a, b) => (a.Id === f.HeadId ? 0 : 1) - (b.Id === f.HeadId ? 0 : 1),
      )) {
        let relation = "?";
        try {
          relation = this.Text.UiText(this.Game.Vm.Call("080F9F1C", p.Id), "?");
        } catch (e) {
          if (!(e instanceof SK.OrigUnmodeled)) throw e;
        }
        s +=
          "\n" +
          (p.Id === f.HeadId ? "♛ " : "· ") +
          relation +
          "  " +
          p.Name +
          "  " +
          p.Age(f.Today) +
          "세  " +
          SK.OrigJobs.Name(p.Job);
      }
      return (
        s +
        "\n\n" +
        this.Game.Mem.R8(SK.OrigMem.Fam + 0x6a3) +
        "대째  세대주: " +
        (f.Get(f.HeadId)?.Name || "?")
      );
    }
    StepDay() {
      if (this.Paused) return false;
      if (this.pending.length) {
        this.StartNext();
        return true;
      }
      if (this.StartHeaven()) return true;
      this.SyncIn();
      this.Game.NextDate();
      let wedding = false,
        millennium = false;
      for (const e of this.Game.TickDay()) {
        this.pending.push(e);
        if (e.Result[0] === 2) this.lineageEnded = true;
        if (e.Result[0] === 1) wedding = true;
        if (e.Result[0] === 3) millennium = true;
      }
      if (wedding) this.HeavenReport();
      if (millennium) this.MillenniumReport();
      this.Project();
      if (this.DeferEvents) return false;
      if (this.pending.length) {
        this.StartNext();
        return true;
      }
      return this.StartHeaven();
    }
    ShowDue(time) {
      if (this.Paused) return false;
      if (this.pending.length) {
        if (this.pending[0].Time > time) return false;
        this.StartNext();
        return true;
      }
      return this.StartHeaven();
    }
    StartHeaven() {
      if (!this.heavenWait || !this.heavenWait.length) {
        this.heavenWait = null;
        return false;
      }
      this.heavenCur = this.heavenWait;
      this.heavenWait = null;
      this.heavenPage = 0;
      this.heavenSong = this.millenniumQueued
        ? 4
        : this.lineageQueued || this.bookmarkQueued ? 5 : 2;
      return true;
    }
    get SceneMusic() {
      if (this.heavenCur) return this.heavenSong;
      if (this.memo && !this.replaying) return -1;
      if (!this.cur) return -1;
      const m = this.Game.Mem, p = m.R32(this.cur.Data + 0x2c);
      if (p < 0x08000000 || p >= 0x0a000000) return -1;
      const id = m.R32(p);
      return id >= 41 && id <= 63 ? id : -1;
    }
    SceneExit(kind) {
      const m = this.Game.Mem;
      try {
        this.Game.Vm.Call("0800F40C");
      } catch (e) {
        if (!(e instanceof SK.OrigUnmodeled)) throw e;
      }
      const f = m.R32(OrigSession.FamFlags);
      m.W32(
        OrigSession.FamFlags,
        kind === 4 ? f | 8 | 0x2000 : (f | 4 | 0x40) & ~0x2000,
      );
      this.EndMenu = kind;
      this.Project();
    }
    FlushEndQueues() {
      if (this.millenniumQueued) {
        this.millenniumQueued = false;
        this.SceneExit(4);
      }
      if (this.lineageQueued) {
        this.lineageQueued = false;
        this.SceneExit(5);
      }
      if (this.bookmarkQueued) {
        this.bookmarkQueued = false;
        this.BookmarkAskPending = true;
      }
    }
    FamilyYears() {
      const m = this.Game.Mem,
        t = 0x0f03b040;
      this.Game.Vm.Call("0800E430", t, 0x0202c688);
      this.Game.Vm.Call("0800E430", t + 4, SK.OrigMem.Date);
      this.Game.Vm.Call("080D448C", t + 8, t + 10, t, t + 4);
      return m.R16(t + 8);
    }
    NewHeaven() {
      return new SK.OrigHeaven(
        this.Game.Vm,
        this.Text,
        this.Text.Heaven,
        (id) => this.MarkName(id),
        this.PlayerName,
      );
    }
    AppendHeaven(h) {
      if (h.Pages.length) {
        if (!this.heavenWait) this.heavenWait = [];
        this.heavenWait.push(...h.Pages);
      }
    }
    LineageReport() {
      if (this.lineageShown || this.EndMenu || this.BookmarkAskPending)
        return false;
      this.lineageShown = true;
      const h = this.NewHeaven();
      h.Years = this.FamilyYears();
      const bm = this.HasBookmark;
      h.RunLineageEnd(bm);
      if (bm) this.bookmarkQueued = true;
      else this.lineageQueued = true;
      this.AppendHeaven(h);
      if (this.StartHeaven()) return true;
      this.FlushEndQueues();
      return false;
    }
    AnswerBookmark(yes) {
      this.BookmarkAskPending = false;
      const h = this.NewHeaven();
      h.Years = this.FamilyYears();
      if (yes) {
        this.RestoreBookmark();
        this.lineageShown = false;
      } else this.lineageQueued = true;
      h.RunBookmarkAnswer(yes);
      this.AppendHeaven(h);
      if (!this.StartHeaven()) this.FlushEndQueues();
    }
    MillenniumReport() {
      const h = this.NewHeaven();
      h.RunMillennium();
      this.AppendHeaven(h);
      this.millenniumQueued = true;
    }
    ShowEndingAgain() {
      if (this.ContinueKind !== 8 || this.Paused) return false;
      this.MillenniumReport();
      if (this.StartHeaven()) return true;
      this.FlushEndQueues();
      return false;
    }
    FinalMsg(id) {
      return this.NewHeaven().MsgPages(id);
    }
    FinishFamily(now) {
      const m = this.Game.Mem;
      m.W32(SK.OrigMem.Fam + 0x668, m.R32(SK.OrigMem.Fam + 0x668) | 0x100);
      this.Record(now);
      this.EndMenu = 0;
    }
    EndingCard() {
      let years;
      try {
        years = this.FamilyYears();
      } catch (e) {
        if (!(e instanceof SK.OrigUnmodeled)) throw e;
        years = this.CurrentRecord()?.Years ?? this.Family.YearsAsFamily;
      }
      return [
        this.Text.UiText(570, "{이름38}성 신님").replaceAll(
          "{이름38}",
          String(this.Game.Mem.R16(0x0202c66e)),
        ),
        this.Text.UiText(571, "{이름38}이/가 지켜본 {이름39}가문은…")
          .replaceAll("{이름38}", this.PlayerName)
          .replaceAll("{이름39}", this.Family.Name)
          .replaceAll("이/가", josa(this.PlayerName, "이가")),
        years + "년가족",
        this.Text.UiText(572, "이었습니다…♪"),
      ];
    }
    HeavenReport(entry = 2) {
      const h = this.NewHeaven();
      try {
        h.RunAfterWedding(entry);
      } catch (e) {
        if (!(e instanceof SK.OrigUnmodeled)) throw e;
      }
      this.LastHeaven = h;
      this.AppendHeaven(h);
    }
    CenturyCheck() {
      const m = this.Game.Mem,
        out = 0x0f03b480;
      try {
        this.Game.Vm.Call("080A113C", out);
        if (m.R32(out) === 0x37 && m.R8(OrigSession.ItemInv + 10) < 255)
          m.W8(OrigSession.ItemInv + 10, m.R8(OrigSession.ItemInv + 10) + 1);
      } catch (e) {
        if (!(e instanceof SK.OrigUnmodeled)) throw e;
      }
    }
    SyncIn() {
      const m = this.Game.Mem;
      for (let n = 0; n < 8; n++) {
        if (!SK.OrigGame.Present(m, n)) continue;
        const a = SK.OrigMem.PersonAddr(n),
          p = this.Family.Get(m.R16(a + 0x3c)),
          sn = p && this.snaps[p.Id];
        if (!p || !sn) continue;
        if (p.ArrowFlags !== sn.Arrow) m.W8(a + 0x69, p.ArrowFlags & 255);
        for (let i = 0; i < 4; i++)
          if (p.Stats[i] !== sn.Stats[i])
            m.W16(a + 0x50 + 2 * i, clamp(p.Stats[i], 0, 5000));
      }
      if (this.Family.Mood !== this.famSnap.Mood)
        m.W8(0x0202c6ae, clamp(this.Family.Mood, 0, 255));
      for (const t of SK.Interventions.Tools) {
        if (t.OrigSlot < 0) continue;
        const n = SK.Interventions.Count(this.Family, t.Id);
        if (
          this.famSnap.Counts[t.Id] === undefined ||
          n !== this.famSnap.Counts[t.Id]
        )
          m.W8(OrigSession.SlotAddr(t), clamp(n, 0, 255));
      }
    }
    static SlotAddr(t) {
      // One original common inventory bank; the selected person is only the
      // recipient of Use(), never an owner or part of the inventory address.
      return (
        (t.Kind === "arrow" ? OrigSession.ArrowInv : OrigSession.ItemInv) +
        t.OrigSlot
      );
    }
    RecordOf(target) {
      if (!target) return 0;
      for (let n = 0; n < 8; n++)
        if (
          SK.OrigGame.Present(this.Game.Mem, n) &&
          this.Game.Mem.R16(SK.OrigMem.PersonAddr(n) + 0x3c) === target.Id
        )
          return SK.OrigMem.PersonAddr(n);
      return 0;
    }
    PersonArrowEffects(target) {
      // Read only the original resident record. Short effects live in flag
      // bits 1/2, not HitArrow (which is reserved for the persistent boom).
      const m = this.Game.Mem, record = this.RecordOf(target), effects = [];
      if (!record) return effects;
      const flags = m.R8(record + 0x69), hit = m.R8(record + 0x60);
      if ((flags & 6) === 2) effects.push({ id: "arrow.encourage", name: "힘내라" });
      if ((flags & 6) === 4) effects.push({ id: "arrow.calm", name: "진정해" });
      const durationYears = hit === 5 ? 1 : [2, 3, 4, 6].includes(hit) ? 5 : 0,
        tool = durationYears ? SK.Interventions.Tools.find(t => t.Kind === "arrow" && t.OrigSlot === hit) : null;
      if (tool) {
        // Original 08027E78 increments +46 and clears +60 at 365/1826 days.
        // Respect that native transition; this read never expires an effect.
        effects.push({
          id: tool.Id, name: tool.Name.replace(/의 화살$/, ""),
          durationYears,
          remainingDays: Math.max(0, (durationYears === 1 ? 365 : 1826) - m.R16(record + 0x46)),
        });
      }
      return effects;
    }
    PersonDetailFields(target) {
      // Read-only original owner data: no event slots, live VM execution,
      // native writes, RNG consumption or new persistent name aliases.
      const m=this.Game.Mem,record=this.RecordOf(target),out={salaryBase:null,loverPresent:false,loverName:null,spouseName:null};
      if(!record)return out;
      const rom=address=>address>=0x08000000&&address<0x0a000000,
        job=m.R8(record+0x58),rank=m.R8(record+0x59),count=SK.OrigJobs.PackNames?.length||161;
      if(job<count){
        // Original08116734 field32 ->0811A1CC: job table, current rank,
        // rank record+4.08113674 stores12×this as annual salary. This
        // is basic monthly pay, not bonuses or a net-pay estimate.
        const entry=m.R32(0x0889d3b8+4*job);
        if(rom(entry)&&rank<m.R8(entry+6)){
          const ranks=m.R32(entry+0x20),selected=rom(ranks)?m.R32(ranks+4*rank):0;
          if(rom(selected))out.salaryBase=m.R32(selected+4);
        }
      }
      out.loverPresent=m.R8(record+0x74)!==255;
      if(out.loverPresent){
        const gender=m.R8(record+0x31)^1;
        if(gender<=1)out.loverName=partnerDisplayName(this,{OwnerId:target.Id,Gender:gender,
          Name:nameBytes(m,record+0x3b2),Surname:nameBytes(m,record+0x3a4),
          Look:Array.from({length:16},(_,k)=>m.R8(record+0x3c0+k))},false,false);
      }
      if(target.SpouseId>=0){
        const id=target.SpouseId,gene=SK.OrigMem.GeneAddr(id);
        out.spouseName=this.Family.Get(id)?.Name||this.Family.OrigNames[id]||null;
        if(!out.spouseName&&gene+SK.OrigMem.GeneSize<=SK.OrigMem.Slots){
          const gender=m.R8(gene+0x31),ordinal=gender<=1?nativeNameOrdinal(m,gender,nameBytes(m,gene+0x20)):-1;
          if(ordinal>=0){const names=gender===1?femaleNames:maleNames;out.spouseName=names[ordinal%names.length];}
        }
      }
      return out;
    }
    PrepareTool(rec) {
      const m = this.Game.Mem;
      for (let i = 0; i < 0x800; i += 4) m.W32(toolObj + i, 0);
      m.W32(toolObj + 4, toolChar);
      m.W32(toolObj + 0x154, 0);
      m.W32(toolChar + 4, rec);
    }
    CanUse(id) {
      const t = SK.Interventions.Find(id);
      return !!(t && t.OrigSlot >= 0 && id !== "arrow.link");
    }
    Use(target, id) {
      const t = SK.Interventions.Find(id);
      if (!t || t.OrigSlot < 0) return "알 수 없는 도구";
      if (id === "arrow.link") return t.Name + "은(는) 아직 옮기지 않았습니다";
      if (id === "item.heart_crystal")
        return "이어받을 선대의 마음을 고르세요 (UseLegacyHeart)";
      if (id === "arrow.legacy")
        return "이어받을 선대의 꿈을 고르세요 (UseLegacyDream)";
      if (!target) return "대상이 없습니다";
      this.SyncIn();
      const m = this.Game.Mem,
        rec = this.RecordOf(target),
        inv = OrigSession.SlotAddr(t);
      if (!rec) return "대상이 없습니다";
      if (!m.R8(inv)) return t.Name + "이(가) 없습니다";
      const ew = m.Ewram.slice(),
        iw = m.Iwram.slice();
      try {
        this.PrepareTool(rec);
        if (t.Kind === "arrow") {
          if (!this.Game.Vm.Call("0801CECC", toolObj, t.OrigSlot))
            return OrigSession.ArrowRefusal(
              OrigSession.RefusalEntry(m, m.R32(toolObj + 0x200)),
              t,
            );
          this.Game.Vm.Call(
            "08024440",
            toolObj,
            t.OrigSlot,
            toolChar,
            m.R16(toolObj + 0x18c),
          );
        } else {
          const r = this.Game.Vm.Call("08024B80", t.OrigSlot, rec, 0, toolObj);
          if (r) return OrigSession.ItemRefusal(t, r);
        }
        m.W8(inv, m.R8(inv) - 1);
        this.Project();
        return null;
      } catch (e) {
        m.Ewram.set(ew);
        m.Iwram.set(iw);
        if (!(e instanceof SK.OrigUnmodeled)) throw e;
        return t.Name + ": 원작 함수 실행 실패 (" + e.message + ")";
      }
    }
    static RefusalEntry(m, text) {
      for (let a = 0x0858683c; a < 0x085868c0; a += 4) {
        try {
          if (m.R32(a) === text) return a;
        } catch (e) {
          if (!(e instanceof SK.OrigUnmodeled)) throw e;
        }
      }
      return 0;
    }
    static ArrowRefusal(msg, t) {
      return (
        {
          0x0858683c:
            "화살의 효과가 계속되고 있습니다. 힘내라의 화살·진정해의 화살은 쏠 수 없습니다",
          0x08586840: "열중 게이지가 바닥이라 힘내라의 화살을 쏠 수 없습니다",
          0x08586844: "열중 게이지가 가득이라 진정해의 화살을 쏠 수 없습니다",
        }[msg] ||
        "지금 이 사람에게는 " +
          t.Name +
          "을(를) 쏠 수 없습니다 (원작 판정, 문구 " +
          hex(msg) +
          ")"
      );
    }
    static ItemRefusal(t, r) {
      return t.Id === "item.torch"
        ? "악마가 와 있을 때만 쓸 수 있습니다"
        : t.Id === "item.ring.love"
          ? "연인이 있을 때만 쓸 수 있습니다"
          : t.Id === "item.crown"
            ? r === 1
              ? "세대주의 자녀에게만 쓸 수 있습니다"
              : "지금은 후계자의 왕관을 쓸 수 없습니다"
            : "지금은 " +
              t.Name +
              "을(를) 쓸 수 없습니다 (원작 판정 " +
              r +
              ")";
    }
    RestoreBookmark() {
      if (!this.HasBookmark) return false;
      const r = this.Game.Vm.Call("08010AB4");
      this.pending = [];
      this.cur = null;
      this.heavenCur = this.heavenWait = null;
      this.lineageEnded = false;
      this.EndMenu = 0;
      this.lineageQueued = this.bookmarkQueued = false;
      this.Project();
      return !!r;
    }
    ReadLegacy(addr, byteLast) {
      const r = [],
        m = this.Game.Mem;
      for (let k = 0; k < 99; k++) {
        const id = m.R16(addr + 4 * k);
        if (id === 65535) break;
        r.push([
          id,
          byteLast ? m.R8(addr + 4 * k + 2) : m.R16(addr + 4 * k + 2),
        ]);
      }
      return r;
    }
    LegacyHearts() {
      return this.ReadLegacy(OrigSession.LegacyList, true);
    }
    LegacyDreams() {
      return this.ReadLegacy(OrigSession.DreamList, false);
    }
    SkillName(k) {
      return this.Text.Skills[k]?.Name || "스킬 " + k + "번";
    }
    SkillDesc(k) {
      const s = this.Text.Skills[k];
      return !s ? "" : s.Effect ? s.Desc + " (" + s.Effect + ")" : s.Desc;
    }
    LegacyName(id) {
      return this.NameOf(id, -1);
    }
    DreamName(interest) {
      const d = this.Text.Heaven.Dreams;
      return (
        (d instanceof Map ? d.get(interest & 0x7fff) : d[interest & 0x7fff]) ||
        "꿈 " + interest + "번"
      );
    }
    UseLegacyHeart(target, k) {
      return this.UseLegacy(target, k, true);
    }
    UseLegacyDream(target, k) {
      return this.UseLegacy(target, k, false);
    }
    UseLegacy(target, k, heart) {
      const t = SK.Interventions.Find(
        heart ? "item.heart_crystal" : "arrow.legacy",
      );
      if (!target) return "대상이 없습니다";
      this.SyncIn();
      const m = this.Game.Mem,
        inv = OrigSession.SlotAddr(t);
      if (!m.R8(inv)) return t.Name + "이(가) 없습니다";
      const list = heart ? this.LegacyHearts() : this.LegacyDreams();
      if (k < 0 || k >= list.length)
        return heart ? "선대의 마음이 없습니다" : "선대의 꿈이 없습니다";
      const rec = this.RecordOf(target);
      if (!rec) return "대상이 없습니다";
      const ew = m.Ewram.slice(),
        iw = m.Iwram.slice();
      try {
        this.PrepareTool(rec);
        m.W16(toolObj + 0x18e, list[k][0]);
        if (heart) {
          m.W16(toolObj + 0x190, list[k][1]);
          m.W16(toolObj + 0x192, 65535);
          if (this.Game.Vm.Call("08024B80", 100 + k, rec, list[k][1], toolObj))
            return "이미 익힌 스킬이라 이어받을 수 없습니다";
        } else {
          m.W16(toolObj + 0x18c, list[k][1]);
          if (!this.Game.Vm.Call("0801CECC", toolObj, 100 + k))
            return OrigSession.ArrowRefusal(
              OrigSession.RefusalEntry(m, m.R32(toolObj + 0x200)),
              t,
            );
          this.Game.Vm.Call("08024440", toolObj, 100 + k, toolChar, list[k][1]);
        }
        this.Game.Vm.Call("0800F9AC", heart ? 1 : 0, k);
        this.Project();
        return null;
      } catch (e) {
        m.Ewram.set(ew);
        m.Iwram.set(iw);
        if (!(e instanceof SK.OrigUnmodeled)) throw e;
        return t.Name + ": 원작 함수 실행 실패 (" + e.message + ")";
      }
    }
    StartNext() {
      this.cur = this.pending.shift();
      this.BuildPages();
    }
    BuildPages() {
      this.page = 0;
      this.stages = [];
      this.endStage = [];
      const rec = this.Text.Records[this.cur.Data],
        name = eventTextResolver(this);
      if (rec && rec.Script)
        this.pages = OrigText.ScenePages(
          rec.Script,
          name,
          this.stages,
          this.endStage,
        );
      else if (this.Text.HasCharset)
        this.pages = this.Text.Decode(
          OrigText.ReadRaw(
            this.Game.Mem,
            this.Game.Mem.R32(this.cur.Data + 0x14),
          ),
          name,
          (id) => this.MarkName(id),
        );
      else this.pages = [];
      if (!this.pages.length)
        this.pages.push(
          "(원작 사건 " + hex(this.cur.Data) + " — 대사 자료 없음)",
        );
      let untranslated = false;
      if (this.Text.HasCharset && this.cur.Shown && this.cur.Shown.length)
        for (const pg of this.Text.Decode(localizedEventShown(this, this.cur.Shown), name, (id) =>
          this.MarkName(id),
        )) {
          if (OrigText.Untranslated(pg)) untranslated = true;
          else this.pages.push(pg);
        }
      if (!this.Text.HasCharset || untranslated) {
        const god = this.GodPage(this.cur, untranslated);
        if (god) this.pages.push(god);
      }
    }
    MarkName(id) {
      if (id === partnerNameMark || id === partnerSurnameMark)
        return partnerDisplayName(this, eventPartnerName(this), id === partnerSurnameMark);
      return id === SK.OrigResultScript.MarkFamily
        ? this.Family.Name
        : id === SK.OrigResultScript.MarkPlayer
          ? this.PlayerName
          : this.NameOf(id, -1);
    }
    GodPage(e, giftsOnly = false) {
      const rows = [];
      if (!giftsOnly && e.Points1 > e.Points0)
        rows.push(
          this.NameOf(e.PersonId, -1) +
            "이(가) 신님에게 감사! 감사의 마음 +" +
            (e.Points1 - e.Points0) +
            " (모두 " +
            e.Points1 +
            "개)",
        );
      if (!giftsOnly && e.Rank1 > e.Rank0)
        rows.push("신님 랭크가 " + e.Rank1 + "성이 됐다!");
      const gifts = [];
      if (e.Inv1 && e.Inv0)
        for (const t of SK.Interventions.Tools) {
          const k = (t.Kind === "arrow" ? 0 : 16) + t.OrigSlot,
            d = e.Inv1[k] - e.Inv0[k];
          if (d > 0) gifts.push(t.Name + " ×" + d);
        }
      if (gifts.length) rows.push("받은 것: " + gifts.join(", "));
      return rows.length ? "[앱 요약] " + rows.join("\n") : null;
    }
    SlotName(code) {
      if (code === 0x27) return this.Family.Name;
      if (code < 0 || code >= 28 || !this.cur) return null;
      const id = this.cur.Slots[code];
      return id === 65535 ? null : this.NameOf(id, -1);
    }
    NameOf(id, gender) {
      if (this.Family.OrigNames[id]) return this.Family.OrigNames[id];
      const m = this.Game.Mem, gene = SK.OrigMem.GeneAddr(id),
        hasGene = id >= 0 && gene + SK.OrigMem.GeneSize <= SK.OrigMem.Slots;
      if (gender < 0) gender = this.Family.Get(id)?.Gender ?? (hasGene && m.R8(gene + 0x31) === 1 ? 1 : 0);
      if (hasGene) {
        const raw = nameKey(nameBytes(m, gene + 0x20)),
          look = nameKey(Array.from({ length: 16 }, (_, k) => m.R8(gene + k))), matches = [];
        for (const [key, name] of Object.entries(this.Family.OrigNames)) {
          const match = /^@partner:(\d+):([01]):([0-9a-f]+):([0-9a-f]{32})$/.exec(key);
          if (match && Number(match[2]) === gender && match[3] === raw && match[4] === look)
            matches.push({ OwnerId: Number(match[1]), Name: name });
        }
        const related = matches.filter((p) => m.R16(SK.OrigMem.GeneAddr(p.OwnerId) + 0x14) === id || m.R16(gene + 0x14) === p.OwnerId),
          match = related.length === 1 ? related[0] : matches.length === 1 ? matches[0] : null;
        if (match) return (this.Family.OrigNames[id] = match.Name);
      }
      const list = gender === 1 ? femaleNames : maleNames,
        used = new Set(this.Family.Members.map((p) => p.Name));
      for (let n = 0; n < 8; n++)
        if (SK.OrigGame.Present(this.Game.Mem, n)) {
          const name =
            this.Family.OrigNames[
              this.Game.Mem.R16(SK.OrigMem.PersonAddr(n) + 0x3c)
            ];
          if (name) used.add(name);
        }
      let s = null;
      for (let k = 0; k < list.length && !s; k++) {
        const c = list[(id + k) % list.length];
        if (!used.has(c)) s = c;
      }
      if (!s) s = list[id % list.length] + id;
      this.Family.OrigNames[id] = s;
      return s;
    }
    View() {
      if (this.heavenCur) {
        const hp =
          this.heavenCur[Math.min(this.heavenPage, this.heavenCur.length - 1)];
        return {
          EventId: hp.State === -2 ? "cupid-help" : "heaven",
          HelpId: hp.State === -2 ? hp.MsgId - 1000 : null,
          NativeMessageId: hp.MsgId,
          Title:
            hp.State === -2
              ? "큐피트"
              : hp.MsgId < 0
                ? "천계 — " + hp.Screen
                : "천계",
          Speaker:
            hp.Speaker === 1 ? "높으신 신" : hp.Speaker === 2 ? "큐피트" : "",
          Text: hp.Text,
          Phase: "pages",
          Origin: "original",
          Certainty: "rom",
          TextSource: hp.MsgId < 0 ? "app-summary" : "original-translation",
          PersonId: -1,
        };
      }
      if (this.memo && !this.replaying) return this.memo.View();
      if (!this.cur) return null;
      const rec = this.Text.Records[this.cur.Data];
      return {
        EventId: rec ? rec.Id : "0x" + hex(this.cur.Data),
        Title: rec?.Title || "원작 사건",
        Speaker: "",
        Text: this.pages[Math.min(this.page, this.pages.length - 1)],
        Phase: "pages",
        Origin: "original",
        Certainty: "rom",
        TextSource: rec ? "reference-translation" : "none",
        PersonId: this.cur.PersonId,
        Scene: this.SceneOf(Math.min(this.page, this.pages.length - 1)),
      };
    }
    RestoreSceneParticipants() {
      const cur = this.cur, m = this.Game.Mem;
      if (!cur || !Array.isArray(this.pending) || this.pending.length || this.memo || this.replaying ||
          !this.Family.IsOriginal || !Array.isArray(cur.Slots) || cur.Slots.length !== 28 ||
          !Number.isInteger(cur.Data) || !this.Text.Records[cur.Data] ||
          !Number.isInteger(cur.PersonId) || !Number.isInteger(cur.Type) || cur.Type < 0 || cur.Type > 65535) return false;
      // Legacy repair is limited to the four audited child-selection scenes;
      // unreviewed effects may have reused dynamic slots after presentation.
      if (![0x08923af8, 0x08923b28, 0x08924b78, 0x08924ba8].includes(cur.Data)) return false;
      const read = m.R16(SK.OrigGame.Queue + 0xa), write = m.R16(SK.OrigGame.Queue + 8);
      if (read >= SK.OrigGame.QueueSize || write >= SK.OrigGame.QueueSize || read !== write) return false;
      // The consumed native queue entry is retained in the cartridge. With
