    }
    OrigLook(n, outfit = 255, set = 0) {
      return this.RecordLook(
        SK.OrigMem.PersonAddr(n),
        outfit,
        set,
        this.Family.Today,
      );
    }
    GeneLook(id, day, set = 0) {
      return this.GeneRecord(id) ? this.ReadOnlyRecordLook(SK.OrigMem.GeneAddr(id), 255, set, day) : null;
    }
    GeneRecord(id) {
      if (!Number.isInteger(id) || id < 0) return 0;
