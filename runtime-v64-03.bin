            f,
            nx - m[7] + f.ax,
            refY + m[1] - 2 + (ages.face === 0 ? 1 : 0) + f.ay,
          );
          const ex = l.extra >= 0 ? part("extra", l.extra, ages.feat) : null,
            keepMouth = !ex || !ex.ext.length || ex.ext[0] !== 0;
          put(part("hairfront", l.hair, ages.hair), nx, refY + m[1]);
          if (keepMouth)
            put(
              part("mouth", l.mouth, ages.feat),
              nx,
              refY + m[5],
              l.mouthFlip,
            );
          if (ex && ex.w)
            put(
              ex,
              nx - Math.trunc(ex.w / 2) + ex.ax,
              refY + (keepMouth ? m[6] : m[5]),
            );
          put(part("nose", l.nose, ages.feat), nx, refY + m[4], l.noseFlip);
          put(part("eyes", l.eyes, ages.feat), nx, refY + m[3], l.eyesFlip);
