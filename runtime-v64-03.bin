      this.Msgs = new Map();
      this.Types = [];
      this.Lives = [];
      this.Dreams = new Map();
      this.EraMsgs = [];
      this.EraBands = [];
      this.Tips = [];
      this.Help = new Map();
    }
    get Ok() {
      return this.Lists.length > 0 && this.Msgs.size > 0;
    }
    static FromJson(h) {
      const d = new HeavenData();
      if (!h) return d;
      d.Lists = h.lists || [];
      for (const [k, v] of Object.entries(h.states || {})) d.States.set(+k, v);
      for (const [k, v] of Object.entries(h.msgs || {}))
        d.Msgs.set(+k, hexBytes(v || ""));
      d.Types = h.types || [];
      d.Lives = h.lives || [];
      for (const [k, v] of Object.entries(h.dreams || {}))
        d.Dreams.set(+k, v || "");
      d.EraMsgs = h.eraMsgs || [];
      d.EraBands = h.eraBands || [];
      d.Tips = h.tips || [];
      for (const [k, v] of Object.entries(h.help || {}))
        d.Help.set(+k, hexBytes(v || ""));
      return d;
    }
  }
  class HeavenPage {
    constructor() {
      this.Speaker = 0;
      this.Text = this.Screen = "";
