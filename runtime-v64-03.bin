      if (saved.family.orig?.mem) s.RestoreSceneParticipants();
    }
    if (typeof ui.heavenSong === "number") s.heavenSong = ui.heavenSong;
    else if (s.heavenCur)
      s.heavenSong = s.millenniumQueued ? 4
        : s.lineageQueued || s.bookmarkQueued ? 5 : 2;
