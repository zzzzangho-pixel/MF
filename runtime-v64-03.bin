      } else st = 5;
      for (let guard = 0; st !== 0x49 && guard < 1000; guard++) {
        this.Trace.push(st);
        st = this.Step(st);
      }
      if (st !== 0x49) throw new OrigUnmodeled("천계 보고 상태가 끝나지 않음");
      m.W32(OrigHeaven.CenturyVar, m.R8(O + 0x94));
      this.Exit = m.R32(O + 0xa4) | 0;
      if (this.Exit === -1) this.vm.Call("0800F40C");
    }
    get F20() {
      return this.m.R32(OrigMem.Fam + 0x20);
    }
    set F20(v) {
      this.m.W32(OrigMem.Fam + 0x20, v);
    }
    get Gen() {
      return this.m.R8(OrigMem.Fam + 0x6a3);
