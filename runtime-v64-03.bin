          historyKeys: rows.map(row => row.key), memoKeys: rows.map(row => row.memoKey) });
        o.active = null;
      }
      const closed = !s.memo && !s.Paused && !s.HasPending && !s.BookmarkAskPending &&
        (s.EndMenu === 5 && s.LineageEnded || s.EndMenu === 4 && s.ContinueKind === 8 || s.Ended);
      if (closed && o.pending.length) {
