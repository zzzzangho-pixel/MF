    Members() {
      const m = this.m,
        O = OrigOffline.Obj;
      m.W8(O + 0x987c, 0);
      for (
        let k = 0;
        k < 8 && m.R16(OrigMem.PersonAddr(k) + 0x3c) !== 65535;
