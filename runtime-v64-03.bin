      return result;
    };
  }
  function captureMemoSnapshot(s) {
    if (!s.memo) return null;
    const banks = {}, memo = {}, game = {}, vm = s.Game.Vm;
    for (const bank of ["Ewram", "Iwram", "Frames", "Io"])
      banks[bank] = bytesToBase64(s.Game.Mem[bank]);
