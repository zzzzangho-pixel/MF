    }
    Run(k) {
      const m = this.m,
        O = OrigHeaven.Obj,
        F = OrigMem.Fam;
      for (let i = 0; i < 0xb4; i += 4) m.W32(O + i, 0);
      for (const off of [0x10, 0xc, 0xa4]) m.W32(O + off, 0xffffffff);
      m.W32(O + 0x1c, 1);
      m.W32(O + 0x20, 1);
      m.W32(O + 0x24, 255);
      m.W32(O + 0x68, k);
      m.W8(O + 0xa1, this.vm.Call("0800F474") & 255);
      m.W32(O + 0x74, O + 0x71);
      m.W16(O + 0x9c, (m.R8(F + 0x6a3) - 2) & 65535);
      m.W32(F + 0x668, m.R32(F + 0x668) & ~4);
