      pages: s.heavenCur ? s.heavenCur.length : s.pages.length,
      choices: (v.Choices || []).map((c, i) => ({
        id: c.Id ?? c.id ?? String(i),
        text: c.Text ?? c.Label ?? c.text ?? c.label ?? String(c),
        index: i,
      })),
      actors: [],
      scene: null,
      eventId: v.EventId,
      personId: v.PersonId,
      phase: v.Phase,
      origin: v.Origin,
      certainty: v.Certainty,
      textSource: v.TextSource,
    };
