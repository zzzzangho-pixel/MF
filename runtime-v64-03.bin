    // serialized banks again after rebuilding adapters, without executing Begin.
    if (ui.memoSnapshot) restoreMemoBanks(s, ui.memoSnapshot);
    const game = new WebGame(s);
    if (ui.offline?.version === 1) game._offline = clone(ui.offline);
    game.log = ui.log || [];
    return game;
  };
})(globalThis);

</script>
<script>
/* Configurable local prototype defaults, NOT original-cartridge balance. */
(function (root) {
  'use strict';
  const SK = root.SK = root.SK || {};
  SK.PET_CONFIG = {
    prototype: true, version: 1, capacity: 2, adultAge: 18,
    nativeUnitKrw: 100000, reserveMonths: 3, incomeMultiplier: 3,
    adoptionMood: 4, adoptionCharm: 8,
