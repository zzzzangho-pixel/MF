    }
    static ReadRecords(vmOrRules, cartridge) {
      let vm = vmOrRules;
      if (cartridge !== undefined) {
        if (!cartridge) return [];
        const m = new SK.OrigMem();
        m.LoadSaveBlock(cartridge);
        vm = vmOrRules.CreateVm(m);
      }
      const m = vm.Mem,
        r = [];
      for (let k = 0; k < 3; k++) {
        const a = OrigSession.RecordTable + 32 * k;
        if (!m.R16(a + 4)) break;
        const start = origDate(m, a + 0x14),
          end = origDate(m, a + 0x17),
          e = {
            Rank: k + 1,
            Members: m.R16(a + 4),
            Type: m.R8(a + 0x1a),
            StartY: start.year,
            StartM: start.month,
            StartD: start.day,
            EndY: end.year,
