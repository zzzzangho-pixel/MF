    static HalfHearts(raw) {
      return raw === 0
        ? 0
        : raw <= 47
          ? 1
          : raw <= 95
            ? 2
            : raw <= 143
              ? 3
              : raw <= 191
                ? 4
                : raw <= 239
                  ? 5
                  : 6;
    }
    Generation(id) {
