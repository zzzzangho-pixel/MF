      if (!((father || mother) && child) && !(father && mother))
        e.push("처음 가족은 부모와 자녀가 함께 있거나, 아버지와 어머니가 모두 있어야 합니다.");
      if (e.length) throw new Error(e.join("; "));
      s = OrigSession.NewCustom(rules, text, setup, seed);
    } else
      s = OrigSession.NewRecommended(
        rules,
        text,
        options.familyName || "",
        seed,
        options.year || 2005,
        options.month || 1,
        options.day || 1,
      );
