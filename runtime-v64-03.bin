        if (m.R8(O + 0x994b) === 0 || m.R8(O + 0x5662) === 1)
          vm.Call("080D7534", O);
        if (m.R16(0x02029ba6) === 0) vm.Call("080D72F0", O);
        m.W8(idx, 0);
        let guard = 0;
        while (m.R8(idx) < m.R8(O + 0x987c)) {
          if (++guard > 100000)
            throw new OrigUnmodeled("오프라인 인물 반복이 너무 많음");
          const k = m.R8(idx),
            rec = OrigMem.PersonAddr(k);
          if (m.R16(rec + 0x3c) === 65535) {
            m.W8(idx, k + 1);
            continue;
          }
          const r = vm.Call("08027E78", rec, O + 0x9880 + 24 * k);
          m.W32(F + 0x14, r);
          if (!r) {
