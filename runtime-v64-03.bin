    ReadOnlyRecordLook(address, outfit, set, today, overrides = null) {
      const source = this.Game.Mem,
        raw = Array.from({ length: 16 }, (_, i) => source.R8(address + i)),
        key = [nameKey(raw), source.R8(address + 0x2e), source.R8(address + 0x2f),
          source.R8(address + 0x30), source.R8(address + 0x31), outfit, set, today,
          overrides?.age, overrides?.gender].join(":");
