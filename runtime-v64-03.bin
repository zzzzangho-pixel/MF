<script>
/* Supplied original PNG borders/tails, extended only through their middle. */
(function (global) {
  "use strict";
  const SK = global.SK = global.SK || {};
  class PixelBubbles {
    constructor(art) {
      this.art = art;
      this.ready = Promise.all(["god", "cupid", "tip", "event"].map(async (kind) => {
        const image = this.image(kind);
        if (image?.decode) await image.decode();
      }));
    }
    image(kind) { return this.art.image("bubble_" + kind); }
    draw(canvas, kind, width = 236, height = 54, tailX = null) {
      if (!canvas) return false;
      const im = this.image(kind);
      if (!im?.complete || !im.naturalWidth) return false;
      const [left, top, right, bottom] = kind === "tip" ? [14, 6, 8, 10] : [72, 16, 10, 8];
      width = Math.max(left + right, Math.round(width));
      height = Math.max(top + bottom, Math.round(height));
      if (canvas.width !== width) canvas.width = width;
      if (canvas.height !== height) canvas.height = height;
      const ctx = canvas.getContext("2d"), sw = im.naturalWidth, sh = im.naturalHeight;
      ctx.clearRect(0, 0, width, height);
      ctx.imageSmoothingEnabled = false;
      const sx = [0, left, sw - right], sy = [0, top, sh - bottom],
        dx = [0, left, width - right], dy = [0, top, height - bottom],
        ws = [left, sw - left - right, right], hs = [top, sh - top - bottom, bottom],
        wd = [left, width - left - right, right], hd = [top, height - top - bottom, bottom];
      for (let y = 0; y < 3; y++) for (let x = 0; x < 3; x++)
        if (ws[x] > 0 && hs[y] > 0 && wd[x] > 0 && hd[y] > 0)
          ctx.drawImage(im, sx[x], sy[y], ws[x], hs[y], dx[x], dy[y], wd[x], hd[y]);
      if (kind === "cupid" && Number.isFinite(tailX)) {
        // The supplied tail is the original 15x15 patch at(31,0), with its
        // tip atx32. Restore ONLY that patch from a flat source edge, then
        // relocate the unchanged pixels. Never mirror/stretch the border,
        // text, or complete bubble to point toward a differently placed Cupid.
        const tip = Math.max(17, Math.min(width - 25, Math.round(tailX)));
        if (tip !== 32) {
          ctx.clearRect(31, 0, 15, 15);
          ctx.drawImage(im, 60, 0, 1, 15, 31, 0, 15, 15);
          ctx.drawImage(im, 31, 0, 15, 15, tip - 1, 0, 15, 15);
        }
        canvas.dataset.tailX = String(tip);
      } else if (canvas.dataset) delete canvas.dataset.tailX;
      return true;
    }
  }
  SK.PixelBubbles = PixelBubbles;
})(globalThis);

</script>
<script>
/* Supplied GameApp.cs introduction, kept separate from rule/save progression.
 * IntroFlow owns only dialogue/branching. The app creates its existing family
 * on a create-family action, calls familyReady(state), and enters the house on
 * finish. IntroScene predecodes the supplied SKF1 heaven reel before playback.
 * No story text, family rules, or persistent game state is invented here. */
(function (root) {
  "use strict";
  const SK = (root.SK = root.SK || {});
  const CUPID_LINES = new Set([
    565, 567, 569, 572, 577, 56, 263, 264, 265, 266, 267, 268, 269, 270, 271, 272, 563,
    292, 294, 669, 298,
  ]);
  const OPENING = [564, 565, 566, 567, 568, 569, 570];
  const NAME_LIMIT = 6;
  const cleanName = (value) => String(value == null ? "" : value).trim();
  const mod = (n, m) => ((n % m) + m) % m;

  function resource(read, paths) {
    let error;
    for (const path of paths) {
      if (SK.resourceExists && !SK.resourceExists(path)) continue;
      try {
        return read(path);
      } catch (e) {
        error = e;
      }
    }
    throw error || new Error("도입부 자료를 찾을 수 없습니다: " + paths[0]);
  }

  function loadText(options) {
    if (options.text) return options.text;
    if (!SK.OrigText) throw new Error("원작 글 해독기가 준비되지 않았습니다.");
    const json = options.textJson || resource(SK.resourceJson, [
      options.textPath || "LocalOrig/orig_text", "LocalOrig/orig_text.json",
    ]);
    return SK.OrigText.FromJson(json);
  }

  class IntroFrameReel {
    constructor(bytes) {
      this.bytes = bytes;
      this.frames = [];
      this.fps = 0;
      this.ticks = 0;
    }
    static parse(value) {
      if (!(value instanceof Uint8Array)) {
        if (value instanceof ArrayBuffer) value = new Uint8Array(value);
        else if (ArrayBuffer.isView(value))
          value = new Uint8Array(value.buffer, value.byteOffset, value.byteLength);
        else throw new Error("도입부 프레임 자료가 올바르지 않습니다.");
      }
      if (value.length < 8 || String.fromCharCode(...value.subarray(0, 4)) !== "SKF1")
        throw new Error("도입부 프레임 형식이 올바르지 않습니다.");
      const view = new DataView(value.buffer, value.byteOffset, value.byteLength);
      const count = view.getUint16(4, true), reel = new IntroFrameReel(value);
      reel.fps = view.getUint16(6, true);
      if (!count || !reel.fps) throw new Error("빈 도입부 프레임 자료입니다.");
      let offset = 8;
      for (let i = 0; i < count; i++) {
        if (offset + 6 > value.length) throw new Error("도입부 프레임 머리글이 잘렸습니다.");
        const repeat = view.getUint16(offset, true), length = view.getUint32(offset + 2, true);
        offset += 6;
        if (!repeat || !length || offset + length > value.length)
          throw new Error("도입부 프레임 내용이 잘렸습니다.");
        const png = value.subarray(offset, offset + length);
        if (png.length < 24 || ![137, 80, 78, 71, 13, 10, 26, 10].every((v, k) => png[k] === v))
          throw new Error("도입부 그림이 PNG 형식이 아닙니다.");
        reel.frames.push({ offset, length, start: reel.ticks, repeat });
        reel.ticks += repeat;
        offset += length;
      }
      if (offset !== value.length) throw new Error("도입부 프레임 뒤에 알 수 없는 자료가 있습니다.");
      return reel;
    }
    get count() { return this.frames.length; }
    get seconds() { return this.ticks / this.fps; }
    png(index) {
      const frame = this.frames[index];
      if (!frame) throw new RangeError("도입부 프레임 번호가 올바르지 않습니다.");
      return this.bytes.subarray(frame.offset, frame.offset + frame.length);
    }
    frameAt(seconds) {
      let tick = Math.max(0, Math.floor(Number(seconds || 0) * this.fps));
      if (tick >= this.ticks) return -1;
      let lo = 0, hi = this.count - 1;
      while (lo < hi) {
        const mid = (lo + hi + 1) >> 1;
        if (this.frames[mid].start <= tick) lo = mid;
        else hi = mid - 1;
      }
      return lo;
    }
    loopAt(seconds) { return this.frameAt(mod(Number(seconds || 0), this.seconds)); }
  }

  async function decodePng(bytes) {
    const blob = new Blob([bytes], { type: "image/png" });
    if (typeof root.createImageBitmap === "function") return root.createImageBitmap(blob);
    if (typeof root.Image !== "function") throw new Error("도입부 그림 해독기를 사용할 수 없습니다.");
    const image = new root.Image(), uri = URL.createObjectURL(blob);
    try {
      if (typeof image.decode === "function") {
        image.src = uri;
        await image.decode();
      } else await new Promise((resolve, reject) => {
        image.onload = () => resolve(image);
        image.onerror = () => reject(new Error("도입부 그림을 불러오지 못했습니다."));
        image.src = uri;
      });
      return image;
    } finally {
      URL.revokeObjectURL(uri);
    }
  }

  class IntroScene {
    constructor(reel, images, options = {}) {
      this.reel = reel;
      this.images = images;
      this.art = options.art || null;
      this.text = options.text || null;
      this.cupid = options.cupid || null;
      this.anger = options.anger || null;
      this.startedAt = null;
      this.disposed = false;
    }
    static async load(options = {}) {
      if (SK.ready) await SK.ready;
      const bytes = options.bytes || resource(SK.resourceBytes, [
        options.reelPath || "LocalArt/heaven_frames.bin", "LocalArt/heaven_frames.bin.bytes",
      ]);
      const reel = IntroFrameReel.parse(bytes), decode = options.decodeImage || decodePng;
      const images = [];
      // Fully decoded before first scene: changing dialogue cannot expose a
      // cleared canvas while a new PNG is still being decoded.
      try {
        for (let i = 0; i < reel.count; i++) images.push(await decode(reel.png(i), i));
        const cupid = options.art && options.art.cupid ? options.art.cupid(0) : null;
        if (cupid && typeof cupid.decode === "function") await cupid.decode();
        let anger = null;
        const angerPaths = ["LocalArt/god_anger_frames.bin", "LocalArt/god_anger_bg2.png", "LocalArt/god_anger_bg3.png"];
        if (options.anger !== false && SK.resourceExists && angerPaths.every((path) => SK.resourceExists(path))) {
          const angerReel = IntroFrameReel.parse(SK.resourceBytes(angerPaths[0])), angerImages = [];
          for (let i = 0; i < angerReel.count; i++) angerImages.push(await decode(angerReel.png(i), i));
          anger = { reel: angerReel, images: angerImages,
            bg2: await decode(SK.resourceBytes(angerPaths[1])),
            bg3: await decode(SK.resourceBytes(angerPaths[2])) };
        }
        return new IntroScene(reel, images, { ...options, cupid, anger, text: loadText(options) });
      } catch (error) {
        images.forEach((image) => { if (image && image.close) image.close(); });
        throw error;
      }
    }
    reset(timeMs = null) { this.startedAt = timeMs; }
    draw(canvas, timeMs = 0, state = {}) {
      if (this.disposed) return -1;
      const ctx = canvas && canvas.getContext && canvas.getContext("2d");
      if (!ctx) return -1;
      if (this.startedAt === null) this.startedAt = timeMs;
      const song = typeof state === "number" ? state : state.song || 1;
      const width = canvas.width || 240, height = canvas.height || 160;
      canvas.skCupidAnchor = null;
      ctx.imageSmoothingEnabled = false;
      ctx.fillStyle = song === 1 ? "#000000" : "#d8f0a8";
      ctx.fillRect(0, 0, width, height);
      if (song === 1) {
        if (typeof state === "object" && state.anger && this.anger) {
          const elapsed = Math.max(0, timeMs - Number(state.angerStartedAt ?? this.startedAt)) / 1000,
            index = this.anger.reel.frameAt(elapsed), frame = index < 0 ? this.anger.reel.count - 1 : index,
            scale = Math.min(width / 240, height / 160), x = (width - 240 * scale) / 2, y = (height - 160 * scale) / 2;
          // Supplied BG layers are256x256 VRAM surfaces. Crop the original
          // top-left240x160 viewport; never stretch them or add a second god.
          for (const image of [this.anger.bg3, this.anger.bg2, this.anger.images[frame]])
            if (image) ctx.drawImage(image, 0, 0, 240, 160, x, y, 240 * scale, 160 * scale);
          return frame;
        }
        const frame = this.reel.loopAt(Math.max(0, timeMs - this.startedAt) / 1000);
        const image = this.images[frame];
        if (image) {
          const scale = Math.min(width / 240, height / 160);
          const x = (width - 240 * scale) / 2, y = (height - 160 * scale) / 2;
          ctx.drawImage(image, x, y, 240 * scale, 160 * scale);
          // All72 supplied native heaven frames keep Cupid horizontally
          // centered atx39 (sprite edges26..52, later28..50/30..48).
          canvas.skCupidAnchor = { speaker: "큐피트", x: x + 39 * scale,
            y: y + 75 * scale, width, height };
        }
        return frame;
      }
      if (this.cupid) {
        // Supplied Unity family-introduction scene: plain pale-green field
        // with the existing original Cupid, not an invented heaven background.
        const size = Math.min(width * 0.4, height * 0.6);
        ctx.drawImage(this.cupid, (width - size) / 2, (height - size) / 2, size, size);
        canvas.skCupidAnchor = { speaker: "큐피트", x: width / 2,
          y: height / 2, width, height };
      }
      return -1;
    }
    dispose() {
      this.images.forEach((image) => { if (image && image.close) image.close(); });
      if (this.anger) [...this.anger.images, this.anger.bg2, this.anger.bg3]
        .forEach((image) => { if (image && image.close) image.close(); });
      this.images = [];
      this.anger = null;
      this.disposed = true;
    }
  }

  class IntroFlow {
    constructor(options = {}) {
      this.text = loadText(options);
      this.onAction = typeof options.onAction === "function" ? options.onAction : null;
      this.savedPlayerName = cleanName(options.savedPlayerName);
      this.playerName = cleanName(options.playerName) || this.savedPlayerName;
