      } else if (!(f & 2) && arrow & 1) {
        this.PushHelp(m, 2);
        f |= 2;
      }
      for (const [bit, threshold, id] of [
        [4, 1, 3],
        [8, 2, 4],
        [16, 3, 5],
        [32, 4, 6],
      ])
        if (!(f & bit) && rank0 <= threshold && rank > threshold) {
          this.PushHelp(m, id);
