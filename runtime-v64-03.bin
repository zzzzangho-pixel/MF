      "Body",
      "Face",
      "Hair",
      "Eyes",
      "Nose",
      "Mouth",
      "EyesFlip",
      "NoseFlip",
      "MouthFlip",
      "HairColor",
      "SkinColor",
      "Outfit",
      "OutfitColor",
      "Preset",
      "Gender",
      "Extra",
      "OutfitBody",
    ])
      r[k[0].toLowerCase() + k.slice(1)] = l[k];
