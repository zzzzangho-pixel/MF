        const canvas = document.createElement("canvas");
        canvas.width = 37;
        canvas.height = 43;
        const ctx = canvas.getContext("2d"), pixels = ctx.createImageData(37, 43),
          glyph = depressionPixels[depression[1] === undefined ? 2 : Number(depression[1])];
        for (let i = 0; i < glyph.length; i++) {
          const index = Number(glyph[i]);
          if (!index) continue;
          const color = depressionPalette[index], r = color & 31,
