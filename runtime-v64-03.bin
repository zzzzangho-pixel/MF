      for (const m of this.Members) {
        if (m.Role === 4) children++;
        else if (seen.has(m.Role)) e.push(m.Role + " 칸이 둘 이상입니다");
        else seen.add(m.Role);
        if (!m.Name) e.push("이름이 비어 있는 구성원이 있습니다");
        if (m.BirthDay > this.StartDay)
