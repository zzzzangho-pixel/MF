      if (!cache) presentationLooks.set(this, (cache = new Map()));
      if (cache.has(key)) return lookClone(cache.get(key));
      const memory = new SK.OrigMem(); memory.ShareRom(source);
      for (const bank of ["Ewram", "Iwram", "Frames", "Io"]) memory[bank].set(source[bank]);
      const vm = presentationVm(this.Game.Vm, memory),
        calls = SK.OrigVm.TotalCalls, undefs = SK.OrigVm.UndefThrows;
