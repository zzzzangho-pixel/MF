    Step() {
      const m = this.m,
        vm = this.vm,
        O = OrigOffline.Obj,
        F = OrigOffline.Scratch,
        idx = F + 0x23,
        buf = F + 8,
        Fam = OrigMem.Fam;
      m.W8(F + 0x27, 0);
      m.W8(F + 0x28, 0);
      let outer = 0;
      for (;;) {
        if (++outer > 400000)
          throw new OrigUnmodeled("오프라인 진행 반복이 너무 많음");
        m.W32(0x0203c268, m.R32(O + 0x5660));
        m.W8(F + 0x22, vm.Call("08096010", m.R16(O + 0x5660)) & 255);
