    }
    ToJson() {
      return {
        id: this.Id,
        name: this.Name,
        gender: this.Gender,
        birth: this.BirthDay,
        stats: Array.from(this.Stats),
        hearts: this.Hearts,
        immersion: this.Immersion,
        job: this.Job,
        mastery: this.JobMastery,
        skills: Array.from(this.Skills),
        spouse: this.SpouseId,
        father: this.FatherId,
        mother: this.MotherId,
        planned: this.PlannedStateId,
        plannedDue: this.PlannedDue,
        alive: this.Alive,
        flags: Array.from(this.Flags),
        dream: this.Dream,
        arrow: this.ArrowId,
        arrowUntil: this.ArrowUntil,
        character: this.Character,
        plannedTitle: this.PlannedTitle,
        look: this.Look ? this.Look.ToJson() : null,
        blood: this.Blood,
        personality: this.Personality,
        gauge: this.Gauge,
        interestDay: this.InterestDay,
        arrowFlags: this.ArrowFlags,
        pcode: this.PersonalityCode,
      };
    }
    static FromJson(d) {
      const map = {
        id: "Id",
        name: "Name",
        gender: "Gender",
        birth: "BirthDay",
        stats: "Stats",
        hearts: "Hearts",
        immersion: "Immersion",
        job: "Job",
        mastery: "JobMastery",
        skills: "Skills",
        spouse: "SpouseId",
        father: "FatherId",
        mother: "MotherId",
        planned: "PlannedStateId",
        plannedDue: "PlannedDue",
        alive: "Alive",
        flags: "Flags",
        dream: "Dream",
        arrow: "ArrowId",
        arrowUntil: "ArrowUntil",
        character: "Character",
        plannedTitle: "PlannedTitle",
