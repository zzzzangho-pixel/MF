        ).filter((sk) => sk !== 255);
        p.InterestDay = m.R16(a + 0x48);
        p.ArrowFlags = m.R8(a + 0x69);
        p.Gratitude = m.R8(a + 0x65) | (m.R8(a + 0x66) << 8);
        p.HitArrow = m.R8(a + 0x60) === 255 ? -1 : m.R8(a + 0x60);
        p.PersonalityCode = m.R8(a + 0x32) & 15;
        const t = m.R16(a + 0x80),
          i = m.R16(a + 0x82);
