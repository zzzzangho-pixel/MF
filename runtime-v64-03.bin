      throw new Error("원작 가족 메모리가 없는 저장입니다");
    return new Family({
      Name: d.name || "",
      Today: int(d.today),
      Mood: int(d.mood, 128),
      Assets: int(d.assets),
      HouseGrade: int(d.house),
      NextPersonId: int(d.nextPersonId, 1),
      StartDay: int(d.startDay, int(d.today)),
      Gratitude: int(d.gratitude),
      HeadId: int(d.head, -1),
      Members: (d.members || []).map(Person.FromJson),
      Flags: d.flags || [],
      History: (d.history || []).map((h) => ({
        Day: h.day ?? h.Day,
        EventId: h.id ?? h.EventId,
        EventVersion: h.ver ?? h.EventVersion ?? 0,
        Title: h.title ?? h.Title ?? "",
        PersonId: h.person ?? h.PersonId ?? -1,
        Choice: h.choice ?? h.Choice ?? "",
        Changes: h.changes ?? h.Changes ?? "",
