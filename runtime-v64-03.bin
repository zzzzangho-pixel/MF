            else if (t === 4) m.W8(O + 0x994f, 1);
          }
        }
        guard = 0;
        for (;;) {
          if (++guard > 100000)
            throw new OrigUnmodeled("오프라인 사건 반복이 너무 많음");
          const q = vm.Call("08027D0C", O + 0x5660);
          m.W32(F + 0x18, q);
          const n = vm.Call("08027BE4", q, buf) & 255;
          m.W8(F + 0x25, n);
          if (!n) break;
          vm.Call("080D75EC", O, buf);
        }
        m.W32(O + 0x9940, m.R32(O + 0x9940) + 1);
        vm.Call("08095DAC", O + 0x5660, O + 0x5660, 1);
        vm.Call("0800E3C8", O + 0x5660, OrigMem.Date);
        m.W16(Fam + 0x672, 0x708);
        m.W8(O + 0x994e, vm.Call("080D7710", O));
        if (m.R32(O + 0x9940) >= m.R32(O + 0x9944) || m.R8(O + 0x994c) === 1) {
          vm.Call("080D7534", O);
          return 1;
        }
        if (m.R8(O + 0x994d) === 1) {
