      vm: { Calls: vm.Calls, heapNext: vm.heapNext, Messages: clone(vm.Messages) } } };
  }
  function restoreMemoBanks(s, snapshot) {
    if (!snapshot || snapshot.version !== 1)
      throw new Error("사건 메모 저장 버전이 올바르지 않습니다");
    // Validate every bank before applying any of the extension.
    const banks = {};
    for (const bank of ["Ewram", "Iwram", "Frames", "Io"]) {
      banks[bank] = base64ToBytes(snapshot.banks?.[bank]);
      if (banks[bank].length !== s.Game.Mem[bank].length)
