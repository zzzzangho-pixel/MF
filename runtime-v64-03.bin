    care: {dog: {action: 'walk', stats: [{index: 1, delta: 4}, {index: 2, delta: 2}]},
           cat: {action: 'play', stats: [{index: 0, delta: 4}, {index: 2, delta: 2}]}},
    lifespanMinYears: 21, lifespanMaxYears: 25, oldAgeFloorYears: 20,
    illnessChance: 1 / 1460, illnessOnsetHealthLoss: 20,
    illnessDailyHealthLoss: 1, illnessCaregiverStamina: -4,
    departureCaregiverStamina: -8, departureMood: -12,
    historyCap: 200,
    species: {cat: {monthlyCost: 1, adoptionFee: 3, treatmentCost: 3},
              dog: {monthlyCost: 2, adoptionFee: 5, treatmentCost: 4}},
    templates: {
      cat: {species: 'cat', palettes: ['original', 'gray-tabby', 'tuxedo', 'calico', 'white', 'black']},
      'dog-original': {species: 'dog', palettes: ['original', 'black', 'white']},
      'dog-corgi': {species: 'dog', palettes: ['original', 'black', 'white']},
      'dog-poodle': {species: 'dog', palettes: ['original', 'black', 'white']},
      'dog-shiba': {species: 'dog', palettes: ['original', 'black', 'white']}
