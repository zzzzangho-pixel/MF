        if (v !== 255) {
          m.W8(this.HelpQueue + i - 1, 255);
          return v;
        }
      }
      return -1;
    },
    Run(vm, rules, n, max) {
      const m = vm.Mem;
      OrigFamily.BuildSlots(m, m.R16(OrigMem.PersonAddr(n) + 0x3c));
      const ev = this.EventOf(m, n, max),
        e = rules.Events.get(ev),
        data = e.Data[this.PickVariant(vm, rules, ev)];
      this.RunEffect(vm, rules, data);
      return data;
    },
  };
