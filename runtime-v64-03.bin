        if (id === 65535) return null;
        if (fmt === 0x1f)
          return (
            d.Dreams.get(m.R16(OrigMem.GeneAddr(id) + 0x1e) & 0x7fff) || null
          );
        return this.personName(id);
      }
      return null;
    }
    Number(a, b) {
      return a === 4
        ? String(this.Gen)
        : a === 2 && b === 9 && this.Years >= 0
          ? String(this.Years)
          : null;
    }
  }
  Object.assign(OrigHeaven, {
    Data: HeavenData,
    Page: HeavenPage,
    Fam: OrigMem.Fam,
    Obj: 0x0f03b600,
    Out: 0x0f03b700,
    EntryVar: 0x0203bdfc,
    CenturyVar: 0x0203be00,
    MessageStates: new Set([
      1, 3, 6, 7, 8, 0xa, 0xc, 0xe, 0x10, 0x14, 0x16, 0x1e, 0x20, 0x24, 0x26,
      0x29, 0x2c, 0x2e, 0x31, 0x34, 0x36, 0x37, 0x3a, 0x3c, 0x3f, 0x42, 0x44,
      0x46, 0x47,
    ]),
  });
  class MemoArgs {
    constructor() {
      this.Person = 65535;
      this.NumBuf =
        this.DateArg =
        this.TitleStruct =
        this.Relation =
        this.Record =
        this.Id =
          0;
      this.Numbers = this.Pages = null;
    }
  }
  MemoArgs.None = new MemoArgs();
  class MemoEntry {
    static NativeMetadata(code) {
      if (!Number.isInteger(code) || code < 0 || code > 0xffffffff) return null;
      // Native 080D75EC stores a THREE-byte packed date at+14..16 and the
      // actual participant-selection return byte at+17. It is not a32-bit date.
      const packed = code & 0xffffff, year = packed >>> 9,
        month = (packed >>> 5) & 15, day = packed & 31;
      if (year < 1 || year > 9999 || month < 1 || month > 12 || day < 1) return null;
      const dt = new Date(0); dt.setUTCFullYear(year, month, 0);
      if (day > dt.getUTCDate()) return null;
      return { Date: SK.GameDate.Make(year, month, day), NativeDateCode: code,
        NativePackedDate: packed, NativeParticipantSelection: code >>> 24 };
    }
    static ParticipantSources(value) {
      if (!Number.isInteger(value) || value < 0 || value > 255) return [];
      const low = value & 15;
      if (!low || (low & (low - 1))) return [];
      const index = Math.log2(low);
      return [[23, index < 3 ? 22 - index : -1], [24, 10 - index],
        [25, 14 - index], [26, 10 - index]];
    }
    constructor() {
      this.Date = this.PersonId = this.Record = 0;
      this.Title = "";
    }
  }
  class OrigMemoFlow {
    constructor(vm, text, personName, player, ageOf, days) {
      this.vm = vm;
      this.m = vm.Mem;
      this.text = text;
      this.personName = personName;
      this.player = player;
      this.ageOf = ageOf;
      this.phase = "Greeting";
      this.pages = [];
      this.page = 0;
      this.answerMsg = 0;
      this.lastReport = -1;
      this.memoPage = 0;
      this.FamilyView = null;
      this.familyShown = false;
      this.ReplayRequest = null;
      this.ReportIdsForTest = [];
      this.WantsHeaven = this.LineageEnded = this.Millennium = false;
      this.Off = OrigOffline.Begin(vm, days);
      this.Greeting();
    }
    get Done() {
      return this.phase === "Done";
    }
    View() {
      const phase = this.phase;
      if (phase === "Done") return null;
      const v = {
        EventId: phase === "Progress" ? "memo-progress" : "memo",
        Title: "사건 메모",
        Speaker: phase === "Progress" ? "" : "큐피트",
        Phase: phase === "Question" ? "choices" : "pages",
        Origin: "original",
        Certainty: "rom",
        TextSource: "original-translation",
        PersonId: -1,
        Text: "",
        Choices: [],
      };
      if (phase === "Progress") {
        v.Text = this.ProgressText();
        v.TextSource = "app-summary";
        return v;
      }
      if (phase === "Memo" && this.familyShown && this.FamilyView) {
        v.Text = this.FamilyView();
        v.Phase = "choices";
        v.TextSource = "original-data";
        v.Speaker = "";
        v.Title = "가족 보기";
        v.Choices.push({ Id: "back", Text: "뒤로 (B)" });
        return v;
      }
      if (phase === "Memo") {
        const es = this.Entries(),
          pagesN = Math.max(1, Math.ceil(es.length / 3));
        this.memoPage = Math.min(this.memoPage, pagesN - 1);
        let s = "사건 메모 " + (this.memoPage + 1) + "/" + pagesN;
        for (
          let i = this.memoPage * 3;
          i < Math.min(es.length, (this.memoPage + 1) * 3);
          i++
        ) {
          const e = es[i];
          s += "\n" + (i - this.memoPage * 3 + 1) + ". ";
          if (e.Date >= 0)
            s +=
              SK.GameDate.Year(e.Date) +
              "." +
              SK.GameDate.Month(e.Date) +
              "." +
              SK.GameDate.Day(e.Date) +
              " ";
          s += this.personName(e.PersonId) + " 『" + (e.Title || "?") + "』";
          v.Choices.push({
            Id: "view:" + i,
            Text: i - this.memoPage * 3 + 1 + " 보기",
          });
        }
        if (!es.length) s += "\n(메모 없음)";
        if (pagesN > 1)
          v.Choices.push(
            { Id: "prev", Text: "◀ 앞" },
            { Id: "next", Text: "다음 ▶" },
          );
        if (this.FamilyView)
          v.Choices.push({ Id: "family", Text: "가족 보기 (START)" });
        v.Choices.push({ Id: "close", Text: "닫기 (B)" });
        v.Text = s;
        v.Phase = "choices";
        v.TextSource = "original-data";
        v.Speaker = "";
        return v;
      }
      v.Text = this.pages.length
        ? this.pages[Math.min(this.page, this.pages.length - 1)]
        : "";
      if (phase === "Question" && this.page >= this.pages.length - 1)
        v.Choices.push({ Id: "yes", Text: "응" }, { Id: "no", Text: "아니" });
      else if (phase === "Question") v.Phase = "pages";
      return v;
    }
    Advance() {
      if (this.phase === "Progress") {
        if (this.Off.Step() === 1) this.StartReport();
        return false;
      }
      if (this.phase === "Question") {
        if (this.page < this.pages.length - 1) this.page++;
        return false;
      }
      if (this.page < this.pages.length - 1) {
        this.page++;
        return false;
      }
      switch (this.phase) {
        case "Greeting":
          if (this.Off.Days === 0) {
            this.StartReport();
            return false;
          }
          this.phase = "Progress";
          return false;
        case "Report":
          if (this.lastReport === 75) {
            this.phase = "Done";
            return true;
          }
          this.Question();
          return false;
        case "MemoIntro":
          this.phase = "Memo";
          this.memoPage = 0;
          return false;
        case "Answer":
          if (this.answerMsg === 83) {
            this.WantsHeaven = true;
            this.phase = "Heaven";
            return false;
          }
          if (this.answerMsg === 95) this.LineageEnded = true;
          if (this.answerMsg === 98) this.Millennium = true;
          this.phase = "Done";
          return true;
      }
      return false;
    }
    Choose(id) {
      if (this.phase === "Memo") {
        if (this.familyShown) {
          if (id === "back") this.familyShown = false;
          return;
        }
        const es = this.Entries(),
          pagesN = Math.max(1, Math.ceil(es.length / 3));
        if (id === "family") this.familyShown = !!this.FamilyView;
        else if (id === "prev")
          this.memoPage = (this.memoPage + pagesN - 1) % pagesN;
        else if (id === "next") this.memoPage = (this.memoPage + 1) % pagesN;
        else if (id === "close") this.Question();
        else if (id.startsWith("view:")) {
          const k = Number(id.slice(5));
          if (Number.isInteger(k) && k >= 0 && k < es.length)
            this.ReplayRequest = es[k];
        }
        return;
      }
      if (this.phase !== "Question") return;
      const m = this.m,
        O = OrigOffline.Obj;
      if (id === "yes") {
        this.answerMsg =
          m.R8(O + 0x994d) === 1
            ? 95
            : m.R8(O + 0x994e) === 1
              ? 98
              : m.R8(O + 0x994c) === 1
                ? 83
                : m.R8(O + 0x994f) === 1
                  ? 103
                  : 84;
        this.SetPages("Answer", this.Msg(this.answerMsg, MemoArgs.None));
      } else {
        const no = m.R8(O + 0x994d) === 1 || m.R8(O + 0x994e) === 1 ? 99 : 85;
        this.SetPages("MemoIntro", this.Msg(no, MemoArgs.None));
      }
    }
    Finish() {
      this.WantsHeaven = false;
      this.phase = "Done";
    }
    Continue() {
      this.WantsHeaven = false;
      this.Off = OrigOffline.BeginNext(this.vm);
      if (this.Off.Days === 0) {
        this.phase = "Done";
        return;
      }
      this.phase = "Progress";
      this.pages = [];
      this.page = 0;
    }
    SetPages(p, l) {
      this.phase = p;
      this.pages = l.slice();
      this.page = 0;
    }
    Greeting() {
      const m = this.m,
        O = OrigOffline.Obj,
        t = OrigMemoFlow.Scratch;
      this.vm.Call("080D448C", t, t + 2, O + 0x5658, O + 0x565c);
      const years = m.R16(t),
        days = m.R16(t + 2);
      let id, num;
      if (this.vm.Call("080D8190", O) & 255) {
        id = 62;
        num = 0;
      } else if (years > 999) {
        id = 63;
        num = years;
      } else if (years) {
        id = 60;
        num = years;
      } else {
        id = 61;
        num = days;
      }
      const a = new MemoArgs();
      a.Numbers = [0, 0, num];
      this.SetPages("Greeting", this.Msg(id, a));
    }
    StartReport() {
      const l = [];
      this.lastReport = -1;
      this.ReportIdsForTest = [];
      for (const a of this.ReportMessages()) {
        l.push(...a.Pages);
        this.lastReport = a.Id;
        this.ReportIdsForTest.push(a.Id);
      }
      this.SetPages("Report", l);
    }
    ReportMessages() {
      const m = this.m,
        vm = this.vm,
        R = OrigMemoFlow.Rep,
        O = OrigOffline.Obj,
        F = OrigMem.Fam;
      for (let a = R; a < R + 0xa0; a++) m.W8(a, 0);
      m.W32(R, O);
      m.W32(R + 0xc, 3);
      m.W32(R + 0x1c, 255);
      let first;
      if (vm.Call("080D8190", O) & 255) first = m.R8(O + 0x994f) ? 100 : 101;
      else if (m.R8(0x02029ba0) === 1) first = 64;
      else first = m.R8(O + 0x994c) === 1 ? 65 : 66;
      m.W32(R + 0x48, first);
      vm.Call("0800E3C8", O + 0x5658, R + 0x4d);
      const gen = m.R8(F + 0x6a3),
        head = m.R16(u(F + 0x2538 + 28 * u(gen - 2)));
      vm.Call("slots", head, 0);
      const a0 = Object.assign(new MemoArgs(), {
        Id: first,
        Person: head,
        NumBuf: R + 0x1c,
        DateArg: R + 0x4d,
      });
      a0.Pages = this.Msg(first, a0);
      const list = [a0];
      for (let k = 0; k < 64; k++) {
        vm.Messages = [];
        const idx = m.R8(R + 0x4c);
        // The supplied report adapter can reach state73 from state66 with
        // an empty important slot after BeginNext. Reuse the cartridge's
        // empty-slot branch (080D604E / 080D60EC -> state76) before its
        // title dereference; nonempty slots and all day rules are unchanged.
        if (m.R32(R + 0x48) === 73 && idx < 20 &&
            m.R32(O + 0x5684 + 4 * idx) === 0) m.W32(R + 0x48, 76);
        vm.Call("080D5CE0", R);
        const got = vm.Messages;
        vm.Messages = null;
        if (!got.length) break;
        for (const g of got) {
          const id = this.MsgId(g[1]),
            a = Object.assign(new MemoArgs(), {
              Id: id,
              Person: g[0],
              NumBuf: g[2],
              DateArg: g[4],
              TitleStruct: g[5],
              Relation: g[6],
            });
          if (id >= 77 && id <= 79) {
            const e = m.R32(O + 0x5684 + 4 * idx);
            if (e) a.Record = m.R32(e + 0x10);
          }
          a.Pages = this.Msg(id, a);
          list.push(a);
        }
      }
      return list;
    }
    Question() {
      const m = this.m,
        O = OrigOffline.Obj,
        id =
          m.R8(O + 0x994d) === 1
            ? 94
            : m.R8(O + 0x994e) === 1
              ? 97
              : m.R8(O + 0x994c) === 1
                ? 81
                : m.R8(O + 0x994f) === 1
                  ? 102
                  : 82;
      this.SetPages("Question", this.Msg(id, MemoArgs.None));
    }
    MsgId(ptr) {
      for (let i = 60; i < 108; i++)
        if (this.m.R32(OrigMemoFlow.MsgTable + 4 * i) === ptr) return i;
      return -1;
    }
    Msg(id, a) {
      const b = this.text.Heaven && this.text.Heaven.Msgs.get(id);
      return b
        ? this.text.Decode(
            b,
            (c, f) => this.Name(c, f, a),
            null,
            (x, y) => this.Number(x, y, a),
          )
        : ["(사건 메모 글 " + id + " — 로컬 글 팩에 없음)"];
    }
    Name(code, fmt, a) {
      const m = this.m,
        F = OrigMem.Fam;
      if (code === 0x26) return this.player();
      if (code === 0x27) return this.personName(OrigResultScript.MarkFamily);
      if (code === 0x2a) {
        if (fmt === 0x1d) return this.personName(m.R16(F + 0x66c));
        if (fmt === 0x1e) return this.personName(m.R16(F + 0x66e));
        const at = fmt === 0x1c ? OrigMem.Date : a.DateArg;
        if (!at) return null;
        const { year: y, month: mo, day: d } = OrigDate.Get(m, at);
        return y + "년" + mo + "월" + d + "일";
      }
      if (code === 0x2b) {
        const r = a.Record && lookup(this.text.Records, a.Record);
        return r && r.Title ? r.Title : null;
      }
      if (code === 0x2c) return this.text.UiText(a.Relation, null);
      if (code < 0x1c) {
        const id = m.R16(OrigMem.Slots + 2 * code);
        return id === 65535 ? null : this.personName(id);
      }
      return null;
    }
    Number(x, y, a) {
      if (x === 4) return String(this.m.R8(OrigMem.Fam + 0x6a3));
      if (x === 2) {
        if (a.Numbers && y < a.Numbers.length) return String(a.Numbers[y]);
        if (a.NumBuf) return String(this.m.R32(a.NumBuf + 4 + 4 * y));
      }
      return null;
    }
    Entries() {
      const m = this.m,
        O = OrigOffline.Obj,
        l = [];
      let p = m.R32(O + 0x566c),
        guard = 0;
      while (p && p !== O + 0x5668 && guard++ < 800) {
        if (m.R8(p + 8)) {
          const dc = m.R32(p + 0x14), metadata = MemoEntry.NativeMetadata(dc);
          const e = new MemoEntry();
          e.PersonId = m.R16(p + 0xa);
          e.Record = m.R32(p + 0x10);
          Object.assign(e, metadata || { Date: -1, NativeDateCode: dc,
            NativePackedDate: dc & 0xffffff, NativeParticipantSelection: dc >>> 24 });
          const r = lookup(this.text.Records, e.Record);
          if (r) e.Title = r.Title;
          l.push(e);
        }
        p = m.R32(p + 4);
      }
      return l;
    }
    ProgressText() {
      const { year: y, month: mo, day: d } = OrigDate.Get(this.m, OrigMem.Date);
      let s = "사건 메모 확인 중\n" + y + "년" + mo + "월" + d + "일";
      const es = this.Entries();
      if (es.length) {
        const e = es.at(-1),
          age = this.ageOf(e.PersonId);
        s +=
          "\n" +
          this.personName(e.PersonId) +
          (age >= 0 ? " (" + age + "세)" : "") +
          "\n" +
          e.Title;
      }
      return s;
    }
  }
  Object.assign(OrigMemoFlow, {
    Args: MemoArgs,
    Entry: MemoEntry,
    Rep: 0x0f03c100,
    Fam: OrigMem.Fam,
    Obj: OrigOffline.Obj,
    MsgTable: 0x085d5cb0,
    Scratch: 0x0f03c0c0,
  });
  Object.assign(SK, {
    OrigSelect,
    OrigNewGame,
    OrigEvents,
    OrigResultScript,
    OrigGame,
    OrigJobs,
    OrigOffline,
    OrigHeaven,
    OrigMemoFlow,
  });

  Object.assign(SK, {
    OrigUnmodeled,
    OrigMem,
    OrigInterest,
    OrigRules,
    OrigVm,
    OrigDate,
    OrigFamily,
  });
})(globalThis);

</script>
<script>
/* Shared Korean display-name catalog for recommended families, births and
 * outside partners. Saved/manual aliases remain authoritative. This catalog
 * consumes no RNG and never changes native genes or naming resources. */
(function (root) {
  "use strict";
  const SK = root.SK = root.SK || {};
  const male = Object.freeze([
    "민준", "서준", "도윤", "하준", "지호", "준우", "현우", "건우", "우진", "선우",
    "유준", "정우", "승현", "시우", "지훈", "태윤", "준서", "지후", "유찬", "승우",
    "도현", "은우", "주원", "이준", "수호", "서진", "연우", "재윤", "지율", "시윤",
    "윤재", "도하", "지한", "민재", "준영", "성훈", "태민", "재현", "종현", "영호",
    "성호", "정호", "동현", "진수", "대현", "창수", "병호", "상철", "광수", "영수",
    "상호", "명수", "정수", "재호", "성진", "현수", "동수", "진호", "용준", "준호",
    "민우", "민수", "민호", "준혁", "민혁", "현준", "승준", "승윤", "태현", "태호",
    "태준", "태우", "태영", "태훈", "태성", "윤호", "윤우", "윤찬", "윤성", "윤수",
    "유빈", "유건", "유성", "유환", "유한", "이안", "이현", "이찬", "이한", "예준",
    "예찬", "예성", "예담", "지환", "지완", "지성", "지석", "지오", "지운", "지섭",
    "지혁", "지헌", "지욱", "지웅", "지용", "재원", "재민", "재영", "재훈", "재욱",
    "재준", "재성", "재환", "재용", "주혁", "주호", "주영", "주환", "주헌", "주안",
    "서후", "서원", "서호", "수혁", "수환", "수찬", "시원", "시온", "시훈", "시준",
    "시후", "도준", "도훈", "도원", "도경", "도진", "도겸", "도율", "하람", "하민",
    "한결", "한울", "찬우", "찬호", "찬영", "찬희", "승호", "승진", "승규", "승훈",
    "승환", "승원", "승철", "승재", "준범", "준석", "준형", "준규", "준기", "준하",
    "준용", "건호", "건희", "건영", "정훈", "정현", "정욱", "정환", "정식", "정근",
    "정섭", "정진", "정철", "성준", "성현", "성우", "성재", "성환", "성욱", "성철",
    "성규", "영준", "영진", "영훈", "영민", "영철", "영식", "병철", "병수", "동훈",
    "동준", "동호", "동욱", "동규", "진우", "진영", "진석", "상민", "상훈", "용호",
  ]);
  const female = Object.freeze([
    "서연", "지우", "하윤", "서윤", "민서", "하은", "지아", "수아", "지유", "채원",
    "윤서", "다은", "예린", "소율", "가은", "나연", "지민", "유나", "지안", "시은",
    "아린", "서아", "예은", "예원", "수빈", "주아", "다인", "은서", "시아", "소은",
    "채윤", "유진", "수진", "은주", "미정", "영미", "정희", "미영", "선영", "경희",
    "명희", "정숙", "영숙", "순자", "옥희", "혜진", "지영", "현정", "은정", "정은",
