","bgm_111_b":"","bgm_114_b":"","bgm_117_a":"","bgm_117_b":"","bgm_132":"","se_201":"","se_211":"","se_212":"","se_215":"","se_216":"","se_218":"","se_220":"","se_231":"","bgm_278":"","se_268":"","se_271":"","se_272":"","se_279":"","se_291":"","se_450":"","se_451":"","se_461":"","se_260":"","se_460":""}};

</script>
<script>
/* SoundKit.cs browser port. Original Ogg bytes are embedded in SK.AUDIO;
 * no URL, fetch, timer-based loop stitching, or third-party audio library.
 * Decoded samples, rather than compressed-file length, define every seam. */
(function (root) {
  "use strict";
  const SK = (root.SK = root.SK || {});
  const CACHE_BYTES = 48 * 1024 * 1024;
  const CACHE_ENTRIES = 12;
  const MAX_EFFECTS = 8;
  const volume = (n, fallback) => {
    const value = Number(n);
    return Number.isFinite(value) ? Math.max(0, Math.min(1, value)) : fallback;
  };
  const sampleDuration = (buffer) => buffer.length / buffer.sampleRate;
  const modulo = (value, length) => ((value % length) + length) % length;
  const fadeSeconds = (value, fallback = 0) => {
    const seconds = Number(value);
    return Number.isFinite(seconds) ? Math.max(0, Math.min(30, seconds)) : fallback;
  };

  class SoundKit {
    constructor(options = {}) {
      this.bgmVolume = volume(options.bgmVolume ?? 0.8, 0.8);
      this.seVolume = volume(options.seVolume ?? 0.8, 0.8);
      this._onStatus = options.onStatus;
      this._onEffectsStop = options.onEffectsStop;
      this._audio = SK.AUDIO || { index: { songs: {} }, files: {} };
      this._songs = this._audio.index?.songs || {};
      this._context = null;
      this._analyser = null;
      this._supported = Boolean(root.AudioContext || root.webkitAudioContext);
      this._disposed = false;
      this._unlocked = false;
      this._hidden = Boolean(root.document?.hidden);
      this._manualPaused = false;
      this._generation = 0;
      this._seGeneration = 0;
      this._desiredId = null;
      this._currentId = null;
      this._options = {};
      this._ended = false;
      this._bgmFailed = false;
      this._lastError = null;
      this._schedule = null;
      this._bgmNodes = new Set();
      this._voiceGain = null;
      this._voiceFade = null;
      this._fadingVoices = new Set();
      this._seNodes = new Set();
      this._cache = new Map();
      this._cacheBytes = 0;
      this._pendingClips = new Map();
      this._decodeQueue = [];
      this._decoding = 0;
      this._decodeCount = 0;
      this._pendingBgm = null;
      this._unlockPromise = null;
      this._unlockWake = null;
      this._lastStatus = null;
      this._gesture = (event) => {
        if (event.isTrusted) void this.unlock();
      };
      this._visibility = () => {
        this._hidden = Boolean(root.document?.hidden);
        if (this._hidden) void this._pauseContext();
        else void this._resumeContext();
        this._notify();
      };
      this._bindGestures = options.bindGestures !== false;
      if (this._bindGestures) {
        root.document?.addEventListener("pointerdown", this._gesture, true);
        root.document?.addEventListener("pointerup", this._gesture, true);
        root.document?.addEventListener("touchend", this._gesture, true);
        root.document?.addEventListener("click", this._gesture, true);
        root.document?.addEventListener("keydown", this._gesture, true);
      }
      root.document?.addEventListener("visibilitychange", this._visibility);
    }

    get available() {
      return this._supported && this.count > 0 && !this._disposed;
    }
    get count() {
      return Object.keys(this._songs).length;
    }
    get context() {
      return this._context;
    }
    get analyser() {
      return this._analyser;
    }
    // Synthesized dialogue shares the existing effects mixer and gesture gate.
    get effectsOutput() {
      return this._seGain || null;
    }
    get effectsReady() {
      return this._unlockPromise || Promise.resolve(this._unlocked);
    }
    has(id) {
      return Object.prototype.hasOwnProperty.call(this._songs, String(id));
    }
    loops(id) {
      return Boolean(this._songs[String(id)]?.loop);
    }
    get status() {
      if (this._disposed) return "disposed";
      if (!this.available) return "unavailable";
      if (this._manualPaused || this._hidden) return "paused";
      if (!this._unlocked || this._context?.state !== "running") return "locked";
      if (this._pendingBgm) return "loading";
      if (this._bgmFailed) return "error";
      if (this._ended) return "ended";
      return this._bgmNodes.size ? "playing" : "idle";
    }
    get diagnostics() {
      const context = this._context;
      const schedule = this._schedule;
      const elapsed = schedule
        ? Math.max(0, (context?.currentTime || 0) - schedule.startTime)
        : 0;
      const position = elapsed + (schedule?.startAt || 0);
      let phase = null;
      let offsetSeconds = 0;
      if (schedule?.onceDuration) {
        phase = this._ended ? "ended" : schedule.repeat ? "repeat-once" : "once";
        offsetSeconds = schedule.repeat
          ? modulo(position, schedule.onceDuration)
          : Math.min(position, schedule.onceDuration);
      } else if (schedule) {
        phase = position < schedule.introDuration ? "intro" : "loop";
        offsetSeconds =
          phase === "intro"
            ? position
            : modulo(position - schedule.introDuration, schedule.loopDuration);
      }
      let rms = 0;
      let peak = 0;
      if (this._analyser && context?.state === "running") {
        const samples = new Float32Array(this._analyser.fftSize);
        this._analyser.getFloatTimeDomainData(samples);
        for (const value of samples) {
          rms += value * value;
          peak = Math.max(peak, Math.abs(value));
        }
        rms = Math.sqrt(rms / samples.length);
      }
      return {
        available: this.available,
        status: this.status,
        currentId: this._currentId,
        desiredId: this._desiredId,
        contextState: context?.state || "not-created",
        unlocked: this._unlocked,
        sampleRate: context?.sampleRate || null,
        generation: this._generation,
        bgmVolume: this.bgmVolume,
        seVolume: this.seVolume,
        phase,
        offsetSeconds,
        startTime: schedule?.startTime ?? null,
        loopStartAt: schedule?.loopStartAt ?? null,
        introDuration: schedule?.introDuration ?? null,
        loopDuration: schedule?.loopDuration ?? null,
        onceDuration: schedule?.onceDuration ?? null,
        repeat: Boolean(schedule?.repeat),
        scheduledStartAt: schedule?.startAt ?? null,
        bgmSources: this._bgmNodes.size + Array.from(this._fadingVoices)
          .reduce((total, voice) => total + voice.nodes.size, 0),
        bgmVoices: Number(this._bgmNodes.size > 0) + this._fadingVoices.size,
        fadingVoices: this._fadingVoices.size,
        seSources: this._seNodes.size,
        cacheBytes: this._cacheBytes,
        cacheLimitBytes: CACHE_BYTES,
        cachedClips: Array.from(this._cache.keys()),
        pendingClips: this._pendingClips.size,
        decoding: this._decoding,
        decodeCount: this._decodeCount,
        rms,
        peak,
        lastError: this._lastError,
      };
    }

    _notify() {
      const status = this.status;
      if (status === this._lastStatus) return;
      this._lastStatus = status;
      try {
        this._onStatus?.(status, this.diagnostics);
      } catch (error) {
        console.warn("Sound status callback failed:", error);
      }
    }
    _error(error) {
      this._lastError = String(error?.message || error || "Audio unavailable");
    }
    _ensureContext() {
      if (this._context) return this._context;
      if (!this.available) return null;
      const Context = root.AudioContext || root.webkitAudioContext;
      try {
        try {
          this._context = new Context({
            sampleRate: Number(this._audio.index?.rate) || 32768,
            latencyHint: "interactive",
          });
        } catch (_) {
          this._context = new Context();
        }
        const context = this._context;
        this._bgmGain = context.createGain();
        this._seGain = context.createGain();
        this._analyser = context.createAnalyser();
        this._analyser.fftSize = 1024;
        this._bgmGain.connect(this._analyser);
        this._seGain.connect(this._analyser);
        this._analyser.connect(context.destination);
        this.setVolumes(this.bgmVolume, this.seVolume);
        this._contextState = () => {
          if (context.state === "running" && !this._isPaused()) {
            this._unlocked = true;
            void this._startDesired();
          }
          this._notify();
        };
        context.addEventListener("statechange", this._contextState);
        return context;
      } catch (error) {
        this._error(error);
        this._supported = false;
        this._notify();
        return null;
      }
    }
    _isPaused() {
      return this._manualPaused || this._hidden;
    }

    // Call directly within the trusted pointer/key handler, before any await.
    // Touch pointerdown can precede activation and leave resume() pending.
    // A completed touch must issue its own resume even while that work waits.
    // Sources are never rebuilt solely because the page is hidden or resumed.
    unlock() {
      if (this._disposed) return Promise.resolve(false);
      const context = this._ensureContext();
      if (!context) return Promise.resolve(false);
      if (this._isPaused()) return Promise.resolve(false);
      let resume;
      try {
        if (context.state !== "running") resume = context.resume();
      } catch (error) {
        this._error(error);
        this._notify();
        return Promise.resolve(false);
      }
      if (this._unlockPromise) {
        const wake = this._unlockWake;
        // Wake the shared first-click/effects waiters on a successful retry;
        // do not depend on an earlier non-activating resume promise settling.
        Promise.resolve(resume).then(wake, (error) => {
          this._error(error);
          this._notify();
        });
        return this._unlockPromise;
      }
      const retry = new Promise((resolve) => { this._unlockWake = resolve; });
      this._unlockPromise = Promise.race([Promise.resolve(resume), retry])
        .then(async () => {
          if (this._disposed || this._isPaused()) {
            if (!this._disposed) await this._pauseContext();
            return false;
          }
          this._unlocked = context.state === "running";
          if (this._unlocked) await this._startDesired();
          this._notify();
          return this._unlocked;
        })
        .catch((error) => {
          this._error(error);
          this._notify();
          return false;
        })
        .finally(() => {
          this._unlockPromise = null;
          this._unlockWake = null;
        });
      return this._unlockPromise;
    }

    playBgm(id, options = {}) {
      if (this._disposed) return Promise.resolve(false);
      options = options && typeof options === "object" ? options : {};
      const key = String(id);
      if (id == null || Number(id) < 0 || !this.has(key)) {
        this.stopBgm(fadeSeconds(options.fadeOut, 0.5));
        return Promise.resolve(false);
      }
      // Once-tracks remain ended when the UI repeatedly requests the same id.
      const replay = options.again && (this._ended || this._bgmFailed);
      if (key === this._desiredId && !replay)
        return this._pendingBgm?.promise || Promise.resolve(!this._bgmFailed);
      ++this._generation;
      this._retireBgm(fadeSeconds(options.fadeOut, 0.5));
      this._desiredId = key;
      this._currentId = null;
      this._schedule = null;
      this._options = options;
      this._ended = false;
      this._bgmFailed = false;
      this._pendingBgm = null;
      this._notify();
      return this._startDesired();
    }

    _startDesired() {
      if (
        this._disposed ||
        !this._desiredId ||
        this._isPaused() ||
        !this._unlocked ||
        this._context?.state !== "running" ||
        this._bgmNodes.size ||
        this._ended ||
        this._bgmFailed
      )
        return Promise.resolve(false);
      if (this._pendingBgm?.generation === this._generation)
        return this._pendingBgm.promise;
      const generation = this._generation;
      const key = this._desiredId;
      const isLive = () => !this._disposed && generation === this._generation;
      const pending = { generation, promise: null };
      this._pendingBgm = pending;
      pending.promise = this._prepareBgm(key, isLive)
        .then((clips) => {
          if (!isLive()) return false;
          if (this._isPaused() || this._context.state !== "running") return false;
          this._scheduleBgm(key, clips, generation);
          return true;
        })
        .catch((error) => {
          if (isLive()) {
            this._error(error);
            this._bgmFailed = true;
            this._retireBgm(0);
          }
          return false;
        })
        .finally(() => {
          if (this._pendingBgm === pending) this._pendingBgm = null;
          this._notify();
          // A visibility resume can race the final decode microtask. Retry
          // scheduling from cached samples only; never restart an active voice.
          if (isLive() && !this._isPaused() && this._context?.state === "running")
            void this._startDesired();
        });
      this._notify();
      return pending.promise;
    }
    async _prepareBgm(key, isLive) {
      const entry = this._songs[key];
      if (entry.once) return { once: await this._clip(entry.once, isLive) };
      if (!entry.loop) throw new Error("Song has no playback clip: " + key);
      const [intro, loop] = await Promise.all([
        entry.intro ? this._clip(entry.intro, isLive) : null,
        this._clip(entry.loop, isLive),
      ]);
      return { intro, loop };
    }
    _scheduleBgm(key, clips, generation) {
      const context = this._context;
      const when = context.currentTime + 0.03;
      const rawOffset = Number(this._options.startAt);
      const startAt = Number.isFinite(rawOffset) ? Math.max(0, rawOffset) : 0;
      const schedule = { id: key, generation, startTime: when, startAt };
      this._voiceGain = context.createGain();
      this._voiceGain.connect(this._bgmGain);
      const fadeIn = fadeSeconds(this._options.fadeIn);
      this._voiceFade = { start: when, end: when + fadeIn };
      this._voiceGain.gain.setValueAtTime(fadeIn ? 0 : 1, when);
      if (fadeIn) this._voiceGain.gain.linearRampToValueAtTime(1, when + fadeIn);
      if (clips.once) {
        const length = sampleDuration(clips.once);
        schedule.onceDuration = length;
        // The title requests again=true while it remains on screen. Native
        // buffer looping implements that repetition without polling the UI.
        schedule.repeat = Boolean(this._options.again);
        schedule.startAt = Math.min(startAt, Math.max(0, length - 1 / clips.once.sampleRate));
        this._newSource(clips.once, this._voiceGain, this._bgmNodes, {
          when,
          offset: schedule.startAt,
          loop: schedule.repeat,
          generation,
        });
      } else {
        const introDuration = clips.intro ? sampleDuration(clips.intro) : 0;
        const loopDuration = sampleDuration(clips.loop);
        Object.assign(schedule, { introDuration, loopDuration });
        if (clips.intro && startAt < introDuration) {
          this._newSource(clips.intro, this._voiceGain, this._bgmNodes, {
            when,
            offset: startAt,
            generation,
          });
          schedule.loopStartAt = when + introDuration - startAt;
          this._newSource(clips.loop, this._voiceGain, this._bgmNodes, {
            when: schedule.loopStartAt,
            loop: true,
            generation,
          });
        } else {
          schedule.loopStartAt = when;
          this._newSource(clips.loop, this._voiceGain, this._bgmNodes, {
            when,
            offset: modulo(startAt - introDuration, loopDuration),
            loop: true,
            generation,
          });
        }
      }
      this._schedule = schedule;
      this._currentId = key;
      this._lastError = null;
    }
    _newSource(buffer, gain, nodes, options = {}) {
      const source = this._context.createBufferSource();
      source.buffer = buffer;
      source.loop = Boolean(options.loop);
      if (source.loop) {
        source.loopStart = 0;
        source.loopEnd = sampleDuration(buffer);
      }
      source.connect(gain);
      nodes.add(source);
      source.onended = () => {
        nodes.delete(source);
        source.disconnect();
        if (
          nodes === this._bgmNodes &&
          options.generation === this._generation &&
          this._schedule?.onceDuration &&
          !this._schedule?.repeat &&
          !nodes.size
        )
          this._ended = true;
        this._releaseFadingVoices();
        this._notify();
      };
      try {
        source.start(options.when ?? this._context.currentTime, options.offset || 0);
      } catch (error) {
        nodes.delete(source);
        source.disconnect();
        throw error;
      }
      return source;
    }

    async prepareEffects(ids) {
      await this.effectsReady;
      if (!this._unlocked || this._disposed || this._isPaused()) return false;
      await Promise.all(ids.map(id => {
        const entry = this._songs[String(id)], name = entry && (entry.once || entry.intro || entry.loop);
        return name ? this._clip(name, () => !this._disposed) : null;
      }));
      return true;
    }
    stopEffects() {
      ++this._seGeneration;
      this._stopNodes(this._seNodes);
      this._onEffectsStop?.();
    }
    async playSe(id, options = {}) {
      const generation = this._seGeneration;
      const isLive = () => !this._disposed && generation === this._seGeneration &&
        (typeof options.isLive !== "function" || options.isLive());
      // Capture unlock runs before the UI's click handler. Preserve that first
      // click while its authorized resume is pending, not arbitrary locked SE.
      if (!this._unlocked && this._unlockPromise) await this._unlockPromise;
      if (
        !isLive() ||
        !this._unlocked ||
        this._isPaused() ||
        this._context?.state !== "running"
      )
        return false;
      const entry = this._songs[String(id)];
      const name = entry && (entry.once || entry.intro || entry.loop);
      if (!name) return false;
      try {
        const buffer = await this._clip(name, isLive);
        if (!isLive() || this._isPaused() || this._context.state !== "running")
          return false;
        while (this._seNodes.size >= MAX_EFFECTS)
          this._stopSource(this._seNodes.values().next().value, this._seNodes);
        this._newSource(buffer, this._seGain, this._seNodes);
        return true;
      } catch (error) {
        if (isLive()) this._error(error);
        return false;
      }
    }

    // Promise coalescing + two workers prevent rapid scene switches from
    // decoding the same Ogg twice or launching unbounded decode work.
    _clip(name, isLive) {
      const key = String(name).replace(/\.ogg$/i, "");
      const cached = this._cache.get(key);
      if (cached) {
        this._cache.delete(key);
        this._cache.set(key, cached);
        return Promise.resolve(cached.buffer);
      }
      const existing = this._pendingClips.get(key);
      if (existing) {
        existing.live.push(isLive);
        return existing.promise;
      }
      let resolve, reject;
      const pending = {
        key,
        live: [isLive],
        promise: new Promise((ok, fail) => { resolve = ok; reject = fail; }),
        resolve: null,
        reject: null,
      };
      pending.resolve = resolve;
      pending.reject = reject;
      this._pendingClips.set(key, pending);
      this._decodeQueue.push(pending);
      this._drainDecodes();
      return pending.promise;
    }
    _drainDecodes() {
      while (this._decoding < 2 && this._decodeQueue.length) {
        const pending = this._decodeQueue.shift();
        if (this._disposed || !pending.live.some((isLive) => isLive())) {
          this._pendingClips.delete(pending.key);
          pending.reject(new Error("Obsolete audio request"));
          continue;
        }
        ++this._decoding;
        void this._decodeClip(pending.key)
          .then((buffer) => {
            if (!this._disposed) this._cacheClip(pending.key, buffer);
            pending.resolve(buffer);
          }, pending.reject)
          .finally(() => {
            this._pendingClips.delete(pending.key);
            --this._decoding;
            this._drainDecodes();
          });
      }
    }
    async _decodeClip(key) {
      const payload = this._audio.files?.[key] || this._audio.files?.[key + ".ogg"];
      const encoded = typeof payload === "string" ? payload : payload?.data;
      if (!encoded) throw new Error("Embedded audio clip missing: " + key);
      const binary = root.atob(encoded.replace(/^data:[^,]*,/, ""));
      const bytes = new Uint8Array(binary.length);
      for (let i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
      ++this._decodeCount;
      const buffer = await new Promise((resolve, reject) => {
        try {
          const result = this._context.decodeAudioData(bytes.buffer, resolve, reject);
          if (result && typeof result.then === "function") result.then(resolve, reject);
        } catch (error) {
          reject(error);
        }
      });
      if (!buffer?.length || !buffer.sampleRate)
        throw new Error("Decoded audio clip is empty: " + key);
      return buffer;
    }
    _cacheClip(key, buffer) {
      const bytes = buffer.length * buffer.numberOfChannels * 4;
      if (bytes > CACHE_BYTES) return; // A large active clip is not an unbounded cache entry.
      while (
        this._cache.size &&
        (this._cacheBytes + bytes > CACHE_BYTES || this._cache.size >= CACHE_ENTRIES)
      ) {
        const oldest = this._cache.keys().next().value;
        this._cacheBytes -= this._cache.get(oldest).bytes;
        this._cache.delete(oldest);
      }
      this._cache.set(key, { buffer, bytes });
      this._cacheBytes += bytes;
    }

    setVolumes(bgm, se) {
      this.bgmVolume = volume(bgm, this.bgmVolume);
      this.seVolume = volume(se, this.seVolume);
      if (this._context) {
        const now = this._context.currentTime;
        this._bgmGain?.gain.setValueAtTime(this.bgmVolume, now);
        this._seGain?.gain.setValueAtTime(this.seVolume, now);
      }
    }
    suspend() {
      this._manualPaused = true;
      return this._pauseContext();
    }
    resume() {
      this._manualPaused = false;
      return this._resumeContext();
    }
    async _pauseContext() {
      this._onEffectsStop?.();
      try {
        if (this._context && this._context.state !== "closed")
          await this._context.suspend();
        this._notify();
        return true;
      } catch (error) {
        this._error(error);
        this._notify();
        return false;
      }
    }
    async _resumeContext() {
      if (this._disposed || this._isPaused() || !this._unlocked) return false;
      try {
        await this._context.resume();
        if (this._isPaused()) return this._pauseContext();
        await this._startDesired();
        this._notify();
        return this._context.state === "running";
      } catch (error) {
        this._error(error);
        this._notify();
        return false;
      }
    }
    _stopSource(source, nodes) {
      source.onended = null;
      try { source.stop(); } catch (_) { /* Already ended. */ }
      try { source.disconnect(); } catch (_) { /* Already disconnected. */ }
      nodes.delete(source);
    }
    _stopNodes(nodes) {
      for (const source of nodes) this._stopSource(source, nodes);
    }
    _releaseFadingVoices() {
      for (const voice of this._fadingVoices) {
        if (!voice.nodes.size) {
          voice.gain.disconnect();
          this._fadingVoices.delete(voice);
        }
      }
    }
    _retireBgm(seconds) {
      const nodes = this._bgmNodes;
      const gain = this._voiceGain;
      this._bgmNodes = new Set();
      this._voiceGain = null;
      if (!gain) {
        this._stopNodes(nodes);
        return;
      }
      if (!nodes.size || !seconds || this._context?.state !== "running") {
        this._stopNodes(nodes);
        gain.disconnect();
        return;
      }
      const now = this._context.currentTime;
      const fade = this._voiceFade;
      const current = fade && fade.end > fade.start
        ? Math.max(0, Math.min(1, (now - fade.start) / (fade.end - fade.start)))
        : 1;
      gain.gain.cancelScheduledValues(now);
      gain.gain.setValueAtTime(current, now);
      gain.gain.linearRampToValueAtTime(0, now + seconds);
      this._fadingVoices.add({ nodes, gain });
      for (const source of nodes) {
        try { source.stop(now + seconds); } catch (_) { /* Already ended. */ }
      }
      // Rapid switches must not accumulate an unlimited number of old voices.
      while (this._fadingVoices.size > 2) {
        const oldest = this._fadingVoices.values().next().value;
        this._stopNodes(oldest.nodes);
        oldest.gain.disconnect();
        this._fadingVoices.delete(oldest);
      }
    }
    stopBgm(fadeOut = 0.5) {
      ++this._generation;
      this._desiredId = this._currentId = null;
      this._schedule = null;
      this._pendingBgm = null;
      this._ended = this._bgmFailed = false;
      this._retireBgm(fadeSeconds(fadeOut, 0.5));
      this._notify();
    }
    stop() {
      this._onEffectsStop?.();
