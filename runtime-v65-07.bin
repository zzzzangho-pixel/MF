"},"bindings":[{"source":"/Users/zzzzangho/.openclaw/workspace/artifacts/2026-10-16-sennen-kazoku-pet-palette-v3/assets/masks/cat-calico-roles.png","path":"/Users/zzzzangho/.openclaw/workspace/artifacts/2026-10-16-sennen-kazoku-pet-system-test-v4/project/assets/pets/masks/cat-calico-roles.png","sha256":"87ede624563a32b5f91cd56a07bd946403d953491c0ccda94079fc98b16040d4","bytes":28828},{"source":"/Users/zzzzangho/.openclaw/workspace/artifacts/2026-10-16-sennen-kazoku-pet-palette-v3/assets/masks/cat-roles.png","path":"/Users/zzzzangho/.openclaw/workspace/artifacts/2026-10-16-sennen-kazoku-pet-system-test-v4/project/assets/pets/masks/cat-roles.png","sha256":"6faa42ba5d43da8940f552b7806016475024705817dd05d09daddfb20295c246","bytes":22424},{"source":"/Users/zzzzangho/.openclaw/workspace/artifacts/2026-10-16-sennen-kazoku-pet-palette-v3/assets/masks/cat-tuxedo-roles.png","path":"/Users/zzzzangho/.openclaw/workspace/artifacts/2026-10-16-sennen-kazoku-pet-system-test-v4/project/assets/pets/masks/cat-tuxedo-roles.png","sha256":"d41246c8bf87df43c8722cde7b6400ffa9e2e09cab3afeec0c9887d05a8eb4ae","bytes":25045},{"source":"/Users/zzzzangho/.openclaw/workspace/artifacts/2026-10-16-sennen-kazoku-pet-palette-v3/assets/masks/dog-corgi-roles.png","path":"/Users/zzzzangho/.openclaw/workspace/artifacts/2026-10-16-sennen-kazoku-pet-system-test-v4/project/assets/pets/masks/dog-corgi-roles.png","sha256":"c36627252bed2ac0779bade53a2906b3fa4c5b2e563818d0500346f1a6309a1f","bytes":27780},{"source":"/Users/zzzzangho/.openclaw/workspace/artifacts/2026-10-16-sennen-kazoku-pet-palette-v3/assets/masks/dog-original-roles.png","path":"/Users/zzzzangho/.openclaw/workspace/artifacts/2026-10-16-sennen-kazoku-pet-system-test-v4/project/assets/pets/masks/dog-original-roles.png","sha256":"df45f3c2616cf384f76b203c9f687ce6b92da8d829f87ba531e778ad3605ec91","bytes":19369},{"source":"/Users/zzzzangho/.openclaw/workspace/artifacts/2026-10-16-sennen-kazoku-pet-palette-v3/assets/masks/dog-poodle-roles.png","path":"/Users/zzzzangho/.openclaw/workspace/artifacts/2026-10-16-sennen-kazoku-pet-system-test-v4/project/assets/pets/masks/dog-poodle-roles.png","sha256":"7b4e09f1579a6dd3b1ea68f12d8c0cccd4d68b1cb81acf3e72715f8c7f677753","bytes":29488},{"source":"/Users/zzzzangho/.openclaw/workspace/artifacts/2026-10-16-sennen-kazoku-pet-palette-v3/assets/masks/dog-shiba-roles.png","path":"/Users/zzzzangho/.openclaw/workspace/artifacts/2026-10-16-sennen-kazoku-pet-system-test-v4/project/assets/pets/masks/dog-shiba-roles.png","sha256":"b95fccfbfd7e44b749e1fea3fc5472559d894924a7f77c98de8568d5d9622192","bytes":26336},{"source":"/Users/zzzzangho/.openclaw/workspace/artifacts/2026-10-16-sennen-kazoku-pet-palette-v3/assets/templates/cat.png","path":"/Users/zzzzangho/.openclaw/workspace/artifacts/2026-10-16-sennen-kazoku-pet-system-test-v4/project/assets/pets/templates/cat.png","sha256":"0767855391b4d431641c57a446f219f49c9f2989561f982ca1b4221673483ba3","bytes":647021},{"source":"/Users/zzzzangho/.openclaw/workspace/artifacts/2026-10-16-sennen-kazoku-pet-palette-v3/assets/templates/dog-corgi.png","path":"/Users/zzzzangho/.openclaw/workspace/artifacts/2026-10-16-sennen-kazoku-pet-system-test-v4/project/assets/pets/templates/dog-corgi.png","sha256":"655875d03823e4dc54d3306580526105dcf2c38becdce7d2a56a980dc3b2bc7c","bytes":706343},{"source":"/Users/zzzzangho/.openclaw/workspace/artifacts/2026-10-16-sennen-kazoku-pet-palette-v3/assets/templates/dog-original.png","path":"/Users/zzzzangho/.openclaw/workspace/artifacts/2026-10-16-sennen-kazoku-pet-system-test-v4/project/assets/pets/templates/dog-original.png","sha256":"777aa36a266928fe5e50e2bdea490671dd6558b0e85b6e8370787e5f706f1a79","bytes":602060},{"source":"/Users/zzzzangho/.openclaw/workspace/artifacts/2026-10-16-sennen-kazoku-pet-palette-v3/assets/templates/dog-poodle.png","path":"/Users/zzzzangho/.openclaw/workspace/artifacts/2026-10-16-sennen-kazoku-pet-system-test-v4/project/assets/pets/templates/dog-poodle.png","sha256":"0a935f3d3a052e997d16cd940c3da88d441eabbb3e28466f52971903427d7cdf","bytes":823196},{"source":"/Users/zzzzangho/.openclaw/workspace/artifacts/2026-10-16-sennen-kazoku-pet-palette-v3/assets/templates/dog-shiba.png","path":"/Users/zzzzangho/.openclaw/workspace/artifacts/2026-10-16-sennen-kazoku-pet-system-test-v4/project/assets/pets/templates/dog-shiba.png","sha256":"facf4bd62d3b515d6d86dc37d3ab6389b111785eba425642146ce2e1f4dcf545","bytes":662920}]};

const templates=new Map(DATA.manifest.templates.map(t=>[t.id,t]));
const sourceCache=new Map(),maskCache=new Map(),sheets=new Map();
async function decode(path){const url=DATA.images[path];if(typeof url!=='string'||!url.startsWith('data:image/png'))throw Error('Pet embedded PNG missing: '+path);const im=new Image();im.src=url;await im.decode();const c=document.createElement('canvas');c.width=im.naturalWidth;c.height=im.naturalHeight;const ctx=c.getContext('2d',{willReadFrequently:true});ctx.drawImage(im,0,0);return {width:c.width,height:c.height,data:ctx.getImageData(0,0,c.width,c.height).data};}
function source(t){if(!sourceCache.has(t.id))sourceCache.set(t.id,decode(t.path).then(s=>{if(s.width!==t.width||s.height!==t.height)throw Error('Pet source dimensions mismatch');return s;}));return sourceCache.get(t.id);}
function roles(path,t){if(!maskCache.has(path))maskCache.set(path,decode(path).then(m=>{if(m.width!==t.width||m.height!==t.height)throw Error('Pet mask dimensions mismatch');const result=new Uint8Array(t.width*t.height);for(let i=0;i<result.length;i++)result[i]=m.data[i*4];return result;}));return maskCache.get(path);}
function entry(templateId,paletteId){const template=templates.get(templateId),variant=template?.variants.find(v=>v.id===paletteId);if(!variant)throw Error('Unknown pet appearance: '+templateId+'/'+paletteId);return {template,variant};}
async function compose(templateId,paletteId){const {template:t,variant:v}=entry(templateId,paletteId),palette=v.palette||{},has=Object.keys(palette).length>0;const [s,mask]=await Promise.all([source(t),has&&v.mask?roles(v.mask,t):new Uint8Array(t.width*t.height)]);const rgba=new Uint8ClampedArray(s.data);if(has)for(let p=0,o=0;p<mask.length;p++,o+=4){const color=mask[p]&&palette[mask[p]];if(color&&rgba[o+3]!==0){rgba[o]=color[0];rgba[o+1]=color[1];rgba[o+2]=color[2];}}const canvas=document.createElement('canvas');canvas.width=t.width;canvas.height=t.height;canvas.getContext('2d').putImageData(new ImageData(rgba,t.width,t.height),0,0);return {canvas,template:t,variant:v,source:s,roles:mask};}
function get(templateId,paletteId){const key=templateId+'/'+paletteId;if(sheets.has(key)){const value=sheets.get(key);sheets.delete(key);sheets.set(key,value);return value;}const promise=compose(templateId,paletteId).catch(e=>{sheets.delete(key);throw e;});sheets.set(key,promise);while(sheets.size>5)sheets.delete(sheets.keys().next().value);return promise;}
function drawFrame(canvas,sheet,frame,padding=.08){const ctx=canvas.getContext('2d'),[x,y,w,h]=frame.sourceRect;ctx.clearRect(0,0,canvas.width,canvas.height);ctx.imageSmoothingEnabled=false;const scale=Math.min(canvas.width*(1-2*padding)/w,canvas.height*(1-2*padding)/h),dw=w*scale,dh=h*scale;ctx.drawImage(sheet,x,y,w,h,(canvas.width-dw)/2,(canvas.height-dh)/2,dw,dh);}
async function verify(templateId,paletteId){const a=await get(templateId,paletteId),actual=a.canvas.getContext('2d').getImageData(0,0,a.canvas.width,a.canvas.height).data;let alphaChangedPixels=0,fixedRgbChangedPixels=0,changedRgbPixels=0;for(let p=0,o=0;o<actual.length;p++,o+=4){if(actual[o+3]!==a.source.data[o+3])alphaChangedPixels++;if(actual[o]!==a.source.data[o]||actual[o+1]!==a.source.data[o+1]||actual[o+2]!==a.source.data[o+2]){changedRgbPixels++;if(a.roles[p]===0)fixedRgbChangedPixels++;}}return {templateId,paletteId,width:a.canvas.width,height:a.canvas.height,alphaChangedPixels,fixedRgbChangedPixels,changedRgbPixels};}
SK.PetAssets=Object.freeze({manifest:DATA.manifest,sourceManifestSha256:DATA.sourceManifestSha256,bindings:DATA.bindings,entry,get,drawFrame,verify});
})(typeof window!=='undefined'?window:globalThis);

</script>
<script>
/* Local connected pet UI. All rules/effects belong to PetRules + PetBridge. */
(function (root) {
  'use strict';
  const SK = root.SK = root.SK || {};
  const installed = new WeakMap();
  const diagnostics = { installed: 0, renderCount: 0, lastDraws: [], errors: [] };
  const $ = id => document.getElementById(id);
  const esc = value => String(value ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const cash = value => SK.Currency?.formatNative ? SK.Currency.formatNative(value) : `${(Number(value) * 100000).toLocaleString('ko-KR')}원`;
  const mod = (v, n) => ((v % n) + n) % n;
  const clamp = (v, lo, hi) => Math.max(lo, Math.min(hi, v));
  const dayText = value => { if (!Number.isInteger(value)) return '—'; const d = new Date(Date.UTC(1900, 0, 1) + value * 86400000); return `${d.getUTCFullYear()}.${d.getUTCMonth()+1}.${d.getUTCDate()}`; };
  const button = (id, label, disabled = false, secondary = true) => `<button type="button" id="${esc(id)}" class="btn ${secondary ? 'secondary' : ''} small"${disabled ? ' disabled' : ''}>${esc(label)}</button>`;
  const paw = '<svg viewBox="0 0 32 32" aria-hidden="true"><path d="M10 18c2-4 4-6 6-6s4 2 6 6c6 5 3 10-2 8-3-1-5-1-8 0-5 2-8-3-2-8Z" fill="currentColor"/><ellipse cx="7" cy="11" rx="3" ry="4" fill="currentColor" transform="rotate(-24 7 11)"/><ellipse cx="14" cy="6" rx="3" ry="4" fill="currentColor"/><ellipse cx="22" cy="7" rx="3" ry="4" fill="currentColor" transform="rotate(15 22 7)"/><ellipse cx="28" cy="14" rx="3" ry="4" fill="currentColor" transform="rotate(25 28 14)"/></svg>';

  class PetUI {
    constructor(app) {
      this.app = app;
      this.tab = 'owned';
      this.notice = '';
      this.promptSeen = new WeakMap();
      this.autoPrompts = true;
      this.assets = new Map();
      this.assetsPending = new Set();
      this.assetErrors = new Set();
      this.anchors = new Map();
      this.visualMs = 0;
      this.lastTime = null;
      this.lastDraws = [];
      this.wrap();
    }
    ownsModal() { return Boolean($('modal-root')?.querySelector('.pet-owned')); }
    nativeBlocked(allowOwnModal = false) {
      const a = this.app, s = a.game?.session;
      return !a.playing || !a.game?.pets || typeof a.game.petAction !== 'function' ||
        Boolean((typeof a.game.petBusy === 'function' ? a.game.petBusy() : a.state?.event || a.state?.paused || s?.memo || s?.replaying) ||
          a.offlineReturnBlocked || a.offlineSummaryOpen || a.offlineReplayReturn || a.offlineBackground ||
          a.journalPlayback || a.introFlow || a.ownWizard || a.recommendedReview || a.arrowFx?.active ||
          (a.modalOpen && !(allowOwnModal && this.ownsModal())));
    }
    read() {
      const context = this.app.game.petContext();
      return { context, view: this.app.game.pets.view(context) };
    }
    adults(context, config) {
      return (context.people || []).filter(person => person.alive !== false && Number(person.age) >= (config.adultAge ?? 18));
    }
    on(id, action) {
      const node = $(id);
      if (!node) return;
      this.app.button(id, () => {
        if (node.isConnected && !node.disabled && this.ownsModal()) return action();
      });
    }
    error(error) {
      const message = String(error?.message || error);
      if (!diagnostics.errors.includes(message)) diagnostics.errors.push(message);
      this.app.toast?.(`반려동물 표시 오류: ${message}`);
    }
    wrap() {
      const owner = this, a = this.app;
      const renderGame = a.renderGame;
      a.renderGame = function (...args) {
        const result = renderGame.apply(this, args);
        if (this === a) owner.inject();
        return result;
      };
      const renderScene = a.renderScene;
      a.renderScene = function (time, dt) {
        const result = renderScene.call(this, time, dt);
        if (this === a) {
          try { owner.paint(time); } catch (error) { owner.error(error); }
        }
        return result;
      };
      const closeModal = a.closeModal;
      a.closeModal = function (...args) {
        const wasOurs = owner.ownsModal();
        const result = closeModal.apply(this, args);
        if (this === a) owner.inject();
        if (this === a && wasOurs && !this.modalOpen) requestAnimationFrame(() => $('pet-menu')?.focus({preventScroll:true}));
        return result;
      };
      a.petUI = this;
      this.inject();
    }
    inject() {
      const a = this.app;
      if (!a.playing || !a.game?.pets || !a.el.querySelector('.day-line')) return;
      const view = a.state?.pets || this.read().view;
      const living = (view.pets || []).filter(pet => pet.status === 'alive');
      const unread = (view.pending || []).filter(event => !event.acknowledged).length;
      const actions = $('person-detail')?.closest('.member-right');
      let menu = $('pet-menu');
      if (actions) {
        actions.classList.add('pet-member-actions');
        if (!menu || menu.parentElement !== actions) {
          menu?.remove();
          menu = document.createElement('button');
          menu.type = 'button';
          menu.id = 'pet-menu';
          menu.className = 'member-more pet-access-button';
          actions.append(menu);
        }
        menu.innerHTML = `${paw}<span>반려동물</span>${unread ? `<b class="pet-access-count" aria-hidden="true">${unread}</b>` : ''}`;
        menu.setAttribute('aria-label', `반려동물 ${living.length}/${view.config?.capacity ?? 2}${unread ? `, 새 소식 ${unread}` : ''}`);
        menu.disabled = this.nativeBlocked();
        a.button('pet-menu', () => this.open('owned'));
      } else menu?.remove();
      requestAnimationFrame(() => this.maybePrompt());
    }
    maybePrompt() {
      if (this.app.petScenePresentation) { this.app.petScenePresentation.prompt(); return; }
      if (!this.autoPrompts || this.nativeBlocked()) return;
      const game = this.app.game, view = this.app.state?.pets;
      if (!view) return;
      let seen = this.promptSeen.get(game);
      if (!seen) { seen = new Set(); this.promptSeen.set(game, seen); }
      const event = (view.pending || []).find(item => !item.acknowledged && !seen.has(item.id));
      if (event && this.open('pending', true)) seen.add(event.id);
    }
    open(tab = 'owned', automatic = false) {
      if (this.nativeBlocked(true)) {
        if (!automatic) this.app.toast('가족의 사건과 기록을 마친 뒤에 만날 수 있어요.');
        return false;
      }
      this.tab = tab;
      this.show();
      return true;
    }
    show() {
      if (this.nativeBlocked(true)) return;
      const {context, view} = this.read();
      const tabs = [['owned','우리 동물'],['pending','소식'],['history','기록']];
      if (!tabs.some(([id])=>id===this.tab)) this.tab='owned';
      const pending = (view.pending || []).filter(event => !event.acknowledged).length;
      const content = this.tab === 'pending' ? this.pendingHTML(view) : this.tab === 'history' ? this.historyHTML(view) : this.ownedHTML(context, view);
      this.app.openModal('우리 집 반려동물', `<div class="pet-owned"><div class="pet-finance"><span>살림 <b>${esc(cash(context.money))}</b></span><span>월 기본급 합계 <b>${esc(cash(context.monthlyIncome))}</b></span></div><nav class="pet-tabs" aria-label="반려동물 메뉴">${tabs.map(([id,label]) => `<button type="button" id="pet-tab-${id}" aria-pressed="${this.tab === id}">${label}${id === 'pending' && pending ? ` <b>${pending}</b>` : ''}</button>`).join('')}</nav>${this.notice ? `<p class="pet-notice" role="status">${esc(this.notice)}</p>` : ''}${content}<p class="pet-policy-note">가족이 생활에 맞춰 작은 가족을 맞이하고, 온 가족이 함께 돌봐요. 이곳에서는 건강과 소식, 함께한 날들을 지켜볼 수 있어요.</p></div>`);
      $('modal-root').querySelector('.modal')?.classList.add('pet-modal');
      for (const [id] of tabs) this.on(`pet-tab-${id}`, () => { this.notice = ''; this.tab = id; this.show(); });
      if (this.tab === 'owned') this.bindOwned(context, view);
      if (this.tab === 'pending') this.bindPending(view);
    }
    ownedHTML(context, view) {
      const living = (view.pets || []).filter(pet => pet.status === 'alive');
      const archived = (view.pets || []).filter(pet => pet.status !== 'alive');
      const rows = living.map((pet,index) => {
        const {template,variant} = SK.PetAssets.entry(pet.templateId,pet.paletteId);
        const waiting = Number.isInteger(pet.nextCareDay) && context.today < pet.nextCareDay;
        const exhausted = pet.careRemainingThisMonth <= 0;
        const careNote=pet.illness?'건강을 회복하도록 가족이 함께 보살피고 있어요.':waiting?'산책과 놀이를 하며 가족과 일상을 보내고 있어요.':'온 가족과 함께 편안한 하루를 보내고 있어요.';
        return `<article class="pet-card"><div class="pet-card-top"><canvas id="pet-owned-image-${index}" width="132" height="118" aria-label="${esc(pet.name)} 모습"></canvas><div><div class="pet-card-title"><h3>${esc(pet.name)}</h3><span class="pet-health ${pet.illness ? 'is-ill' : ''}">${pet.illness ? '아파요' : '건강'} ${esc(pet.health)}</span></div><p>${esc(template.label)} · ${esc(variant.label)} · ${esc(pet.ageYears)}살</p><p>온 가족이 함께 돌봐요</p><p>월 유지비 ${esc(cash(pet.monthlyCost))}</p></div></div>${pet.arrears ? `<p class="pet-debt">아직 내지 못한 유지비 ${esc(cash(pet.arrears))}</p>` : ''}${pet.illness ? `<p class="pet-ill-note">몸을 돌보며 쉬고 있어요. 진료비 ${esc(cash(pet.treatmentCost))}</p>` : ''}<p class="pet-care-note">${esc(careNote)}</p></article>`;
      }).join('');
      return `${view.arrears ? `<p class="pet-debt">가족의 미납 유지비 합계 ${esc(cash(view.arrears))}</p>` : ''}${rows || '<div class="pet-empty"><span aria-hidden="true">♧</span><h3>아직 함께 사는 동물이 없어요.</h3><p>가족의 생활 속에 인연이 찾아오면<br>이곳에 작은 가족의 이야기가 쌓여요.</p></div>'}${archived.length ? `<section class="pet-archive"><h3>기억 속의 작은 가족</h3>${archived.map(pet => `<div><strong>${esc(pet.name)}</strong><span>${esc(pet.ageYears)}살 · ${pet.status === 'rehomed' ? '새 가정으로' : pet.cause === 'disease' ? '질병으로 이별' : '노령으로 이별'}</span></div>`).join('')}</section>` : ''}`;
    }
    bindOwned(context, view) {
      (view.pets || []).filter(pet => pet.status === 'alive').forEach((pet,index) => {
        this.thumbnail($(`pet-owned-image-${index}`),pet.templateId,pet.paletteId,pet.illness ? 11 : 0);
      });
    }
    pendingHTML(view) {
      return (view.pending || []).map(event => `<article class="pet-event"><p class="pet-event-date">${esc(dayText(event.day))}${event.acknowledged ? ' · 확인한 소식' : ' · 새 소식'}</p><h3>${esc(event.title)}</h3><p>${esc(event.text)}</p></article>`).join('') || '<div class="pet-empty"><h3>새로운 소식이 없어요.</h3><p>작은 가족과 평온한 하루를 보내세요.</p></div>';
    }
    bindPending(view) {
      let seen = this.promptSeen.get(this.app.game);
      if (!seen) { seen = new Set(); this.promptSeen.set(this.app.game, seen); }
      (view.pending || []).forEach(event => seen.add(event.id));
    }
    historyHTML(view) {
      const rows = (view.history || []).slice().reverse();
      return rows.length ? `<ol class="pet-history">${rows.map(event => `<li><time>${esc(dayText(event.day))}</time><strong>${esc(event.title)}</strong><p>${esc(event.text)}</p></li>`).join('')}</ol>` : '<div class="pet-empty"><h3>함께한 날을 여기 남겨요.</h3><p>입양과 돌봄, 건강과 이별의 기록이 쌓입니다.</p></div>';
    }
    thumbnail(canvas,templateId,paletteId,pose) {
      if (!canvas) return;
      const key = `${templateId}/${paletteId}/${pose}`;
      canvas.dataset.petImage = key;
      SK.PetAssets.get(templateId,paletteId).then(asset => {
        if (canvas.isConnected && canvas.dataset.petImage === key) SK.PetAssets.drawFrame(canvas,asset.canvas,asset.template.frames[pose]);
      }).catch(error => this.error(error));
    }
    requestAsset(pet) {
      const key = `${pet.templateId}/${pet.paletteId}`;
      if (!this.assets.has(key) && !this.assetsPending.has(key) && !this.assetErrors.has(key)) {
        this.assetsPending.add(key);
        SK.PetAssets.get(pet.templateId,pet.paletteId).then(asset => { this.assets.set(key,asset); this.assetsPending.delete(key); }).catch(error => { this.assetsPending.delete(key); this.assetErrors.add(key); this.error(error); });
      }
      return this.assets.get(key);
    }
    pose(pet,index) {
      if (pet.illness || pet.health <= 30) return {index:11,moving:false};
      const fraction = Number(this.app.dayFraction) || 0;
      if (fraction < .2 || fraction >= .9) return {index:7 + Math.floor(this.visualMs/1100)%2,moving:false};
      if (pet.lastCareDay === this.app.state?.pets?.today) return {index:9 + Math.floor(this.visualMs/320)%2,moving:false};
      const phase = mod(this.visualMs + index*7100,24000);
      if (phase < 8500) return {index:3 + Math.floor(this.visualMs/210)%4,moving:true};
      if (phase < 14000) return {index:Math.floor(this.visualMs/1300)%2,moving:false};
      if (phase < 18000) return {index:2,moving:false};
      return {index:7 + Math.floor(this.visualMs/1100)%2,moving:false};
    }
    paint(time) {
      const a = this.app;
      // Clear before every guard: an event or a removed last pet must never
      // leave the previous house-only presentation layer visible.
      const prior = $('house-pets-canvas');
      if (prior) {
        const context = prior.getContext('2d');
        context.setTransform(1,0,0,1,0,0);
        context.clearRect(0,0,prior.width,prior.height);
        prior.hidden = true;
      }
      this.lastDraws = [];diagnostics.lastDraws = [];
      const elapsed = this.lastTime == null ? 0 : clamp(Number(time)-this.lastTime,0,120);
      this.lastTime = Number(time);
      const prelude = a.nativeEventPresentation?.current;
      if (!a.playing || !a.state || a.state.event || (prelude && !prelude.done) || a.introFlow || a.recommendedReview || a.ownWizard || a.arrowFx?.active || a.journalPlayback || a.offlineBackground || a.offlineSummaryOpen || a.offlineReplayReturn) return;
      if (!a.modalOpen && !document.hidden && !a.state.paused && !matchMedia('(prefers-reduced-motion: reduce)').matches) this.visualMs += elapsed;
      const pets = (a.state.pets?.pets || []).filter(pet => pet.status === 'alive');
      const liveAssetKeys = new Set(pets.map(pet => `${pet.templateId}/${pet.paletteId}`));
      for (const key of this.assets.keys()) if (!liveAssetKeys.has(key)) this.assets.delete(key);
      const base = $('house-canvas');
      if (!base || !pets.length || !a.art?.house?.rooms) { this.lastDraws = []; return; }
      // Match the visible human layer's raster density. At normal zoom both
      // use native 240px pixels; zoom-out follows the native detail canvas.
      // Keep this pet-only layer separate so event guards can clear it safely.
      const box = base.getBoundingClientRect();
      const detail = $('house-detail-canvas'), scene = detail && !detail.hidden ? detail : base;
      if (box.width <= 0 || box.height <= 0) return;
      let target = prior;
      if (!target) {
        target = document.createElement('canvas');
        target.id = 'house-pets-canvas';target.className = 'house-pets-canvas';
        target.setAttribute('aria-hidden','true');base.parentElement.append(target);
      }
      const pixelWidth = scene.width, pixelHeight = scene.height;
      if (target.width !== pixelWidth) target.width = pixelWidth;
      if (target.height !== pixelHeight) target.height = pixelHeight;
      Object.assign(target.style,{left:base.offsetLeft+'px',top:base.offsetTop+'px',width:box.width+'px',height:box.height+'px',imageRendering:getComputedStyle(scene).imageRendering});
      target.hidden = false;
      const ctx = target.getContext('2d'), resolution = target.width/base.width, zoom = a.houseZoom();
      const worldWidth = a.art.house.width || 960, viewWidth = base.width/zoom;
      const actors = [...a.actors.values()].filter(actor => !actor.hidden && actor.room > 0);
      const rooms = a.art.house.rooms.map((bounds,index) => ({bounds,index})).filter(room => room.index > 0 && room.bounds?.length >= 4);
      const reserved = new Map(), draws = [];
      ctx.save();ctx.setTransform(resolution,0,0,resolution,0,0);ctx.scale(zoom,zoom);ctx.imageSmoothingEnabled=false;
      pets.forEach((pet,index) => {
        const asset = this.requestAsset(pet); if (!asset) return;
        const household=actors.slice().sort((one,two)=>one.id-two.id), companion=household[index%Math.max(1,household.length)], preferred=companion?.room;
        const previous = this.anchors.get(pet.id);
        const ordered = rooms.slice().sort((one,two) => {
          const score = room => (room.index === preferred ? -10000 : 0) + Math.abs(mod((room.bounds[0]+room.bounds[1])/2-a.scrollX,worldWidth)-viewWidth/2);
          return score(one)-score(two);
        });
        let location = null;
        for (const room of ordered) {
          const [left,right] = room.bounds, occupied = actors.filter(actor => actor.room === room.index);
          const used = reserved.get(room.index) || [];
          const candidates = [];
          const clear = x => !occupied.some(actor => x+17 > actor.x-1 && x-17 < actor.x+33) && !used.some(other => Math.abs(other-x)<36);
          if (previous?.room === room.index && previous.x >= left+18 && previous.x <= right-18 && clear(previous.x)) candidates.push(previous.x);
          for (let x=left+18;x<=right-18;x+=2) if (clear(x)) candidates.push(x);
          if (!candidates.length) continue;
          const desired = previous?.room === room.index ? previous.x : (left+right)/2;
          candidates.sort((x,y)=>Math.abs(x-desired)-Math.abs(y-desired));
          location = {room:room.index,bounds:room.bounds,x:candidates[0]};
          used.push(location.x);reserved.set(room.index,used);break;
        }
        if (!location) return;
        this.anchors.set(pet.id,{room:location.room,x:location.x});
        const pose = this.pose(pet,index), frame = asset.template.frames[pose.index], rect = frame.sourceRect;
        const scale = 1/8, width = rect[2]*scale, height = rect[3]*scale;
        const x = location.x + (pose.moving ? Math.sin(this.visualMs/1700 + index*Math.PI)*1.5 : 0);
        // Native humans: top=floor-61-8; opaque soles end at source row62
        // (exclusive63), so their visible foot edge is floor-6, not floor-8.
        // Pose crops include transparent padding; anchor measured visible paws.
        const footOffset = (frame.bboxAlphaGt16[3]-rect[1])*scale;
        const ground = location.bounds[3]-6, dy = ground-a.camY-footOffset;
        let sx = mod(x-a.scrollX,worldWidth);if(sx>viewWidth+32)sx-=worldWidth;
        if (sx+width/2<0 || sx-width/2>viewWidth || dy+height<0 || dy>base.height/zoom) return;
        const facingLeft = pose.moving && Math.cos(this.visualMs/1700 + index*Math.PI)<0;
        ctx.save();ctx.translate(sx,dy);if(facingLeft)ctx.scale(-1,1);ctx.drawImage(asset.canvas,rect[0],rect[1],rect[2],rect[3],-width/2,0,width,height);ctx.restore();
        draws.push({petId:pet.id,templateId:pet.templateId,paletteId:pet.paletteId,poseIndex:pose.index,pose:frame.pose,sourceRect:rect.slice(),sourceRectFormat:'xywh',room:location.room,world:{x,ground},footOffset,screenFootY:(ground-a.camY)*zoom,screen:{x:(sx-width/2)*zoom,y:dy*zoom,width:width*zoom,height:height*zoom},canvas:target.id,zoom,resolution});
      });
      ctx.restore();
      this.lastDraws = draws;diagnostics.lastDraws=draws;diagnostics.renderCount++;
    }
  }
  function installApp(app) {
    if (!app || installed.has(app)) return app;
    const controller = new PetUI(app);installed.set(app,controller);diagnostics.installed++;
    return app;
  }
  SK.PetUI = Object.freeze({installApp,open:(app,tab)=>installed.get(app)?.open(tab),diagnostics,controller:app=>installed.get(app)});
  const start = SK.startApp;
  if (typeof start === 'function') SK.startApp = function (...args) { const result=start.apply(this,args);return result&&typeof result.then==='function'?result.then(installApp):installApp(result); };
})(typeof window !== 'undefined' ? window : globalThis);

</script>
<script>
/* Pet-scoped full-scene presentation. The native VM/session is never a scene
 * queue: effects remain exclusively in PetBridge/PetRules transactions. */
(function (root) {
  'use strict';
  const SK = root.SK = root.SK || {}, installed = new WeakMap();
  const clone = value => JSON.parse(JSON.stringify(value));
  const kinds = ['adoption', 'care', 'illness', 'treatment', 'departure'];
  const diagnostics = { installed: 0, queued: 0, choices: 0, completed: 0, automaticResolutions: 0, blocked: 0, draws: [], errors: [] };
  const fail = reason => ({ok:false,reason,effects:{moneyDelta:0,moodDelta:0,stats:[]},events:[]});
  const $ = id => document.getElementById(id);
  const esc = value => String(value ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const fix = text => SK.OrigText?.FixJosa ? SK.OrigText.FixJosa(text) : text;
  function pagesFor(record, illnessOutcome = null) {
    const p = record.pet, e = record.event;
    if (e.kind === 'adoption') return [
      fix(`${p.name}이/가 새 보금자리에 도착했어!\n앞으로 함께할 날들이 기대되는걸♪`),
      `${p.name}의 새 보금자리가 생겼어!\n가족과 오래오래 행복하게 지내렴♪`];
    if (e.kind === 'care') return e.detail?.action === 'walk' ? [
      fix(`${p.name}이/가 가족과 산책을 나왔어!\n함께 걸으니 기분도 상쾌해 보여♪`),
      `${p.name}도 꼬리를 흔들며 즐거워해!\n오늘도 소중한 추억이 하나 늘었네♪`] : [
      fix(`${p.name}이/가 가족과 함께 놀고 있어!\n온 집안이 즐거워 보이는걸♪`),
      fix(`${p.name}와/과 보내는 다정한 시간!\n작은 놀이가 멋진 추억이 되었어♪`)];
    if (e.kind === 'illness') return [
      `${p.name}의 기운이 없어 보여…\n치료를 받고 푹 쉬어야 할 것 같아.`,
      illnessOutcome === 'home-care' ? `${p.name}의 진료비를 마련하기 어려워서\n지금은 집에서 조심히 돌보고 있어.` :
      illnessOutcome === 'home-treatment' ? fix(`${p.name}을/를 위해 가족이 집에서 돌볼 준비를 해.\n정성껏 보살펴서 기운을 되찾으면 좋겠어.`) :
        fix(`${p.name}이/가 가족과 병원에 갈 준비를 해.\n검진을 받고 기운을 되찾으면 좋겠어.`)];
    if (e.kind === 'treatment') return [
      record.treatmentRoute?.kind==='hospital' ? fix(`${p.name}이/가 병원에서 치료를 받았어!\n선생님이 꼼꼼하게 살펴봐 주었대.`) :
        fix(`${p.name}이/가 집에서 가족의 보살핌을 받았어!\n따뜻한 보살핌으로 기운을 되찾았대.`),
      `${p.name}의 건강이 다시 회복되었어♪\n가족도 한시름 놓은 것 같아!`];
    return [
      `${p.name}의 마지막 인사를 전할게…\n가족과 함께한 날들은 오래 기억될 거야.`,
      fix(`${p.name}와/과 나눈 따뜻한 추억을\n가족의 마음속에 소중히 간직하자.`)];
  }
  function titleFor(record) {
    const name=record.pet.name,kind=record.event.kind;
    return fix(kind==='adoption'?`${name}의 새 보금자리!`:
      kind==='care'?`${name}의 ${record.event.detail?.action==='walk'?'즐거운 산책!':'신나는 놀이!'}`:
      kind==='illness'?`${name}의 기운이 없어요…`:
      kind==='treatment'?(record.page===1?`${name}이/가 다시 건강해졌어요!`:
        record.treatmentRoute?.kind==='hospital'?`${name}의 병원 진료!`:`${name}의 회복을 응원해요!`):`${name}와/과 함께한 날들`);
  }
  // Reuse original audio bytes via SoundKit, not synthetic diagnostics or VM
  // music writes. Read-only ROM references: happy0x08900E40=>41,
  // illness0x08941670=>50, healthy0x08904620=>42. Pet stories are extensions.
  function audioFor(record) {
    return {song:['illness','departure'].includes(record.event.kind)?50:
      record.event.kind==='treatment'?42:41,source:'original-audio/pet-extension-direction'};
  }
  // Presentation-only scene direction. Rules, saved pages and scene ownership
  // do not depend on this palette, camera-facing pose or emotion animation.
  function visualFor(record) {
    const kind=record.event.kind;
    if(kind==='treatment' && record.treatmentRoute?.kind==='hospital')return {back:'ev_back_08888044',band:'ev_band_08887F10',emotion:'13',mood:'hospital-relief',pic:'ev_pic_088892C0',doctor:true};
    return kind==='illness' ? {back:'ev_back_08888044',band:'ev_band_08887EB0',emotion:'05',mood:'worried'} :
      kind==='departure' ? {back:'ev_back_08888094',band:'ev_band_08887F58',emotion:'05',mood:'grief'} :
      {back:'ev_back_08887F94',band:'ev_band_08887E98',emotion:kind==='care'?'02':kind==='treatment'?'13':'0B',mood:kind==='treatment'?'relief':'happy'};
  }
  // Original doctor-career outfit1 look/palette from the read-only asset audit;
  // the original short black hair parts distinguish this anonymous clinician.
  // This constant is composed by ArtLibrary only: no live SceneLook/VM call.
  const doctorLook=Object.freeze({"Body":10,"Face":8,"Hair":0,"Eyes":1,"Nose":8,"Mouth":1,"EyesFlip":false,"NoseFlip":false,"MouthFlip":false,"HairColor":0,"SkinColor":-1,"Outfit":2,"OutfitColor":-1,"Preset":"orig","OutfitBody":48,"Extra":0,"Gender":0,"PresetPalette":[-1,0,32767,31741,22226,13771,28607,24447,17086,11799,24191,21106,27449,9718,30384,16]});
  const sceneDoctor=event=>Boolean(event?.scene?.doctor);
  function attach(game, saved) {
    if (game.petScenes) return game;
    const original = {};
    for (const name of ['state','save','petBusy','petAction','syncPets','tickDay','advanceEvent','choose',
      'showDue','queueOfflineElapsed','recordOffline','_tryOffline','useItem','shoot']) original[name] = game[name];
    const history = game.pets.serialize().history;
    let data = {schema:'pet-presentation-v1',version:1,queue:[],seen:history.map(e=>e.id),deferredDue:null};
    if (saved != null) {
      if (saved.schema !== data.schema || saved.version !== 1 || !Array.isArray(saved.queue) || saved.queue.length > 512 ||
          !Array.isArray(saved.seen) || saved.seen.length > 2048 || saved.seen.some(id=>!/^pet-event:\d+$/.test(id)))
        throw Error('반려동물 사건 화면 저장 정보가 올바르지 않습니다.');
      for (const r of saved.queue) {
        if (!r || !kinds.includes(r.event?.kind) || !/^pet-event:\d+$/.test(r.event.id) ||
            r.event.petId !== r.pet?.id || typeof r.pet?.name !== 'string' || !Number.isInteger(r.page) || r.page < 0 || r.page > 1 ||
            typeof r.pet.templateId !== 'string' || typeof r.pet.paletteId !== 'string' ||
            (r.person != null && (!Number.isInteger(r.person.id) || typeof r.person.name !== 'string')) ||
            (r.household != null && (!Array.isArray(r.household) || r.household.length>8 || r.household.some(p=>!p||!Number.isInteger(p.id)||typeof p.name!=='string'))) ||
            ['preludeComplete','preludeCuePlayed'].some(key=>r[key]!==undefined&&typeof r[key]!=='boolean'))
          throw Error('반려동물 사건 화면 페이지가 손상되었습니다.');
        SK.PetAssets.entry(r.pet.templateId,r.pet.paletteId);
        const route=r.treatmentRoute;
        if (route != null && (r.event.kind!=='treatment' || route.version!==1 || !['hospital','home'].includes(route.kind) ||
            !['automatic','legacy'].includes(route.source) || route.source==='legacy' && route.kind!=='home' ||
            route.source==='automatic' && ['moneyBefore','monthlyIncome','fee','monthlyCost','reserveMonths','incomeMultiplier'].some(key=>!Number.isSafeInteger(route[key]) || route[key]<0)))
          throw Error('반려동물 치료 장면 저장 정보가 올바르지 않습니다.');
      }
      if (new Set(saved.queue.map(r=>r.event.id)).size !== saved.queue.length || new Set(saved.seen).size !== saved.seen.length)
        throw Error('반려동물 사건 화면이 중복되었습니다.');
      if (saved.deferredDue != null && (!Number.isFinite(saved.deferredDue) || saved.deferredDue < 0))
        throw Error('반려동물 사건 다음 순서가 올바르지 않습니다.');
      data = {...clone(saved),deferredDue:saved.deferredDue ?? null};
      for (const record of data.queue) if(record.event.kind==='treatment' && record.treatmentRoute==null)
        record.treatmentRoute={version:1,kind:'home',source:'legacy'};
    }
    let privileged = false;
    const seen = new Set(data.seen);
    const boundaryOptions = () => ({betweenEvents:data.deferredDue !== null});
    function boundaryBusy() { return original.petBusy.call(game,{betweenEvents:true}); }
    function nativeBusy() {
      const s = game.session;
      return original.petBusy.call(game,boundaryOptions()) || Boolean(s.cur || s.heavenCur || s.heavenWait?.length ||
        s.memo || s.replaying || game.pets.serialize().throughDay !== s.Family.Today ||
        game._offline?.active || game._offline?.pending?.length || original.state.call(game).event);
    }
    function active() { return data.queue.length > 0 && !nativeBusy() ? data.queue[0] : null; }
    function capture(event) {
      const native = original.state.call(game), pet = game.pets.serialize().pets.find(p=>p.id===event.petId);
      if (!pet) return null;
      const household=native.members.filter(p=>p.alive!==false).sort((a,b)=>a.id-b.id);
      const person=household[0]||null;
      return {event:clone(event),pet:clone(pet),person:person?clone(person):null,household:clone(household),page:0,preludeComplete:false,preludeCuePlayed:false,
        ...(event.kind==='treatment'?{treatmentRoute:clone(event.detail?.treatmentRoute || {version:1,kind:'home',source:'legacy'})}:{})};
    }
    function enqueue(events, force = false) {
      for (const event of events || []) {
        if (!event || (!force && seen.has(event.id))) continue;
        seen.add(event.id);
        if (!kinds.includes(event.kind) || data.queue.some(r=>r.event.id===event.id)) continue;
        if (['illness','departure'].includes(event.kind) && event.acknowledged && !force) continue;
        const record = capture(event);
        if (record) { data.queue.push(record); diagnostics.queued++; }
      }
      data.seen = [...seen].slice(-2048);
    }
    function prune() {
      const state = game.pets.serialize();
      data.queue = data.queue.filter(r=>!['illness','departure'].includes(r.event.kind) ||
        state.pending.some(e=>e.id===r.event.id && e.petId===r.pet.id));
    }
    const originalSessionShowDue = game.session.ShowDue;
    function resumeNative() {
      if (data.queue.length || data.deferredDue === null || boundaryBusy()) return false;
      const units = data.deferredDue;
      data.deferredDue = null;
      // Synchronous handoff: keep the native queue and its order, and do not
      // expose a home frame or advance the date between two event scenes.
      return originalSessionShowDue.call(game.session,units);
    }
    function automaticResolution(record, pending) {
      if (!pending) return {choice:null,outcome:null};
      if (pending.kind === 'departure') return {choice:pending.choices.includes('ack')?'ack':null,outcome:null};
      if (pending.kind !== 'illness') return {choice:null,outcome:null};
      const ctx=game.petContext(),config=game.pets.config,species=config.species[record.pet.species];
      const cost=species.treatmentCost,affordable=ctx.money>=cost;
      // Scene routing reads earned/current resources only. It never changes
      // the existing fee, grants credit, or predicts future salary.
      const hospital=affordable && (ctx.money>=cost+config.reserveMonths*species.monthlyCost ||
        ctx.monthlyIncome>=config.incomeMultiplier*species.monthlyCost);
      const route={version:1,kind:hospital?'hospital':'home',source:'automatic',moneyBefore:ctx.money,
        monthlyIncome:ctx.monthlyIncome,fee:cost,monthlyCost:species.monthlyCost,
        reserveMonths:config.reserveMonths,incomeMultiplier:config.incomeMultiplier};
      return {choice:affordable && pending.choices.includes('treat') ? 'treat' :
        !pending.acknowledged && pending.choices.includes('later') ? 'later' : null,
        outcome:affordable?(hospital?'hospital':'home-treatment'):'home-care',route};
    }
    const controller = game.petScenes = {
      active, nativeBusy, serialize:()=>clone(data),
      token() { const r=active();return r ? r.event.id+'/'+r.page : null; },
      markPreludeCue(record) {if(active()===record)record.preludeCuePlayed=true;},
      markPreludeComplete(record) {if(active()===record)record.preludeComplete=true;},
      view() {
        const r = active(); if (!r) return null;
        const pending = game.pets.serialize().pending.find(e=>e.id===r.event.id);
        const outcome = automaticResolution(r,pending).outcome;
        return {scope:'pet',eventId:'pet-scene:'+r.event.id,id:'pet-scene:'+r.event.id,petEventId:r.event.id,
          title:titleFor(r),text:pagesFor(r,outcome)[r.page],speaker:'큐피트',page:r.page,phase:'dialogue',
          choices:[],canAdvance:true,personId:r.person?.id ?? -1,petId:r.pet.id,
          audio:audioFor(r),prelude:r.page===0&&!r.preludeComplete?{scope:'pet',text:'가족에게 무슨 일이！？',personId:r.person?.id ?? -1,se:461,cuePlayed:!!r.preludeCuePlayed}:null,
          treatmentRoute:r.treatmentRoute?clone(r.treatmentRoute):null,
          scene:{petScoped:true,pic:r.event.kind==='care'&&r.event.detail?.action==='walk'?'ev_pic_08889060':'ev_pic_08888FE0',...visualFor(r)}};
      },
      pending(eventId) {
        if (active() || nativeBusy()) return false;
        const event = game.pets.serialize().pending.find(e=>e.id===eventId);
        if (!event) return false;
        enqueue([event],true);return Boolean(active());
      },
      next(token) {
        const r=active();if (!r || token!==this.token() || privileged) return false;
        if (r.page < 1) {r.page++;return true;}
        // A pet story is the same plain-next flow as an ordinary family scene.
        // Its final page commits the existing pending outcome exactly once;
        // no hidden choice handler or duplicate economy implementation exists.
        const pending=game.pets.serialize().pending.find(e=>e.id===r.event.id);
        const automatic=automaticResolution(r,pending);
        let result=null;
        if (automatic.choice) {
          privileged=true;
          try {result=original.petAction.call(game,'resolve',{eventId:r.event.id,choice:automatic.choice},boundaryOptions());}
          finally {privileged=false;}
          if (!result?.ok) return result;
          diagnostics.automaticResolutions++;
        }
        // Already-acknowledged, underfunded legacy illness has no 'later'
        // transaction left. Close its narrative once without replaying it.
        data.queue.shift();diagnostics.completed++;
        if (result) {
          const waiting = data.queue.length;
          enqueue(result.events);
          // Recovery is this illness story's direct continuation, not an
          // independent incident. Keep all other waiting scenes in FIFO order.
          if (automatic.choice === 'treat') {
            const ids = new Set((result.events || []).filter(e=>e.kind==='treatment' && e.petId===r.pet.id).map(e=>e.id));
            const added = data.queue.splice(waiting);
            for(const item of added) if(ids.has(item.event.id)) item.treatmentRoute=clone(automatic.route);
            data.queue.unshift(...added.filter(item=>ids.has(item.event.id)));
            data.queue.push(...added.filter(item=>!ids.has(item.event.id)));
          }
        }
        prune();resumeNative();return result || true;
      },
      choice() {return fail('반려동물 사건은 다음 대사로 이어집니다.');}

    };
    game.petBusy = function (options = {}) { return (!privileged && Boolean(active())) || original.petBusy.call(this,options); };
    game.syncPets = function (options = {}) {
      if (active()) return {ok:true,deferred:true,changed:false,effects:{moneyDelta:0,moodDelta:0,stats:[]},events:[]};
      const result=original.syncPets.call(this,options);enqueue(result?.events);prune();return result;
    };
    game.petAction = function (action,input={}) {
      if (action !== 'resolve') return fail('입양과 돌봄은 가족의 생활 속에서 자연스럽게 이어져요.');
      if (action === 'resolve') return fail('반려동물 소식은 사건 화면에서 이어집니다.');
      if (active()) {diagnostics.blocked++;return fail('반려동물 사건을 먼저 마쳐 주세요.');}
      const result=original.petAction.call(this,action,input);if(result?.ok){enqueue(result.events);prune();}return result;
    };
    game.state = function () {const state=original.state.call(this),view=controller.view();if(view){state.event=view;state.paused=true;}return state;};
    game.save = function () {const saved=original.save.call(this);saved.webUi=saved.webUi||{};saved.webUi.petPresentation=controller.serialize();return saved;};
    // A cold restore must still account for its absence. The original queue
    // owns that explicit resume boundary: its pending/memo preempts this view
    // without consuming or resetting our saved page. Blocking this entry would
    // lose throughMs and leave applyOfflineReturn unable to commit the window.
    game.queueOfflineElapsed = function (...args) {
      const result=original.queueOfflineElapsed.apply(this,args);prune();return result;
    };
    for (const name of ['tickDay','advanceEvent','choose','showDue','recordOffline','_tryOffline','useItem','shoot']) {
      if (typeof original[name] !== 'function') continue;
      game[name] = function (...args) {
        if (active()) {
          diagnostics.blocked++;
          return ['showDue','recordOffline','_tryOffline','useItem','shoot'].includes(name)?false:this.state();
        }
        const result=original[name].apply(this,args);prune();return ['tickDay','advanceEvent','choose'].includes(name)?this.state():result;
      };
    }
    game.session.ShowDue = function (units) {
      // WebGame.advanceEvent calls this seam after its current native scene
      // ends, before it starts the next pending one. A normal due-time call
      // reaches the same safe boundary. Never consume/reorder native queues.
      if (Number.isFinite(units) && units >= 0 && !boundaryBusy()) {
        const update = original.syncPets.call(game,{betweenEvents:true});
        enqueue(update?.events);prune();
        if (data.queue.length && game.pets.serialize().throughDay === this.Family.Today) {
          data.deferredDue = data.deferredDue === null ? units : data.deferredDue;
          return true;
        }
        if (data.deferredDue !== null) return resumeNative();
      }
      return originalSessionShowDue.call(this,units);
    };
    if (saved == null) enqueue(game.pets.serialize().pending.filter(e=>!e.acknowledged),true);
    prune();
    // Restore a saved boundary with no remaining pet scene without a menu tap.
    resumeNative();
    return game;
  }

  function installApp(app) {
    if (!app || installed.has(app)) return app;
    const old = {};
    for (const name of ['renderGame','renderScene','prepareEventArt','releaseEventDialogue','eventDialoguePending',
      'eventNext','eventChoice','syncMusic','dialogueHtml']) old[name]=app[name];
    const control={app,art:null,lastTime:null,visualMs:0,error:null};installed.set(app,control);diagnostics.installed++;
    const scoped=()=>app.state?.event?.scope==='pet' && app.game?.petScenes?.active();
    function guarded(token) {
      if (!scoped() || token!==app.game.petScenes.token() || !app.playing || app.modalOpen || document.hidden ||
          app.offlineBackground || app.offlineReturnBlocked || app.offlineSummaryOpen || app.offlineReplayReturn ||
          app.journalPlayback || app.introFlow || app.ownWizard || app.recommendedReview || app.arrowFx?.active || app.eventDialoguePending()) return false;
      const node=$('event-next');
      return !!node?.isConnected && !node.disabled && !node.closest('[hidden],[inert],[aria-hidden="true"]') &&
        getComputedStyle(node).visibility==='visible' && !!node.getClientRects().length;
    }
    function finish(token) {
      if (!guarded(token)) return false;
      app.resetDialogueAuto();
      const result=app.game.petScenes.next(token);
      if (!result || result.ok===false) {if(result?.reason)app.toast(result.reason);return false;}
      app.refresh();app.saveSlot('auto',true);return true;
    }
    control.prompt=function () {
      if (!app.playing || app.modalOpen || app.state?.event || app.offlineReturnBlocked || app.offlineBackground ||
          app.offlineSummaryOpen || app.offlineReplayReturn || app.journalPlayback || app.introFlow || app.ownWizard ||
          app.recommendedReview || app.arrowFx?.active) return false;
      const next=(app.state?.pets?.pending||[]).find(e=>!e.acknowledged);
      if (next && app.game?.petScenes?.pending(next.id)) {app.refresh();app.saveSlot('auto',true);return true;}
      return false;
    };
    control.fromAction=function (result) {
      if (!result?.ok || !app.game?.petScenes?.active()) return false;
      if (app.petUI?.ownsModal()) app.closeModal();
      app.refresh();app.saveSlot('auto',true);return true;
    };
    control.openPending=function (eventId) {
      if (!app.game?.petScenes?.pending(eventId)) return false;
      if (app.petUI?.ownsModal()) app.closeModal();
      app.refresh();app.saveSlot('auto',true);return true;
    };
    app.petScenePresentation=control;
    app.renderGame=function (...args) {
      const result=old.renderGame.apply(this,args);
      if(this===app && scoped()) {
        const token=app.game.petScenes.token(),next=$('event-next'),touch=$('event-advance');
        if(next)next.onclick=()=>{if(next.isConnected&&next===$('event-next'))finish(token);};
        if(touch)touch.onclick=()=>{if(touch.isConnected&&touch===$('event-advance')&&!touch.disabled)finish(token);};
        const shell=app.el.querySelector('.scene-shell');shell?.setAttribute('data-pet-event',app.state.event.petEventId);
      }
      return result;
    };
    app.eventNext=function (...args) {return this===app&&scoped()?finish(app.game.petScenes.token()):old.eventNext.apply(this,args);};
    app.eventChoice=function (index,...args) {return this===app&&scoped()?false:old.eventChoice.call(this,index,...args);};
    app.prepareEventArt=function (event) {
      if(this!==app || event?.scope!=='pet')return old.prepareEventArt.call(this,event);
      const detail=$('house-detail-canvas');if(detail)detail.hidden=true;
      const record=app.game.petScenes.active();if(!record)return false;
      const key=[record.event.id,record.pet.templateId,record.pet.paletteId,event.scene.back,event.scene.pic,event.scene.band,event.scene.emotion,event.scene.doctor?'doctor':''].join('/');
      if(control.art?.key!==key){
        const prepared=control.art={key,ready:false,error:null,asset:null,doctor:sceneDoctor(event)?app.art.look(doctorLook,35,2,0,true):null};
        const scene=event.scene;
        if(scene.doctor&&!prepared.doctor)throw (prepared.error=Error('병원 치료 장면의 원작 의사 모습이 준비되지 않았습니다.'));
        const names=[scene.back,scene.pic,scene.band,'ev_frame','ev_cupid'];
        for(const [frame] of app.art.backAnim[scene.back.replace(/^ev_back_/,'')] || [])
          if(frame>=0)names.push(scene.back+'_'+frame);
        for(const [frame] of app.art.emotion[scene.emotion] || [])
          if(frame>=0)names.push('ev_emo_'+scene.emotion+'_'+frame);
        prepared.names=[...new Set(names)];
        const images=prepared.names.map(name=>app.art.image(name));
        if(images.some(im=>!im)){prepared.error=Error('반려동물 사건의 원작 그림 자료가 없습니다.');}
        else Promise.all([Promise.all(images.map(im=>im.decode())),SK.PetAssets.get(record.pet.templateId,record.pet.paletteId)]).then(
          ([,asset])=>{prepared.asset=asset;prepared.ready=true;},error=>{prepared.error=error;});
      }
      if(control.art.error)throw control.art.error;
      return control.art.ready;
    };
    app.releaseEventDialogue=function(t){
      if(this!==app||!scoped())return old.releaseEventDialogue.call(this,t);
      if(!app.prepareEventArt(app.state.event))return;
      const dialog=app.el.querySelector('.scene-dialog[data-event-visual="pending"]');if(!dialog||dialog.dataset.releaseScheduled)return;
      const token=app.game.petScenes.token();dialog.dataset.releaseScheduled='1';
      requestAnimationFrame(()=>{if(!dialog.isConnected||token!==app.game?.petScenes?.token()||!scoped())return;
        dialog.dataset.eventVisual='ready';dialog.style.visibility='';dialog.inert=false;dialog.removeAttribute('aria-hidden');
        app.updateSceneDialog();app.syncDialogueVoice();});
    };
    app.renderScene=function(t,dt){
      if(this!==app||!scoped()){control.lastTime=null;return old.renderScene.call(this,t,dt);}
      const record=app.game.petScenes.active();
      if((app.state.event.prelude&&!record?.preludeComplete)||app.nativeEventPresentation?.current?.customPet&&!app.nativeEventPresentation.current.done){
        control.lastTime=null;return old.renderScene.call(this,t,dt);
      }
      const canvas=$('house-canvas');if(!canvas)return;
      const pets=$('house-pets-canvas');if(pets){pets.getContext('2d').clearRect(0,0,pets.width,pets.height);pets.hidden=true;}
      const detail=$('house-detail-canvas');if(detail)detail.hidden=true;
      app.el.querySelector('#native-event-announcement')?.remove();
      for(const node of app.el.querySelectorAll('.scene-tip,.family-chatter'))node.hidden=true;
      if(!app.prepareEventArt(app.state.event)){control.lastTime=t;return;}
      const elapsed=control.lastTime==null?0:Math.max(0,Math.min(100,t-control.lastTime));control.lastTime=t;
      if(app.running&&!app.modalOpen&&!document.hidden&&!app.offlineBackground&&!root.matchMedia?.('(prefers-reduced-motion: reduce)').matches)control.visualMs+=elapsed;
      const ctx=canvas.getContext('2d'),e=app.state.event,r=app.game.petScenes.active(),scene=e.scene;
      const pose=r.event.kind==='illness'?11:r.event.kind==='departure'?7:r.event.kind==='care'&&r.event.detail?.action==='walk'?3+Math.floor(control.visualMs/220)%4:9+Math.floor(control.visualMs/500)%2;
      const asset=control.art.asset,frame=asset.template.frames[pose],rect=frame.sourceRect;
      ctx.save();ctx.setTransform(1,0,0,1,0,0);ctx.globalAlpha=1;ctx.imageSmoothingEnabled=false;
      ctx.fillStyle='#172c30';ctx.fillRect(0,0,240,160);
      const animationFrames=Math.floor(control.visualMs*.06),backFrame=app.art.frame(app.art.backAnim,scene.back.replace(/^ev_back_/,''),animationFrames);
      app.draw(ctx,app.art.image(backFrame>=0?scene.back+'_'+backFrame:scene.back),0,0,240,160);
      app.draw(ctx,app.art.image(scene.pic),56,40,128,64);
      app.draw(ctx,app.art.image('ev_frame'),0,0,240,160);
      if(scene.doctor)app.draw(ctx,control.art.doctor,66,36,32,64);
      const household=(r.household||[r.person]).filter(Boolean).slice(0,2),caregiverX=household.length>1?90:104,caregiverPose=2,caregiverMirror=true;
      household.forEach((person,index)=>app.draw(ctx,app.art.look(person.look,person.age,caregiverPose,app.state.family.era||0,caregiverMirror)||app.art.figure(person,caregiverPose,app.state.family.era||0),caregiverX+index*23,36,32,64));
      const scale=1/8,width=rect[2]*scale,height=rect[3]*scale,footOffset=(frame.bboxAlphaGt16[3]-rect[1])*scale,ground=99,walk=r.event.kind==='care'&&r.event.detail?.action==='walk',petCenter=151+(walk?Math.sin(control.visualMs/800)*9:0),x=petCenter-width/2,y=ground-footOffset;
      const petMirror=r.event.kind!=='illness'&&!(r.event.kind==='care'&&r.event.detail?.action==='walk');
      ctx.save();ctx.beginPath();ctx.rect(56,40,128,64);ctx.clip();
      if(petMirror){
        ctx.translate(x+width,y);ctx.scale(-1,1);
        ctx.drawImage(asset.canvas,rect[0],rect[1],rect[2],rect[3],0,0,width,height);
      }else ctx.drawImage(asset.canvas,rect[0],rect[1],rect[2],rect[3],x,y,width,height);
      ctx.restore();
      // Keep a fully formed native expression visible even if paused during
      // a native bubble entrance/exit; active native frames still animate.
      const rawEmotionFrame=app.art.frame(app.art.emotion,scene.emotion,animationFrames+8);
      const emotionFrame=rawEmotionFrame>=2&&rawEmotionFrame<=4?rawEmotionFrame:2;
      const emotionName='ev_emo_'+scene.emotion+'_'+emotionFrame;
      const emotion=app.art.emotionImage(emotionName),crop=app.art.emotion.crop||[0,33,37,39];
      const placement=emotion?.skEmotionPlacement||{x:crop[0],y:crop[1],width:crop[2],height:crop[3]};
      const caregiverBubbleRect=r.person?{x:caregiverX+placement.x-8,y:placement.y,width:placement.width,height:placement.height}:null;
      if(caregiverBubbleRect)app.draw(ctx,emotion,caregiverBubbleRect.x,caregiverBubbleRect.y,caregiverBubbleRect.width,caregiverBubbleRect.height);
      // Draw the original expression at native1x: fractional downscaling drops
      // outline/icon pixels even with smoothing disabled. Only move the bubble
      // above the pet; keep its aspect and each source pixel intact.
      const petHeadTop=y+(frame.bboxAlphaGt16[1]-rect[1])*scale;
      const petBubbleRect={x:138,y:Math.max(31,Math.floor(petHeadTop)-placement.height-2),width:placement.width,height:placement.height};
      app.draw(ctx,emotion,petBubbleRect.x,petBubbleRect.y,petBubbleRect.width,petBubbleRect.height);
      app.draw(ctx,app.art.image(scene.band),0,0,240,30);app.renderEventTitle(e.title,0,true);
      app.draw(ctx,app.art.image('ev_cupid'),8,64,32,40);
      canvas.skCupidAnchor={speaker:'큐피트',x:24,y:80,width:240,height:160};
      canvas.dataset.petScene=e.petEventId;canvas.dataset.petScenePage=String(e.page);canvas.dataset.petSceneKind=r.event.kind;
      diagnostics.draws=[{eventId:r.event.id,kind:r.event.kind,personId:r.person?.id,householdIds:household.map(p=>p.id),petId:r.pet.id,pose,petScale:scale,personFootY:99,petFootY:ground,petRect:{x,y,width,height},petMirror,petFacing:petMirror?'toward-caregiver':'original',treatmentRoute:r.treatmentRoute?clone(r.treatmentRoute):null,doctor:Boolean(scene.doctor),doctorOutfitBody:scene.doctor?doctorLook.OutfitBody:null,doctorX:scene.doctor?66:null,pic:scene.pic,mood:scene.mood,back:scene.back,backFrame,band:scene.band,caregiverX,caregiverPose,caregiverMirror,facing:'toward-pet',emotionName,emotionFrame,rawEmotionFrame,caregiverBubbleRect,petEmotionName:emotionName,petEmotionFrame:emotionFrame,petEmotionScale:1,petBubbleRect,petHeadTop,visualMs:control.visualMs}];
      ctx.restore();app.releaseEventDialogue(t);
    };
    app.syncMusic=function(...args) {
      if(this!==app||!scoped()||app.modalOpen||app.nativeEventPresentation?.current?.customPet&&!app.nativeEventPresentation.current.done)
        return old.syncMusic.apply(this,args);
      const r=app.game.petScenes.active();
      if(r&&!r.preludeComplete&&r.page===0)return old.syncMusic.apply(this,args);
      return app.sound.playBgm(audioFor(r).song,{fadeIn:.15,fadeOut:.5});
    };
    // Custom copy is explicitly pet-scoped metadata, never a native text decode.
    app.dialogueHtml=function(view,intro){
      let html=old.dialogueHtml.call(this,view,intro);
      if(view?.scope==='pet')html=html.replace('class="scene-dialog"','class="scene-dialog" data-pet-scene="'+esc(view.petEventId)+'"');
      return html;
    };
    return app;
  }
  SK.PetScenes={attach,installApp,diagnostics,pagesFor,titleFor,visualFor,audioFor,controller:app=>installed.get(app)};
  const create=SK.createGame,restore=SK.restoreGame;
  SK.createGame=function(...args){return attach(create.apply(this,args));};
  SK.restoreGame=function(saved){const value=typeof saved==='string'?JSON.parse(saved):saved;return attach(restore.call(this,value),value?.webUi?.petPresentation);};
  const start=SK.startApp;
  if(typeof start==='function')SK.startApp=function(...args){const value=start.apply(this,args);return value&&typeof value.then==='function'?value.then(installApp):installApp(value);};
})(globalThis);

</script>
<script>
(function () {
  "use strict";
  function showError(error) {
    console.error(error);
    const target =
      document.querySelector("#loading") ||
      document.querySelector("#app") ||
      document.body;
    const panel = document.createElement("section");
    panel.setAttribute("role", "alert");
    panel.style.cssText =
      "padding:24px;white-space:pre-wrap;line-height:1.7;color:#922c25;background:#fff8eb";
    panel.textContent =
      "게임을 시작하지 못했습니다.\n" + (error.message || String(error));
    target.replaceChildren(panel);
  }
  async function boot() {
    try {
      await SK.ready;
      if (typeof SK.startApp !== "function")
        throw new Error("화면 소스가 불러와지지 않았습니다.");
      await SK.startApp();
      SK.appReady = true;
    } catch (error) {
      showError(error);
    }
  }
  if (document.readyState === "loading")
    document.addEventListener("DOMContentLoaded", boot, { once: true });
  else boot();
})();

</script>
  </body>
</html>
