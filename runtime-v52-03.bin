  }
  const nameOf = SK.OrigSession.prototype.NameOf;
  SK.OrigSession.prototype.NameOf = function (id, gender) {
    // Existing aliases win even after registry removal or a later registration.
    if (this.Family.OrigNames[id]) return this.Family.OrigNames[id];
    const meta = this._nameBook, trace = meta?.births[id], actual = trace && !meta.known[id] && newborn(this, Number(id), trace);
    if (actual && (gender < 0 || gender === actual.gender)) {
      const pool = meta.entries.filter(e => e.gender === actual.gender && trace.eligibleIds.includes(e.id));
      if (pool.length) {
        const used = new Set(Object.values(this.Family.OrigNames));
        for (const person of this.Family.Members || []) if (person.Name) used.add(person.Name);
        let selected = pool.find(e => !used.has(e.name));
        if (!selected) {
          const uses = entry => Object.values(meta.assignments).filter(a => a.entryId === entry.id).length;
          selected = pool.reduce((best, entry) => uses(entry) < uses(best) ? entry : best);
        }
        this.Family.OrigNames[id] = selected.name;
        meta.assignments[id] = { entryId: selected.id, name: selected.name };
        meta.known[id] = true;
        return selected.name;
      }
    }
    const result = nameOf.call(this, id, gender);
    if (meta && validId(Number(id))) meta.known[id] = true;
    return result;
  };
  const create = SK.createGame, restore = SK.restoreGame, save = SK.WebGame.prototype.save;
  SK.createGame = function (...args) { return attachQuery(create.apply(this, args), null); };
  SK.restoreGame = function (saved, ...args) {
    const decoded = typeof saved === 'string' ? JSON.parse(saved) : saved;
    return attachQuery(restore.call(this, decoded, ...args), decoded?.nameBook);
  };
  SK.WebGame.prototype.save = function (...args) {
