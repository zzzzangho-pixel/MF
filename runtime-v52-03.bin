      moneyAdvice: messageIn(query, moneyMessage(cash)),
      houseAdvice: messageIn(query, 136 + grade + 4 * era), carAdvice: messageIn(query, 152 + Math.min(4, carId)),
      budgetAdvice: messageIn(query, budgetMessage(total)),
