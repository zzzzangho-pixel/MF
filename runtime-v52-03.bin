  const DATA = {"0,0":["부모 흉내에 푹 빠졌어！","{이름0}은/는 부모가 하는 일을\n유심히 보고 줄곧 따라 하고 있어．\n（매력↑↓ 변화 무드↑↓ 변화）"],"0,1":["움직이는 것에 푹 빠졌어！","갓 태어난 아기는\n움직이는 물건을 즐거운 듯 바라봐．\n（체력↑↓ 변화 하트↑ 상승）"],"0,2":["낮잠에 푹 빠졌어！","새근새근 낮잠을 자며 기운을 모으면\n몸이 쑥쑥 자랄지도 몰라．\n（체력↑ 상승 하트↑ 상승）"],"0,3":["우유에 푹 빠졌어！","우유는 아기에게 힘을 주는 원천이야！\n많이 마시고 무럭무럭 자라．\n（체력↑↓ 변화 하트↑ 상승）"],"0,4":["뭐든 만져 보고 싶어！","{이름0}은/는 「이건 뭘까？」 하며\n여러 물건을 만지고 있어．\n（지력↑↓ 변화 무드↑↓ 변화）"],"0,5":["마음을 전하고 싶어！","자기 마음을 전하고 싶어서\n가족을 빤히 바라보고 있어！\n（무드↑↓ 변화 하트↑↓ 변화）"],"0,6":["그림책에 푹 빠졌어！","{이름0}은/는 가족에게 졸라서\n늘 그림책을 읽어 달라고 해！\n（지력↑↓ 변화）"],"0,7":["집 안 물건에 호기심 가득！","호기심으로 가득한 {이름0}은/는\n집 안을 이리저리 돌아다녀！\n（지력↑↓ 변화 하트↑↓ 변화）"],"0,8":["엄마 젖 먹고 싶어！","엄마가 정말 좋아！\n엄마 젖도 정말 좋아하는 모양이야♪\n（체력↑ 상승）"],"0,9":["기어 다니고 싶어！","아기가 능숙하게 움직이는 기술…\n그게 바로 기어 다니기야！\n（체력↑ 상승 하트↑ 상승）"],"0,10":["방구석이 신경 쓰여…","어째선지 {이름0}은/는 방구석이\n무척 신경 쓰이는 모양이야…\n（하트↑↓ 변화）"],"0,11":["거울이 신경 쓰여…","{이름0}은/는 거울에 비친 자기 모습을 보고\n무척 신기하게 여기는 모양이야！\n（지력↑ 상승 하트↑↓ 변화）"],"0,12":["온갖 것에 호기심 가득！","{이름0}은/는 여러 가지에 관심을 갖고\n이것저것 자기 눈과 손으로 확인하고 \n있어！（하트↑ 상승）"],"0,13":["심부름에 호기심 가득！","{이름0}은/는 심부름을 해서\n가족을 돕고 싶대！\n（능력↑↓ 변화 하트↑ 상승）"],"0,14":["역할놀이에 푹 빠졌어！","소꿉놀이와 캐릭터 놀이…\n친구들과 역할놀이를 즐기고 있어！\n（매력↑↓ 변화）"],"0,15":["숨바꼭질에 푹 빠졌어！","숨고 찾고…\n여기저기 뛰어다니니 정말 씩씩하구나．\n（체력↑ 상승 하트↑↓ 변화）"],"0,16":["생물에 호기심 가득！","{이름0}은/는 생물에 관심을 갖고\n언제까지나 즐거운 듯 바라보고 있어♪\n（능력↑ 상승）"],"0,17":["탈것에 푹 빠졌어！","{이름0}은/는 멋진 탈것에\n완전히 마음을 빼앗긴 모양이야．\n（지력↑↓ 변화 하트↑↓ 변화）"],"0,18":["주사가 싫어！","뾰족한 바늘이 콕 찌르는…\n그런 주사가 정말 싫대…\n（하트↑↓ 변화）"],"0,19":["그림 그리기에 푹 빠졌어！","{이름0}은/는 상상력을 펼치며\n그림을 잔뜩 그리고 있어♪\n（매력↑ 상승 무드↑↓ 변화）"],"0,20":["새 장난감이 갖고 싶어！","{이름0}은/는 새 장난감을 갖고 싶어서\n가족에게 줄곧 떼를 쓰고 있어…\n（능력↑↓ 변화 하트↑↓ 변화）"],"0,21":["친구가 부러워！","친구들이 부러워서\n무엇이든 갖고 싶대．\n（하트↑↓ 변화）"],"0,22":["장난에 푹 빠졌어！","{이름0}은/는 가족을 곤란하게 하는\n민폐 장난에 푹 빠졌어！\n（지력↑ 상승 무드↓ 하락）"],"0,23":["오디션에 호기심 가득！","{이름0}은/는 잡지 독자 모델\n오디션에 도전할 모양이야！\n（매력↑↓ 변화 하트↑ 상승）"],"0,24":["사인 연습에 푹 빠졌어！","자기만의 독특한 사인을 만들면\n기분만큼은 연예인이 될지도 몰라！？\n（매력↑↓ 변화 하트↑↓ 변화）"],"0,25":["프로 야구 경기에 푹 빠졌어！","멋진 프로 야구 선수를 동경해서\n직접 경기를 보고 싶어 해．\n（하트↑ 상승）"],"0,26":["달리기 시합에 푹 빠졌어！","달리기를 아주 좋아하는 {이름0}은/는\n언제나 모두와 달리기 시합을 해．\n（체력↑ 상승）"],"0,27":["야구에 호기심 가득！","팀원 모두가 하얀 공을 뒤쫓는…\n그런 야구에 관심이 생긴 모양이야．\n（하트↑↓ 변화）"],"0,28":["노래 부르는 걸 좋아해！","노래 부르기를 좋아하는 {이름0}은/는\n자기 노래를 들려주고 싶어 해．\n（매력↑↓ 변화 하트↑ 상승）"],"0,29":["스포츠에 푹 빠졌어！","스포츠라면 무엇이든 좋아！\n몸을 움직이는 게 즐거운 모양이야♪\n（체력↑ 상승 하트↑↓ 변화）"],"0,30":["집안일 돕기에 호기심 가득！","{이름0}은/는 집안일을 도와\n가족을 기쁘게 하고 싶어 해！\n（무드↑↓ 변화 하트↑↓ 변화）"],"0,31":["모르는 걸 알고 싶어！","{이름0}은/는 모르는 것이 생기면\n무엇이든 이유를 알고 싶어 해♪\n（지력↑ 상승 하트↑ 상승）"],"0,32":["몸의 성장 때문에 고민이야…","어른처럼\n빨리 크고 싶어 해．\n（체력↑↓ 변화）"],"0,33":["게임에 푹 빠졌어！","시간 가는 줄도 모를 만큼 빠져서\n게임만 하며 놀고 있어．\n（하트↑ 상승）"],"0,34":["아이돌에 푹 빠졌어！","{이름0}은/는 텔레비전에 나오는\n반짝이는 아이돌에게 완전히 빠졌어♪\n（매력↑ 상승 하트↑↓ 변화）"],"0,35":["집안일에 호기심 가득！","청소… 빨래… 장보기…\n집안일을 도와 보고 싶대！\n（무드↑↓ 변화 하트↑↓ 변화）"],"0,36":["ＴＶ에 푹 빠졌어！","모두의 화제에 뒤처지지 않으려고\n텔레비전에 푹 빠졌어！\n（지력↑↓ 변화 하트↑↓ 변화）"],"0,37":["공상에 푹 빠졌어！","머릿속으로 이런저런 생각을 하는 건…\n자기만의 은밀한 즐거움이야♪\n（하트↑ 상승）"],"0,38":["우주의 신비에 호기심 가득！！","끝없이 펼쳐진 우주에는 신비가 가득해！\n우주의 신비를 더 알고 싶어 해．\n（지력↑ 상승 하트↑ 상승）"],"0,39":["눈에 띄는 사람이 되고 싶어！","{이름0}은/는 한껏 눈에 띄어서\n모두의 관심을 끌려고 해！\n（매력↑↓ 변화 하트↑↓ 변화）"],"0,40":["어른의 세계에 호기심 가득！","어른의 세계가 궁금한 {이름0}은/는\n빨리 어른이 되고 싶대！\n（하트↑↓ 변화）"],"0,41":["나쁜 녀석이 될 거야！","모두가 두려워할 만한\n나쁜 남자가 되고 싶어 해．\n（매력↑↓ 변화 하트↑ 상승）"],"0,42":["몸의 성장이 신경 쓰여…","{이름0}은/는 자기 몸의 성장 상태가\n조금 불안한 모양이야…\n（체력↑ 상승 하트↑↓ 변화）"],"0,43":["봉사 활동에 푹 빠졌어！","남에게 도움이 되는 일을 하고 싶어서\n봉사 활동에 참여하고 있어．\n（매력↑ 상승 하트↑↓ 변화）"],"0,44":["우리 집 저녁밥이 신경 쓰여…","배가 몹시 고픈 채 집에 돌아오는 \n{이름0}은/는 저녁밥을 기대하고 있어♪\n（하트↑↓ 변화）"],"0,45":["세상을 더 좋게 만들고 싶어！","세상의 여러 모순이 신경 쓰여서…\n세상을 더 좋게 만들고 싶어 해！\n（하트↑↓ 변화）"],"0,46":["화장에 푹 빠졌어！","화장해서 아름답고 어른스러운 여자로\n변신하고 싶어 해．\n（매력↑↓ 변화 하트↑ 상승）"],"0,47":["나 자신 때문에 고민이야…","나는 대체 어떤 사람일까…\n{이름0}은/는 머리를 싸매고 고민하고 있어…\n（매력↑ 상승 하트↓ 하락）"],"0,48":["여러 책을 읽는 데 푹 빠졌어！","{이름0}은/는 책을 닥치는 대로 읽고 있어．교양을\n쌓는 데는 독서가 가장 좋을지도 몰라！\n（지력↑↓ 변화）"],"0,49":["인기 만점이 되고 싶어！","언제나 이성의 시선을 의식하고 싶어！\n무슨 수를 써서라도 인기를 얻고 싶어 해．\n（매력↑↓ 변화 하트↑↓ 변화）"],"0,50":["유행하는 가게에 가고 싶어！","멋진 물건이 빼곡히 진열된\n유행하는 가게에 가고 싶대！\n（매력↑ 상승 하트↑↓ 변화）"],"0,51":["젊음을 유지하는 데 푹 빠졌어！","언제까지나 젊고 생기 넘치고 싶어！\n젊음을 지키려고 필사적이야♪\n（매력↑↓ 변화 하트↑↓ 변화）"],"0,52":["파란만장하게 살아 보고 싶어！","{이름0}은/는 날마다 사건이 가득한\n자극적인 생활을 하고 싶대！\n（하트↑↓ 변화）"],"0,53":["마음 내키는 대로 살아 보고 싶어！","{이름0}은/는 남의 시선을 신경 쓰지 않고\n자유롭게 살아가고 싶대！\n（하트↑ 상승）"],"0,54":["향상심이 폭발하는 중！","{이름0}은/는 자신을 갈고닦고 싶어져서\n의욕이 잔뜩 솟아난 모양이야！\n（능력↑ 상승）"],"0,55":["양치질에 푹 빠졌어！","{이름0}은/는 매일 이를 닦으며\n반짝이는 미소를 목표로 삼았어♪\n（매력↑ 상승）"],"0,56":["사랑 이야기에 호기심 가득！","친구의 연애 이야기가 무척 궁금해！\n자기 연애에도 도움이 될지도 몰라．\n（능력↑↓ 변화）"],"0,57":["스포츠에 푹 빠졌어！","몸을 마음껏 움직이며\n상쾌하게 땀을 흘리고 있어！\n（체력↑ 상승 하트↑↓ 변화）"],"0,58":["잡학 지식에 푹 빠졌어！","살아가는 데 전혀 필요 없는 지식…\n그게 바로 잡학이야！\n（지력↑ 상승 매력↑↓ 변화）"],"0,59":["세상을 더 좋게 만들고 싶어！","세상의 여러 모순이 신경 쓰여서…\n세상을 더 좋게 만들고 싶어 해！\n（하트↑↓ 변화）"],"0,60":["세상 뉴스가 신경 쓰여…","{이름0}은/는 세상일이 궁금해서\n많은 뉴스를 확인하고 있어！\n（지력↑↓ 변화）"],"0,61":["기계 만지기에 푹 빠졌어！","기계 만지기에 푹 빠진 {이름0}은/는\n집의 자동차도 만져 보고 싶대！\n（지력↑↓ 변화 하트↑↓ 변화）"],"0,62":["장래 일을 망상 중！","{이름0}은/는 자기 미래를 두고\n근거 없는 상상을 부풀리고 있어！\n（하트↑↓ 변화）"],"0,63":["사랑 이야기에 호기심 가득！","친구의 연애 이야기가 무척 궁금해！\n자기 연애에도 도움이 될지도 몰라．\n（능력↑↓ 변화）"],"0,64":["최신 유행은 어려워…","유행에 뒤처진 자신이 신경 쓰이지만\n{이름0} 나름대로 노력하고 있어！\n（매력↑↓ 변화 하트↑↓ 변화）"],"0,65":["ＴＶ 프로그램에 푹 빠졌어！","{이름0}은/는 텔레비전에 푹 빠져서\n방송에 꽤 많은 영향을 받는 모양이야！\n（하트↑↓ 변화）"],"0,66":["사후 세계가 궁금해…","사람이 죽으면 대체 어떻게 되는 \n걸까？너무나 신기해서 견딜 수가 없대．\n（지력↑ 상승 하트↑ 상승）"],"0,67":["영화를 좋아해！","영화 보는 걸 정말 좋아해！\n영화에 관해 더 잘 알고 싶어 해．\n（하트↑↓ 변화）"],"0,68":["인간에 대해 고민이야…","사람은 무엇을 위해 사는 걸까…\n그런 문제로 머리를 싸매고 있어．\n（지력↑ 상승 하트↑ 상승）"],"0,69":["밝은 사람이 되고 싶어…","어두운 자신을 어디엔가 버리고\n환하고 밝은 사람이 되고 싶어 해．\n（매력↑↓ 변화 하트↑ 상승）"],"0,70":["이야기 쓰기에 푹 빠졌어！","자기가 생각한 멋진 이야기를\n비밀 공책에 쓰고 있는 모양이야．\n（지력↑↓ 변화）"],"0,71":["소설 읽기에 푹 빠졌어！","재미있는 소설에 푹 빠져\n시간 가는 줄도 모르는 모양이야．\n（지력↑ 상승 체력↑↓ 변화）"],"0,72":["섹시 화보에 푹 빠졌어！","{이름0}은/는 몰래 가족의 눈을 피해\n섹시 화보집에 푹 빠졌어！\n（하트↑↓ 변화）"],"0,73":["섹시 화보에 푹 빠졌어！","{이름0}은/는 몰래 가족의 눈을 피해\n섹시 화보집에 푹 빠졌어！\n（하트↑↓ 변화）"],"0,74":["어른의 놀이에 호기심 가득！","어른의 놀이를 즐기고 싶다며\n{이름0}은/는 몸이 근질근질한가 봐．\n（매력↑↓ 변화 하트↑↓ 변화）"],"0,75":["미팅에 푹 빠졌어！","성인 남녀가 만나는 자리…\n그게 바로 미팅이야！\n（연인이 생길지도？ 하트↑↓ 변화）"],"0,76":["호화로운 생활을 하고 싶어！","돈 