          while (spot < 7 && used.has(spot)) spot++;
          a.spot = spot;
          const position = this.game.session.RoomSpot(ri, spot);
          a.nativeAnchor = Number.isFinite(position?.x) ? position.x : (r[0] + r[1]) / 2 - 16;
          const outside = Number(v(plan, "kind", -1)) === 5;
          a.anchor = clamp(a.nativeAnchor, r[0], Math.max(r[0], r[1] - 32));
          a.target = outside ? a.nativeAnchor : a.anchor;
