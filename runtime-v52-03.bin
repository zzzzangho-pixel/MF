          SK.WebHouseClock.fromFraction(this.dayFraction),
        ),
        im = this.art.selectHouse(
          Number(f.era || 0),
          Number(f.grade || 0),
          slot,
        ),
        h = this.art.house,
        W = h.width || 960,
        H = h.height || 160;
