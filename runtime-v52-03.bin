    isCupidLesson(e) {
      // Native Help pages have State -2 and a message identity 1000 + HelpId.
      // Keep detection independent of the renderer's display-only EventId.
      const page = this.game?.session?.heavenCur?.[this.game.session.heavenPage];
      return e?.nativeHelp != null || page?.State === -2 ||
        e?.eventId === "cupid-help";
    }
    isNativeHeaven(e) {
      return (e?.eventId || e?.EventId) === "heaven" && !this.isCupidLesson(e);
    }
    prepareEventArt(e) {
      const scene = e.scene || e.Scene || {},
        pic = v(scene, "pic", e.pic || ""),
        back = v(scene, "back", e.back || ""),
        band = v(scene, "band", e.band || "");
      if (!pic && this.isNativeHeaven(e) && !this.heavenArt) {
        const prepared = this.heavenArt = { ready: false, error: null, scene: null },
          loading = this.introScene && !this.introScene.disposed
            ? Promise.resolve(this.introScene) : SK.IntroScene.load({ art: this.art });
        loading.then(
          (scene) => {
            // Share already-decoded native art, but not the intro's clock.
            prepared.scene = Object.create(scene);
            prepared.scene.reset();
            prepared.ready = true;
          },
          (error) => { prepared.error = error; },
        );
      }
      const names = pic ? [back, pic, band, "ev_frame", "ev_cupid"]
          : ["band_event", ...(this.art.manifest.cupid || [])],
        runs = this.art.backAnim[back.replace(/^ev_back_/, "")] || [];
      // The first no-picture render must already contain Cupid, not lazily
      // request his current frame after the speech-release paint is queued.
      if (!pic && this.isCupidLesson(e)) {
        const f = this.state.family,
          slot = SK.WebHouseClock.slot(SK.WebHouseClock.fromFraction(this.dayFraction)),
          h = this.art.manifest.houses?.["e" + Number(f.era || 0) + "g" + Number(f.grade || 0)]
            || this.art.manifest.house || {};
        names.push(h.slots?.[slot] || h.slots?.[(slot & ~1) % 8] || h.file);
      }
      for (const [frame] of runs)
        if (frame >= 0) names.push(back + "_" + frame);
      for (const actor of e.actors || v(scene, "actors", []) || []) {
        const npc = v(actor, "npcKey", ""),
          anim = v(actor, "anim", -1);
        if (npc) names.push("ev_npc_" + npc);
        if (anim >= 0) {
          const key = anim.toString(16).toUpperCase().padStart(2, "0");
          for (const [frame] of this.art.emotion[key] || [])
            if (frame >= 0) names.push("ev_emo_" + key + "_" + frame);
        }
      }
      const unique = [...new Set(names.filter(Boolean))],
        key = JSON.stringify(unique);
      if (!this.eventArt || this.eventArt.key !== key) {
        const images = unique.map((name) => this.art.image(name)).filter(Boolean),
          prepared = { key, ready: false, error: null };
