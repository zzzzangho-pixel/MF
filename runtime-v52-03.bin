            50,
            32,
            64,
          ),
        );
        this.draw(ctx, this.art.cupid(Math.floor(t / 170)), 12, 115, 32, 32);
        ctx.canvas.skCupidAnchor = { speaker: "큐피트", x: 28, y: 131,
          width: ctx.canvas.width, height: ctx.canvas.height };
        const title = this.art.image("band_event");
        if (title?.complete) {
          this.draw(ctx, title, 10, 8, 220, 28);
          this.renderEventTitle(e.title, 8, true);
        }
        return;
      }
