    if (!entry?.canReplay) return { label: "재생 자료 없음", captured: false,
      detail: "다시 볼 장면과 대사 자료가 남아 있지 않아요." };
    if (entry.origin === "captured") return { label: "당시 장면", captured: true,
      detail: "저장된 당시 장면과 대사를 다시 보여줘요." };
    return { label: "장면 복원", captured: false,
      detail: "당시 모습이 남아 있지 않아 지금의 가족 정보로 장면과 대사를 복원해요." };
  }

  SK.HistoryPresentation = Object.freeze({ classify, replayInfo,
    replayLabel: entry => replayInfo(entry).label });
})(globalThis);

</script>
<script>
/* GameApp.cs-inspired DOM/Canvas front end; source rules live in engine/session.js.
 * Editing guide: title/new-family and game markup -> showTitle/renderGame;
 * menus and persistence -> *Dialog/saveSlot; pixel scene -> renderScene/renderEventScene.
 * Visual colors, spacing and responsive layout are in style.css. */
(function (root) {
  "use strict";
  const SK = (root.SK = root.SK || {}),
    STORE = "sennen-kazoku-web:v1:",
    $ = (id) => document.getElementById(id),
    v = (o, k, d) =>
      o && o[k] !== undefined
        ? o[k]
        : o && o[k[0].toUpperCase() + k.slice(1)] !== undefined
          ? o[k[0].toUpperCase() + k.slice(1)]
          : d,
    mod = (n, m) => ((n % m) + m) % m,
    clamp = (n, a, b) => Math.max(a, Math.min(b, n));
  const escape = (s) =>
    String(s == null ? "" : s).replace(
      /[&<>"']/g,
      (c) =>
        ({
          "&": "&amp;",
          "<": "&lt;",
          ">": "&gt;",
          '"': "&quot;",
          "'": "&#39;",
        })[c],
    );
  // Raise house figures and outing signs together without moving floor or camera.
  const CHARACTER_RISE = 8;
  // The supplied 32px sign ends at floor + 3 before the shared upward offset.
  const OUT_SIGN_TOP = 29 + CHARACTER_RISE, FAST_FACTOR = 6.5;
  // Browser UI advice only: this clock and rotation never enter game/save data.
  const CUPID_FIRST_DELAY = 12000, CUPID_TIP_INTERVAL = 45000;
  const CUPID_TIPS = ["끌어서 집 둘러보기", "아이템은 아껴서 써 줘！", "화살로 가족을 이끌자♪", "가족 무드는 중요해！", "가족의 스킬도 주목해 줘"];
  const number = (n) => Number(n || 0).toLocaleString("ko-KR");
  // Native monetary fields remain in ten-thousand-yen units. Convert only
  // their presentation; ordinary stats keep their original numeric values.
  const money = (n) => SK.Currency.formatNative(n);
  const currencyText = (s) => SK.Currency.text(s);
  const toolIcon = (key, fallback) => '<span class="tool-icon" aria-hidden="true">' +
    (root.SK_UI_ICONS?.[key] ? '<canvas class="menu-tool-icon" width="128" height="128" data-tool-icon="' + key + '"></canvas>' : fallback) + '</span>';
  // Supplied Unity Core/Interventions.cs descriptions, keyed by stable tool ID.
  // Presentation only: original tool effects and native inventory stay unchanged.
  const TOOL_DESCRIPTIONS = {
    "arrow.encourage": "현재 관심사에 몰두하는 마음을 응원하는 화살.",
    "arrow.calm": "현재 관심사에 대한 열기를 식히는 화살.",
    "arrow.easy": "몇 년 동안 편한 일에 마음이 가게 하는 화살.",
    "arrow.effort": "몇 년 동안 꿈·공부·일에 마음이 가게 하는 화살.",
    "arrow.love": "몇 년 동안 여러 사람에게 마음이 가게 하는 화살.",
    "arrow.single": "한동안 결혼할 마음이 없어지게 하는 화살.",
    "arrow.myway": "몇 년 동안 다른 화살이 듣지 않는 대신 고마움을 많이 받는 화살.",
    "arrow.ambition": "마음속에 큰 꿈이 생기게 하는 화살.",
    "arrow.legacy": "앞 세대가 남긴 꿈을 이어받게 하는 화살.",
    "arrow.encounter": "좋은 사람을 만날 만한 일에 마음이 가게 하는 화살.",
    "arrow.link": "다른 가족과 통신으로 결혼시키는 화살 (통신 기능은 옮기지 않음).",
    "item.heart_fruit": "하트를 1개 회복합니다.",
    "item.poison_heart_fruit": "하트를 모두 없앱니다.",
    "item.torch": "악마를 쫓아내는 횃불.",
    "item.happiness_box": "가족 무드가 한 단계 좋아집니다.",
    "item.ring.int": "지력이 한 등급 오릅니다.",
    "item.ring.stamina": "체력이 한 등급 오릅니다.",
    "item.ring.charm": "매력이 한 등급 오릅니다.",
    "item.ring.luck": "운이 한 등급 오릅니다.",
    "item.ring.love": "연인에 대한 사랑을 깊게 합니다 (연인이 있을 때만).",
    "item.crown": "세대주의 자녀에게 쓰면 다음 세대주 후보가 됩니다.",
    "item.bookmark": "가문이 끊겼을 때 쓴 날로 돌아가는 책갈피.",
    "item.heart_crystal": "앞 세대가 익힌 스킬을 이어받게 합니다."
  };
  const memoryStore = new Map();
  let storageAvailable = true;
  function storeGet(k) {
    try {
      return localStorage.getItem(STORE + k);
    } catch (e) {
      storageAvailable = false;
      return memoryStore.get(k) || null;
    }
  }
  function storeSet(k, s) {
    try {
      localStorage.setItem(STORE + k, s);
      return true;
    } catch (e) {
      storageAvailable = false;
      memoryStore.set(k, s);
      return false;
    }
  }
  function storeRemove(k) {
    try {
      localStorage.removeItem(STORE + k);
      return true;
    } catch (e) {
      storageAvailable = false;
      return false;
    } finally {
      memoryStore.delete(k);
    }
  }
  function manualSlotSnapshot(key) {
    if (!["1", "2", "3"].includes(key)) return null;
    return [key, key + ":backup"].map((k) => {
      const cached = memoryStore.has(k), memory = memoryStore.get(k);
      try {
        return { readable: true, raw: localStorage.getItem(STORE + k), cached, memory };
      } catch (_) {
        storageAvailable = false;
        return { readable: false, raw: null, cached, memory };
      }
    });
  }
  function parseSlot(key, backup = false) {
    const raw = storeGet(key + (backup ? ":backup" : ""));
    if (!raw) return null;
    return JSON.parse(raw);
  }
  function slotInfo(key) {
    try {
      const primary = parseSlot(key);
      if (primary) return primary;
      const back = parseSlot(key, true);
      return back ? { ...back, recovered: true } : null;
    } catch (e) {
      try {
        const back = parseSlot(key, true);
        if (back) return { ...back, recovered: true };
      } catch (_) {}
      return { corrupt: true };
    }
  }
  let app = null;
  class GameApp {
    constructor() {
      this.el = $("app");
      this.art = new SK.ArtLibrary();
      this.bubbles = new SK.PixelBubbles(this.art);
      this.introFlow = null;
      this.introScene = null;
      this.introSceneTime = 0;
      this.introLoading = false;
      this.introToken = 0;
      this.introPreviousGame = null;
      this.introRecommendedStaged = false;
      this.recommendedReview = null;
      this.ownWizard = null;
      this.game = null;
      this.state = null;
      this.selectedId = -1;
      this.playing = false;
      this.running = true;
      this.follow = true;
      this.fast = false;
      this.fastTier = 0;
      this.cameraZoom = 1;
      this.actorTime = 0;
      this.dayFraction = 0;
      this.scrollX = 0;
      this.camY = 0;
      this.actors = new Map();
      this.arrowTintStates = new Map();
      this.arrowTintGame = null;
      this.actorHouseKey = null;
      this.chatter = new SK.FamilyChatter();
      this.familyBubbleArt = Promise.all([3, 4, 7].flatMap(emote =>
        [0, 1, 2, 3, 4].map(frame => this.art.image("house_emo_" + emote + "_" + frame).decode())));
      this.modalOpen = false;
      this.cupidTip = { index: -1, text: "", until: 0, nextAt: 0 };
      this.lastFrame = 0;
      this.lastHudSecond = -1;
      this.eventKey = "";
      this.eventStart = 0;
      this.titleStart = performance.now();
      this.fatal = false;
      this.storageWarned = false;
      this.offlineAnchor = null;
      this.offlineGame = null;
      this.offlineBackground = false;
      this.offlineCheckpointAt = 0;
      this.offlineSummaryOpen = false;
      this.offlineReplayReturn = null;
      this.offlineReturnBlocked = false;
      this.settings = this.readSettings();
      this.dialogueAuto = this.settings.dialogueAuto === true;
      this.dialogueAutoTimer = null;
      this.bgmVolume = clamp(Number(this.settings.bgmVolume ?? 0.8) || 0, 0, 1);
      this.seVolume = clamp(Number(this.settings.seVolume ?? 0.8) || 0, 0, 1);
      this.musicOverride = -1;
      this.sound = new SK.SoundKit({
        bgmVolume: this.bgmVolume, seVolume: this.seVolume, bindGestures: false,
        onStatus: () => this.updateAudioStatus(),
        onEffectsStop: () => this.voice?.stop(),
      });
      this.voice = new SK.DialogueVoice(this.sound, this.settings.dialogueVoice !== false);
      this.arrowOutline = new SK.ArrowOutlineTint();
      this.arrowFx = new SK.ArrowFx(this.art, this.sound, (cancelled) => {
        const target = this.actors.get(this.arrowFx.targetId);
        const person = this.state?.members.find(p => p.id === this.arrowFx.targetId);
        if (!cancelled && person) this.arrowTintFor(person).pending = false;
        if (!cancelled && target) target.tintPending = false;
        this.resetCupidTips();
      });
      this.voiceLineKey = null;
      this.voiceOccurrences = new WeakMap();
      this.voiceOccurrenceIndex = 0;
      this.running = this.settings.running !== false;
      this.follow = this.settings.follow !== false;
      this.bind();
      this.showTitle();
      this.raf = requestAnimationFrame((t) => this.frame(t));
    }
    readSettings() {
      try {
        return JSON.parse(storeGet("settings") || "{}");
      } catch (_) {
        return {};
      }
    }
    persistSettings() {
      storeSet(
        "settings",
        JSON.stringify({ running: this.running, follow: this.follow,
          bgmVolume: this.bgmVolume, seVolume: this.seVolume,
          dialogueVoice: this.voice.enabled, dialogueAuto: this.dialogueAuto }),
      );
    }
    toast(s) {
      const el = $("toast");
      el.textContent = String(s);
      el.hidden = false;
      clearTimeout(this.toastTimer);
      this.toastTimer = setTimeout(() => (el.hidden = true), 3800);
    }
    bind() {
      // AudioContext must be resumed in the trusted gesture, not after a timer.
      const unlock = (e) => { if (e.isTrusted) this.sound.unlock(); };
      document.addEventListener("pointerdown", unlock, true);
      document.addEventListener("pointerup", unlock, true);
      document.addEventListener("touchend", unlock, true);
      document.addEventListener("keydown", unlock, true);
      document.addEventListener("click", (e) => {
        unlock(e);
        const b = e.target.closest("button");
        if (b && b.id !== "audio-start" && !b.disabled && e.isTrusted && !this.arrowFx.active) this.sound.playSe(201);
      }, true);
      document.addEventListener("keydown", (e) => {
        // Native Hangul IME owns composition keys, including Escape. A phone
        // keyboard dismissal must not discard the family-creation draft.
        if (e.isComposing || e.keyCode === 229 ||
            (e.key === "Escape" && e.target.closest("input,textarea,select"))) return;
        if (this.arrowFx.active) { e.preventDefault(); return; }
        if (e.key === "Escape") {
          if (this.introFlow?.read().mode === "family") this.cancelIntro();
          else this.closeModal();
          return;
        }
        if (e.target.closest("input,textarea,select")) return;
        if (this.modalOpen) return;
        if (!this.playing) return;
        // Focused buttons own their native Space/Enter activation, including fast.
        if (e.target.closest("button") && (e.key === " " || e.key === "Enter"))
          return;
        if (e.key === "ArrowLeft") {
          e.preventDefault();
          this.cycle(-1);
        }
        if (e.key === "ArrowRight") {
          e.preventDefault();
          this.cycle(1);
        }
        if (e.key === " ") {
          e.preventDefault();
          this.toggleRun();
        }
        if (e.key === "Enter" && this.state.event) {
          e.preventDefault();
          this.eventNext();
        }
      });
      document.addEventListener("visibilitychange", () => {
        this.resetDialogueAuto();
        if (document.hidden) this.suspendOffline("hidden");
        else this.resumeOffline();
        if (this.journalPlayback) this.journalPlayback.last = 0;
        this.lastFrame = 0;
        this.titleLastFrame = null;
        this.arrowFx.resetClock();
        this.updateCupidTip();
        this.updateFamilyChatter();
        this.syncDialogueVoice();
      });
      root.addEventListener("beforeunload", () => {
        this.arrowFx.cancel();
        this.voice.stop();
        this.suspendOffline("hidden");
      });
      root.addEventListener("pagehide", () => {
        this.resetDialogueAuto(); this.suspendOffline("hidden");
        if (this.journalPlayback) this.stopJournalReplayAudio(this.journalPlayback);
      });
      root.addEventListener("pageshow", () => { this.resetDialogueAuto(); this.titleLastFrame = null; if (!document.hidden) this.resumeOffline(); });
      root.addEventListener("resize", () => {
        this.updateSceneDialog();
        this.updateFamilyChatter();
      });
      root.addEventListener("error", (e) =>
        this.showError(e.error || new Error(e.message), false),
      );
      root.addEventListener("unhandledrejection", (e) =>
        this.showError(
          e.reason instanceof Error ? e.reason : new Error(String(e.reason)),
          false,
        ),
      );
    }
    act(fn) {
      if (this.arrowFx?.active) return null;
      try {
        return fn();
      } catch (e) {
        this.showError(e, false);
        return null;
      }
    }
    showError(e, boot = false) {
      this.arrowFx?.cancel();
      console.error(e);
      this.running = false;
      const text = (e && e.message) || String(e);
      if (boot) {
        this.fatal = true;
        this.el.innerHTML =
          '<section class="error-screen"><p class="overline">실행 오류</p><h1>게임을 열지 못했어요.</h1><p>아래 오류가 발생했습니다. 새로고침 후에도 계속되면 이 내용을 함께 알려 주세요.</p><pre>' +
          escape(text) +
          "</pre></section>";
      } else {
        let b = $("runtime-error");
        if (!b) {
          b = document.createElement("div");
          b.id = "runtime-error";
          b.className = "error-banner";
          this.el.prepend(b);
        }
        b.textContent = "진행을 멈췄어요: " + text;
        this.toast(
          "오류가 발생해 진행을 멈췄습니다. 저장 내보내기는 사용할 수 있어요.",
        );
      }
    }
    button(id, fn) {
      const b = $(id);
      if (b) b.onclick = () => this.act(fn);
    }
    showTitle() {
      this.resetDialogueAuto();
      this.ownWizard = null;
      this.arrowFx?.cancel();
      this.voice.stop();
      this.voiceLineKey = null;
      this.fast = false;
      this.playing = false;
      this.resetCupidTips();
      this.closeModal();
      this.titleStart = performance.now();
      this.resetTitleCrowd();
      const saved = slotInfo("auto");
      this.el.innerHTML =
        '<section class="title-screen"><div class="title-top"><p class="overline">MILLENNIAL FAMILY</p><h1>천년가족</h1><p class="subtitle">작은 하루가 모여, 천 년의 이야기가 됩니다.<br>우리 가족을 지켜보는 신님이 되어 주세요.</p></div><div class="title-art-wrap"><canvas id="title-canvas" class="title-art" width="240" height="160" aria-label="원작 첫 타이틀 화면의 집과 하늘"></canvas></div><div class="title-actions"><button id="continue" class="btn" ' +
        (!saved || saved.corrupt ? "disabled" : "") +
        ">이어하기" +
        (!saved ? " · 저장 없음" : "") +
        '</button><button id="new-game" class="btn orange">새 가족의 이야기</button><div class="button-row"><button id="title-slots" class="btn secondary">저장 / 불러오기</button></div></div></section>';
      this.button("continue", () => this.loadSlot("auto"));
      this.button("new-game", () => this.newGameDialog());
      this.button("title-slots", () => this.saveDialog());
      const soundButton = document.createElement("button");
      soundButton.id = "title-sound";
      soundButton.className = "btn secondary";
      soundButton.textContent = "♪ 원작 소리 · 음량 설정";
      this.el.querySelector(".title-actions").append(soundButton);
      this.button("title-sound", () => this.soundDialog());
      this.syncMusic();
    }
    newGameDialog() {
      this.startIntro();
    }
    async startIntro() {
      if (this.introLoading || this.introFlow) return;
      this.voice.stop();
      this.voiceLineKey = null;
      this.introLoading = true;
      this.introPreviousGame = this.game;
      this.introRecommendedStaged = false;
      this.playing = false;
      this.closeModal();
      this.running = true;
      this.resetDialogueAuto();
      const token = ++this.introToken;
      this.el.innerHTML = '<section class="intro-screen"><p class="overline">새 가족의 이야기</p><p>천계로 가는 중…</p><button id="intro-cancel" class="btn secondary">타이틀로</button></section>';
      this.button("intro-cancel", () => this.cancelIntro());
      try {
        if (!this.introScene) this.introScene = await SK.IntroScene.load({ art: this.art });
        await this.bubbles.ready;
        if (token !== this.introToken) return;
        this.introLoading = false;
        this.introSceneTime = 0;
        this.introScene.reset(0);
        this.introFlow = new SK.IntroFlow({ text: this.introScene.text,
          savedPlayerName: "",
          onAction: (action) => this.handleIntroAction(action) });
        this.introFlow.start();
        this.renderIntro();
      } catch (error) {
        this.introLoading = false;
        this.showError(error);
      }
    }
    handleIntroAction(action) {
      if (action.type === "create-family") {
        if (action.own) {
          this.recommendedReview = null;
          this.introRecommendedStaged = false;
          this.customDialog();
        } else {
          this.closeModal();
          this.recommendedReview = new SK.RecommendedFamilyReview(this);
          this.recommendedReview.start();
        }
      } else if (action.type === "player-name") {
        this.game.setPlayerName(action.name);
        if (action.persist) storeSet("player-name", action.name);
      } else if (action.type === "finish") {
        if (this.introRecommendedStaged) {
          this.selectedId = -1;
          this.dayFraction = 0;
          this.actors.clear();
          this.fast = false;
          this.actorTime = 0;
        }
        this.recommendedReview = null;
        this.introRecommendedStaged = false;
        this.introFlow = null;
        this.introPreviousGame = null;
        this.modalOpen = false;
        $("modal-root").innerHTML = "";
        this.musicOverride = -1;
        this.enterGame();
        this.saveSlot("auto", true);
      }
    }
    cancelIntro() {
      this.ownWizard = null;
      this.recommendedReview = null;
      this.introRecommendedStaged = false;
      this.introToken++;
      this.introFlow?.cancel();
      this.introFlow = null;
      this.introLoading = false;
      this.game = this.introPreviousGame;
      this.state = this.game ? this.game.state() : null;
      this.introPreviousGame = null;
      this.showTitle();
    }
    advanceIntro(button = null) {
      if (!this.introFlow) return;
      if (button && !this.introNextReady(this.introFlow.read(), button)) return;
      this.resetDialogueAuto();
      this.introFlow.advance();
      if (this.introFlow?.read().mode === "dialogue") this.renderIntro();
      else if (this.introFlow?.read().mode === "name") this.renderIntro();
    }
    renderIntro() {
      if (!this.introFlow) return;
      const view = this.introFlow.read();
      if (view.mode === "family") return;
      this.resetDialogueAuto();
      this.el.innerHTML = '<section class="intro-screen"><header class="intro-header"><span>천년가족 · 도입부</span><button id="intro-cancel" class="intro-cancel">타이틀로</button></header><section class="scene-shell intro-scene"><canvas id="intro-canvas" class="house-canvas" width="240" height="160" aria-label="원작 천계의 신님과 큐피트"></canvas>' +
        this.dialogueHtml(view, true) + '</section>' +
        '<div class="day-line intro-playback" role="group" aria-label="도입부 재생"><button id="run" class="btn secondary small">' +
        (this.running ? 'Ⅱ 멈춤' : '▶ 진행') + '</button><span class="intro-playback-buttons"><button id="fast" class="fast-btn" aria-pressed="' +
        this.fast + '" aria-label="배속 ' + this.speedMultiplier() + '배">' +
        (this.fast ? '» 배속 ' + this.speedMultiplier() + '배' : '» 배속 OFF') + '</button><button id="dialog-auto" class="btn secondary small" aria-pressed="' +
        this.dialogueAuto + '" aria-label="대사 자동 넘기기 ' + (this.dialogueAuto ? '켜짐' : '꺼짐') + '">Auto</button></span></div>' +
        (view.mode === "dialogue" ? this.eventAdvanceHtml() : '') +
        (view.mode === "name" ? '<form id="intro-name-form" class="intro-name-form"><label class="form-label" for="intro-player-name">' + escape(view.title) + '</label><input id="intro-player-name" class="input" type="text" inputmode="text" maxlength="6" enterkeyhint="done" autocomplete="off" value=""><button class="btn orange" type="submit">이 이름으로 할래!</button></form>' : '') + '</section>';
      this.button("intro-cancel", () => this.cancelIntro());
      this.button("run", () => this.toggleRun());
      this.button("fast", () => this.toggleFast());
      this.button("dialog-auto", () => this.toggleDialogueAuto());
      const next = $("intro-next");
      this.button("intro-next", () => this.advanceIntro(next));
      const advance = $("event-advance");
      if (advance) advance.onclick = () => {
        this.updateIntroAdvanceButton();
        if (!advance.isConnected || advance !== $("event-advance") || advance.disabled) return;
        advance.disabled = true;
        $("intro-next").click();
      };
      document.querySelectorAll("[data-intro-choice]").forEach((button) => {
        button.onclick = () => this.act(() => {
          this.introFlow.choose(Number(button.dataset.introChoice));
          if (this.introFlow?.read().mode !== "family") this.renderIntro();
        });
      });
      if (view.mode === "name") $("intro-name-form").onsubmit = (event) => {
        event.preventDefault();
        this.act(() => {
          const name = $("intro-player-name").value.trim();
          if (!name) return;
          this.introFlow.setPlayerName(name);
          this.renderIntro();
        });
      };
      this.renderIntroScene(performance.now());
      this.updateSceneDialog();
      this.updateIntroAdvanceButton();
      this.syncMusic();
      this.syncDialogueVoice();
    }
    renderIntroScene(t) {
      if (this.recommendedReview) this.recommendedReview.draw(t);
      else if (this.ownWizard) this.ownWizard.draw(t);
      else if (this.introFlow && this.introScene) {
        this.introScene.draw($("intro-canvas"), this.introSceneTime, this.introFlow.read());
        this.dialogueAnchor = $("intro-canvas")?.skCupidAnchor || null;
      }
      const canvas = $("intro-canvas"), box = canvas?.closest(".scene-shell")?.querySelector(".dialogue-frame");
      if (box) this.paintDialogueTail(box, canvas, canvas.clientWidth / 240);
    }
    recommendedFamilyDialog() {
      this.openModal(
        "신님이 아는 가족",
        '<p>“내가 아는 가족을 지켜봐 주지 않겠느냐?”</p><label class="form-label" for="family-name">가족의 성</label><input id="family-name" class="input" type="text" inputmode="text" maxlength="8" autocomplete="off" value="" placeholder="예: 김, 이, 박, 최 등"><label class="form-label" for="player-name">신님의 이름</label><input id="player-name" class="input" maxlength="12" value="신님"><p class="form-help">가족의 성을 입력하면 이름과 가족 구성을 랜덤으로 정해 시작합니다. 예: 김, 이, 박, 최 등.</p><div class="form-actions"><button id="create-family" class="btn orange">네, 알겠습니다! · 시작</button><button id="custom-family" class="btn secondary">내가 아는 가족 만들기</button></div>',
      );
      this.button("create-family", () => this.createFamily());
      this.button("custom-family", () => this.customDialog());
      if (this.introFlow) {
        $("custom-family")?.remove();
        const input = $("player-name");
        input?.previousElementSibling?.remove();
        input?.remove();
      }
      this.musicOverride = 1;
      this.syncMusic();
    }
    createFamily(setup) {
      const familyName =
          ($("family-name") && $("family-name").value.trim()) || "",
        playerName = this.introFlow ? "신님" :
          ($("player-name") && $("player-name").value.trim()) || "신님";
      if (!setup && !familyName) {
        this.toast("가족의 성을 입력해 주세요. 예: 김, 이, 박, 최");
        $("family-name")?.focus();
        return;
      }
      const seed = (Date.now() ^ Math.floor(Math.random() * 0xffffffff)) >>> 0;
      // Random/recommended START is a new setup, not a reshuffle of an
      // existing save. The explicit own-family wizard remains untouched.
      const startSetup = setup || SK.RandomFamilySetup.create({
        seed, surname: familyName, parts: this.art.parts,
      });
      this.game = SK.createGame({
        familyName,
        playerName,
        seed,
        setup: startSetup,
      });
      // Keep the private wizard available if NewCustom throws; release it only
      // after the original rule path has returned a concrete family.
      this.ownWizard = null;
      this.selectedId = -1;
      this.dayFraction = 0;
      this.actors.clear();
      this.fast = false;
      this.fastTier = 0;
      this.cameraZoom = 1;
      this.actorTime = 0;
      this.closeModal();
      if (this.introFlow) {
        this.introFlow.familyReady(this.game.state());
        this.renderIntro();
        return;
      }
      this.enterGame();
      this.saveSlot("auto", true);
      this.toast(
        "이제 " + this.familyTitle(this.state.family.name) + "의 이야기가 시작됩니다.",
      );
    }
    customDialog() {
      this.closeModal();
      this.musicOverride = 3;
      this.ownWizard = new SK.OwnFamilyWizard(this);
      this.ownWizard.start();
    }
    finishOwnFamily(setup) {
      const errors = setup.Validate();
      if (errors.length) { this.ownWizard.error(errors[0]); return; }
      const wizard = this.ownWizard, previousGame = this.game;
      try { this.createFamily(setup); }
      catch (error) {
        this.ownWizard = wizard;
        this.game = previousGame;
        wizard.open("choose");
        wizard.error("가족 만들기를 완료하지 못했어요: " + error.message);
      }
    }
    enterGame() {
      this.arrowFx.cancel();
      this.playing = true;
      if (this.offlineGame !== this.game) {
        this.offlineGame = this.game;
        this.offlineAnchor = null;
        this.offlineReturnBlocked = false;
      }
      this.offlineBackground = false;
      this.offlineCheckpointAt = Date.now();
      this.resetCupidTips();
      this.chatter.reset();
      this.state = this.game.state();
      const alive = this.state.members.filter((p) => p.alive !== false);
      if (!alive.some((p) => p.id === this.selectedId))
        this.selectedId =
          this.state.family.headId !== undefined
            ? this.state.family.headId
            : (alive[0] || {}).id;
      if (this.returnToTitleAfterClosure()) return;
      this.renderGame();
    }
    returnToTitleAfterClosure() {
      const state = this.state, session = this.game?.session;
      // A missing head alone is not the end: finish the native death/Heaven
      // pages and any bookmark question first. SceneExit(5) is the actual
      // completed lineage boundary; do not invent an Ended bit or run a rule.
      if (!this.playing || !state?.lineageEnded || state.endMenu !== 5 ||
          state.event || state.paused || state.bookmarkAskPending || session?.HasPending)
        return false;
      this.showTitle();
      return true;
    }
    familyHeirId() {
      const memory = this.game?.session?.Game?.Mem, familyBase = SK.OrigMem?.Fam;
      if (!memory || typeof memory.R16 !== "function" || !Number.isInteger(familyBase)) return null;
      let id;
      try { id = memory.R16(familyBase + 0x66e); }
      catch (_) { return null; }
      return Number.isInteger(id) && id >= 0 && id < 65535 &&
        this.state?.members?.some((member) => member.id === id && member.alive !== false) ? id : null;
    }
    heirTag(p) {
      const id = this.familyHeirId();
      return id !== null && p?.id === id
        ? '<span class="heir-tag" data-native-heir-id="' + id + '">후계자</span>' : "";
    }
    selected() {
      return (
        this.state &&
        (this.state.members.find((x) => x.id === this.selectedId) ||
          this.state.members.find((x) => x.alive !== false))
      );
    }
    familyTitle(name) {
      // Format the surname only at presentation sites. Native family names,
      // literal surname inputs, save labels and exported data stay untouched.
      const surname = String(name == null ? "" : name).trim();
      return surname ? surname + "씨 가족" : "우리 가족";
    }
    avatar(p) {
      const im = this.art.figure(
        p,
        2,
        (this.state && this.state.family.era) || 0,
      );
      if (!im) return "";
      if (im instanceof HTMLCanvasElement) return im.toDataURL();
      return im.src;
    }
    memberPortrait(p) {
      const figure = this.art.figure(p, 2, (this.state && this.state.family.era) || 0);
      let portrait = this.avatar(p);
      if (figure && (figure instanceof HTMLCanvasElement || figure.complete)) {
        this.memberPortraitCache ||= new WeakMap();
        portrait = this.memberPortraitCache.get(figure);
        if (!portrait) {
          const width = figure.naturalWidth || figure.width, height = figure.naturalHeight || figure.height;
          if (width && height) {
            const canvas = document.createElement("canvas");
            canvas.width = width; canvas.height = height;
            const ctx = canvas.getContext("2d");
            ctx.drawImage(figure, 0, 0);
            const pixels = ctx.getImageData(0, 0, width, height).data;
            let left = width, top = height, right = -1, bottom = -1;
            for (let y = 0; y < height; y++) for (let x = 0; x < width; x++) {
              if (!pixels[(y * width + x) * 4 + 3]) continue;
              left = Math.min(left, x); right = Math.max(right, x);
              top = Math.min(top, y); bottom = Math.max(bottom, y);
            }
            if (right >= left) {
              // Center the visible sprite, not the native32×64transparent canvas.
              canvas.width = right - left + 1; canvas.height = bottom - top + 1;
              ctx.imageSmoothingEnabled = false;
              ctx.drawImage(figure, left, top, canvas.width, canvas.height, 0, 0, canvas.width, canvas.height);
              portrait = canvas.toDataURL();
              this.memberPortraitCache.set(figure, portrait);
            }
          }
        }
      }
      return portrait || this.avatar(p);
    }
    hearts(p) {
      let html = "";
      for (let i = 0; i < 3; i++) {
        const n = Number(p.hearts || 0) - i * 96,
          key = n >= 96 ? "heart_full" : n >= 48 ? "heart_half" : "heart_empty",
          im = this.art.ui(key);
        html += im
          ? '<img class="heart" src="' +
            im.src +
            '" alt="' +
            (key === "heart_full"
              ? "하트"
              : key === "heart_half"
                ? "반 하트"
                : "빈 하트") +
            '">'
          : '<span class="heart-fallback">' +
            (n >= 96 ? "♥" : "♡") +
            "</span>";
      }
      return html;
    }
    renderGame() {
      if (!this.playing) return;
      this.resetDialogueAuto();
      this.syncMusic();
      const previousCanvas = $("house-canvas"),
        previousTitle = $("event-scene-title");
      const f = this.state.family,
        p = this.selected(),
        isEvent = Boolean(this.state.event),
        // Keep normal play and events in the same native 240x160 viewport.
        sceneHeight = 160;
      this.el.innerHTML =
        '<header class="game-header"><div><p class="overline">' +
        escape(f.generation || 1) +
        "대째 이어지는 이야기</p><h1>" +
        escape(this.familyTitle(f.name)) +
        '</h1></div><button id="settings" class="icon-button" aria-label="설정">☷</button></header><div class="hud"><span class="hud-date">' +
        escape(f.year) +
        ". " +
        escape(f.month) +
        ". " +
        escape(f.day) +
        " <small>" +
        escape((SK.GameDate.WeekdayKo || [])[f.weekday] || "") +
        '</small></span><span class="hud-money">살림 <strong>' +
        money(f.money) +
        '</strong></span></div><section class="scene-shell"><canvas id="house-canvas" class="house-canvas" width="240" height="' + sceneHeight + '" aria-label="가족이 생활하는 집. 끌어서 이동하고, 두 손가락으로 확대·축소하고, 인물을 눌러 선택할 수 있습니다."></canvas><div id="family-chatter" class="family-chatter" aria-hidden="true" hidden></div><span id="event-scene-title" class="event-scene-title" hidden><span></span></span><span class="scene-note" ' +
        'hidden' +
        '></span><button id="cupid-tip-trigger" class="cupid-tip-trigger" type="button" aria-label="큐피트 팁 듣기" ' + (isEvent ? 'hidden' : '') + '></button><div id="scene-hud" class="scene-hud" ' + (isEvent ? 'hidden' : '') + '><span id="scene-time" class="scene-time"></span><span id="scene-mood" class="scene-mood"></span></div><div class="scene-bottom"><button id="follow" class="follow-btn" ' +
        (isEvent ? "hidden" : "") +
        ">" +
        (this.follow ? "◎ 따라가는 중" : "◎ 선택한 사람 찾기") +
        '</button></div>' + (isEvent ? this.eventHtml() : "") + '</section><div class="day-line"><button id="run" class="btn secondary small">' +
        (this.running ? "Ⅱ 멈춤" : "▶ 진행") +
        '</button><span class="speed-label" id="progress-label">' +
        (isEvent ? "사건이 진행 중이에요." : "가족의 하루를 지켜보고 있어요.") +
        '</span><button id="fast" class="fast-btn" aria-pressed="' +
        this.fast + '" aria-label="배속 ' + this.speedMultiplier() + '배">' +
        (this.fast ? '» 배속 ' + this.speedMultiplier() + '배' : '» 배속 OFF') +
        '</button><button id="dialog-auto" class="btn secondary small" aria-pressed="' +
        this.dialogueAuto + '" aria-label="대사 자동 넘기기 ' +
        (this.dialogueAuto ? '켜짐' : '꺼짐') + '">Auto</button></div>' +
        (isEvent ? this.eventAdvanceHtml() : this.memberHtml(p)) +
        '<nav class="game-tools"><button id="arrows" class="tool-button orange">' + toolIcon('arrow', '➶') + '화살</button><button id="items" class="tool-button">' + toolIcon('items', '✧') + '아이템</button><button id="family-tree" class="tool-button">' + toolIcon('family', '♧') + '가족</button><button id="cupid-menu" class="tool-button">' + toolIcon('cupid', '♡') + '큐피트</button><button id="save-exit" class="tool-button exit-tool" aria-label="저장 후 종료">' + toolIcon('save', '⏻') + '종료</button></nav><footer class="game-footer"><span>천년가족 · 브라우저 에디션</span><span id="save-status">브라우저 자동 저장</span></footer>';
      // Keep the last composed scene while the new event's local images decode.
      // Replacing the UI must not expose an empty canvas between animation frames.
      if (previousCanvas) {
        $("house-canvas").getContext("2d").drawImage(previousCanvas, 0, 0);
        if (isEvent && previousTitle && !previousTitle.hidden)
          $("event-scene-title").replaceWith(previousTitle.cloneNode(true));
      }
      this.button("settings", () => this.settingsDialog());
      this.button("follow", () => {
        this.focusHousePerson();
        this.persistSettings();
        this.renderGame();
      });
      this.button("run", () => this.toggleRun());
      this.button("dialog-auto", () => this.toggleDialogueAuto());
      this.button("arrows", () => this.toolsDialog("arrow"));
      this.button("items", () => this.toolsDialog("item"));
      this.button("family-tree", () => this.treeDialog());
      this.button("cupid-menu", () => SK.CupidMenu.open(this));
      this.button("save-exit", () => this.requestSaveAndExit());
      if (this.offlineReturnBlocked) {
        document.querySelectorAll('.game-tools button:not(#save-exit), #run, #fast, #dialog-auto, #person-detail')
          .forEach(button => { button.disabled = true; });
        $("progress-label").textContent = "부재중 기록의 저장을 기다리고 있어요.";
      }
      this.button("previous-person", () => this.cycle(-1));
      this.button("next-person", () => this.cycle(1));
      this.button("person-detail", () => this.detailDialog(this.selected()));
      this.button("event-next", () => this.eventNext());
      const eventAdvance = $("event-advance");
      if (eventAdvance) eventAdvance.onclick = () => {
        this.updateEventAdvanceButton();
        // A detached control from the previous page must not activate the
        // next page on a second click. Forward only the live dialogue button.
        if (!eventAdvance.isConnected || eventAdvance !== $("event-advance") || eventAdvance.disabled) return;
        const next = $("event-next");
        eventAdvance.disabled = true;
        next.click();
      };
      document
        .querySelectorAll("[data-choice]")
        .forEach(
          (b) =>
            (b.onclick = () =>
              this.act(() => this.eventChoice(Number(b.dataset.choice)))),
        );
      this.button("fast", () => this.toggleFast());
      this.bindCanvas();
      this.updateSceneDialog();
      this.updateCupidTip();
      this.updateFamilyChatter();
      this.paintToolIcons();
      // renderGame replaces the time HUD even while paused. Repaint from the
      // retained fraction immediately, without waiting for another clock tick.
      this.updateClock();
      this.syncDialogueVoice();
      const bow = this.art.ui("btn_bow");
      if (bow && !root.SK_UI_ICONS?.arrow) {
        const span = $("arrows").querySelector(".tool-icon");
        span.innerHTML = '<img src="' + bow.src + '" alt="">';
      }
    }
    paintToolIcons() {
      this.menuArt ||= new Map();
      for (const canvas of this.el.querySelectorAll("canvas[data-tool-icon]")) {
        const key = canvas.dataset.toolIcon;
        let entry = this.menuArt.get(key);
        if (!entry) {
          const image = new Image();
          const spec = root.SK_UI_ICONS[key];
          image.src = typeof spec === "string" ? spec : spec.src;
          entry = { image, bounds: spec.bounds, ready: image.decode() };
          this.menuArt.set(key, entry);
        }
        const paint = () => {
          if (!canvas.isConnected) return;
          const image = entry.image, ctx = canvas.getContext("2d");
          const bounds = entry.bounds || [0, 0, image.naturalWidth, image.naturalHeight];
          const [left, top, right, bottom] = bounds;
          const sourceWidth = right - left, sourceHeight = bottom - top;
          const resolution = canvas.width, targetSize = resolution * 26 / 32;
          const scale = Math.min(targetSize / sourceWidth, targetSize / sourceHeight);
          const width = sourceWidth * scale, height = sourceHeight * scale;
          ctx.clearRect(0, 0, resolution, resolution);
          // Keep smooth artwork high-resolution while preserving its aspect
          // and an equal visual size inside the fixed square menu slot.
          ctx.imageSmoothingEnabled = true;
          ctx.imageSmoothingQuality = "high";
          ctx.drawImage(image, left, top, sourceWidth, sourceHeight,
            (resolution - width) / 2, (resolution - height) / 2, width, height);
          canvas.dataset.ready = "1";
        };
        entry.ready.then(paint).catch(() => { canvas.dataset.ready = "error"; });
      }
    }
    memberHtml(p) {
      if (!p)
        return '<div class="member-panel empty">현재 집에 있는 가족이 없어요.</div>';
      const portrait = this.memberPortrait(p);
      return (
        '<section class="member-panel"><button id="previous-person" class="nav-arrow" aria-label="이전 가족"><span class="nav-chevron" aria-hidden="true">‹</span></button><div class="member-content"><div class="member-nav"><img class="portrait" data-sex="' +
        (p.gender === 1 ? "female" : "male") + '" src="' + portrait +
        '" alt="' +
        escape(p.name) +
        '"><div class="member-id"><div class="member-name">' +
        escape(p.name) +
        (p.id === this.state.family.headId
          ? '<span class="head-tag">가장</span>'
          : "") +
        this.heirTag(p) +
        ' <span class="member-age">' +
        escape(p.age) +
        '세</span></div><div class="member-job">' +
        escape(p.jobName || "직업 " + p.job) +
        '</div><div class="member-hearts">' +
        this.hearts(p) +
        '</div></div><div class="member-right"><button id="person-detail" class="member-more">자세히 ↗</button></div></div><div class="activity"><span class="label">지금</span><span class="activity-text">' +
        escape(currencyText(
          p.plannedTitle ||
            p.currentTitle ||
            p.interest ||
            p.dream ||
            "가족의 하루를 보내고 있어요.",
        )) +
        '</span></div>' + this.interestDescriptionHtml(p) + '<div class="gauge-wrap"><div class="gauge-label"><span>몰입도</span><span>' +
        this.focusPercent(p) +
        '%</span></div><div class="gauge"><div class="gauge-fill" style="width:' +
        this.focusPercent(p) +
        '%"></div></div></div></div><button id="next-person" class="nav-arrow" aria-label="다음 가족"><span class="nav-chevron" aria-hidden="true">›</span></button></section>'
      );
    }
    focusPercent(p) {
      // Gauge is current-interest focus; Immersion remains the native heart
      // source. The latter is only a fallback for older incomplete DTOs.
      return Math.round(clamp(Number(p.gauge ?? p.immersion ?? 0) * 100 / 255, 0, 100));
    }
    interestDescriptionHtml(p) {
      const description = SK.InterestDescription?.get(p, { ...this.state,
        origNames: this.game?.session?.Family?.OrigNames });
      if (!description) return "";
      const text = value => escape(currencyText(String(value || "").replace(/\s*\n\s*/g, " ")));
      const hint = description.hintRuns?.length
        ? description.hintRuns.map((run) => {
          const code = run.nativeColorCode ?? run.color,
            color = [10, 11, 12, 13].includes(code) ? SK.InterestDescription.palette?.[code] : null;
          return '<span class="interest-hint-run"' + (color && /^#[0-9a-f]{6}$/i.test(color)
            ? ' style="color:' + color + '" data-native-color="' + code + '"' : '') + '>' + text(run.text) + '</span>';
        }).join("") : text(description.hint?.replace(/\s*([↑↓]+)\s*/g, ' $1 '));
      return '<div class="interest-description" data-interest-key="' + escape(description.key) +
        '" aria-label="현재 관심사 설명"><p class="interest-description-body">' + text(description.body) +
        '</p>' + (description.hint ? '<p class="interest-description-hint">(' + hint + ')</p>' : "") + '</div>';
    }
    eventHtml() {
      return this.dialogueHtml(this.state.event, false).replace(
        'class="scene-dialog"',
        'class="scene-dialog" data-event-visual="pending" style="visibility:hidden" inert aria-hidden="true"',
      );
    }
    eventAdvanceHtml() {
      return '<div class="event-advance-area"><button id="event-advance" class="event-advance-button" type="button" aria-label="다음 대사" disabled><span class="event-advance-icon" aria-hidden="true">▶</span><span class="event-advance-label">Touch</span></button></div>';
    }
    updateEventAdvanceButton() {
      const button = $("event-advance");
      if (!button) return;
      const event = this.state?.event, next = $("event-next"),
        advance = event && !(event.choices || []).length && event.mode !== "name" && event.canAdvance !== false &&
          (event.eventId || event.EventId) !== "memo-progress";
      button.disabled = !this.playing || !this.game || !advance || this.modalOpen ||
        this.offlineBackground || this.offlineReturnBlocked || document.hidden || this.arrowFx?.active ||
        !!this.eventDialoguePending() || !next || !this.el.contains(next) || next.disabled ||
        !!next.closest('[hidden],[inert],[aria-hidden="true"]') ||
        getComputedStyle(next).visibility !== "visible" || !next.getClientRects().length;
    }
    resetDialogueAuto() {
      this.dialogueAutoTimer = null;
    }
    toggleFast() {
      if (!this.fast) { this.fast = true; this.fastTier = 1; }
      else if (this.fastTier !== 2) this.fastTier = 2;
      else { this.fast = false; this.fastTier = 0; }
      const button = $("fast");
      if (!button) return;
      button.setAttribute("aria-pressed", String(this.fast));
      button.setAttribute("aria-label", "배속 " + this.speedMultiplier() + "배");
      button.textContent = this.fast ? "» 배속 " + this.speedMultiplier() + "배" : "» 배속 OFF";
    }
    speedMultiplier() {
      return this.fast ? FAST_FACTOR * (this.fastTier === 2 ? 2 : 1) : 1;
    }
    houseZoom() {
      return this.state?.event ? 1 : clamp(this.cameraZoom || 1, .5, 2);
    }
    focusHousePerson() {
      // Camera preference is presentation-only, never part of the family save.
      this.cameraZoom = 1;
      this.follow = true;
      const actor = this.actors.get(this.selectedId), canvas = $("house-canvas");
      if (!actor || !canvas) return;
      this.scrollX = mod(actor.x - 104, this.art.house.width || 960);
      this.camY = clamp(actor.floor - 112, 0,
        Math.max(0, (this.art.house.height || 160) - canvas.height));
    }
    introNextReady(view, button) {
      return !!this.introFlow && !this.introLoading && !this.ownWizard && !this.recommendedReview &&
        !this.modalOpen && !document.hidden && !this.offlineBackground && !this.arrowFx?.active &&
        view.mode === "dialogue" && view.canAdvance === true && !(view.choices || []).length &&
        button === $("intro-next") && button?.isConnected && this.el.contains(button) &&
        !button.disabled && !button.closest('[hidden],[inert],[aria-hidden="true"]') &&
        getComputedStyle(button).visibility === "visible" && !!button.getClientRects().length;
    }
    updateIntroAdvanceButton() {
      if (this.recommendedReview) {
        this.recommendedReview.updateAdvanceButton();
        return;
      }
      const button = $("event-advance");
      if (button) button.disabled = !this.introFlow || !this.introNextReady(this.introFlow.read(), $("intro-next"));
    }
    updateIntroDialogueAuto(dt) {
      const flow = this.introFlow, view = flow?.read(), next = $("intro-next");
      if (!this.dialogueAuto || !this.running || !view || !this.introNextReady(view, next)) {
        this.resetDialogueAuto();
        return;
      }
      const key = JSON.stringify([view.sequence, view.mode, view.messageId, view.messageIndex,
        view.page, view.speaker, view.text]), timer = this.dialogueAutoTimer;
      if (!timer || timer.button !== next || timer.flow !== flow || timer.key !== key) {
        this.dialogueAutoTimer = { button: next, flow, key, elapsed: 0, hold: this.dialogueAutoDelay(view) };
        return;
      }
      timer.elapsed += clamp(Number(dt) || 0, 0, 0.1) * 1000;
      const voice = this.voice?.diagnostics;
      if (timer.elapsed < timer.hold || (this.voice?.enabled && (voice?.active || voice?.pending))) return;
      if (this.dialogueAutoTimer !== timer || this.introFlow !== flow ||
          !this.introNextReady(flow.read(), next)) {
        this.resetDialogueAuto();
        return;
      }
      this.resetDialogueAuto();
      next.click();
    }
    toggleDialogueAuto() {
      this.dialogueAuto = !this.dialogueAuto;
      this.resetDialogueAuto();
      this.persistSettings();
      const button = $("dialog-auto");
      if (!button) return;
      button.setAttribute("aria-pressed", String(this.dialogueAuto));
      button.setAttribute("aria-label", "대사 자동 넘기기 " + (this.dialogueAuto ? "켜짐" : "꺼짐"));
    }
    dialogueAutoDelay(event) {
      const length = Array.from(currencyText(event.text || "").replace(/\s+/g, " ").trim()).length;
      return clamp(2500 + length * 65, 3000, 8000);
    }
    updateDialogueAuto(dt) {
      if (this.introFlow) { this.updateIntroDialogueAuto(dt); return; }
      const event = this.state?.event, session = this.game?.session;
      // Native state.paused is true while a story owns the VM. User pause
      // belongs to running; Auto must not change that or the fast clock.
      if (!this.dialogueAuto || !this.running || !this.playing || !event || !this.game ||
          this.introFlow || this.introLoading || this.ownWizard || this.recommendedReview ||
          this.modalOpen || this.journalPlayback || session?.replaying || document.hidden ||
          this.offlineBackground || this.offlineReturnBlocked || this.arrowFx?.active ||
          event.autoProcessing || event.AutoProcessing || event.phase === "choices" ||
          event.mode === "name" || event.canAdvance === false || (event.choices || []).length ||
          (event.eventId || event.EventId) === "memo-progress" || session?.memo?.phase === "Progress") {
        this.resetDialogueAuto();
        return;
      }
      this.updateEventAdvanceButton();
      const next = $("event-next"), advance = $("event-advance");
      // Share Touch's visual/input readiness, including cold images and the
      // native prelude. Only the current live forward button can be clicked.
      if (!advance || advance.disabled || !next?.isConnected || next.tagName !== "BUTTON") {
        this.resetDialogueAuto();
        return;
      }
      const memo = session?.memo,
        key = JSON.stringify([event.eventId || event.EventId, event.personId, event.phase,
          event.page, event.speaker, event.text, memo?.page, memo?.phase, memo?.memoPage, memo?.familyShown]),
        timer = this.dialogueAutoTimer;
      if (!timer || timer.button !== next || timer.game !== this.game || timer.key !== key) {
        this.dialogueAutoTimer = { button: next, game: this.game, key, elapsed: 0,
          hold: this.dialogueAutoDelay(event) };
        return;
      }
      // Accumulate only bounded, visible presentation time. Hidden/menu/off
      // or restored unread pages restart their hold, with no elapsed catch-up.
      timer.elapsed += clamp(Number(dt) || 0, 0, 0.1) * 1000;
      const voice = this.voice?.diagnostics;
      if (timer.elapsed < timer.hold || (this.voice?.enabled && (voice?.active || voice?.pending))) return;
      this.updateEventAdvanceButton();
      if (this.dialogueAutoTimer !== timer || advance !== $("event-advance") || advance.disabled ||
          next !== $("event-next") || !next.isConnected) {
        this.resetDialogueAuto();
        return;
      }
      this.resetDialogueAuto();
      next.click();
    }
    eventDialoguePending() {
      return this.playing && !!this.state?.event &&
        this.el.querySelector('.scene-dialog[data-event-visual="pending"]');
    }
    releaseEventDialogue(t) {
      const dialog = this.el.querySelector('.scene-dialog[data-event-visual="pending"]');
      if (!dialog || dialog.dataset.releaseScheduled) return;
      const e = this.state?.event;
      if (!e) return;
      const scene = e.scene || e.Scene || {}, pic = v(scene, "pic", e.pic || "");
      // Native picture fade/entrance precedes Cupid's final pose at frame152.
      if (pic && Math.floor((t - this.eventStart) * 0.06) < 152) return;
      dialog.dataset.releaseScheduled = "1";
      requestAnimationFrame(() => {
        if (!dialog.isConnected || this.state?.event !== e) return;
        dialog.dataset.eventVisual = "ready";
        dialog.style.visibility = "";
        dialog.inert = false;
        dialog.removeAttribute("aria-hidden");
        this.updateSceneDialog();
        this.syncDialogueVoice();
      });
    }
    syncDialogueVoice() {
      // A history modal owns its recorded dialogue, not the live scene's
      // modal guard. Keep the shared effects mixer and the user's voice flag.
      if (this.journalPlayback?.active) {
        this.syncJournalReplayAudio(this.journalPlayback);
        return;
      }
      if (this.eventDialoguePending()) {
        if (this.voice.diagnostics.active || this.voice.diagnostics.pending) this.voice.stop();
        return;
      }
      let key = null, text = "", speaker = "narrator";
      const box = this.el.querySelector(".dialogue-frame");
      if (box && this.recommendedReview) {
        const view = this.recommendedReview.view();
        key = view ? JSON.stringify(["recommended", this.recommendedReview.serial, view.messageId, view.page, view.text]) : null;
        text = view?.text || "";
        speaker = view?.speakerKey || "cupid";
      } else if (box && this.ownWizard) {
        const view = this.ownWizard.view();
        key = view ? JSON.stringify(["own-family", this.ownWizard.serial, view.messageId, view.page, view.text]) : null;
        text = view?.text || "";
        speaker = "cupid";
      } else if (box && this.introFlow) {
        const view = this.introFlow.read();
        key = JSON.stringify(["intro", view.sequence, view.mode, view.messageId,
          view.messageIndex, view.page, view.text]);
        text = view.text;
        speaker = view.speakerKey;
      } else if (box && this.playing && this.state?.event) {
        const view = this.state.event, session = this.game.session;
        const memo = session.memo && !session.replaying ? session.memo : null;
        const occurrence = session.heavenCur || memo || session.cur || session;
        if (!this.voiceOccurrences.has(occurrence))
          this.voiceOccurrences.set(occurrence, ++this.voiceOccurrenceIndex);
        key = JSON.stringify(["event", this.voiceOccurrences.get(occurrence), view.eventId,
          view.personId, view.phase, view.page, memo?.page, memo?.phase, memo?.memoPage,
          memo?.familyShown, view.speaker, view.text]);
        text = view.text;
        speaker = view.speaker === "큐피트" ? "cupid" : view.speaker === "높으신 신" ? "god" :
          this.state.members.find(p => p.name === view.speaker || p.id === view.personId) || view.speaker;
      } else if (this.playing) {
        const tip = this.el.querySelector(".scene-tip");
        if (tip && !tip.hidden && this.cupidTip.until) {
          key = "tip:" + this.cupidTip.until;
          text = this.cupidTip.text;
          speaker = "cupid";
        }
      }
      // Consume hidden/muted pages without replaying old speech when they return.
      const changed = key !== this.voiceLineKey;
      this.voiceLineKey = key;
      if (!key || this.modalOpen || document.hidden || this.arrowFx.active || !this.voice.enabled) {
        if (this.voice.diagnostics.active || this.voice.diagnostics.pending) this.voice.stop();
        return;
      }
      if (changed) void this.voice.speak(currencyText(text), speaker);
    }
    dialogueHtml(view, intro) {
      const choices = view.choices || [],
        kind = intro ? view.speakerKey : view.speaker === "높으신 신" ? "god" : view.speaker === "큐피트" ? "cupid" : "event",
        advance = !choices.length && view.mode !== "name" && view.canAdvance !== false,
        tag = advance ? "button" : "div",
        id = intro ? "intro-next" : "event-next";
      return '<div class="scene-dialog" role="region" aria-label="' + escape(currencyText(view.title || "대사")) + '">' +
        '<' + tag + (advance ? ' id="' + id + '" type="button" aria-label="다음 대사"' : '') + ' class="dialogue-frame" data-bubble="' + kind + '" data-fixed-width="1">' +
        '<canvas class="bubble-art" width="236" height="54" aria-hidden="true"></canvas>' +
        '<span class="dialog-copy">' +
        (view.speaker ? '<span class="dialog-speaker">' + escape(view.speaker) + '</span>' : '') +
        '<span class="dialog-text">' + escape(currencyText(view.text || "")) + '</span>' +
        (choices.length ? '<span class="dialog-actions">' + choices.map((choice, i) => '<button class="btn secondary" ' + (intro ? 'data-intro-choice' : 'data-choice') + '="' + i + '">' +
          escape(currencyText(typeof choice === "string" ? choice : choice.text || choice.label || "선택 " + (i + 1))) + '</button>').join("") + '</span>' : '') + '</span>' +
        (advance ? '<span class="dialog-next" aria-hidden="true">▶</span>' : '') + '</' + tag + '></div>';
    }
    paintDialogueTail(box, canvas, scale, force = false) {
      if (!box || !canvas || !(scale > 0)) return false;
      const art = box.querySelector(".bubble-art"), kind = box.dataset.bubble,
        anchor = canvas.skCupidAnchor || this.dialogueAnchor;
      let tailX = null;
      if (kind === "cupid" && anchor?.speaker === "큐피트" &&
          Number.isFinite(anchor.x) && Number.isFinite(anchor.width) && anchor.width > 0) {
        const cr = canvas.getBoundingClientRect(), br = box.getBoundingClientRect();
        tailX = (cr.left + anchor.x / anchor.width * cr.width - br.left) / scale;
      }
      const width = Math.round(box.clientWidth / scale), height = Math.ceil(box.clientHeight / scale),
        key = [kind, width, height, Number.isFinite(tailX) ? Math.round(tailX) : "default"].join(":");
      if (!force && box.dataset.bubblePaint === key) return true;
      if (!this.bubbles.draw(art, kind, width, height, tailX)) return false;
      box.dataset.bubblePaint = key;
      return true;
    }
    updateSceneDialog() {
      this.updateEventAdvanceButton();
      const scene = this.el.querySelector(".scene-shell");
      if (!scene) return;
      const canvas = scene.querySelector(".house-canvas"), scale = canvas.clientWidth / 240;
      scene.style.setProperty("--pixel-scale", scale);
      const box = scene.querySelector(".dialogue-frame");
      if (box) {
        const text = box.querySelector(".dialog-text"), art = box.querySelector(".bubble-art");
        box.classList.remove("single-line", "short-dialogue");
        box.style.removeProperty("--dialog-copy-offset");
        box.style.width = "";
        text.style.minHeight = "";
        text.style.maxHeight = "";
        text.style.overflowY = "";
        // Fractional line heights can round a fully visible two-line page to
        // scrollHeight=51/clientHeight=50 and show a spurious PC scrollbar.
        // Give only that one-pixel rounding gap room; keep real long-page
        // overflow readable rather than hiding or truncating its contents.
        if (text.scrollHeight - text.clientHeight === 1)
          text.style.minHeight = text.scrollHeight + "px";
        // Fitting pages are not scroll containers: Korean glyph ink can
        // extend slightly beyond the fractional line box without overflow.
        if (text.scrollHeight <= text.clientHeight + 1)
          text.style.overflowY = "visible";
        // A speakerless short notice uses the original54px bubble height.
        // Center its copy within the flat body, not within the tail above it.
        // Speaker/two-/three-line pages keep their natural v27 height.
        const line = parseFloat(getComputedStyle(text).lineHeight);
        box.classList.toggle("short-dialogue", !box.querySelector(".dialog-speaker,.dialog-actions") &&
          text.scrollHeight <= Math.ceil(line) + 1);
        // Main story dialogue stays full-width and LEFT-aligned like the original.
        // Text fitting / single-line centering belongs only to Cupid help tips.
        const limit = canvas.clientHeight * 0.65, height = box.getBoundingClientRect().height;
        if (height > limit) {
          text.style.minHeight = "";
          text.style.maxHeight = Math.max(18 * scale, text.clientHeight - height + limit) + "px";
          text.style.overflowY = "";
        }
        // Center the complete visible copy (speaker, dialogue and choices)
        // inside the original flat panel, excluding the11px tail. Range
        // rectangles are font boxes; use native font ink metrics so Korean
        // glyphs do not look top-heavy within those boxes. Real overflow
        // remains in the same scrollable text viewport and LEFT-aligned.
        const copy = box.querySelector(".dialog-copy"), bounds = box.getBoundingClientRect();
        if (copy) {
          this.dialogTextMetrics ||= document.createElement("canvas").getContext("2d");
          const walker = document.createTreeWalker(copy, NodeFilter.SHOW_TEXT);
          let inkTop = Infinity, inkBottom = -Infinity;
          for (let node; (node = walker.nextNode());) {
            if (!node.textContent.trim()) continue;
            const element = node.parentElement, style = getComputedStyle(element),
              range = document.createRange(), scroll = element.closest(".dialog-text");
            this.dialogTextMetrics.font = style.fontWeight + " " + style.fontSize + " " + style.fontFamily;
            const metrics = this.dialogTextMetrics.measureText(node.textContent),
              clip = scroll && getComputedStyle(scroll).overflowY !== "visible" ? scroll.getBoundingClientRect() : null;
            range.selectNodeContents(node);
            for (const r of range.getClientRects()) {
              const baseline = r.top + (metrics.fontBoundingBoxAscent || parseFloat(style.fontSize)),
                top = Math.max(baseline - metrics.actualBoundingBoxAscent, clip?.top ?? -Infinity),
                bottom = Math.min(baseline + metrics.actualBoundingBoxDescent, clip?.bottom ?? Infinity);
              if (r.width && bottom > top) { inkTop = Math.min(inkTop, top); inkBottom = Math.max(inkBottom, bottom); }
            }
          }
          if (Number.isFinite(inkTop)) {
            const center = bounds.top + (14 * scale + bounds.height - 5 * scale) / 2;
            box.style.setProperty("--dialog-copy-offset", (center - (inkTop + inkBottom) / 2) + "px");
          }
        }
        const paint = () => this.paintDialogueTail(box, canvas, scale, true);
        if (!paint()) this.bubbles.ready.then(() => { if (art.isConnected) paint(); });
      }
      const tip = scene.querySelector(".scene-tip");
      if (tip && !tip.hidden) {
        const hud = scene.querySelector(".scene-hud"),
          available = hud && !hud.hidden
            ? hud.getBoundingClientRect().left - scene.getBoundingClientRect().left - 46 * scale
            : scene.clientWidth - 52 * scale;
        tip.style.maxWidth = Math.max(60 * scale, available) + "px";
        const text = tip.querySelector("span"), line = parseFloat(getComputedStyle(text).lineHeight);
        tip.classList.toggle("single-line", text.scrollHeight <= Math.ceil(line) + 1);
        const art = tip.querySelector("canvas"), paint = () => this.bubbles.draw(art, "tip", Math.round(tip.clientWidth / scale), Math.ceil(tip.clientHeight / scale));
        if (!paint()) this.bubbles.ready.then(() => { if (art.isConnected) paint(); });
      }
    }
    resetCupidTips(t = performance.now()) {
      this.cupidTip = { index: -1, text: "", until: 0, nextAt: t + CUPID_FIRST_DELAY, blocked: false };
    }
    updateFamilyChatter(t = performance.now()) {
      const layer = $("family-chatter"), canvas = $("house-canvas");
      if (!layer || !canvas || !this.chatter) return;
      const blocked = !this.playing || !this.running || !this.game ||
        this.state?.paused || this.state?.event || this.modalOpen || document.hidden || this.arrowFx.active ||
        Boolean(this.cupidTip.until && t < this.cupidTip.until);
      const worldWidth = this.art.house.width || 960, scale = canvas.clientWidth / 240,
        zoom = this.houseZoom(), figureScale = scale * zoom;
      canvas.closest(".scene-shell").style.setProperty("--pixel-scale", scale);
      const screen = new Map(), members = (this.state?.members || []).filter(p => {
        const actor = this.actors.get(p.id);
        if (p.alive === false || !actor || actor.hidden) return false;
        let x = mod(actor.x - this.scrollX, worldWidth);
        if (x > canvas.width / zoom + 32) x -= worldWidth;
        const sx = (x + 16) * zoom, y = (actor.floor - 61 - CHARACTER_RISE - this.camY) * zoom;
        if (sx < 12 || sx > 228 || y < 12 || y > canvas.height - 8) return false;
        screen.set(p.id, { x: sx, y });
        return true;
      });
      const speech = this.chatter.update(t, members, this.actors, blocked);
      if (!speech.length) {
        layer.hidden = true;
        layer.replaceChildren();
        layer.dataset.speech = "";
        return;
      }
      const signature = JSON.stringify(speech.map(line => [line.id, line.emote, line.reply]));
      if (layer.dataset.speech !== signature) {
        layer.replaceChildren(...speech.map(line => {
          const bubble = document.createElement("img");
          bubble.className = "family-chatter-bubble";
          bubble.dataset.speakerId = line.id;
          bubble.dataset.reply = line.reply ? "1" : "0";
          bubble.dataset.emote = line.emote;
          bubble.alt = "";
          bubble.draggable = false;
          return bubble;
        }));
        layer.dataset.speech = signature;
      }
      layer.hidden = false;
      const gap = 4 * scale, width = canvas.clientWidth, height = canvas.clientHeight;
      const sceneRect = canvas.getBoundingClientRect(), placed = [];
      const hud = $("scene-hud"), hudRect = hud && !hud.hidden ? hud.getBoundingClientRect() : null;
      // Give the responding icon priority if two figures stand almost together.
      for (const bubble of [...layer.children].sort((a, b) => Number(b.dataset.reply) - Number(a.dataset.reply))) {
        const id = Number(bubble.dataset.speakerId), anchor = screen.get(id);
        if (!anchor) { bubble.hidden = true; continue; }
        const reaction = speech.find(line => line.id === id);
        const frame = this.art.frame(this.art.houseEmotion, String(reaction.emote), reaction.elapsed * .06);
        const name = "house_emo_" + reaction.emote + "_" + frame;
        const image = frame >= 0 ? this.art.image(name) : null;
        if (!image?.complete || !image.naturalWidth) { bubble.hidden = true; continue; }
        if (bubble.dataset.asset !== name) {
          bubble.src = image.src;
          bubble.dataset.asset = name;
        }
        bubble.hidden = false;
        const w = 32 * figureScale, h = 32 * figureScale;
        bubble.style.width = w + "px";
        bubble.style.height = h + "px";
        // The original 32x32 bubble already includes its tail and icon.
        // Keep its original position over the figure's transparent upper area.
        const left = anchor.x * scale - w / 2, top = anchor.y * scale;
        if (left < 0 || top < 0 || left + w > width || top + h > height ||
            (hudRect && left + w > hudRect.left - sceneRect.left - gap &&
             left < hudRect.right - sceneRect.left + gap &&
             top + h > hudRect.top - sceneRect.top - gap &&
             top < hudRect.bottom - sceneRect.top + gap)) { bubble.hidden = true; continue; }
        const bounds = { left: left + 2 * scale, right: left + w - 2 * scale,
          top: top + 2 * scale, bottom: top + h };
        if (placed.some(other => bounds.left < other.right && bounds.right > other.left &&
            bounds.top < other.bottom && bounds.bottom > other.top)) { bubble.hidden = true; continue; }
        bubble.style.left = left + "px";
        bubble.style.top = top + "px";
        placed.push(bounds);
      }
    }
    showCupidTip(t = performance.now()) {
      if (!this.playing || !this.game || this.state?.event || this.modalOpen || document.hidden || this.arrowFx.active) return;
      const tip = this.cupidTip;
      const original = this.game.session?.Text.Heaven?.Tips;
      const messages = original
        ? [CUPID_TIPS[0], ...[1, 2, 4, 5].map(i => original[i]).filter(s => typeof s === "string" && /[가-힣]/.test(s) && !/[\u3040-\u30ff□]/.test(s))]
        : CUPID_TIPS;
      tip.index = (tip.index + 1) % messages.length;
      tip.text = messages[tip.index];
      tip.until = t + Math.max(5200, tip.text.length * 180);
      tip.nextAt = tip.until + CUPID_TIP_INTERVAL;
      this.updateCupidTip(t);
    }
    updateCupidTip(t = performance.now()) {
      const state = this.cupidTip, tip = this.el.querySelector(".scene-note, .scene-tip"), button = $("cupid-tip-trigger"),
        blocked = !this.playing || !this.game || this.state?.event || this.modalOpen || document.hidden || this.arrowFx.active;
      if (button) button.hidden = Boolean(blocked);
      if (blocked) {
        if (!state.blocked) state.nextAt = t + CUPID_TIP_INTERVAL;
        state.blocked = true;
        state.until = 0;
        if (tip) tip.hidden = true;
        return;
      }
      state.blocked = false;
      if (state.until && t >= state.until) state.until = 0;
      if (!state.until && t >= state.nextAt) return this.showCupidTip(t);
      if (!tip) return;
      if (!state.until) { tip.hidden = true; return; }
      const changed = tip.hidden || tip.querySelector("span")?.textContent !== state.text;
      tip.hidden = false;
      if (changed) {
        tip.className = "scene-tip";
        tip.setAttribute("role", "status");
        tip.innerHTML = '<canvas aria-hidden="true"></canvas><span></span>';
        tip.querySelector("span").textContent = state.text;
        this.updateSceneDialog();
      }
    }
    cycle(dir) {
      const a = this.state.members.filter((p) => p.alive !== false);
      if (!a.length) return;
      this.selectedId =
        a[mod(a.findIndex((p) => p.id === this.selectedId) + dir, a.length)].id;
      this.focusHousePerson();
      this.renderGame();
    }
    refresh() {
      this.state = this.game.state();
      const alive = this.state.members.filter((p) => p.alive !== false);
      if (!alive.some((p) => p.id === this.selectedId))
        this.selectedId = (alive[0] || {}).id;
      this.renderGame();
    }
    toggleRun() {
      this.running = !this.running;
      this.resetDialogueAuto();
      if (this.introFlow) {
        const button = $("run");
        if (button) button.textContent = this.running ? "Ⅱ 멈춤" : "▶ 진행";
        return;
      }
      this.persistSettings();
      this.renderGame();
    }
    tickDay() {
      if (this.offlineReturnBlocked) { this.toast("부재중 진행의 저장이 완료된 뒤 진행할 수 있어요."); return; }
      if (!this.game || this.state.paused || this.state.event) {
        this.toast("사건을 마친 뒤에 하루를 넘길 수 있어요.");
        return;
      }
      this.game.tickDay();
      this.dayFraction = 0;
      this.refresh();
      this.saveSlot("auto", true);
      this.returnToTitleAfterClosure();
    }
    eventNext() {
      this.resetDialogueAuto();
      if (this.offlineReturnBlocked) { this.toast("부재중 진행의 저장이 완료된 뒤 진행할 수 있어요."); return; }
      if (this.eventDialoguePending()) return;
      this.game.advanceEvent();
      this.refresh();
      this.saveSlot("auto", true);
      this.returnToTitleAfterClosure();
      this.maybeOfflineHistory();
    }
    eventChoice(i) {
      if (this.offlineReturnBlocked) { this.toast("부재중 진행의 저장이 완료된 뒤 진행할 수 있어요."); return; }
      if (this.eventDialoguePending()) return;
      this.game.choose(i);
      this.refresh();
      this.saveSlot("auto", true);
      this.returnToTitleAfterClosure();
      this.maybeOfflineHistory();
    }
    openModal(title, html, initialFocusId = null) {
      this.skillHelpClose?.(false);
      this.slotDeleteConfirmation = null;
      this.resetDialogueAuto();
      this.stopJournalReplay();
      this.musicOverride = -1;
      this.syncMusic();
      this.modalOpen = true;
      this.updateEventAdvanceButton();
      this.syncDialogueVoice();
      this.updateCupidTip();
      this.updateFamilyChatter();
      $("modal-root").innerHTML =
        '<div class="modal-overlay" id="modal-overlay"><section class="modal" role="dialog" aria-modal="true" aria-label="' +
        escape(title) +
        '"><header class="modal-header"><h2>' +
        escape(title) +
        '</h2><button id="modal-close" class="close-button" aria-label="닫기">×</button></header><div class="modal-body">' +
        html +
        "</div></section></div>";
      this.button("modal-close", () => this.introFlow?.read().mode === "family" ? this.cancelIntro() : this.closeModal());
      $("modal-overlay").onclick = (e) => {
        if (e.target.id === "modal-overlay") {
          if (this.introFlow?.read().mode === "family") this.cancelIntro();
          else this.closeModal();
        }
      };
      setTimeout(() => {
        const f = (initialFocusId && $(initialFocusId)) || $("modal-root").querySelector("input,button,select");
        if (f) f.focus();
      }, 20);
    }
    closeModal() {
      this.skillHelpClose?.(false);
      if (this.slotDeleteConfirmation) {
        this.slotDeleteConfirmation = null;
        this.saveDialog();
        return;
      }
      const exitReturnId = this.exitConfirmationReturnId;
      this.exitConfirmationReturnId = null;
      const offlineIds = this.offlineSummaryOpen || this.offlineReplayReturn
        ? this.offlineSummaryIds?.slice() : null;
      this.offlineSummaryOpen = false;
      this.offlineReplayReturn = null;
      this.stopJournalReplay();
      this.modalOpen = false;
      $("modal-root").innerHTML = "";
      this.musicOverride = -1;
      if (offlineIds?.length && this.game?.acknowledgeOffline) {
        this.game.acknowledgeOffline(offlineIds);
        this.saveSlot("auto", true, { preserveAnchor: true });
      }
      this.syncMusic();
      this.updateCupidTip();
      this.syncDialogueVoice();
      if (exitReturnId && this.playing) $(exitReturnId)?.focus();
      this.updateEventAdvanceButton();
    }
    syncMusic() {
      if (!this.sound) return;
      if (this.journalPlayback?.active) {
        this.syncJournalReplayAudio(this.journalPlayback);
        return;
      }
      let id, fadeIn = 0;
      if (this.recommendedReview && !this.modalOpen) id = this.recommendedReview.read().song;
      else if (this.introFlow && !this.modalOpen) id = this.introFlow.read().song;
      else if (this.modalOpen && this.musicOverride >= 0) id = this.musicOverride;
      else if (!this.playing) id = 132;
      else {
        const s = this.game.session;
        if (s.SceneMusic >= 0) id = s.SceneMusic;
        else if (s.EndMenu === 4) id = 4;
        else if (s.EndMenu === 5 || s.BookmarkAskPending || s.LineageEnded) id = 5;
        else {
          const f = this.state.family;
          id = 81 - 3 * clamp(f.grade & 15, 0, 3) + 12 * clamp(f.era, 0, 3);
          fadeIn = 0.5;
        }
      }
      this.sound.playBgm(id, { again: id === 132, fadeIn, fadeOut: 0.5 });
    }
    audioStatusText() {
      if (!this.sound?.available) return "이 브라우저에서 소리를 재생할 수 없어요.";
      if (this.bgmVolume === 0 && this.seVolume === 0) return "음악과 효과음이 꺼져 있어요. 음량을 올려 주세요.";
      if (this.audioAttemptFailed) return "소리를 켜지 못했어요. 다시 시도해 주세요.";
      switch (this.sound.status) {
        case "locked": return "아래 버튼을 눌러 소리를 켜 주세요.";
        case "loading": return "소리를 준비하고 있어요…";
        case "error": return "소리를 준비하지 못했어요. 다시 시도해 주세요.";
        case "paused": return "소리가 잠시 멈춰 있어요.";
        default: return "소리 재생이 준비됐어요.";
      }
    }
    updateAudioStatus() {
      const node = $("audio-status");
      if (node) node.textContent = this.audioStatusText();
    }
    async startAudio() {
      this.audioAttemptFailed = false;
      try {
        if (!await this.sound.unlock()) return;
        this.syncMusic();
        await this.sound.playSe(201);
      } catch (_) {
        this.audioAttemptFailed = true;
      } finally {
        this.updateAudioStatus();
      }
    }
    audioControls() {
      const select = (id, label, value) =>
        '<div class="setting-row"><label for="' + id + '">' + label +
        '</label><select id="' + id + '" class="audio-volume">' +
        [0, 0.25, 0.5, 0.8, 1].map((n) => '<option value="' + n + '"' +
          (n === value ? ' selected' : '') + '>' +
          (n === 0 ? '끔' : Math.round(n * 100) + '%') + '</option>').join('') + '</select></div>';
      return select('setting-bgm', '배경음악 음량', this.bgmVolume) +
        select('setting-se', '효과음 음량', this.seVolume) +
        '<div class="setting-row"><label for="setting-voice">대사 옹알이</label>' +
        '<select id="setting-voice" class="audio-volume"><option value="1"' +
        (this.voice.enabled ? ' selected' : '') + '>켬</option><option value="0"' +
        (!this.voice.enabled ? ' selected' : '') + '>끔</option></select></div>' +
        '<p id="audio-status" class="form-help" role="status">' + this.audioStatusText() + '</p><button type="button" id="audio-start" class="btn secondary small">소리 켜기 · 시험 재생</button>';
    }
    bindAudioControls() {
      $("setting-voice").onchange = (e) => {
        this.voice.setEnabled(e.target.value === "1");
        this.persistSettings();
      };
      for (const [id, key] of [['setting-bgm','bgmVolume'], ['setting-se','seVolume']]) {
        $(id).onchange = (e) => {
          this[key] = clamp(Number(e.target.value) || 0, 0, 1);
          this.sound.setVolumes(this.bgmVolume, this.seVolume);
          this.persistSettings();
          this.updateAudioStatus();
        };
      }
      this.button("audio-start", () => { void this.startAudio(); });
    }
    soundDialog() {
      this.openModal('원작 소리', this.audioControls());
      this.bindAudioControls();
    }
    detailDialog(p) {
      if (!p) return;
      const skills = this.detailSkills(p);
      const stats = p.stats || [p.intelligence, p.health, p.charm, p.luck],
        rank = (n) => SK.Stat.Rank(n),hit=Number(p.hitArrow??-1),
        hitName=hit>1?(SK.Interventions.Tools.find(t=>t.Kind==='arrow'&&t.OrigSlot===hit)?.Name||'화살 #'+hit):null;
      this.openModal(
        p.name + "의 이야기",
        '<div class="detail-hero"><div class="detail-profile"><img class="portrait detail-portrait" data-sex="' +
          (p.gender === 1 ? "female" : "male") + '" src="' +
          this.memberPortrait(p) +
          '" alt="' +
          escape(p.name) +
          '"><div class="detail-identity"><div class="detail-name">' +
          '<span>' + escape(p.name) + '</span><button id="rename-person" class="name-edit" aria-label="' +
          escape(p.name + ' 이름 바꾸기') + '">변경</button></div><p class="detail-sex-line">' +
          escape(p.age) +
          "세 · " +
          escape(p.gender === 1 ? "여성" : "남성") +
          '<span class="detail-hearts">' +
          this.hearts(p) +
          '</span></p><p class="detail-job">' + escape(p.jobName || "직업 " + p.job) +
          '</p></div></div><div class="detail-stats">' +
          ["지력", "체력", "매력", "운"]
            .map(
              (x, i) =>
                '<div class="stat" data-grade="' + escape(rank(stats[i] || 0)) + '"><label>' +
                x +
                "</label><strong>" +
                escape(rank(stats[i] || 0)) +
                "</strong></div>",
            )
            .join("") +
          "</div></div>" +
          this.info("기본월급", p.salaryBase === null || p.salaryBase === undefined ? "—" : money(p.salaryBase) + " / 월") +
          this.info("애인", p.loverName || (p.loverPresent ? "이름 미확인" : "없음")) +
          (p.spouseId >= 0 ? this.info("배우자", p.spouseName || "이름 미확인") : "") +
          this.info("맞은 화살", hitName || "맞은 화살 없음") +
          this.info("꿈", p.dream || "지금은 없어요.") +
          this.info("관심", p.interest === undefined ? "—" : p.interest) +
          this.info("몰입도", this.focusPercent(p) + "%") +
          this.info("숙련도", p.jobMastery === undefined ? "—" : p.jobMastery) +
          this.info("감사", p.gratitude === undefined ? "—" : p.gratitude) +
          '<div class="info-line"><label>스킬</label><div class="detail-skills">' +
          (skills.length ? skills.map((skill, index) => '<button type="button" class="skill-token" data-skill-index="' + index +
            '" aria-label="' + escape(skill.name + ' 스킬 설명') + '" aria-haspopup="dialog" aria-expanded="false">' +
            escape(skill.name) + '</button>').join('') : '<span>없음</span>') + '</div></div>',
      );
      this.button("rename-person", () => this.renameDialog(p));
      $("modal-root").querySelectorAll('[data-skill-index]').forEach((button) => {
        button.onclick = () => this.skillDescriptionDialog(skills[Number(button.dataset.skillIndex)], button);
      });
    }
    detailSkills(p) {
      return (p.skills || p.skillNames || []).map((skill) => {
        const id = typeof skill === "number" ? skill : skill?.id ?? skill?.Id,
          native = Number.isInteger(id) ? this.game?.session?.Text?.Skills[id] : null,
          name = typeof skill === "string" ? skill : v(skill, "name", native?.Name || "스킬 " + id),
          description = (typeof skill === "object" && (skill.description || skill.desc || skill.Desc)) ||
            (native ? this.game.session.SkillDesc(id) : "");
        return { name, description };
      });
    }
    skillDescriptionDialog(skill, trigger) {
      if (!skill || !trigger.isConnected) return;
      this.skillHelpClose?.(false);
      const base = $("modal-root").querySelector(".modal"),
        overlay = document.createElement("div");
      overlay.className = "skill-help-overlay";
      overlay.innerHTML = '<section class="skill-help-card" role="dialog" aria-modal="true" aria-labelledby="skill-help-name" aria-describedby="skill-help-text">' +
        '<header><h3 id="skill-help-name">' + escape(skill.name) + '</h3><button type="button" class="close-button" aria-label="스킬 설명 닫기">×</button></header>' +
        '<p id="skill-help-text">' + escape(currencyText(skill.description || "이 스킬의 설명 자료가 없어요.")) + '</p></section>';
      base.inert = true;
      trigger.setAttribute("aria-expanded", "true");
      $("modal-overlay").append(overlay);
      const button = overlay.querySelector("button"),
        close = (returnFocus = true) => {
          overlay.remove();
          base.inert = false;
          trigger.setAttribute("aria-expanded", "false");
          this.skillHelpClose = null;
          if (returnFocus && trigger.isConnected) trigger.focus();
        };
      this.skillHelpClose = close;
      button.onclick = () => close();
      overlay.onclick = (e) => { if (e.target === overlay) close(); };
      overlay.onkeydown = (e) => {
        if (e.isComposing || e.keyCode === 229) return;
        if (e.key === "Escape") { e.preventDefault(); e.stopPropagation(); close(); }
        else if (e.key === "Tab") { e.preventDefault(); button.focus(); }
      };
      button.focus();
    }
    info(label, text) {
      return (
        '<div class="info-line"><label>' +
        escape(label) +
        "</label><span>" +
        escape(currencyText(text)) +
        "</span></div>"
      );
    }
    renameDialog(p) {
      this.openModal(
        "이름 바꾸기",
        '<label class="form-label">' +
          escape(p.name) +
          '의 새 이름</label><input id="rename-input" class="input" maxlength="12" value="' +
          escape(p.name) +
          '"><div class="form-actions"><button id="rename-save" class="btn">이름 저장</button></div>',
      );
      this.button("rename-save", () => {
        const name = $("rename-input").value.trim();
        if (!name) {
          this.toast("이름을 입력해 주세요.");
          return;
        }
        if (typeof this.game.rename === "function")
          this.game.rename(p.id, name);
        else {
          this.toast("현재 포팅에서 이름 편집을 지원하지 않습니다.");
          return;
        }
        this.refresh();
        this.saveSlot("auto", true);
        this.detailDialog(this.selected());
      });
    }
    treeDialog() {
      const a = this.state.members;
      const relation = (p) => {
        const f = v(p, "fatherId", -1),
          m = v(p, "motherId", -1),
          s = v(p, "spouseId", -1),
          find = (id) => (a.find((x) => x.id === id) || {}).name;
        return [
          f >= 0 ? "아버지 " + (find(f) || f) : "",
          m >= 0 ? "어머니 " + (find(m) || m) : "",
          s >= 0 ? "배우자 " + (find(s) || s) : "",
        ]
          .filter(Boolean)
          .join(" · ");
      };
      this.openModal(
        "가족의 계보",
        a
          .map(
            (p) =>
              '<button class="tree-card" style="width:100%;text-align:left;color:inherit" data-person="' +
              p.id +
              '"><img class="portrait" data-sex="' + (p.gender === 1 ? "female" : "male") + '" src="' +
              this.memberPortrait(p) +
              '" alt=""><div><strong>' +
              escape(p.name) +
              " " +
              (p.id === this.state.family.headId ? "♛" : "") +
              this.heirTag(p) +
              "</strong><p>" +
              escape(p.age) +
              "세 · " +
              escape(p.jobName || "") +
              (p.alive === false ? " · †" : "") +
              '</p><span class="tree-meta">' +
              escape(relation(p) || "가족 관계 정보 없음") +
              "</span></div></button>",
          )
          .join("") +
          '<p class="form-help">부부·부모 관계는 원작 가족 메모리의 실제 관계 정보를 사용합니다.</p>',
      );
      document
        .querySelectorAll("[data-person]")
        .forEach(
          (b) =>
            (b.onclick = () =>
              this.act(() =>
                this.detailDialog(
                  a.find((p) => p.id === Number(b.dataset.person)),
                ),
              )),
        );
    }
    logDialog(page = 0) {
      const entries = this.game.storyJournal().slice().reverse().sort((a, b) =>
        (Number.isInteger(b.date) ? b.date : -Infinity) - (Number.isInteger(a.date) ? a.date : -Infinity)),
        pages = Math.max(1, Math.ceil(entries.length / 3));
      page = mod(page, pages);
      this.openModal(
        "우리 가족의 이야기",
        entries.length ? '<p class="form-help">사건 ' + entries.length + '개 · ' + (page + 1) + '/' + pages + '</p>' +
          entries.slice(page * 3, page * 3 + 3).map(e => '<section class="log-entry journal-row"><div class="journal-row-copy">' +
            '<p class="form-help">' + escape(Number.isInteger(e.date) && e.date >= 0 ? SK.GameDate.Format(e.date) : '날짜 기록 없음') +
            (e.personName ? ' · ' + escape(e.personName) : '') + '</p><strong>' + escape(currencyText(e.title)) + '</strong>' +
            (!e.canReplay ? '<p class="form-help">다시 볼 대사가 남아 있지 않아요.</p>' : '') + '</div>' +
            '<button class="btn secondary small journal-row-replay" data-story-replay="' + escape(e.key) + '" ' +
            'aria-label="' + escape(currencyText(e.title)) + ' 다시보기" ' + (!e.canReplay ? 'disabled' : '') + '>다시보기</button></section>').join('') +
          (pages > 1 ? '<div class="button-row"><button id="journal-prev" class="btn secondary small">◀ 이전 기록</button>' +
            '<button id="journal-next" class="btn secondary small">다음 기록 ▶</button></div>' : '')
          : '<div class="empty">아직 기록된 사건이 없어요.<br>가족에게 사건이 생기면 날짜와 함께 남아요.</div>',
      );
      document.querySelectorAll('[data-story-replay]').forEach(b =>
        b.onclick = () => this.act(() => this.journalReplayDialog(b.dataset.storyReplay, 0, page)));
      this.button('journal-prev', () => this.logDialog(page - 1));
      this.button('journal-next', () => this.logDialog(page + 1));
    }
    journalReplayDialog(key, page = 0, listPage = 0, replay = null) {
      replay ||= this.game.storyReplay(key);
      if (!replay?.views?.length) return this.logDialog(listPage);
      page = clamp(page, 0, replay.views.length - 1);
      this.openModal(currencyText(replay.title),
        '<p class="form-help">' + escape(Number.isInteger(replay.date) && replay.date >= 0 ? SK.GameDate.Format(replay.date) : '날짜 기록 없음') +
        (replay.personName ? ' · ' + escape(replay.personName) : '') + '</p>' +
        (replay.origin !== 'captured' ? '<p class="form-help">기존 기록 복원 · 당시 모습이 남아 있지 않은 기록은 지금의 가족 정보로 보여줘요.</p>' : '') +
        '<div id="journal-replay-view"><div class="scene-shell" style="width:100%;border-radius:8px;overflow:hidden"><canvas id="journal-replay-canvas" class="house-canvas" width="240" height="160" style="cursor:default"></canvas>' +
        '<div id="journal-scene-title" class="event-scene-title" hidden><span></span></div><div id="journal-replay-dialogue"></div></div></div>' +
        '<p id="journal-replay-status" class="form-help" aria-live="polite">장면 준비 중…</p>' +
        '<div class="button-row"><button id="journal-replay-prev" class="btn secondary small">이전</button>' +
        '<button id="journal-replay-toggle" class="btn secondary small">일시정지</button>' +
        '<button id="journal-replay-next" class="btn small">다음</button></div>' +
        '<div class="button-row" style="margin-top:8px"><button id="journal-replay-restart" class="btn secondary small">처음부터</button>' +
        '<button id="journal-replay-back" class="btn secondary small">기록 목록</button></div>');
      const playback = this.journalPlayback = { key, replay, page, listPage,
        elapsed: 0, pageStart: 0, last: 0, playing: true, active: true,
        released: false, ready: false, revision: 0,
        audioSong: this.journalReplaySong(replay), audioOffset: 0, audioMusicActive: false, voiceKey: null };
      this.button('journal-replay-prev', () => this.setJournalReplayPage(playback, playback.page - 1, true));
      this.button('journal-replay-next', () => this.setJournalReplayPage(playback, playback.page + 1));
      this.button('journal-replay-toggle', () => {
        playback.playing = !playback.playing; playback.last = 0;
        if (playback.playing) this.syncJournalReplayAudio(playback);
        else this.stopJournalReplayAudio(playback);
        this.updateJournalReplayStatus(playback);
      });
      this.button('journal-replay-restart', () => this.setJournalReplayPage(playback, 0, true));
      this.button('journal-replay-back', () => this.logDialog(listPage));
      void this.paintJournalReplay($('journal-replay-canvas'), replay.views[page], replay, playback);
    }
    stopJournalReplay() {
      const playback = this.journalPlayback;
      if (!playback) return;
      this.stopJournalReplayAudio(playback);
      playback.active = false;
      cancelAnimationFrame(playback.raf);
      this.journalPlayback = null;
    }
    journalReplaySong(replay) {
      // Same cartridge metadata as OrigSession.SceneMusic. Reading the ROM
      // is sufficient: no VM, native scene execution or scratch-memory write.
      const record = Number(replay.record), memory = this.game?.session?.Game?.Mem;
      if (memory && Number.isInteger(record) && record >= 0x08000000 && record < 0x0a000000 - 0x30) {
        const pointer = memory.R32(record + 0x2c);
        if (pointer >= 0x08000000 && pointer < 0x0a000000 - 4) {
          const song = memory.R32(pointer);
          if (song >= 41 && song <= 63) return song;
        }
      }
      const family = this.state.family;
      return 81 - 3 * clamp(family.grade & 15, 0, 3) + 12 * clamp(family.era, 0, 3);
    }
    stopJournalReplayAudio(playback, restart = false) {
      if (playback !== this.journalPlayback) return;
      if (playback.audioMusicActive) {
        const audio = this.sound.diagnostics;
        if (Number(audio.currentId) === playback.audioSong && audio.startTime !== null)
          playback.audioOffset = (audio.scheduledStartAt || 0) +
            Math.max(0, (this.sound.context?.currentTime || 0) - audio.startTime);
      }
      this.sound.stopEffects();
      this.sound.stopBgm(0);
      playback.audioMusicActive = false;
      if (restart) playback.audioOffset = 0;
    }
    syncJournalReplayAudio(playback) {
      if (playback !== this.journalPlayback || !playback.active) return;
      if (document.hidden || !playback.playing) {
        if (playback.audioMusicActive || this.voice.diagnostics.active || this.voice.diagnostics.pending)
          this.stopJournalReplayAudio(playback);
        return;
      }
      if (!playback.ready) return;
      if (!playback.audioMusicActive) {
        playback.audioMusicActive = true;
        void this.sound.playBgm(playback.audioSong, { startAt: playback.audioOffset, fadeOut: 0 });
      }
      if (!playback.released) return;
      const view = playback.replay.views[playback.page], key = playback.revision + ':' + playback.page;
      if (playback.voiceKey === key) return;
      // Muted/disabled dialogue is consumed, never queued for a later page.
      playback.voiceKey = key;
      if (!this.voice.enabled) return;
      const actors = view.actors || view.scene?.actors || [],
        speaker = view.speaker === '큐피트' ? 'cupid' : view.speaker === '높으신 신' ? 'god' :
          actors.find(actor => actor.name === view.speaker) ||
          (playback.replay.subject?.name === view.speaker ? playback.replay.subject : view.speaker);
      void this.voice.speak(currencyText(view.text || ''), speaker);
    }
    updateJournalReplayStatus(playback) {
      if (playback !== this.journalPlayback) return;
      const done = playback.page === playback.replay.views.length - 1 && playback.finished;
      $('journal-replay-status').textContent = (playback.page + 1) + '/' + playback.replay.views.length +
        (done ? ' · 재생 완료' : playback.playing ? ' · 자동 재생' : ' · 일시정지');
      $('journal-replay-toggle').textContent = playback.playing ? '일시정지' : '재생';
      $('journal-replay-prev').disabled = playback.page === 0;
      $('journal-replay-next').disabled = playback.page === playback.replay.views.length - 1;
    }
    setJournalReplayPage(playback, page, restart = false) {
      if (playback !== this.journalPlayback || !playback.active) return;
      if (restart) this.stopJournalReplayAudio(playback, true);
      else this.sound.stopEffects();
      const previous = playback.replay.views[playback.page],
        view = playback.replay.views[clamp(page, 0, playback.replay.views.length - 1)];
      playback.page = clamp(page, 0, playback.replay.views.length - 1);
      if (restart) {
        playback.elapsed = 0;
        playback.presentation.eventKey = '';
        playback.presentation.eventOccurrence = null;
        playback.presentation.eventReplayClock.emotion.clear();
        playback.presentation.eventReplayClock.zoom.clear();
      } else if (JSON.stringify(previous.scene) !== JSON.stringify(view.scene) &&
          (previous.scene?.pic !== view.scene?.pic || previous.scene?.back !== view.scene?.back)) {
        playback.presentation.eventKey = '';
        playback.presentation.eventOccurrence = null;
      }
      playback.pageStart = playback.elapsed; playback.last = 0;
      playback.released = false; playback.ready = false; playback.finished = false;
      playback.playing = true; playback.revision++;
      playback.presentation.state.event = view;
      $('journal-replay-dialogue').innerHTML = '';
      this.updateJournalReplayStatus(playback);
    }
    async paintJournalReplay(canvas, view, replay, playback) {
      // A detached presentation object and native scene clock. There is no
      // live event advance, VM, RNG, reward, inventory or save call in playback.
      const presentation = Object.create(this);
      presentation.el = $('journal-replay-view');
      presentation.art = Object.create(this.art);
      presentation.state = { ...this.state, family: { ...this.state.family },
        event: view, members: replay.subject ? [replay.subject] : [] };
      presentation.game = { session: { cur: { Data: replay.record }, replaying: true } };
      presentation.eventKey = ''; presentation.eventOccurrence = null; presentation.eventArt = null;
      presentation.eventReplayClock = { emotion: new Map(), zoom: new Map() };
      playback.presentation = presentation;
      presentation.renderEventTitle = (text, y, visible) => {
        const label = canvas.parentElement.querySelector('#journal-scene-title');
        if (!label) return;
        label.hidden = !visible; label.firstElementChild.textContent = currencyText(text);
        const scale = canvas.getBoundingClientRect().width / 240;
        label.style.top = y / 160 * 100 + '%';
        label.style.height = label.style.lineHeight = 30 * scale + 'px';
        label.style.fontSize = 12 * scale + 'px';
        label.firstElementChild.style.transform = 'scaleX(' +
          Math.min(1, (label.clientWidth - 2) / Math.max(1, label.firstElementChild.scrollWidth)) + ')';
      };
      presentation.selected = () => replay.subject;
      const context = canvas.getContext('2d'); context.imageSmoothingEnabled = false;
      const frame = (t) => {
        if (!playback.active || playback !== this.journalPlayback || !canvas.isConnected) return;
        try {
          if (document.hidden) playback.last = 0;
          else {
            const ready = presentation.prepareEventArt(presentation.state.event);
            if (ready && playback.playing && playback.last)
              playback.elapsed += clamp(t - playback.last, 0, 100);
            playback.last = ready ? t : 0;
            if (ready) {
              playback.ready = true;
              presentation.renderEventScene(context, playback.elapsed);
              const nativeFrame = Math.floor((playback.elapsed - presentation.eventStart) * .06),
                view = presentation.state.event;
              canvas.dataset.ready = '1'; canvas.dataset.frame = String(nativeFrame);
              canvas.dataset.page = String(playback.page); canvas.dataset.revision = String(playback.revision);
              if (!playback.released && (!view.scene?.pic || nativeFrame >= 156)) {
                playback.released = true; playback.pageStart = playback.elapsed;
                $('journal-replay-dialogue').innerHTML = presentation.dialogueHtml({ ...view, choices: [], canAdvance: true }, false)
                  .replace('id="event-next"', 'id="journal-dialogue-next"');
                $('journal-dialogue-next').onclick = () => this.act(() => {
                  if (playback.page < replay.views.length - 1) this.setJournalReplayPage(playback, playback.page + 1);
                });
                presentation.updateSceneDialog();
                this.updateJournalReplayStatus(playback);
              }
              if (playback.released) presentation.updateSceneDialog();
              this.syncJournalReplayAudio(playback);
              // Original dialogue was reader-driven, so use a readable web
              // autoplay hold; manual next/previous/pause remain available.
              const hold = Math.max(3000, Math.min(16000, currencyText(view.text || '').length * 85));
              if (playback.playing && playback.released && playback.elapsed - playback.pageStart >= hold &&
                  !(this.voice.enabled && (this.voice.diagnostics.active || this.voice.diagnostics.pending))) {
                if (playback.page < replay.views.length - 1) this.setJournalReplayPage(playback, playback.page + 1);
                else {
                  playback.finished = true; playback.playing = false;
                  this.stopJournalReplayAudio(playback);
                  this.updateJournalReplayStatus(playback);
                }
              }
            }
          }
        } catch (error) {
          playback.playing = false;
          this.stopJournalReplayAudio(playback);
          $('journal-replay-status').textContent = '장면을 재생하지 못했어요. 기록 목록에서 다시 열어 주세요.';
          console.error(error);
        }
        playback.raf = requestAnimationFrame(frame);
      };
      playback.raf = requestAnimationFrame(frame);
    }
    toolsDialog(kind) {
      const p = this.selected();
      const map = kind === "arrow" ? this.state.arrows : this.state.items,
        list = (SK.Interventions && SK.Interventions.Tools) || [],
        rows = Object.entries(map || {})
          .filter(([id, n]) => Number(n) > 0)
          .map(([id, n]) => {
            const def = list.find((x) => v(x, "id", "") === id) || {},
              label = v(def, "name", id),
              desc = TOOL_DESCRIPTIONS[id] || v(def, "desc", "");
            return (
              '<button class="inventory-tool" data-tool="' +
              escape(id) +
              '" ' +
              (!p || this.state.paused || this.state.event ? "disabled" : "") +
              "><div><strong>" +
              escape(label) +
              "</strong><p>" +
              escape(desc) +
              '</p></div><span class="count">× ' +
              n +
              "</span></button>"
            );
          })
          .join("");
      this.openModal(
        (kind === "arrow" ? "화살" : "아이템") + " · 공용 보관함",
        '<p class="inventory-target">' +
          (p ? '사용 대상 · <strong class="inventory-target-name">' + escape(p.name) + '</strong>' :
            '사용하려면 가족 중 한 사람을 선택해 주세요.') + '</p>' + (rows ||
          '<div class="empty">가진 ' +
            (kind === "arrow" ? "화살" : "아이템") +
            "이 없어요.</div>"),
      );
      document.querySelectorAll("[data-tool]").forEach(
        (b) =>
          (b.onclick = () =>
            this.act(() => {
              if (!p) return;
              const id = b.dataset.tool,
                result =
                  kind === "arrow"
                    ? this.game.shoot(p.id, id)
                    : this.game.useItem(p.id, id);
              this.closeModal();
              this.refresh();
              const fx = kind === "arrow" && result?.ok && !this.state.event &&
                this.actors.has(p.id) && this.arrowFx.play(p.id, id === "arrow.calm");
              if (fx) {
                this.arrowTintFor(p).pending = true;
                this.actors.get(p.id).tintPending = true;
                this.selectedId = p.id;
                this.focusHousePerson();
                this.voice.stop();
                this.updateCupidTip();
                this.updateFamilyChatter();
              } else this.toast(
                (result && result.message) ||
                  (result && result.ok
                    ? "사용했습니다."
                    : "사용하지 못했습니다."),
              );
              if (result && result.ok) this.saveSlot("auto", true);
            })),
      );
    }
    settingsDialog() {
      this.openModal(
        "설정",
        '<div class="setting-row"><label>하루 자동 진행</label><input id="setting-run" type="checkbox" ' +
          (this.running ? "checked" : "") +
          '></div><div class="setting-row"><label>선택한 가족 따라가기</label><input id="setting-follow" type="checkbox" ' +
          (this.follow ? "checked" : "") +
          '></div><p class="form-help">원본과 같은 하루 약 88초. 배속 버튼을 누를 때마다 ON/OFF가 바뀌며, ON이면 시간과 가족의 걷기·걸음 동작이 약 6.5배 빨라집니다. 멈춤·사건·메뉴에서는 진행을 멈춥니다.</p><div class="form-actions"><button id="settings-save" class="btn secondary">저장 / 불러오기</button><button id="settings-title" class="btn ghost">타이틀로 돌아가기</button></div>',
      );
      $("modal-root").querySelector(".modal-body").insertAdjacentHTML("afterbegin", this.audioControls());
      this.bindAudioControls();
      $("setting-run").onchange = (e) => {
        this.running = e.target.checked;
        this.persistSettings();
        this.renderGame();
      };
      $("setting-follow").onchange = (e) => {
        this.follow = e.target.checked;
        if (this.follow) this.focusHousePerson();
        this.persistSettings();
      };
      this.button("settings-save", () => this.saveDialog());
      this.button("settings-title", () => this.requestSaveAndExit());
    }
    aboutDialog() {
      this.openModal(
        "천년가족 · 브라우저 에디션",
        '<p>제공된 Unity 소스의 원작 규칙·트리 실행기·가족 상태와 픽셀 자료를 JavaScript/Canvas로 옮긴 비공식 브라우저 버전입니다.</p><p>타이틀·가족 입력·집·사건·천계 보고에 원작 음악을 연결하고, 버튼에는 원작 효과음을 사용합니다. 음량은 설정에서 각각 바꿀 수 있어요.</p><div class="warning">원본 Unity 게임과 모든 연출·기능이 완전히 같은 것은 아닙니다. 오프닝 동영상, 기기별 백그라운드 진행, 콘텐츠 서버 업데이트와 일부 세부 설정 화면은 제공하지 않습니다. 집 인물 행동 효과음과 대사 글자 소리는 받은 소스에도 미구현입니다.</div><p class="form-help">저장은 같은 브라우저와 파일 경로에서 유지됩니다. 브라우저의 파일 저장 정책에 따라 자동 저장이 제한될 수 있으니 중요한 가족은 JSON으로 내보내 주세요. 이 화면은 어디에도 업로드하지 않습니다.</p>',
      );
    }
    requestSaveAndExit() {
      if (!this.playing || !this.game || this.introFlow || this.introLoading || this.arrowFx.active ||
          this.exitConfirmationReturnId) return false;
      this.exitConfirmationReturnId = this.modalOpen ? "settings" : "save-exit";
      this.openModal("저장 후 종료",
        '<p id="exit-confirm-message">현재 상태를 저장하고 종료할까요?</p><div class="form-actions"><button id="exit-confirm-yes" class="btn">예</button><button id="exit-confirm-no" class="btn secondary">아니오</button></div>',
        "exit-confirm-no");
      this.button("exit-confirm-yes", () => this.saveAndExit());
      this.button("exit-confirm-no", () => this.closeModal());
      const dialog = $("modal-root").querySelector(".modal");
      dialog.setAttribute("aria-describedby", "exit-confirm-message");
      // Keep keyboard navigation inside this confirmation, with the safe
      // cancellation action initially focused. Existing modal close paths
      // (Escape, backdrop and X) all cancel without recording an exit.
      dialog.onkeydown = (e) => {
        if (e.key !== "Tab") return;
        const buttons = [...dialog.querySelectorAll("button:not([disabled])")],
          first = buttons[0], last = buttons[buttons.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault(); last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault(); first.focus();
        }
      };
      return true;
    }
    saveAndExit() {
      if (!this.playing || !this.game || this.introFlow || this.introLoading || this.arrowFx.active) return false;
      if (this.offlineReturnBlocked) {
        this.applyOfflineReturn();
        if (this.offlineReturnBlocked) return false;
      }
      const now = Date.now(), candidate = SK.restoreGame(this.game.save()),
        anchor = { version: 1, atMs: now, reason: "exit" };
      candidate.recordOffline(now);
      // Commit the candidate before replacing the live session. A denied or
      // full browser store must not spend live RNG or take the user to title.
      if (!this.saveSlot("auto", true, { game: candidate, anchor, nowMs: now })) {
        this.toast("저장을 완료하지 못해 종료하지 않았어요. 저장 내보내기를 사용해 주세요.");
        return false;
      }
      this.game = candidate;
      this.state = candidate.state();
      this.offlineGame = candidate;
      this.offlineAnchor = anchor;
      this.offlineBackground = false;
      this.showTitle();
      this.toast("저장했어요. 이제 브라우저를 닫아도 괜찮아요.");
      return true;
    }
    suspendOffline(reason = "hidden") {
      if (!this.playing || !this.game || this.introFlow || this.introLoading || this.offlineBackground) return;
      this.saveSlot("auto", true, this.offlineReturnBlocked ? { preserveAnchor: true }
        : { anchor: { version: 1, atMs: Date.now(), reason } });
      // Even when the last write fails, retain the last successful anchor.
      // pagehide/beforeunload after visibilitychange must not rebase it again.
      this.offlineBackground = true;
      this.lastFrame = 0;
    }
    resumeOffline() {
      if (!this.playing || !this.offlineBackground || !this.game || document.hidden) return;
      this.offlineBackground = false;
      this.lastFrame = 0;
      // A still-live page was only paused while minimized. Actual reopening
      // restores the hidden checkpoint through restoreEnvelope instead.
      if (this.offlineReturnBlocked) {
        this.saveSlot("auto", true, { preserveAnchor: true });
      } else {
        const now = Date.now(), anchor = { version: 1, atMs: now, reason: "checkpoint" };
        // Keep the live anchor fresh even if storage is denied, so this
        // page cannot later mistake the minimized interval for an absence.
        this.offlineAnchor = anchor;
        this.offlineGame = this.game;
        this.saveSlot("auto", true, { anchor, nowMs: now });
      }
      this.refresh();
      this.maybeOfflineHistory();
    }
    applyOfflineReturn(now = Date.now()) {
      const anchor = this.offlineAnchor;
      if (!anchor || !this.game?.queueOfflineElapsed || now - anchor.atMs < 8000) return false;
      const previous = this.game, candidate = SK.restoreGame(previous.save());
      candidate.queueOfflineElapsed(anchor.atMs, now);
      const status = candidate.offlineStatus(), through = Number(status.throughMs);
      if (!Number.isFinite(through) || through < anchor.atMs) return false;
      const nextAnchor = { version: 1, atMs: through, reason: "checkpoint" };
      // Native Begin is performed on a private candidate. The resulting
      // memo/pending-window snapshot and consumed interval are one save.
      if (!this.saveSlot("auto", true, { game: candidate, anchor: nextAnchor, nowMs: now })) {
        this.offlineReturnBlocked = true;
        this.toast("부재중 진행을 저장하지 못해 적용을 보류했어요. 저장 공간을 확인하거나 내보내 주세요.");
        return false;
      }
      this.game = candidate;
      this.offlineGame = candidate;
      this.offlineAnchor = nextAnchor;
      this.offlineReturnBlocked = false;
      this.state = candidate.state();
      return true;
    }
    maybeOfflineHistory() {
      const status = this.game?.offlineStatus?.();
      if (!status?.completed?.length || status.active || status.pending?.length ||
          this.state?.event || this.modalOpen || this.offlineBackground || this.offlineReturnBlocked || document.hidden) return;
      this.showOfflineHistory(status.completed.map(batch => batch.id));
    }
    showOfflineHistory(batchIds) {
      const status = this.game.offlineStatus(), ids = new Set(batchIds || status.completed.map(batch => batch.id)),
        batches = status.completed.filter(batch => ids.has(batch.id)),
        keys = new Set(batches.flatMap(batch => batch.historyKeys || [])),
        entries = this.game.storyJournal().filter(entry => keys.has(entry.key)).sort((a, b) => a.date - b.date),
        days = batches.reduce((total, batch) => total + (batch.appliedDays ?? batch.days), 0),
        text = this.game.session.Text;
      this.offlineSummaryIds = batches.map(batch => batch.id);
      this.offlineReplayReturn = null;
      this.openModal("부재중 가족의 역사",
        '<div id="offline-history-summary"><p class="form-help offline-history-summary-count">부재중 ' + escape(days) + '일 · 사건 ' + entries.length + '개</p>' +
        entries.map(entry => {
          const kind = SK.HistoryPresentation.classify(entry, text);
          return '<section class="offline-history-row' + (['red', 'blue'].includes(kind.colorTone) ? ' is-native-' + kind.colorTone : '') + '"><div class="offline-history-copy">' +
            '<strong class="offline-history-title">' + escape(currencyText(entry.title)) + '</strong>' +
            (entry.personName ? '<span class="offline-history-person">' + escape(entry.personName) + '</span>' : '') + '</div>' +
            '<button class="btn secondary small" data-offline-replay="' + escape(entry.key) + '" aria-label="' + escape(currencyText(entry.title)) +
            ' 다시보기"' + (!entry.canReplay ? ' disabled' : '') + '>다시보기</button></section>';
        }).join('') + (entries.length ? '' : '<p class="empty">이 기간에는 따로 기록된 사건이 없었어요.</p>') +
        '<div class="form-actions"><button id="offline-history-done" class="btn">가족 지켜보기</button></div></div>');
      this.offlineSummaryOpen = true;
      this.button("offline-history-done", () => this.closeModal());
      document.querySelectorAll("[data-offline-replay]:not(:disabled)").forEach(button => {
        button.onclick = () => this.act(() => {
          const returnIds = this.offlineSummaryIds.slice();
          this.offlineSummaryOpen = false;
          this.offlineReplayReturn = returnIds;
          this.journalReplayDialog(button.dataset.offlineReplay);
          this.offlineReplayReturn = returnIds;
          this.button("journal-replay-back", () => this.showOfflineHistory(returnIds));
        });
      });
    }
    envelope(options = {}) {
      const game = options.game || this.game, f = game.state().family,
        now = Number.isFinite(options.nowMs) ? options.nowMs : Date.now(),
        anchor = options.anchor || (options.preserveAnchor || this.offlineReturnBlocked || !this.playing
          ? this.offlineAnchor : null) || { version: 1, atMs: now, reason: "checkpoint" };
      return {
        format: "sennen-kazoku-web-save",
        version: 1,
        savedAt: new Date(now).toISOString(),
        label: { name: f.name, year: f.year, month: f.month, day: f.day },
        ui: { selectedId: this.selectedId, dayFraction: this.dayFraction },
        data: game.save(),
        offlineAnchor: { version: 1, atMs: anchor.atMs, reason: anchor.reason },
      };
    }
    saveSlot(key, quiet = false, options = {}) {
      if (!this.game || (!this.state && !options.game)) return false;
      if (this.introLoading || this.introFlow || this.ownWizard ||
          this.recommendedReview || this.introRecommendedStaged) return false;
      this.offlineCheckpointAt = Date.now();
      try {
        const previous = storeGet(key);
        if (previous) {
          try {
            JSON.parse(previous);
            storeSet(key + ":backup", previous);
          } catch (_) {}
        }
        const envelope = this.envelope(options), ok = storeSet(key, JSON.stringify(envelope));
        if (ok && (!options.game || options.game === this.game)) {
          this.offlineAnchor = envelope.offlineAnchor;
          this.offlineGame = this.game;
          this.offlineCheckpointAt = Date.now();
        }
        if (!ok && !this.storageWarned) {
          this.storageWarned = true;
          this.toast(
            "브라우저 저장이 제한돼 임시로만 보관합니다. JSON 내보내기를 사용해 주세요.",
          );
        } else if (!quiet) this.toast("슬롯에 저장했어요.");
        const status = $("save-status");
        if (status)
          status.textContent = ok
            ? "✓ 자동 저장됨"
            : "임시 저장 · 내보내기 권장";
        return ok;
      } catch (e) {
        this.toast("저장하지 못했어요: " + e.message);
        return false;
      }
    }
    loadSlot(key) {
      let s;
      try {
        s = parseSlot(key);
        if (!s) throw new Error("저장이 없습니다.");
        this.restoreEnvelope(s);
      } catch (e) {
        const primary = e;
        try {
          s = parseSlot(key, true);
          if (!s) throw primary;
          this.restoreEnvelope(s);
          this.toast("이전 정상 백업으로 복구했어요.");
        } catch (_) {
          throw new Error("저장 파일을 불러오지 못했어요: " + primary.message);
        }
      }
    }
    restoreEnvelope(s) {
      if (s.format !== "sennen-kazoku-web-save" || s.version !== 1 || !s.data)
        throw new Error("지원하지 않는 저장 형식입니다.");
      const game = SK.restoreGame(s.data);
      this.ownWizard = null;
      this.recommendedReview = null;
      this.introRecommendedStaged = false;
      this.introFlow?.cancel();
      this.introFlow = null;
      this.introLoading = false;
      this.introToken++;
      this.game = game;
      this.state = game.state();
      this.offlineGame = game;
      this.offlineAnchor = s.offlineAnchor?.version === 1 &&
        Number.isFinite(s.offlineAnchor.atMs) && s.offlineAnchor.atMs > 0
        ? { version: 1, atMs: s.offlineAnchor.atMs, reason: s.offlineAnchor.reason || "checkpoint" } : null;
      this.offlineSummaryOpen = false;
      this.offlineReplayReturn = null;
      this.offlineReturnBlocked = false;
      this.selectedId = s.ui && s.ui.selectedId;
      this.dayFraction = clamp(Number(s.ui && s.ui.dayFraction) || 0, 0, 1);
      this.actors.clear();
      this.fast = false;
      this.fastTier = 0;
      this.cameraZoom = 1;
      this.actorTime = 0;
      this.closeModal();
      this.applyOfflineReturn();
      this.enterGame();
      this.maybeOfflineHistory();
    }
    saveDialog() {
      const rows = ["auto", "1", "2", "3"]
        .map((key) => {
          const s = slotInfo(key),
            snapshot = manualSlotSnapshot(key),
            occupied = snapshot?.some((entry) => !entry.readable || entry.raw !== null || entry.cached),
            l = s && s.label,
            desc = !s
              ? occupied
                ? snapshot.some((entry) => !entry.readable) ? "저장 확인 불가" : "저장 데이터 있음"
                : "비어 있음"
              : s.corrupt
                ? "손상된 저장"
                : l
                  ? this.familyTitle(l.name) +
                    " · " +
                    l.year +
                    ". " +
                    l.month +
                    ". " +
                    l.day +
                    (s.recovered ? " · 백업 복구 가능" : "")
                  : "저장됨";
          return (
            '<section class="slot' + (key === "auto" ? ' slot-auto' : '') + '" data-slot="' + key + '"><h3>' +
            (key === "auto" ? "자동 저장" : "슬롯 " + key) +
            "</h3><p>" +
            escape(desc) +
            '</p><div class="button-row slot-actions' + (key === "auto" ? ' slot-auto-actions' : '') + '"><button class="btn secondary small" data-save="' +
            key +
            '" aria-label="' +
            (key === "auto" ? "자동 저장" : "슬롯 " + key + "에 저장") +
            '" ' +
            (!this.game || key === "auto" ? "disabled" : "") +
            '>저장</button><button class="btn small" data-load="' +
            key +
            '" aria-label="' +
            (key === "auto" ? "자동 저장 불러오기" : "슬롯 " + key + " 불러오기") +
            '" ' +
            (!s || s.corrupt ? "disabled" : "") +
            ">불러오기</button>" +
            (key === "auto" ? "" : '<button class="slot-delete btn secondary small" data-delete="' + key +
              '" aria-label="슬롯 ' + key + ' 삭제" ' + (!occupied ? "disabled" : "") + '>삭제</button>') +
            "</div></section>"
          );
        })
        .join("");
      this.openModal(
        "저장 / 불러오기",
        rows +
          '<div class="button-row"><button id="export-save" class="btn secondary small" ' +
          (!this.game ? "disabled" : "") +
          '>JSON 내보내기 ↓</button><button id="import-save" class="btn secondary small">JSON 가져오기 ↑</button></div><input id="import-file" class="file-input" type="file" accept=".json,application/json"><p class="form-help">덮어쓰기 전 마지막 정상 저장을 백업합니다. 저장 파일을 내보내면 브라우저나 기기를 바꿔도 이어 할 수 있어요.</p>',
      );
      document.querySelectorAll("[data-save]").forEach(
        (b) =>
          (b.onclick = () =>
            this.act(() => {
              this.saveSlot(b.dataset.save);
              this.saveDialog();
            })),
      );
      document
        .querySelectorAll("[data-load]")
        .forEach(
          (b) =>
            (b.onclick = () => this.act(() => this.loadSlot(b.dataset.load))),
        );
      $("modal-root").querySelectorAll("[data-delete]").forEach((b) => {
        b.onclick = () => {
          if (!b.disabled && b.isConnected && $("modal-root").contains(b))
            this.requestSlotDelete(b.dataset.delete);
        };
      });
      this.button("export-save", () => this.exportSave());
      this.button("import-save", () => $("import-file").click());
      $("import-file").onchange = (e) => this.importSave(e.target.files[0]);
    }
    requestSlotDelete(key) {
      const snapshot = manualSlotSnapshot(key);
      if (!snapshot || !snapshot.some((entry) => !entry.readable || entry.raw !== null || entry.cached)) return false;
      this.openModal("슬롯 " + key + " 삭제",
        '<p id="slot-delete-message">슬롯 ' + key + '을 삭제할까요?</p><p class="form-help">이 슬롯의 저장과 백업을 함께 삭제합니다. 현재 가족과 자동 저장은 그대로 유지돼요.</p><div class="form-actions"><button id="slot-delete-cancel" class="btn secondary">취소</button><button id="slot-delete-confirm" class="slot-delete btn secondary">삭제</button></div>',
        "slot-delete-cancel");
      const confirm = $("slot-delete-confirm"), dialog = $("modal-root").querySelector(".modal"),
        token = { key, snapshot };
      this.slotDeleteConfirmation = token;
      dialog.setAttribute("aria-describedby", "slot-delete-message");
      this.button("slot-delete-cancel", () => this.closeModal());
      this.button("slot-delete-confirm", () => {
        if (!confirm.isConnected || $("slot-delete-confirm") !== confirm || this.slotDeleteConfirmation !== token) return;
        const current = manualSlotSnapshot(key);
        if (!current.every((entry, i) => entry.readable === snapshot[i].readable && entry.raw === snapshot[i].raw &&
            entry.cached === snapshot[i].cached && entry.memory === snapshot[i].memory)) {
          this.slotDeleteConfirmation = null;
          this.saveDialog();
          this.requestSlotDelete(key);
          this.toast("저장 내용이 바뀌었어요. 다시 확인해 주세요.");
          return;
        }
        this.slotDeleteConfirmation = null;
        // Both removals run even if one fails; a surviving backup must stay
        // visible rather than silently resurrecting a supposedly empty slot.
        const primaryRemoved = storeRemove(key), backupRemoved = storeRemove(key + ":backup");
        this.saveDialog();
        this.toast(primaryRemoved && backupRemoved
          ? "슬롯 " + key + "을 삭제했어요."
          : "브라우저 저장 삭제를 완료하지 못했어요. 슬롯을 확인하고 다시 시도해 주세요.");
      });
      dialog.onkeydown = (e) => {
        if (e.key !== "Tab") return;
        const buttons = [...dialog.querySelectorAll("button:not([disabled])")],
          first = buttons[0], last = buttons[buttons.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault(); last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault(); first.focus();
        }
      };
      return true;
    }
    exportSave() {
      const blob = new Blob([JSON.stringify(this.envelope(), null, 2)], {
          type: "application/json",
        }),
        url = URL.createObjectURL(blob),
        a = document.createElement("a");
      a.href = url;
      a.download =
        "천년가족-" +
        this.state.family.name +
        "-" +
        new Date().toISOString().slice(0, 10) +
        ".json";
      document.body.append(a);
      a.click();
      a.remove();
      setTimeout(() => URL.revokeObjectURL(url), 3000);
      this.toast("가족 저장 파일을 내보냈어요.");
    }
    async importSave(file) {
      if (!file) return;
      try {
        if (file.size > 16 * 1024 * 1024)
          throw new Error("저장 파일이 너무 큽니다.");
        const s = JSON.parse(await file.text());
        this.restoreEnvelope(s);
        this.saveSlot("auto", true);
        this.toast("저장 파일을 가져왔어요.");
      } catch (e) {
        this.toast("가져오지 못했어요: " + e.message);
      }
    }
    bindCanvas() {
      const c = $("house-canvas");
      const pointers = new Map();
      let drag = null, pinch = null, suppressTap = false;
      const blocked = () => !c.isConnected || !this.playing || !this.game ||
        this.state?.event || this.modalOpen || this.offlineBackground || this.offlineReturnBlocked ||
        document.hidden || this.arrowFx.active;
      const clear = () => { pointers.clear(); drag = pinch = null; suppressTap = false; };
      const point = (p) => {
        const r = c.getBoundingClientRect();
        return { x: (p.x - r.left) * c.width / r.width,
          y: (p.y - r.top) * c.height / r.height };
      };
      const startDrag = (p) => {
        const r = c.getBoundingClientRect();
        drag = { x: p.x, y: p.y, sx: this.scrollX, sy: this.camY,
          scaleX: r.width / c.width * this.houseZoom(),
          scaleY: r.height / c.height * this.houseZoom(), moved: suppressTap };
      };
      const pair = () => {
        const [a, b] = [...pointers.values()];
        return { middle: point({ x: (a.x + b.x) / 2, y: (a.y + b.y) / 2 }),
          distance: Math.max(1, Math.hypot(a.x - b.x, a.y - b.y)) };
      };
      const stopFollowing = () => {
        this.follow = false;
        const button = $("follow");
        if (button) button.textContent = "◎ 선택한 사람 찾기";
      };
      c.onpointerdown = (e) => {
        if (blocked() || (e.pointerType === "mouse" && e.button !== 0)) return;
        if (!pointers.size) suppressTap = false;
        pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
        if (pointers.size === 1) startDrag(pointers.get(e.pointerId));
        else {
          suppressTap = true;
          const current = pair(), zoom = this.houseZoom();
          pinch = { distance: current.distance, zoom,
            wx: this.scrollX + current.middle.x / zoom,
            wy: this.camY + current.middle.y / zoom };
          drag = null;
          stopFollowing();
        }
        e.currentTarget.setPointerCapture(e.pointerId);
      };
      c.onpointermove = (e) => {
        if (!pointers.has(e.pointerId)) return;
        if (blocked()) { clear(); return; }
        pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
        const W = this.art.house.width || 960, H = this.art.house.height || 160;
        if (pinch && pointers.size >= 2) {
          const current = pair(), zoom = clamp(pinch.zoom * current.distance / pinch.distance, .5, 2);
          this.cameraZoom = zoom;
          this.scrollX = mod(pinch.wx - current.middle.x / zoom, W);
          this.camY = clamp(pinch.wy - current.middle.y / zoom, 0, Math.max(0, H - c.height / zoom));
          return;
        }
        if (!drag) return;
        const dx = (e.clientX - drag.x) / drag.scaleX,
          dy = (e.clientY - drag.y) / drag.scaleY;
        if (drag.moved || Math.abs(e.clientX - drag.x) + Math.abs(e.clientY - drag.y) > 4) {
          drag.moved = true;
          stopFollowing();
          this.scrollX = mod(drag.sx - dx, W);
          this.camY = clamp(drag.sy - dy, 0, Math.max(0, H - c.height / this.houseZoom()));
        }
      };
      const finish = (e, cancelled = false) => {
        if (!pointers.has(e.pointerId)) return;
        const tap = !cancelled && !blocked() && pointers.size === 1 && drag &&
          !drag.moved && !suppressTap;
        pointers.delete(e.pointerId);
        pinch = null;
        if (pointers.size >= 2) {
          const current = pair(), zoom = this.houseZoom();
          pinch = { distance: current.distance, zoom,
            wx: this.scrollX + current.middle.x / zoom,
            wy: this.camY + current.middle.y / zoom };
        } else if (pointers.size) startDrag([...pointers.values()][0]);
        else { drag = null; suppressTap = false; }
        if (tap) {
          const r = c.getBoundingClientRect(),
            px = (e.clientX - r.left) * c.width / r.width,
            py = (e.clientY - r.top) * c.height / r.height,
            zoom = this.houseZoom(), x = px / zoom, y = py / zoom;
          if (px >= 0 && px <= 44 && py >= 20 && py <= 64) {
            this.showCupidTip();
            return;
          }
          const found = [...this.actors.values()].find((a) => {
            let ax = mod(a.x - this.scrollX, this.art.house.width || 960);
            if (ax > c.width / zoom + 32) ax -= this.art.house.width || 960;
            const outSign = a.hidden ? this.art.ui("outing") : null;
            return (
              (!a.hidden || outSign) &&
              x >= ax - 5 &&
              x <= ax + 37 &&
              y >= a.floor - (a.hidden ? OUT_SIGN_TOP : 69 + CHARACTER_RISE) - this.camY &&
              y <= a.floor + 3 - CHARACTER_RISE - this.camY
            );
          });
          if (found) {
            this.selectedId = found.id;
            this.focusHousePerson();
            this.renderGame();
            this.detailDialog(this.selected());
          }
        }
      };
      c.onpointerup = (e) => finish(e);
      c.onpointercancel = (e) => finish(e, true);
      c.onlostpointercapture = (e) => finish(e, true);
      const cupid = $("cupid-tip-trigger");
      if (cupid) {
        // Same pan gesture as the house; only a stationary release asks for a tip.
        cupid.onpointerdown = c.onpointerdown;
        cupid.onpointermove = c.onpointermove;
        cupid.onpointerup = c.onpointerup;
        cupid.onpointercancel = c.onpointercancel;
        cupid.onlostpointercapture = c.onlostpointercapture;
        cupid.onclick = (e) => { if (e.detail === 0) this.showCupidTip(); };
      }
    }
    frame(t) {
      if (this.fatal) return;
      const dt = this.lastFrame
        ? clamp((t - this.lastFrame) / 1000, 0, 0.1)
        : 0;
      this.lastFrame = t;
      try {
        if (this.introFlow) {
          // Intro controls own presentation only: never tick the prior family.
          // Hidden/paused intervals do not catch up when the screen returns.
          if (this.running && !document.hidden && !this.modalOpen && !this.ownWizard && !this.recommendedReview)
            this.introSceneTime += dt * 1000 * this.speedMultiplier();
          this.renderIntroScene(t);
          this.updateIntroAdvanceButton();
        }
        else if (this.playing && this.game) {
          this.arrowFx.advance(t);
          // Like the supplied native GameApp, run one original 25-day bundle
          // per frame only during the memo's Progress screen. Other native
          // greeting/report/choice pages remain readable and user-controlled.
          if (!document.hidden && !this.offlineBackground && !this.offlineReturnBlocked && !this.modalOpen &&
              !this.arrowFx.active && this.state.event?.eventId === "memo-progress") {
            this.game.advanceEvent();
            this.refresh();
            if (this.state.event?.eventId !== "memo-progress") this.saveSlot("auto", true);
          }
          if (!document.hidden && !this.offlineBackground && !this.journalPlayback &&
              Date.now() - this.offlineCheckpointAt >= 5000) {
            this.offlineCheckpointAt = Date.now();
            if (this.offlineReturnBlocked) {
              if (this.applyOfflineReturn()) this.refresh();
            }
            else this.saveSlot("auto", true);
          }
          this.maybeOfflineHistory();
          if (
            this.running &&
            !this.offlineBackground &&
            !this.offlineReturnBlocked &&
            !this.arrowFx.active &&
            !this.modalOpen &&
            !document.hidden &&
            !this.state.paused &&
            !this.state.event
          ) {
            this.dayFraction += (dt * this.speedMultiplier()) / 88;
            if (this.dayFraction >= 1) {
              this.tickDay();
            }
          }
          if (
            typeof this.game.showDue === "function" &&
            !document.hidden &&
            !this.offlineBackground &&
            !this.offlineReturnBlocked &&
            !this.arrowFx.active &&
            !this.modalOpen &&
            !this.state.event
          ) {
            const changed = this.game.showDue(
              Math.trunc(1800 + this.dayFraction * 7200),
            );
            if (changed) {
              this.refresh();
              this.saveSlot("auto", true);
            }
          }
          this.renderScene(t, dt);
          const sec = Math.floor(this.dayFraction * 24 * 60);
          if (sec !== this.lastHudSecond) {
            this.lastHudSecond = sec;
            this.updateClock();
          }
        } else this.renderTitle(t);
        this.syncDialogueVoice();
        this.updateDialogueAuto(dt);
      } catch (e) {
        this.showError(e, false);
      }
      this.raf = requestAnimationFrame((x) => this.frame(x));
    }
    updateClock() {
      const el = $("scene-time");
      if (!el) return;
      const units = SK.WebHouseClock.fromFraction(this.dayFraction),
        h = Math.floor(units / 300),
        m = Math.floor((units % 300) / 5),
        slot = SK.WebHouseClock.slot(units),
        label =
          slot === 4 ? "밤" : slot === 6 ? "새벽" : slot === 2 ? "저녁" : "낮";
      el.textContent =
        String(h).padStart(2, "0") +
        ":" +
        String(m).padStart(2, "0") +
        " · " +
        label;
      const moodEl = $("scene-mood");
      if (moodEl && this.state?.family) {
        const mood = SK.CupidData.moodInfo(this.state.family.mood);
        if (moodEl.dataset.level !== String(mood.index) || !moodEl.querySelector(".scene-mood-state"))
          moodEl.innerHTML = '가족의 무드 <span class="scene-mood-state">' + escape(mood.label) + '</span>';
        moodEl.dataset.level = String(mood.index);
      }
    }
    draw(ctx, im, x, y, w, h) {
      if (!im) return;
      if (im instanceof HTMLImageElement && !im.complete) return;
      if (im instanceof HTMLImageElement && !im.naturalWidth) return;
      ctx.drawImage(
        im,
        Math.round(x),
        Math.round(y),
        Math.round(w === undefined ? im.width : w),
        Math.round(h === undefined ? im.height : h),
      );
    }
    titleViewRandom() {
      let seed = this.titleMotionSeed;
      seed ^= seed << 13; seed ^= seed >>> 17; seed ^= seed << 5;
      this.titleMotionSeed = seed >>> 0;
      return this.titleMotionSeed / 4294967296;
    }
    resetTitleCrowd() {
      // Decorative title actors have their own RNG and clock, never a native
      // family/session RNG, save field, or offline checkpoint.
      this.titleMotionSeed = (Math.floor(Math.random() * 4294967296) ^ Date.now()) >>> 0 || 1;
      this.titleMotionTime = 0;
      this.titleLastFrame = null;
      this.titleActors = [];
      this.titlePresetKeys = Object.keys(this.art.parts.presets);
      this.titleRoles = [...new Set(this.titlePresetKeys.map(key => this.art.parts.presets[key].role || key.split("_")[0]))];
      for (let i = this.titleRoles.length - 1; i > 0; i--) {
        const j = Math.floor(this.titleViewRandom() * (i + 1));
        [this.titleRoles[i], this.titleRoles[j]] = [this.titleRoles[j], this.titleRoles[i]];
      }
      for (let i = 0; i < Math.min(6, this.titlePresetKeys.length); i++) this.titleActors.push(this.makeTitleActor(i, true));
    }
    makeTitleActor(index, initial = false) {
      const role = initial ? this.titleRoles[index % this.titleRoles.length]
          : this.titleRoles[Math.floor(this.titleViewRandom() * this.titleRoles.length)],
        used = new Set(this.titleActors.map(actor => actor.key)),
        sameRole = this.titlePresetKeys.filter(key => !used.has(key) &&
          (this.art.parts.presets[key].role || key.split("_")[0]) === role),
        available = sameRole.length ? sameRole : this.titlePresetKeys.filter(key => !used.has(key)),
        keys = available.length ? available : this.titlePresetKeys,
        key = keys[Math.floor(this.titleViewRandom() * keys.length)], raw = this.art.parts.presets[key];
      return { key, look: SK.normalLook(raw), age: /^grand/.test(role) ? 72 : /7$/.test(role) ? 7 : /13$/.test(role) ? 13 : /18$/.test(role) ? 18 : 40,
        x: initial ? (index + .5) * 240 / Math.min(6, this.titlePresetKeys.length) - 10 : 0,
        dir: index % 2 ? -1 : 1, speed: 10 + this.titleViewRandom() * 10,
        gaitTime: this.titleViewRandom() * .5, pose: 2 };
    }
    renderTitle(t) {
      const c = $("title-canvas");
      if (!c) return;
      const ctx = c.getContext("2d");
      ctx.imageSmoothingEnabled = false;
      // These are the supplied, complete native 240x160 title backgrounds.
      // The 8-second palette cycle is a web presentation, not the original
      // title movie: keep the first view daytime and never scroll/crop art.
      const times = ["day", "evening", "dusk", "night"];
      this.titleArt ||= new Map();
      for (const time of times) {
        if (this.titleArt.has(time)) continue;
        const spec = root.SK_UI_ICONS?.["title_house_" + time];
        if (!spec) continue;
        const im = new Image();
        im.src = typeof spec === "string" ? spec : spec.src;
        this.titleArt.set(time, im);
      }
      const dt = document.hidden || this.modalOpen || this.titleLastFrame === null ? 0
        : clamp((t - this.titleLastFrame) / 1000, 0, .05);
      this.titleLastFrame = t;
      this.titleMotionTime += dt;
      const elapsed = this.titleMotionTime * 1000,
        time = times[Math.floor(elapsed / 8000) % times.length],
        im = this.titleArt.get(time);
      ctx.clearRect(0, 0, c.width, c.height);
      ctx.fillStyle = "#e9e6c9";
      ctx.fillRect(0, 0, c.width, c.height);
      c.dataset.timeOfDay = time;
      c.dataset.ready = "0";
      if (im && im.complete && im.naturalWidth) {
        this.draw(ctx, im, 0, 0, c.width, c.height);
        c.dataset.ready = "1";
      }
      this.titleActors.forEach((actor, i) => {
        actor.x += actor.dir * actor.speed * dt;
        actor.gaitTime += dt;
        if (actor.x < -22 || actor.x > 242) {
          const dir = actor.x < 0 ? 1 : -1, replacement = this.makeTitleActor(i);
          replacement.dir = dir; replacement.x = dir > 0 ? -20 : 240;
          this.titleActors[i] = actor = replacement;
        }
        // Native Front A/B face left, Back A/B face right, as in the house.
        actor.pose = (actor.dir < 0 ? 2 : 0) + (Math.floor(actor.gaitTime * 4) % 2);
        this.draw(ctx, this.art.look(actor.look, actor.age, actor.pose, 0), actor.x, 98, 20, 40);
      });
      const cupid = this.titleCupid = { x: 104 - Math.cos(this.titleMotionTime * Math.PI / 5) * 86,
        y: 18 + Math.sin(elapsed / 600) * 3 };
      this.draw(ctx, this.art.cupid(Math.floor(elapsed / 170)), cupid.x, cupid.y, 32, 32);
      c.dataset.titleCrowdCount = String(this.titleActors.length);
      c.dataset.titleActorKeys = this.titleActors.map(actor => actor.key).join(",");
      c.dataset.titlePositions = JSON.stringify(this.titleActors.map(actor => [actor.key, Math.round(actor.x * 100) / 100, actor.dir, actor.pose]));
      c.dataset.cupidX = cupid.x.toFixed(2);
      c.dataset.peopleScale = "0.625";
    }
    arrowTintFor(p) {
      // Presentation-only state follows each native person across house rebuilds.
      // A new/restored game starts fresh; no native/save fields are written.
      if (this.arrowTintGame !== this.game) {
        this.arrowTintGame = this.game;
        this.arrowTintStates.clear();
      }
      let state = this.arrowTintStates.get(p.id);
      if (!state) {
        state = { phase: 0, clock: 0, pending: false };
        this.arrowTintStates.set(p.id, state);
      }
