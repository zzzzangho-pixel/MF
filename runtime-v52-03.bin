      // the former 24px dark strip above it or a padded strip below it.
      const y = 0;
      ctx.fillStyle = "#172c30";
      ctx.fillRect(0, 0, ctx.canvas.width, ctx.canvas.height);
      let backName = back;
      const bf = this.art.frame(
