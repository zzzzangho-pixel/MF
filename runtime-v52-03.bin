        // Replay has one entrance clock, but each native emotion starts on
        // its first appearance and each zoom starts when that actor zooms.
        // Keep the live renderer's existing clock untouched.
        const clocks = this.eventReplayClock,
          zoomKey = i + ':' + v(a, "personId", -1),
          zoomOn = v(a, "zoom", false);
        if (clocks && !zoomOn) clocks.zoom.delete(zoomKey);
        if (clocks && zoomOn && !clocks.zoom.has(zoomKey)) clocks.zoom.set(zoomKey, t);
        const zoomFrames = clocks && zoomOn ? Math.floor((t - clocks.zoom.get(zoomKey)) * .06) : frames;
        let fig = look
          ? this.art.look(look, v(a, "age", person ? person.age : 25), backPose, 0, mirror)
          : npcKey
            ? this.art.image("ev_npc_" + npcKey)
            : null;
        if (v(a, "zoom", false)) {
          const inv = Math.max(128, 244 - 24 * Math.max(0, zoomFrames)),
            sc = 256 / inv,
            frac = (256 - inv) / 128,
            zx = cx + (120 - cx) * frac,
            zy = 68 + (60 - 68) * frac;
          ctx.save();
          ctx.beginPath();
          ctx.rect(56, y + 40, 128, 64);
          ctx.clip();
          this.draw(ctx, fig, zx - 16 * sc, y + zy - 32 * sc, 32 * sc, 64 * sc);
          ctx.restore();
        } else
          this.draw(
            ctx,
            fig,
            cx - 16,
            y + (npcKey ? 56 : 36),
            32,
            npcKey ? 48 : 64,
          );
        const anim = v(a, "anim", -1);
        if (anim >= 0) {
          const emotionKey = i + ':' + anim;
          if (clocks && !clocks.emotion.has(emotionKey)) clocks.emotion.set(emotionKey, t);
          const emotionFrames = clocks ? Math.floor((t - clocks.emotion.get(emotionKey)) * .06) : frames,
            key = anim.toString(16).toUpperCase().padStart(2, "0"),
            ef = this.art.frame(this.art.emotion, key, emotionFrames),
            crop = this.art.emotion.crop || [0, 33, 37, 39];
          if (clocks) ctx.canvas.dataset.emotionFrame = String(emotionFrames);
          if (ef >= 0)
            this.draw(
              ctx,
              this.art.emotionImage("ev_emo_" + key + "_" + ef),
              cx - 16 + crop[0],
              y + crop[1],
              crop[2],
              crop[3],
            );
        }
      });
      if (band) {
        const offsets = [
            -28, -26, -23, -20, -17, -13, -8, -3, 1, -2, -4, -6, -8, -9, -10,
            -10, -10, -9, -8, -6, -3, -1, 1, 0, -1, -2, -2, -2, -1, 0,
          ],
          k = frames - 68,
          by = k < 0 ? -30 : k < offsets.length ? offsets[k] : 0;
        this.draw(ctx, this.art.image(band), 0, y + by, 240, 30);
        this.renderEventTitle(e.title, y + by, by > -28);
      }
      if (frames >= 148) {
        const cy =
          frames < 152
            ? 8 - 2 * (frames - 148)
            : [0, 1, 2, 1][Math.floor((frames - 152) / 8) % 4];
        this.draw(ctx, this.art.image("ev_cupid"), 8, y + 64 + cy, 32, 40);
        ctx.canvas.skCupidAnchor = { speaker: "큐피트", x: 24, y: 80 + cy,
          width: ctx.canvas.width, height: ctx.canvas.height };
      }
      const black = 1 - clamp(Math.floor((frames - 17) / 2.875), 0, 16) / 16;
      if (black > 0) {
        ctx.fillStyle = "rgba(0,0,0," + black + ")";
        // Unity's112px mask covered its entire cropped112px event stage.
        // This web stage displays the full160px art, so fade the full stage.
        ctx.fillRect(0, 0, ctx.canvas.width, ctx.canvas.height);
      }
    }
  }
  SK.startApp = function () {
    if (app) return app;
    try {
      if (typeof SK.createGame !== "function")
        throw new Error("게임 규칙 모듈을 읽지 못했습니다.");
      app = new GameApp();
      SK.app = app;
      return app;
    } catch (e) {
      console.error(e);
      $("app").innerHTML =
        '<section class="error-screen"><h1>게임 실행 오류</h1><pre>' +
        escape(e.message || e) +
        "</pre></section>";
      throw e;
    }
  };
  SK.WebSave = { slotInfo, storeGet, storeSet, storeRemove };
})(globalThis);

</script>
<script>
/* Cupid's sky menu. All displayed game values come from CupidData's private,
 * read-only native snapshot. Only explicit name actions write a save.
 * Reference screenshots are not embedded or redistributed by this UI. */
(function (root) {
  "use strict";
  const SK = (root.SK = root.SK || {}), contexts = new WeakMap();
  const esc = (s) => String(s == null ? "" : s).replace(/[&<>"']/g, c =>
    ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]);
  const amount = n => Number.isFinite(Number(n)) ? Number(n).toLocaleString("ko-KR") : "—";
  const cash = n => SK.Currency.formatNative(n);
  const byId = id => document.getElementById(id);
  const button = (id, label, className = "secondary", disabled = false) =>
    '<button type="button" id="' + id + '" class="btn ' + className + '"' +
      (disabled ? ' disabled' : '') + '>' + esc(label) + '</button>';
  const line = (label, value, className = "") =>
    '<div class="cupid-info-line ' + className + '"><dt>' + esc(label) +
    '</dt><dd>' + esc(value) + '</dd></div>';
  const textOf = message => SK.Currency.text(typeof message === "string" ? message : message?.text || "");

  class CupidMenu {
    constructor(app) {
      this.app = app;
      this.opener = document.activeElement;
      this.stack = [];
      this.current = null;
      this.disposed = false;
      this.frame = -1;
      this.focusTimer = 0;
      this.animation = 0;
      // A failed read must not leave keyboard/observer ownership behind.
      this.read();
      this.keyListener = event => this.keydown(event);
      document.addEventListener("keydown", this.keyListener, true);
      this.observer = new MutationObserver(() => {
        if (!byId("modal-root")?.querySelector(".cupid-owned")) this.dispose();
      });
      this.observer.observe(byId("modal-root"), { childList: true, subtree: false });
    }
    read() {
      this.data = SK.CupidData.snapshot(this.app.game);
      return this.data;
    }
    message(id) {
      return textOf(SK.CupidData.message(this.app.game, id));
    }
    familyName() {
      return typeof this.app.familyTitle === "function"
        ? this.app.familyTitle(this.data.familyName)
        : this.data.familyName + "씨 가족";
    }
    person(id) {
      return (this.app.state?.members || []).find(p => Number(p.id) === Number(id));
    }
    on(id, callback) {
      const node = byId(id);
      if (node) node.onclick = event => this.app.act(() => callback(event));
    }
    navigate(view, options = {}) {
      if (this.current) this.stack.push({ ...this.current });
      this.show(view, options);
    }
    back() {
      const previous = this.stack.pop();
      if (previous) this.show(previous.view, previous.options);
      else this.close();
    }
    close() {
      this.app.closeModal();
      this.dispose();
    }
    dispose() {
      if (this.disposed) return;
      this.disposed = true;
      this.observer.disconnect();
      document.removeEventListener("keydown", this.keyListener, true);
      cancelAnimationFrame(this.animation);
      clearTimeout(this.focusTimer);
      if (contexts.get(this.app) === this) contexts.delete(this.app);
      const opener = this.opener;
      requestAnimationFrame(() => {
        if (!this.app.modalOpen && opener?.isConnected) opener.focus({ preventScroll: true });
      });
    }
    keydown(event) {
      if (this.disposed || !byId("modal-root")?.querySelector(".cupid-owned")) return;
      if (event.isComposing || event.keyCode === 229) return;
      if (event.key === "Escape") {
        // An IME or phone keyboard owns Escape inside an editable field.
        if (event.target.closest("input,textarea,select")) return;
        event.preventDefault();
        event.stopImmediatePropagation();
        this.back();
        return;
      }
      const modal = byId("modal-root").querySelector(".modal"),
        focusable = Array.from(modal.querySelectorAll('button:not(:disabled),input:not(:disabled),select:not(:disabled),a[href]'))
          .filter(node => !node.hidden && node.getClientRects().length);
      if (event.key === "Tab" && focusable.length) {
        const first = focusable[0], last = focusable[focusable.length - 1];
        if (event.shiftKey && (document.activeElement === first || !modal.contains(document.activeElement))) {
          event.preventDefault(); last.focus();
        } else if (!event.shiftKey && (document.activeElement === last || !modal.contains(document.activeElement))) {
          event.preventDefault(); first.focus();
        }
      }
      if (this.current?.view !== "menu" || !["ArrowUp", "ArrowDown", "Home", "End"].includes(event.key)) return;
      const rows = Array.from(modal.querySelectorAll("[data-cupid-menu]:not(:disabled)"));
      if (!rows.length) return;
      event.preventDefault();
      const old = rows.indexOf(document.activeElement);
      const index = event.key === "Home" ? 0 : event.key === "End" ? rows.length - 1 :
        (Math.max(0, old) + (event.key === "ArrowDown" ? 1 : -1) + rows.length) % rows.length;
      rows[index].focus();
    }
    animate() {
      cancelAnimationFrame(this.animation);
      const update = time => {
        if (this.disposed) return;
        const image = byId("cupid-sky-figure"), frame = Math.floor(time / 170);
        if (image && frame !== this.frame) {
          const native = this.app.art.cupid(frame);
          if (native?.src && image.src !== native.src) image.src = native.src;
          this.frame = frame;
        }
        this.animation = requestAnimationFrame(update);
      };
      this.animation = requestAnimationFrame(update);
    }
    mood() {
      const mood = this.data.mood;
      return '<section class="cupid-mood" aria-label="가족의 무드 ' + esc(mood.label) +
        '"><div class="cupid-mood-track" role="img" aria-label="5단계 중 ' +
        (Number(mood.index) + 1) + '단계"><span aria-hidden="true">−</span>' +
        [0, 1, 2, 3, 4].map(i => '<i class="cupid-mood-cell mood-' + i +
          (i === Number(mood.index) ? ' is-lit' : '') + '"></i>').join("") +
        '<span aria-hidden="true">＋</span></div><p>가족의 무드 <strong class="cupid-mood-state">' + esc(mood.label) +
        '</strong></p></section>';
    }
    render(title, content, speech = "", options = {}) {
      clearTimeout(this.focusTimer);
      const image = this.app.art.cupid(0);
      this.app.openModal(title,
        '<div class="cupid-shell" data-cupid-view="' + esc(this.current?.view || "") + '">' +
        '<div class="cupid-skyline" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>' +
        '<header class="cupid-summary"><div><span>' + esc(this.data.generation) + '대째</span><strong>' +
        esc(this.familyName()) + '</strong></div><p class="' + (this.data.cash < 0 ? 'is-negative' : '') +
        '">소지금 <b>' + esc(cash(this.data.cash)) + '</b></p></header>' +
        '<div class="cupid-stage"><aside class="cupid-guide"><img id="cupid-sky-figure" src="' +
        esc(image?.src || "") + '" width="72" height="72" alt="큐피트"></aside>' +
        '<section class="cupid-panel">' + content + '</section></div>' +
        (speech ? '<section class="cupid-speech" aria-label="큐피트의 말"><span class="cupid-speaker">큐피트</span>' +
          '<p>' + esc(SK.Currency.text(speech)) + '</p></section>' : '') +
        (options.hideMood ? '' : this.mood()) +
        '<footer class="cupid-footer">' + button("cupid-back", this.stack.length ? "‹ 뒤로" : "‹ 집으로", "secondary small") +
        (options.footer || "") + '</footer></div>');
      const modal = byId("modal-root").querySelector(".modal");
      modal.classList.add("cupid-modal", "cupid-owned");
      byId("modal-overlay").classList.add("cupid-overlay");
      this.on("cupid-back", () => this.back());
      this.on("modal-close", () => this.close());
      this.animate();
      this.focusTimer = setTimeout(() => {
        const target = byId(options.focus || "") || modal.querySelector("[data-cupid-menu]") ||
          modal.querySelector(".cupid-panel button:not(:disabled),.cupid-panel input,.cupid-panel select") || byId("cupid-back");
        target?.focus({ preventScroll: true });
      }, 25);
    }
    show(view, options = {}) {
      if (this.disposed) return;
      this.current = { view, options };
      switch (view) {
        case "menu": return this.menu();
        case "generation": return this.diagnosis();
        case "diagnosis-row": return this.diagnosisRow(options.key);
        case "generation-info": return this.generationInfo();
        case "generation-row": return this.generationRow(options.key);
        case "budget": return this.budget();
        case "history": return this.history(options);
        case "history-replay": return this.historyReplay(options);
        case "family": return this.family();
        case "person": return this.personInfo(options.id);
        case "rename": return this.renamePerson(options.id);
        case "save-slots": return this.delegate(() => this.app.saveDialog());
        case "player": return this.player();
        case "names": return this.names(options);
        case "name-add": return this.nameAdd(options.sex);
        case "name-delete": return this.nameDelete(options);
      }
    }
    menu() {
      this.read();
      const rows = this.data.menuItems.map(item =>
        '<button type="button" class="cupid-menu-row" data-cupid-menu="' + esc(item.id) + '"><span>' +
        esc(item.label) + '</span><span aria-hidden="true">›</span></button>').join("");
      this.render("큐피트의 메모", '<nav class="cupid-menu-list" aria-label="큐피트 메뉴">' + rows + '</nav>');
      document.querySelectorAll("[data-cupid-menu]").forEach(node => {
        node.onclick = () => this.app.act(() => {
          if (node.dataset.cupidMenu === "tree") return this.navigate("family");
          if (node.dataset.cupidMenu === "end") return this.app.showTitle();
          this.navigate(node.dataset.cupidMenu);
        });
      });
    }
    diagnosis() {
      const rows = this.data.diagnosis.map(row => {
        const enabled = Array.isArray(row.advice) && row.advice.length;
        return '<button type="button" class="cupid-diagnosis-row" data-diagnosis="' + esc(row.key) + '"' +
          (!enabled ? ' disabled' : '') + '><span>' + esc(row.label) + '</span><span class="cupid-evaluation evaluation-' +
          esc(row.value) + '"><span aria-hidden="true">⌂</span>' + esc(row.word) + '</span></button>';
      }).join("");
      this.render(this.data.generation + "대째 정보", '<div class="cupid-diagnosis">' + rows + '</div>' +
        '<div class="cupid-panel-actions">' + button("cupid-generation-next", "다음 · 세대 정보") + '</div>',
        this.message(214).replace(/[AＡ]\s*버튼(?:으로|을)\s*눌러\s*줘/g, "터치해줘"));
      document.querySelectorAll("[data-diagnosis]:not(:disabled)").forEach(node => {
        node.onclick = () => this.app.act(() => this.navigate("diagnosis-row", { key: node.dataset.diagnosis }));
      });
      this.on("cupid-generation-next", () => this.navigate("generation-info"));
    }
    diagnosisRow(key) {
      const row = this.data.diagnosis.find(item => item.key === key);
      if (!row) return this.back();
      this.render(row.label + " 진단", '<div class="cupid-evaluation-large evaluation-' + esc(row.value) + '">' +
        '<span aria-hidden="true">⌂</span><strong>' + esc(row.word) + '</strong></div>',
        row.advice.map(textOf).filter(Boolean).join("\n\n"));
    }
    generationInfo() {
      const head = this.data.head, heir = this.data.heir;
      const rows = [
        { key: "head", label: this.data.generation + "대째 세대주", value: head?.name || "없음", enabled: !!this.person(head?.id) },
        { key: "cash", label: "소지금", value: cash(this.data.cash), enabled: true },
        { key: "house", label: "살고 있는 집", value: this.data.housing?.name || "—", enabled: true },
        { key: "car", label: "소유한 자동차", value: this.data.car?.name || "없음", enabled: true },
        { key: "heir", label: "차기 세대주 후보", value: heir?.name || "—", enabled: !!this.person(heir?.id) },
      ].map(row => '<button type="button" class="cupid-info-button' + (row.key === "cash" && this.data.cash < 0 ? ' is-negative' : '') +
        '" data-generation-row="' + row.key + '"' + (!row.enabled ? ' disabled' : '') + '><span>' + esc(row.label) +
        '</span><strong>' + esc(row.value) + '</strong></button>').join("");
      this.render(this.data.generation + "대째 세대 정보", rows + '<div class="cupid-panel-actions">' +
        button("cupid-budget-next", "다음 · 이번 달 수지") + '</div>',
        textOf(this.data.generationAdvice).replace(/\n[ \t]*\n+/g, "\n"));
      document.querySelectorAll("[data-generation-row]:not(:disabled)").forEach(node => {
        node.onclick = () => this.app.act(() => this.navigate("generation-row", { key: node.dataset.generationRow }));
      });
      this.on("cupid-budget-next", () => this.navigate("budget"));
    }
    generationRow(key) {
      if (key === "head" || key === "heir") {
        const person = this.person(this.data[key]?.id);
        if (person) return this.personInfo(person.id);
        return this.back();
      }
      const labels = { house: "살고 있는 집", car: "소유한 자동차", cash: "소지금" },
        speech = key === "house" ? this.data.houseAdvice : key === "car" ? this.data.carAdvice : this.data.moneyAdvice,
        value = key === "house" ? this.data.housing?.name : key === "car" ? this.data.car?.name || "없음" : cash(this.data.cash);
      this.render(labels[key], '<p class="cupid-feature-value">' + esc(value || "—") + '</p>',
        key === "car" && this.data.car?.id < 0 ? "아직 자동차를 가지고 있지 않아요." : textOf(speech));
    }
    budget() {
      this.render("이번 달 수지 예상", '<dl class="cupid-info-list">' + line("수입", "＋ " + cash(this.data.income)) +
        line("생활비", "− " + cash(this.data.expenses), "is-negative") +
        line("합계", (this.data.total > 0 ? "＋ " : "") + cash(this.data.total),
          "cupid-budget-total" + (this.data.total < 0 ? " is-negative" : "")) + '</dl>' +
        '<div class="cupid-panel-actions">' + button("cupid-budget-done", "메뉴로") + '</div>', textOf(this.data.budgetAdvice));
      this.on("cupid-budget-done", () => { this.stack = []; this.show("menu"); });
    }
    history(options = {}) {
      const filter = options.personId == null ? "all" : String(options.personId),
        entries = (this.data.history || this.app.game.storyJournal()).slice().sort((a, b) =>
          (Number.isInteger(b.date) ? b.date : -Infinity) - (Number.isInteger(a.date) ? a.date : -Infinity)),
        filtered = filter === "all" ? entries : entries.filter(entry => String(entry.personId) === filter),
        members = (this.app.state?.members || []).map(person => ({ ...person })), pages = Math.max(1, Math.ceil(filtered.length / 3)),
        page = Math.min(pages - 1, Math.max(0, Number(options.page) || 0));
      for (const entry of entries) {
        if (!Number.isInteger(entry.personId) || entry.personId < 0 || members.some(person => person.id === entry.personId)) continue;
        members.push({ id: entry.personId, name: entry.personName || "이름 기록 없음", historical: true });
      }
      this.current.options = { personId: filter, page };
      const filters = '<button type="button" class="cupid-history-filter' + (filter === "all" ? ' is-selected' : '') +
        '" data-history-person="all" aria-pressed="' + (filter === "all") + '">⌂ 가족 전체</button>' +
        members.map(person => '<button type="button" class="cupid-history-filter' + (filter === String(person.id) ? ' is-selected' : '') +
          '" data-history-person="' + esc(person.id) + '" aria-pressed="' + (filter === String(person.id)) + '">' +
          (person.historical ? '<span class="cupid-history-memory" aria-hidden="true">✧</span>' : '<img src="' + esc(this.app.avatar(person)) + '" alt="">') +
          '<span>' + esc(person.name) + (person.historical ? ' · 기록' : '') + '</span></button>').join("");
      const rows = filtered.slice(page * 3, page * 3 + 3).map(entry => {
        const kind = SK.HistoryPresentation.classify(entry, this.app.game.session.Text),
          replay = SK.HistoryPresentation.replayInfo(entry);
        return '<section class="cupid-history-row' + (kind.important ? ' is-important' : '') + '"><div><p>' +
          esc(Number.isInteger(entry.date) && entry.date >= 0 ? SK.GameDate.Format(entry.date) : "날짜 기록 없음") +
          (entry.personName ? ' · ' + esc(entry.personName) : '') + '</p><strong>' + esc(SK.Currency.text(entry.title)) + '</strong>' +
          '<div class="cupid-history-badges">' +
          (kind.important ? '<span class="cupid-history-badge is-important">' + esc(kind.label) + '</span>' : '') +
          '<span class="cupid-history-badge" title="' + esc(replay.detail) + '">' + esc(replay.label) + '</span></div></div>' +
          '<button type="button" class="btn secondary small" data-cupid-replay="' + esc(entry.key) + '"' +
          (!entry.canReplay ? ' disabled' : '') + ' aria-label="' + esc(SK.Currency.text(entry.title)) + ' 다시보기">다시보기</button></section>';
      }).join("");
      this.render("가족의 역사", '<div class="cupid-history-filters" aria-label="기록 대상">' + filters + '</div>' +
        '<p class="cupid-count">사건 ' + filtered.length + '개' + (filtered.length ? ' · ' + (page + 1) + '/' + pages : '') + '</p>' +
        (rows || '<p class="cupid-empty">아직 기록된 사건이 없어요.</p>') +
        (pages > 1 ? '<div class="cupid-panel-actions">' + button("cupid-history-prev", "‹ 이전", "secondary small", page === 0) +
          button("cupid-history-next", "다음 ›", "secondary small", page === pages - 1) + '</div>' : ''), "",
        { footer: button("cupid-history-family", "가족 보기", "secondary small"), hideMood: true });
      document.querySelectorAll("[data-history-person]").forEach(node => {
        node.onclick = () => this.app.act(() => this.show("history", { personId: node.dataset.historyPerson, page: 0 }));
      });
      document.querySelectorAll("[data-cupid-replay]:not(:disabled)").forEach(node => {
        node.onclick = () => this.app.act(() => {
          this.navigate("history-replay", { key: node.dataset.cupidReplay });
        });
      });
      this.on("cupid-history-prev", () => this.show("history", { personId: filter, page: page - 1 }));
      this.on("cupid-history-next", () => this.show("history", { personId: filter, page: page + 1 }));
      this.on("cupid-history-family", () => this.navigate("family"));
    }
    historyReplay(options) {
      this.delegate(() => this.app.journalReplayDialog(options.key));
      this.on("journal-replay-back", () => this.back());
    }
    family() {
      this.delegate(() => this.app.treeDialog());
      document.querySelectorAll("[data-person]").forEach(node => {
        node.onclick = () => this.app.act(() => this.navigate("person", { id: Number(node.dataset.person) }));
      });
    }
    personInfo(id) {
      const person = this.person(id);
      if (!person) return this.back();
      this.delegate(() => this.app.detailDialog(person));
      this.on("rename-person", () => this.navigate("rename", { id: person.id }));
    }
    renamePerson(id) {
      const person = this.person(id);
      if (!person) return this.back();
      this.delegate(() => this.app.renameDialog(person));
      this.on("rename-save", () => {
        const name = byId("rename-input").value.trim();
        if (!name) return this.app.toast("이름을 입력해 주세요.");
        this.app.game.rename(person.id, name);
        this.app.refresh();
        this.app.saveSlot("auto", true);
        this.read();
        this.back();
      });
    }
    delegate(callback) {
      clearTimeout(this.focusTimer);
      cancelAnimationFrame(this.animation);
      callback();
      const modal = byId("modal-root")?.querySelector(".modal");
      if (!modal) return;
      modal.classList.add("cupid-owned");
      const actions = document.createElement("div");
      actions.className = "cupid-delegate-back";
      actions.innerHTML = button("cupid-delegate-back", "‹ 뒤로", "secondary small");
      modal.querySelector(".modal-body").prepend(actions);
      this.on("cupid-delegate-back", () => this.back());
      this.on("modal-close", () => this.close());
    }
    player() {
      const data = this.data, rank = Number(data.godRank);
      this.render("당신의 정보", '<dl class="cupid-info-list">' + line("신님의 이름", data.playerName) +
        line("신님 랭크", rank === 0 ? "별 없는 신님" : rank + "성 신님") +
        line("감사의 마음", amount(data.gratitude) + "개") +
        line(rank >= 50 ? "최고 랭크" : "다음 랭크까지", rank >= 50 ? "더 이상 랭크가 오르지 않아요." :
          "앞으로 " + amount(data.nextGratitude) + "개", "cupid-rank-next") + '</dl>', textOf(data.rankTip));
    }
    nameBook() {
      return typeof SK.NameBook?.names === "function" ? SK.NameBook.names(this.app.game) : null;
    }
    names(options = {}) {
      const book = this.nameBook(), sex = options.sex === "female" ? "female" : "male";
      if (!book) {
        this.render("작명서", '<p class="cupid-empty">작명서 관리 기능을 사용할 수 없어요.</p>', "",
          { footer: button("cupid-person-names", "가족 이름 바꾸기", "secondary small") });
        this.on("cupid-person-names", () => this.navigate("family"));
        return;
      }
      const names = book.filter(entry => entry.gender === (sex === "female" ? 1 : 0)),
        addSupported = typeof SK.NameBook.add === "function",
        deleteSupported = typeof SK.NameBook.remove === "function";
      this.current.options = { sex };
      this.render("작명서", '<div class="cupid-name-tabs" aria-label="작명서 대상">' +
        ['male', 'female'].map(id => '<button type="button" class="cupid-name-tab' + (id === sex ? ' is-selected' : '') +
          '" data-name-sex="' + id + '" aria-pressed="' + (id === sex) + '">' + (id === "male" ? "남자아이" : "여자아이") + '</button>').join("") +
        '</div><p class="cupid-count">등록 ' + names.length + '개' +
        '</p><div class="cupid-names-list">' + (names.length ? names.map((name, index) =>
          '<div class="cupid-name-entry"><span>' + esc(name.name) + '</span><button type="button" class="btn ghost small" data-name-delete="' +
          esc(name.id) + '"' + (!deleteSupported ? ' disabled' : '') + ' aria-label="' + esc(name.name) + ' 삭제">삭제</button></div>').join("") :
          '<p class="cupid-empty">등록된 이름이 없어요.</p>') + '</div><div class="cupid-panel-actions">' +
        button("cupid-name-add", "이름 등록", "secondary", !addSupported) + '</div>',
        "등록한 이름은 새로 태어나는 아이의 이름을 지을 때 사용해요.");
      document.querySelectorAll("[data-name-sex]").forEach(node => {
        node.onclick = () => this.app.act(() => this.show("names", { sex: node.dataset.nameSex }));
      });
      document.querySelectorAll("[data-name-delete]:not(:disabled)").forEach(node => {
        node.onclick = () => this.app.act(() => this.navigate("name-delete", { sex, id: node.dataset.nameDelete }));
      });
      this.on("cupid-name-add", () => this.navigate("name-add", { sex }));
    }
    nameAdd(sex) {
      this.render("이름 등록", '<form id="cupid-name-form"><label class="form-label" for="cupid-new-name">' +
        (sex === "female" ? "여자아이" : "남자아이") + ' 이름</label><input class="input" id="cupid-new-name" maxlength="24" autocomplete="off">' +
        '<p class="cupid-setting-note">이름은 12자까지 등록할 수 있어요.</p>' +
        '<p id="cupid-name-error" class="cupid-form-error" role="status"></p><div class="cupid-panel-actions">' +
        button("cupid-name-submit", "작명서에 등록") + '</div></form>', "새로 등록할 이름을 입력해 줘！", { focus: "cupid-new-name" });
      const submit = () => {
        const name = byId("cupid-new-name").value.trim();
        if (!name) { byId("cupid-name-error").textContent = "이름을 입력해 주세요."; return; }
        const result = SK.NameBook.add(this.app.game, { name, gender: sex === "female" ? 1 : 0 });
        if (result === false || result?.ok === false) {
          byId("cupid-name-error").textContent = result?.message || "이름을 등록하지 못했어요."; return;
        }
        this.app.refresh();
        const stored = this.app.saveSlot("auto", true);
        this.stack.pop(); this.show("names", { sex });
        this.app.toast(stored ? "이름을 작명서에 등록했어요." : "이름은 등록했지만 자동 저장을 확인하지 못했어요.");
      };
      byId("cupid-name-form").onsubmit = event => { event.preventDefault(); this.app.act(submit); };
      this.on("cupid-name-submit", submit);
    }
    nameDelete(options) {
      const value = this.nameBook()?.find(entry => String(entry.id) === String(options.id)), name = value?.name;
      if (!name) return this.back();
      this.render("이름 삭제", '<p class="cupid-feature-value">' + esc(name) + '</p><div class="cupid-panel-actions">' +
        button("cupid-name-delete-yes", "예 · 삭제") + button("cupid-name-delete-no", "아니오", "secondary") + '</div>',
        "이 이름을 작명서에서 지워도 돼？");
      this.on("cupid-name-delete-no", () => this.back());
      this.on("cupid-name-delete-yes", () => {
        const result = SK.NameBook.remove(this.app.game, value.id);
        if (result === false || result?.ok === false) { this.app.toast(result?.message || "이름을 지우지 못했어요."); return; }
        this.app.refresh();
        const stored = this.app.saveSlot("auto", true);
        this.stack.pop(); this.show("names", { sex: options.sex });
        this.app.toast(stored ? "이름을 작명서에서 지웠어요." : "이름은 지웠지만 자동 저장을 확인하지 못했어요.");
      });
    }
  }
  SK.CupidMenu = {
    open(app) {
      if (!app?.game || !app.state || !SK.CupidData) return false;
      contexts.get(app)?.dispose();
      let menu;
      try { menu = new CupidMenu(app); }
      catch (error) { app.toast("큐피트 메모를 열지 못했어요: " + error.message); return false; }
      contexts.set(app, menu);
      menu.show("menu");
      return true;
    },
    dispose(app) { contexts.get(app)?.dispose(); },
  };
})(globalThis);

</script>
<script>
/* Native reference-only event presentation. No VM call, rule, inventory or save
 * writes: raw color markers are parallel metadata; pre-event cues are view clocks.
 * Load after app.js and before boot.js. */
(function (root) {
  "use strict";
  const SK = root.SK = root.SK || {}, PALETTE = Object.freeze({10:"#000000",11:"#DE0000",12:"#0000DE",13:"#00BD00"}),
    arrayStyles = new WeakMap(), rawStyles = new WeakMap(), pageStyles = new WeakMap(), textStyles = new Map(),
    diagnostics = { colorPages:0, rejectedStyles:0, preludes:0, completed:0 },
    mod = (n,m) => ((n%m)+m)%m, clamp = (v,lo,hi) => Math.max(lo,Math.min(hi,v)),
    esc = s => String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
  const CHARSET = t => t?.Charset || {};
  function normalized(chars,trim=true) {
    let a=chars.slice(), s=a.map(x=>x.text).join("");
    for(const token of ["은/는","이/가","을/를","과/와","와/과","(으)로","⑦"]){
      let k;
      while((k=s.indexOf(token))>=0){
        const prefix=k?s.slice(k-1,k):"", replacement=SK.OrigText.FixJosa(prefix+token).slice(prefix.length),
          offset=Array.from(s.slice(0,k)).length, count=Array.from(token).length, color=a[offset]?.color??10;
        a.splice(offset,count,...Array.from(replacement,text=>({text,color})));s=a.map(x=>x.text).join("");
      }
    }
    if(trim){while(a.length&&/\s/u.test(a[0].text))a.shift();while(a.length&&/\s/u.test(a.at(-1).text))a.pop();}
    const runs=[];
    for(const x of a){const last=runs.at(-1);if(last?.color===x.color)last.text+=x.text;else runs.push({...x});}
    return {text:a.map(x=>x.text).join(""),runs};
  }
  class StyledBuilder {
    constructor(color=10){this.color=color;this.chars=[];this.pages=[];}
    emit(text){for(const c of String(text??""))this.chars.push({text:c,color:this.color});}
    flush(trim=true){const p=normalized(this.chars,trim);if(p.text)this.pages.push(p);this.chars=[];}
  }
  function resolverLog(callbacks){
    const log={name:[],person:[],number:[]}, wrapped={};
    for(const kind of Object.keys(log)){const fn=callbacks[kind];wrapped[kind]=typeof fn==="function"?function(...args){const value=fn.apply(this,args);log[kind].push({args,value});return value;}:fn;}
    const cursor={name:0,person:0,number:0};
    return {wrapped,log,take(kind,fallback){return log[kind][cursor[kind]++]?.value??fallback;}};
  }
  function byteRun(builder,bytes,text,resolved,scene=false){
    const cs=CHARSET(text);
    for(let i=0;i<bytes.length;){
      const c=bytes[i];if(c===0||c===255){i++;continue;}
      if(c===0x1a&&i+1<bytes.length){
        const op=bytes[i+1], len=op===0x86?4:op===0x87?6:SK.OrigText.TokenLen(bytes,i);
        if(op===255||scene&&op===0x12)break;
        if(op===1)builder.emit("\n");
        else if(op===2||op===9)builder.flush();
        else if(op===3&&PALETTE[bytes[i+2]])builder.color=bytes[i+2];
        else if(op===6)builder.emit(resolved.take("name","○○"));
        else if(op===0x86)builder.emit(resolved.take("person","○○"));
        else if(op===5)builder.emit(resolved.take("number","?"));
        else if(op===0x87&&i+5<bytes.length){
          const address=(bytes[i+2]|bytes[i+3]<<8|bytes[i+4]<<16|bytes[i+5]<<24)>>>0, override=text.Overrides?.[address];
          if(override!==undefined){
            const player=resolved.take("person","○○"),family=resolved.take("person","○○"),value=String(override)
              .replaceAll("{플레이어}",player).replaceAll("{가문}",family).replaceAll("{이가}","이/가")
              .replaceAll("{은는}","은/는").replaceAll("{을를}","을/를").replaceAll("{과와}","과/와");
            value.split("|").forEach((p,n)=>{if(n)builder.flush();const fixed=SK.OrigText.FixJosa(p).replaceAll("/","\n");builder.emit(fixed);});builder.flush();
          }
        }
        i+=len>0?len:2;continue;
      }
      if(scene){i++;continue;}
      const code=c>=128&&i+1<bytes.length?(c<<8)|bytes[i+1]:c;i+=c>=128&&i+1<bytes.length?2:1;
      builder.emit(cs[code]??"□");
    }
  }
  function decodeStyled(bytes,text,resolved,initialColor=10){const b=new StyledBuilder(initialColor);byteRun(b,bytes,text,resolved);b.flush();return b.pages;}
  function sceneStyled(script,resolved){
    const b=new StyledBuilder();let pending=[],i=0;
    const process=()=>{byteRun(b,pending,null,resolved,true);pending=[];};
    while(i<script.length){const a=script.indexOf("{{HEX:",i),literal=a<0?script.slice(i):script.slice(i,a);if(literal){process();b.emit(literal);}if(a<0)break;const end=script.indexOf("}}",a);if(end<0)break;pending.push(...script.slice(a+6,end).trim().split(/\s+/).filter(Boolean).map(h=>parseInt(h,16)));i=end+2;}
    process();b.flush();return b.pages;
  }
  function register(original,styled,input){
    if(!Array.isArray(original)||!Array.isArray(styled)||original.length!==styled.length||original.some((p,i)=>p!==styled[i]?.text)){diagnostics.rejectedStyles++;return;}
    arrayStyles.set(original,styled);if(input&&typeof input==="object")rawStyles.set(input,styled);
    for(const p of styled){const signature=JSON.stringify(p.runs);let variants=textStyles.get(p.text);if(!variants)textStyles.set(p.text,variants=new Map());variants.set(signature,p.runs);diagnostics.colorPages++;}
    if(textStyles.size>1024)textStyles.delete(textStyles.keys().next().value);
  }
  function installDecoders(){
    const Text=SK.OrigText, Heaven=SK.OrigHeaven;if(!Text||Text.prototype._nativeColorInstalled)return;
    Text.prototype._nativeColorInstalled=true;
    const decode=Text.prototype.Decode;
    Text.prototype.Decode=function(bytes,name,person,number,...rest){
      const r=resolverLog({name,person,number}), result=decode.call(this,bytes,r.wrapped.name,r.wrapped.person,r.wrapped.number,...rest);
      try{register(result,decodeStyled(bytes,this,r),bytes);}catch{diagnostics.rejectedStyles++;}return result;
    };
    const scene=Text.ScenePages;
    Text.ScenePages=function(script,name,...rest){const r=resolverLog({name}),result=scene.call(this,script,r.wrapped.name,...rest);try{register(result,sceneStyled(script,r));}catch{diagnostics.rejectedStyles++;}return result;};
    if(Heaven?.prototype.HelpPages){
      const help=Heaven.prototype.HelpPages;
      Heaven.prototype.HelpPages=function(k){
        const family=[],personName=this.personName;
        this.personName=function(...args){const value=personName.apply(this,args);family.push(value);return value;};
        let result;try{result=help.call(this,k);}finally{this.personName=personName;}
        try{
          const bytes=this.data.Help.get(k),b=new StyledBuilder();let run=[],fi=0;
          const flush=()=>{if(!run.length)return;const segment=new StyledBuilder(b.color);byteRun(segment,run,this.text,{take(){return"○○";}});const fixed=normalized(segment.chars);for(const r of fixed.runs){b.color=r.color;b.emit(r.text);}run=[];};
          for(let i=0;i<bytes.length;){
            if(bytes[i]===37&&i+1<bytes.length){flush();const op=String.fromCharCode(bytes[i+1]);i+=2;if(op==='e')break;if(op==='n')b.emit('\n');else if(op==='p')b.flush(false);else if(op==='u')b.emit(this.player);else if(op==='f')b.emit(family[fi++]??'○○');else if({k:10,r:11,b:12,g:13}[op])b.color={k:10,r:11,b:12,g:13}[op];}
            else if(bytes[i]>=128&&i+1<bytes.length){run.push(bytes[i],bytes[i+1]);i+=2;}else i++;
          }
          flush();b.flush(false);if(result.length===b.pages.length&&result.every((p,i)=>p.Text===b.pages[i].text)){for(let i=0;i<result.length;i++)pageStyles.set(result[i],b.pages[i].runs);register(result.map(p=>p.Text),b.pages,bytes);}else diagnostics.rejectedStyles++;
        }catch{diagnostics.rejectedStyles++;}return result;
      };
    }
  }
  function validRuns(text,runs){return Array.isArray(runs)&&runs.length>0&&runs.every(r=>typeof r.text==='string'&&PALETTE[r.color])&&runs.map(r=>r.text).join('')===text;}
  // Old saves contain plain pages, not color metadata. Align only source-coded
  // literal glyphs and explicitly marked name/number operands against that exact
  // captured text. This never searches for "important" words or reruns a VM.
  function abstractPages(input,text,help=false,scene=false){
    const pages=[];let color=10,parts=[];
    const emit=(value,dynamic=false)=>{const last=parts.at(-1);if(!dynamic&&last&&!last.dynamic&&last.color===color)last.text+=value;else parts.push({text:value,color,dynamic});},
      flush=()=>{if(parts.length)pages.push(parts);parts=[];},bytes=(b)=>{
        for(let i=0;i<b.length;){const c=b[i];if(c===0||c===255){i++;continue;}
          if(help&&c===37&&i+1<b.length){const op=String.fromCharCode(b[i+1]);i+=2;if(op==='e')break;if(op==='p')flush();else if(op==='n')emit('\n');else if(op==='u'||op==='f')emit('',true);else if({k:10,r:11,b:12,g:13}[op])color={k:10,r:11,b:12,g:13}[op];continue;}
          if(c===26&&i+1<b.length){const op=b[i+1],len=op===134?4:op===135?6:SK.OrigText.TokenLen(b,i);if(op===255||scene&&op===18)break;if(op===1)emit('\n');else if(op===2||op===9)flush();else if(op===3&&PALETTE[b[i+2]])color=b[i+2];else if([5,6,134,135].includes(op))emit('',true);i+=len>0?len:2;continue;}
          if(scene){i++;continue;}const code=c>=128&&i+1<b.length?(c<<8)|b[i+1]:c;i+=c>=128&&i+1<b.length?2:1;if(!help||c>=128)emit(CHARSET(text)[code]??'□');
        }
      };
    if(scene){let i=0,pending=[];while(i<input.length){const a=input.indexOf('{{HEX:',i),literal=a<0?input.slice(i):input.slice(i,a);if(literal){bytes(pending);pending=[];emit(literal);}if(a<0)break;const end=input.indexOf('}}',a);if(end<0)break;pending.push(...input.slice(a+6,end).trim().split(/\s+/).filter(Boolean).map(h=>parseInt(h,16)));i=end+2;}bytes(pending);}
    else bytes(input);flush();return pages;
  }
  function alignRaw(parts,plain){
    if(!parts?.length)return null;parts=parts.map(p=>({...p}));
    if(!parts[0].dynamic)parts[0].text=parts[0].text.trimStart();if(!parts.at(-1).dynamic)parts.at(-1).text=parts.at(-1).text.trimEnd();
    if(parts.some((p,i)=>p.dynamic&&parts[i+1]?.dynamic&&p.color!==parts[i+1].color))return null;
    const literal=s=>{let out='',i=0;const markers={'은/는':'(?:은|는)','이/가':'(?:이|가)','을/를':'(?:을|를)','과/와':'(?:과|와)','와/과':'(?:과|와)','(으)로':'(?:으로|로)','⑦':'(?:이)?'};while(i<s.length){const key=Object.keys(markers).find(k=>s.startsWith(k,i));if(key){out+=markers[key];i+=key.length;}else out+=s[i++].replace(/[.*+?^${}()|[\]\\]/g,'\\$&');}return out;},
      pattern='^'+parts.map(p=>'('+(p.dynamic?'[\\s\\S]*?':literal(p.text))+')').join('')+'$',match=new RegExp(pattern,'u').exec(plain);
    if(!match)return null;const runs=parts.map((p,i)=>({text:match[i+1],color:p.color})).filter(r=>r.text);return validRuns(plain,runs)?runs:null;
  }
  function runsFor(view,app){
    const text=String(view.text??''),s=app?.game?.session;let runs=view.textRuns;
    if(!validRuns(text,runs)&&s&&view===app.state?.event){
      if(s.heavenCur){const hp=s.heavenCur[s.heavenPage];runs=pageStyles.get(hp);if(!runs){const help=hp.State===-2,raw=(help?s.Text.Heaven.Help:s.Text.Heaven.Msgs).get(help?hp.MsgId-1000:hp.MsgId),styles=raw&&rawStyles.get(raw),index=s.heavenCur.slice(0,s.heavenPage).filter(p=>p.MsgId===hp.MsgId).length;runs=styles?.[index]?.runs;if(!validRuns(text,runs)&&raw)runs=alignRaw(abstractPages(raw,s.Text,help)[index],text);if(runs)pageStyles.set(hp,runs);}}
      else {runs=arrayStyles.get(s.pages)?.[s.page]?.runs;const script=s.Text.Records[s.cur?.Data]?.Script;if(!validRuns(text,runs)&&script)runs=alignRaw(abstractPages(script,s.Text,false,true)[s.page],text);}
    }
    if(!validRuns(text,runs)&&Number.isInteger(view.messageId)){const t=app?.ownWizard?.text||app?.introScene?.text,raw=t?.Heaven?.Msgs?.get(view.messageId);runs=raw&&rawStyles.get(raw)?.[view.page||0]?.runs;}
    if(!validRuns(text,runs)){const variants=textStyles.get(text);if(variants?.size===1)runs=variants.values().next().value;}
    return validRuns(text,runs)?runs:null;
  }
  function richHtml(text,runs){return validRuns(text,runs)?runs.map(r=>'<span class="native-color-run" data-native-color="'+r.color+'" style="color:'+PALETTE[r.color]+'">'+esc(r.text)+'</span>').join(''):esc(text);}
  function announcementFor(event,session,state){
    const cur=session?.cur;
    if(!cur||session.heavenCur||session.memo||session.replaying||!event||event.nativeHelp||event.eventId==='heaven'||event.eventId==='cupid-help'||event.page!==0||event.phase==='result')return null;
    // RunQueue explicitly replaces its late-bound queue kind6 with person kind0.
    // DayEvent.Type retained the old6; it is NOT a proven devil announcement.
    const kind=Number(event.announcementKind??cur.AnnouncementKind??(cur.Type===6?0:cur.Type)),
      person=(state.members||[]).find(p=>p.id===event.personId),name=person?.name||session.Family?.OrigNames?.[event.personId];
    if([0,5].includes(kind)&&name)return{kind,text:name+'에게 무언가가！？',personId:event.personId,se:460};
    if(kind===1)return{kind,text:'우리 집에 무언가가！？',personId:event.personId,se:461};
    // Reference author identifies kind2 as untranslated Japanese. This is its
    // supplied Korean interpretation, not a claim of byte-exact translated ROM.
    if(kind===2)return{kind,text:'우리 집에 무언가가！？',personId:event.personId,se:461,certainty:'reference-translation'};
    // Other reference kinds are not exported/proven by the current queue adapter.
    return null;
  }
  function pinwheel(ctx,progress){
    if(progress<=0)return;ctx.fillStyle='#000000';if(progress>=1){ctx.fillRect(0,0,ctx.canvas.width,ctx.canvas.height);return;}
    const x=ctx.canvas.width/2,y=ctx.canvas.height/2,r=Math.hypot(ctx.canvas.width,ctx.canvas.height)*2,angle=progress*Math.PI/2;
    for(let k=0;k<4;k++){const start=k*Math.PI/2;ctx.beginPath();ctx.moveTo(x,y);ctx.lineTo(x+Math.cos(start)*r,y+Math.sin(start)*r);ctx.lineTo(x+Math.cos(start+angle)*r,y+Math.sin(start+angle)*r);ctx.closePath();ctx.fill();}
  }
  function installApp(app){
    if(!app||app.nativeEventPresentation)return app;
    const control=app.nativeEventPresentation={current:null,completed:new WeakSet(),diagnostics},
      old={renderGame:app.renderGame,renderScene:app.renderScene,pending:app.eventDialoguePending,voice:app.syncDialogueVoice,music:app.syncMusic,dialogue:app.dialogueHtml,tip:app.updateCupidTip,chatter:app.updateFamilyChatter,title:app.showTitle};
    function clearAnnouncement(){app.el.querySelector('#native-event-announcement')?.remove();}
    function showAnnouncement(canvas,p,width){
      if(p.phase!=='shout'||document.hidden||app.modalOpen){clearAnnouncement();return;}
      let status=app.el.querySelector('#native-event-announcement');
      if(!status){
        status=document.createElement('span');status.id='native-event-announcement';
        status.className='native-event-announcement';status.setAttribute('role','status');
        status.dataset.nativeTextLayer='css-resolution';
        status.style.cssText='position:absolute;z-index:3;display:block;pointer-events:none;white-space:nowrap;overflow:hidden;color:#000000;background:transparent;opacity:1;text-shadow:none;filter:none;transform:none;image-rendering:auto;font-style:normal;font-weight:400;font-synthesis:none;line-height:1.1;letter-spacing:normal;word-spacing:normal;text-align:left;-webkit-text-stroke:0';
        canvas.parentElement.append(status);
      }
      // Rasterize text at actual CSS/device resolution, not into the enlarged
      // 240px pixel-art canvas. Keep the original native bubble/text origin.
      // Only update the live-region text when it changes, never on every RAF.
      if(status.textContent!==p.text)status.textContent=p.text;
      const rect=canvas.getBoundingClientRect(),host=canvas.parentElement,box=host.getBoundingClientRect(),
        sx=rect.width/canvas.width,sy=rect.height/canvas.height,family=getComputedStyle(app.el).fontFamily,
        left=rect.left-box.left-host.clientLeft+host.scrollLeft+46*sx,
        top=rect.top-box.top-host.clientTop+host.scrollTop+28*sy,
        available=(width-12)*sx,key=JSON.stringify([p.text,left,top,available,sy,family]);
      if(status.dataset.nativeTextMetrics===key)return;
      status.style.left=left+'px';status.style.top=top+'px';status.style.fontFamily=family;
      status.style.fontSize=9*sy+'px';status.style.width='max-content';status.style.maxWidth='none';
      const natural=status.getBoundingClientRect().width;
      if(natural>available)status.style.fontSize=9*sy*available/natural+'px';
      status.style.width=available+'px';status.style.maxWidth=available+'px';
      // A font's hinted metrics can round by a CSS pixel after fitting. Retain
      // the complete text rather than clipping/ellipsis or bitmap scaling.
      if(status.scrollWidth>status.clientWidth)status.style.fontSize=parseFloat(status.style.fontSize)*Math.max(0,available-1)/status.scrollWidth+'px';
      status.dataset.nativeTextMetrics=key;
    }
    function current(){const p=control.current;return p&&!p.done&&app.playing&&app.game?.session?.cur===p.occurrence&&!app.game.session.heavenCur?p:null;}
    function ensure(t){
      let p=current();if(p)return p;
      const s=app.game?.session,e=app.state?.event,cur=s?.cur;if(!app.playing||!cur||control.completed.has(cur))return null;
      const cue=announcementFor(e,s,app.state);if(!cue)return null;
      p=control.current={...cue,occurrence:cur,elapsed:0,last:t,ready:false,done:false,phase:'loading',startX:app.scrollX,startY:app.camY,voicePlayed:false,selectionChanged:false};diagnostics.preludes++;
      app.voice.stop();app.voiceLineKey=null;
      const f=app.state.family,slot=SK.WebHouseClock.slot(SK.WebHouseClock.fromFraction(app.dayFraction)),house=app.art.manifest.houses?.['e'+Number(f.era||0)+'g'+Number(f.grade||0)]||app.art.manifest.house||{},names=[...(app.art.manifest.cupid||[]),'bubble_tip',house.slots?.[slot]||house.slots?.[(slot&~1)%8]||house.file];
      const images=[...new Set(names.filter(Boolean))].map(n=>app.art.image(n)).filter(Boolean);
      Promise.all(images.map(im=>im.decode())).then(()=>{p.ready=true;},error=>{p.error=error;console.warn('Event reference art decode',error);});
      // Prepare the eventual event picture during the house cue, never release it.
      app.prepareEventArt(e);
      if(app.state.members.some(x=>x.id===cue.personId)){app.selectedId=cue.personId;p.selectionChanged=true;}
      return p;
    }
    function withoutEvent(fn,args){
      const state=app.state,cupid=app.art.cupid;
      app.state={...state,event:null,paused:true};app.art.cupid=()=>null;
      try{return fn.apply(app,args);}finally{app.state=state;app.art.cupid=cupid;}
    }
    function draw(t){
      const p=ensure(t);if(!p){clearAnnouncement();return false;}
      const c=app.el.querySelector('#house-canvas');if(!c){clearAnnouncement();return true;}
      if(!p.ready){clearAnnouncement();p.last=t;return true;}
      const blocked=!app.running||document.hidden||app.modalOpen,dt=blocked?0:clamp((t-p.last)/1000,0,.1);p.last=t;p.elapsed+=dt;
      const frame=p.elapsed*60,panning=clamp(frame/53,0,1),actor=app.actors.get(p.personId),W=app.art.house.width||960;
      if(actor){const target=actor.x-104,d=mod(target-p.startX+W/2,W)-W/2;app.scrollX=mod(p.startX+d*panning,W);app.camY=p.startY+(clamp(actor.floor-112,0,Math.max(0,(app.art.house.height||160)-160))-p.startY)*panning;}
      withoutEvent(old.renderScene,[t,0]);
      const ctx=c.getContext('2d');ctx.imageSmoothingEnabled=false;
      app.draw(ctx,app.art.cupid(Math.floor(frame/8)),8,34,32,32);
      p.phase=frame<53?'camera':frame<90?'wait':frame<178?'shout':frame<196?'wipe':frame<205?'black':'entrance';
      let width=0;
      if(frame>=90&&frame<196){
        const text=p.text,font='9px '+getComputedStyle(app.el).fontFamily;ctx.font=font;
        // Original tip caps are14px left +8px right; extend only their middle
        // to fit this shout, rather than imposing the old152px empty bubble.
        width=clamp(Math.ceil(ctx.measureText(text).width)+14,22,196);p.bubble||=document.createElement('canvas');
        app.bubbles.draw(p.bubble,'tip',width,28);app.draw(ctx,p.bubble,40,20,width,28);
        if(!p.voicePlayed&&!blocked){p.voicePlayed=true;if(app.voice.enabled)void app.voice.speak(text,'cupid');}
      }
      showAnnouncement(c,p,width);
      if(frame>=178){if(!p.voiceStopped){p.voiceStopped=true;app.voice.stop();}pinwheel(ctx,clamp((frame-178)/18,0,1));}
      c.dataset.preEventPhase=p.phase;c.dataset.preEventText=p.text;c.dataset.preEventFrame=String(frame);
      if(frame>=205&&app.prepareEventArt(app.state.event)){
        p.done=true;control.completed.add(p.occurrence);diagnostics.completed++;app.voice.stop();app.voiceLineKey=null;
        app.eventKey='';app.eventOccurrence=null;app.eventStart=t;app.renderGame();old.renderScene.call(app,t,0);old.music.call(app);return false;
      }
      return true;
    }
    app.renderGame=function(...args){if(this!==app)return old.renderGame.apply(this,args);const p=ensure(performance.now());return p?withoutEvent(old.renderGame,args):old.renderGame.apply(this,args);};
    app.renderScene=function(t,dt){if(this!==app)return old.renderScene.call(this,t,dt);if(draw(t))return;return old.renderScene.call(this,t,dt);};
    app.eventDialoguePending=function(...args){return this===app&&!!current()||old.pending.apply(this,args);};
    app.syncDialogueVoice=function(...args){if(this===app&&current()){if(document.hidden||this.modalOpen)clearAnnouncement();if((!this.running||document.hidden||this.modalOpen)&&this.voice.diagnostics?.active)this.voice.stop();return;}return old.voice.apply(this,args);};
    app.syncMusic=function(...args){if(this===app&&current()&&!this.modalOpen){const f=this.state.family,id=81-3*clamp(Number(f.grade)&15,0,3)+12*clamp(Number(f.era),0,3);this.sound.playBgm(id,{fadeIn:0,fadeOut:.5});return;}return old.music.apply(this,args);};
    for(const [key,fn]of [['updateCupidTip',old.tip],['updateFamilyChatter',old.chatter]])app[key]=function(...args){if(this===app&&current()){for(const e of this.el.querySelectorAll('.scene-tip,.family-chatter'))e.hidden=true;return;}return fn.apply(this,args);};
    app.dialogueHtml=function(view,intro){const html=old.dialogue.call(this,view,intro),runs=runsFor(view,this),text=SK.Currency.text(view.text||''),displayRuns=runs&&SK.Currency.runs(runs);return displayRuns?html.replace('<span class="dialog-text">'+esc(text)+'</span>','<span class="dialog-text">'+richHtml(text,displayRuns)+'</span>'):html;};
    app.showTitle=function(...args){if(this===app){clearAnnouncement();const p=current();if(p){p.done=true;control.completed.add(p.occurrence);}this.voice.stop();}return old.title.apply(this,args);};
    document.addEventListener('visibilitychange',()=>{if(document.hidden)clearAnnouncement();});
    return app;
  }
  installDecoders();
  SK.EventPresentation={PALETTE,diagnostics,decodeStyled,sceneStyled,abstractPages,alignRaw,richHtml,runsFor,announcementFor,pinwheel,installApp,arrayStyles,rawStyles,pageStyles};
  const start=SK.startApp;if(typeof start==='function')SK.startApp=function(...args){const value=start.apply(this,args);return value&&typeof value.then==='function'?value.then(installApp):installApp(value);};
})(globalThis);

</script>
<script>
(function () {
  "use strict";
  function showError(error) {
    console.error(error);
    const target =
      document.querySelector("#loading") ||
      document.querySelector("#app") ||
      document.body;
    const panel = document.createElement("section");
    panel.setAttribute("role", "alert");
    panel.style.cssText =
      "padding:24px;white-space:pre-wrap;line-height:1.7;color:#922c25;background:#fff8eb";
    panel.textContent =
      "게임을 시작하지 못했습니다.\n" + (error.message || String(error));
    target.replaceChildren(panel);
  }
  async function boot() {
    try {
      await SK.ready;
      if (typeof SK.startApp !== "function")
        throw new Error("화면 소스가 불러와지지 않았습니다.");
      await SK.startApp();
      SK.appReady = true;
    } catch (error) {
      showError(error);
    }
  }
  if (document.readyState === "loading")
    document.addEventListener("DOMContentLoaded", boot, { once: true });
  else boot();
})();

</script>
  </body>
</html>
