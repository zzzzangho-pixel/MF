    const error = validateName(input.name);
    if (error) return { ok: false, message: error };
    if (input.gender !== 0 && input.gender !== 1) return { ok: false, message: '남성 또는 여성 이름을 선택해주세요.' };
    const meta = ensure(session), name = canonical(input.name), key = duplicateKey(name);
    if (meta.entries.some(e => duplicateKey(e.name) === key)) return { ok: false, message: '이미 등록된 이름이에요.' };
    const entry = { id: 'name:' + meta.nextId++, name, gender: input.gender };
    meta.entries.push(entry);
    return { ok: true, entry: clone(entry) };
  }
  function remove(value, id) {
    const session = sessionOf(value);
    if (!session?.Family || !session.Game?.Mem) return { ok: false, message: '가족 게임이 필요합니다.' };
    const meta = session._nameBook, index = meta?.entries.findIndex(e => e.id === id) ?? -1;
    if (index < 0) return { ok: false, message: '등록된 이름을 찾을 수 없어요.' };
    const [entry] = meta.entries.splice(index, 1);
