<script>
/* Web naming extension, NOT a verified original-cartridge naming-book port.
 * Registry/aliases live only in web metadata. Native names/genes, VM memory
 * and original RNG are never rewritten or consumed by registry operations.
 * Newborn aliases require an observed native birth call and valid parent
 * genes; existing people and newly generated outside partners are untouched. */
(function (root) {
  'use strict';
  const SK = root.SK = root.SK || {};
  if (SK.NameBook) return;
  const clone = value => JSON.parse(JSON.stringify(value));
  const sessionOf = value => value?.session || value;
  const fresh = () => ({ version: 1, nextId: 1, entries: [], known: {}, births: {}, assignments: {} });
  const validId = id => Number.isInteger(id) && id >= 0 &&
    SK.OrigMem.GeneAddr(id) + SK.OrigMem.GeneSize <= SK.OrigMem.Slots;
  const entryId = id => /^name:[1-9]\d*$/.test(String(id));
  const canonical = name => name.normalize('NFC');
  const duplicateKey = name => canonical(name).toLocaleLowerCase('und');
  function validateName(value) {
    if (typeof value !== 'string' || !value.length) return '이름을 입력해주세요.';
    const name = canonical(value);
    if (/\s|\p{Cc}|\p{Cf}/u.test(name)) return '이름에는 공백이나 제어 문자를 넣을 수 없어요.';
    if (Array.from(name).length > 12) return '이름은 12글자 이내로 입력해주세요.';
    return null;
  }
  function normalize(saved) {
    const meta = fresh();
    if (!saved || saved.version !== 1) return meta;
    const ids = new Set(), names = new Set();
    for (const item of Array.isArray(saved.entries) ? saved.entries : []) {
      if (!item || !entryId(item.id) || ids.has(item.id) || validateName(item.name) ||
          item.gender !== 0 && item.gender !== 1) continue;
      const name = canonical(item.name), key = duplicateKey(name);
      if (names.has(key)) continue;
      ids.add(item.id); names.add(key);
      meta.entries.push({ id: item.id, name, gender: item.gender });
      meta.nextId = Math.max(meta.nextId, Number(item.id.slice(5)) + 1);
    }
    if (Number.isSafeInteger(saved.nextId) && saved.nextId > meta.nextId) meta.nextId = saved.nextId;
    for (const [key, value] of Object.entries(saved.known || {}))
      if (validId(Number(key)) && value === true) meta.known[key] = true;
    for (const [key, value] of Object.entries(saved.births || {})) {
      if (!validId(Number(key)) || !value || value.source !== 'native:081141D8/08028EAC' ||
          !validId(value.fatherId) || !validId(value.motherId) || value.fatherId === value.motherId ||
          !Number.isInteger(value.birthDay) || !Number.isInteger(value.observedDay) ||
          value.gender !== 0 && value.gender !== 1) continue;
      meta.births[key] = { source: value.source, fatherId: value.fatherId, motherId: value.motherId,
        birthDay: value.birthDay, observedDay: value.observedDay, gender: value.gender,
        eligibleIds: (Array.isArray(value.eligibleIds) ? value.eligibleIds : []).filter(entryId) };
    }
    for (const [key, value] of Object.entries(saved.assignments || {}))
      if (validId(Number(key)) && value && entryId(value.entryId) && !validateName(value.name))
        meta.assignments[key] = { entryId: value.entryId, name: canonical(value.name) };
    return meta;
  }
  function ensure(session) {
    if (!session?._nameBook) session._nameBook = fresh();
    return session._nameBook;
  }
  function dateAt(memory, address) {
    const date = SK.OrigDate.Get(memory, address);
    if (date.year < 1 || date.month < 1 || date.month > 12 || date.day < 1 || date.day > 31) return null;
    const day = SK.GameDate.Make(date.year, date.month, date.day);
    return SK.GameDate.Year(day) === date.year && SK.GameDate.Month(day) === date.month &&
      SK.GameDate.Day(day) === date.day ? day : null;
  }
  function newborn(session, id, expected = null) {
    if (!validId(id) || !session?.Game?.Mem) return null;
    const memory = session.Game.Mem, gene = SK.OrigMem.GeneAddr(id),
      fatherId = memory.R16(gene + 0x10), motherId = memory.R16(gene + 0x12),
      gender = memory.R8(gene + 0x31), birthDay = dateAt(memory, gene + 0x2e),
      observedDay = dateAt(memory, SK.OrigMem.Date), record = SK.OrigFamily.Record(memory, id);
    if (!validId(fatherId) || !validId(motherId) || fatherId === motherId || fatherId === id || motherId === id ||
        gender !== 0 && gender !== 1 || birthDay === null || observedDay === null || birthDay > observedDay ||
        SK.GameDate.AgeYears(birthDay, observedDay) !== 0 || !record ||
        memory.R8(record + 0x31) !== gender || dateAt(memory, record + 0x2e) !== birthDay) return null;
    const father = SK.OrigMem.GeneAddr(fatherId), mother = SK.OrigMem.GeneAddr(motherId),
      fatherBirth = dateAt(memory, father + 0x2e), motherBirth = dateAt(memory, mother + 0x2e);
    if (memory.R8(father + 0x31) !== 0 || memory.R8(mother + 0x31) !== 1 ||
        fatherBirth === null || motherBirth === null || fatherBirth >= birthDay || motherBirth >= birthDay) return null;
    if (expected && (expected.fatherId !== fatherId || expected.motherId !== motherId ||
        expected.birthDay !== undefined && expected.birthDay !== birthDay ||
        expected.gender !== undefined && expected.gender !== gender)) return null;
    return { source: 'native:081141D8/08028EAC', fatherId, motherId, birthDay, observedDay, gender };
  }
  function installVm(session) {
    const machine = session.Game?.Vm;
    if (!machine) return;
    machine._nameBookSession = session;
    if (machine._nameBookInstalled) return;
    machine._nameBookInstalled = true;
    const call = machine.Call;
    let birthScope = 0;
    machine.Call = function (fn, ...args) {
