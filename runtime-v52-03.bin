    }
    renderEventTitle(text, y, visible) {
      const label = $("event-scene-title"),
        canvas = $("house-canvas");
      if (!label || !canvas) return;
      label.hidden = !visible;
      if (!visible) return;
      // Keep pixel art at its original resolution, but rasterize letters at
      // the browser's display resolution rather than enlarging 10px glyphs.
      const width = canvas.getBoundingClientRect().width,
        value = currencyText(text || ""),
        line = label.firstElementChild;
      label.style.top = (y / canvas.height) * 100 + "%";
      label.style.height = (30 / canvas.height) * 100 + "%";
      if (label._sceneWidth !== width || line.textContent !== value) {
        line.textContent = value;
        label.style.fontSize = (width / 240) * 12 + "px";
        line.style.transform = "none";
        const scale = Math.min(1, (label.clientWidth - 2) / Math.max(1, line.scrollWidth));
        line.style.transform = "scaleX(" + scale + ")";
        label._sceneWidth = width;
      }
    }
    renderEventScene(ctx, t) {
      const e = this.state.event,
        scene = e.scene || e.Scene || {},
        id = e.id || e.eventId || e.title || "",
        session = this.game?.session,
        occurrence = (session?.memo && !session.replaying ? session.memo : null) ||
          session?.cur || session?.heavenCur || id;
      if (this.eventKey !== id || this.eventOccurrence !== occurrence) {
        this.eventKey = id;
        this.eventOccurrence = occurrence;
        this.eventStart = t;
      }
      const frames = Math.floor((t - this.eventStart) * 0.06),
        back = v(scene, "back", e.back || ""),
        pic = v(scene, "pic", e.pic || ""),
        band = v(scene, "band", e.band || "");
      if (!pic || !band) this.renderEventTitle("", 0, false);
      ctx.canvas.skCupidAnchor = null;
      if (!pic) {
        if (this.isNativeHeaven(e)) {
          // Native Heaven reports/endings use their supplied complete reel,
          // not the generic no-picture stand-in family member. Its original
