      this.app.el.innerHTML = '<section class="intro-screen own-setup-screen recommended-screen"><header class="intro-header"><span>신님이 아는 가족</span><button id="intro-cancel" class="intro-cancel">타이틀로</button></header><section class="scene-shell intro-scene own-scene recommended-scene' + (heaven ? ' recommended-heaven' : '') + (view ? ' recommended-dialogue-scene' : '') + '" data-recommended-step="' + this.stage + '"><canvas id="intro-canvas" class="house-canvas" width="240" height="160" aria-label="' + (heaven ? '원작 천계의 신님과 큐피트' : '원작 추천 가족 소개') + '"></canvas>' +
        (!heaven && this.stage !== "intro" ? '<h2 class="own-scene-title">' + esc(title) + '</h2>' : '') + content + (view ? this.app.dialogueHtml(dialogueView, true) : '') +
