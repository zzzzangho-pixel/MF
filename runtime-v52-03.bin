      if (this.stage === "list") { ctx.fillStyle = '#fff'; ctx.fillRect(6, 101, 228, 53); this.slice(ctx, panel, 1, 96, 238, 62); }
      if (this.stage === "detail") { ctx.fillStyle = '#fff'; ctx.fillRect(6, 62, 228, 82); this.slice(ctx, panel, 1, 57, 238, 91); }
