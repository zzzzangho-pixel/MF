      this.scrollX = mod(this.scrollX, W);
      const zoom = this.houseZoom(), viewWidth = c.width / zoom;
      this.camY = clamp(this.camY, 0, Math.max(0, H - c.height / zoom));
      ctx.save();
      ctx.scale(zoom, zoom);
