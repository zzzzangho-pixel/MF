        at += len;
      }
    }
    return bytes;
  }
  function summaryFor(id, query) {
    const rank = bounded(query.Game.Mem.R16(SK.OrigMem.Fam + 0x65e), 0, 50), next = rank + 1;
    if (id === 105) return '지금까지의 사건을 큐피트의 사건 메모에 기록할까요?';
    if (id === 106) return '사건 메모를 기록했어요. 계속 가족을 지켜볼까요?';
    if (id === 107) return '기록하지 않았어요. 다음에 기록하고 싶으면 불러 주세요.';
    if (id === 659) return '이미 최고 랭크예요. 이제 천년 가족을 목표로 지켜봐 주세요!';
    if (id === 629) return '21성 신님이 되면 새로운 특별한 화살을 받을 수 있어요.';
