      for (let stat = 0; stat < 4; stat++) if (original.stats[stat] !== current.stats[stat])
        changes.push({ personId: id, key: 's' + stat, label: SK.Stat.Names[stat], delta: current.stats[stat] - original.stats[stat] });
      if (original.hearts !== current.hearts)
        changes.push({ personId: id, key: 'hearts', label: '하트', delta: current.hearts - original.hearts });
    }
    if (before.mood !== after.mood) changes.push({ personId: -1, key: 'mood', label: '무드', delta: after.mood - before.mood });
