      const motionDt = this.running && !document.hidden && !this.state.paused &&
          !this.modalOpen && !this.state.event && !this.arrowFx.active
        ? dt * this.speedMultiplier() : 0;
      this.actorTime += motionDt * 1000;
      alive.forEach((p) => this.actorFor(p, this.actorTime, motionDt));
      const sel = this.actors.get(this.selectedId);
      if (this.follow && sel && !this.state.event) {
        const target = sel.x - 104;
        let d = mod(target - this.scrollX + W / 2, W) - W / 2;
        this.scrollX = mod(this.scrollX + d * Math.min(1, dt * 5), W);
        const cy = clamp(sel.floor - 112, 0, Math.max(0, H - c.height));
        this.camY += (cy - this.camY) * Math.min(1, dt * 5);
