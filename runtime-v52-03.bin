","bounds":[84,216,1173,1040]},"family":{"src":"data:image/png;base64,","bounds":[255,193,998,1087]},"story":{"src":"data:image/png;base64,","bounds":[225,173,1051,1112]},"save":{"src":"data:image/png;base64,","bounds":[220,243,1034,1015]}};

</script>
<script>
/* Presentation-only paired original emotion bubbles. No authored dialogue,
 * speech sound, game RNG, member mutation, or save data. */
(function (root) {
  "use strict";
  const SK = (root.SK = root.SK || {});
  const FIRST_DELAY = 6000, REPLY_DELAY = 1200,
    FIRST_DURATION = 4000, EPISODE_DURATION = 4800, RETRY_DELAY = 2000;
  // Original house_emo resources: 3 = ♪, 4 = ♫, 7 = heart.
  const REACTIONS = [[3, 4], [7, 7], [4, 3], [3, 7]];

  function visibleMember(p, actors) {
    if (!p || p.id == null || p.alive === false) return false;
    const a = actors.get(p.id);
    return Boolean(a && !a.hidden && a.room != null &&
      Number.isFinite(a.x) && Number.isFinite(a.floor) &&
      (!Number.isFinite(a.target) || Math.abs(a.target - a.x) <= .5));
  }
  function near(a, b) {
    // Adjacent original room slots can be 72 pixels apart.
    return a.room === b.room && Math.abs(a.x - b.x) <= 80 &&
      Math.abs(a.floor - b.floor) <= 8;
  }

  class FamilyChatter {
    constructor(t = performance.now()) {
      this.reset(t);
    }
    reset(t = performance.now()) {
      this.episode = null;
      this.episodeIndex = 0;
      this.nextAt = t + FIRST_DELAY;
    }
    cancel(t) {
      this.episode = null;
      this.nextAt = Math.max(this.nextAt, t + FIRST_DELAY);
    }
    update(t, members, actors, blocked = false) {
      if (blocked) {
        this.cancel(t);
        return [];
      }
      // De-duplicate caller inputs without editing or retaining member objects.
      const visible = new Map();
      for (const p of members) {
        if (visibleMember(p, actors)) visible.set(p.id, p);
      }
      if (this.episode) {
        const e = this.episode, a = actors.get(e.firstId), b = actors.get(e.secondId);
        if (!visible.has(e.firstId) || !visible.has(e.secondId) || !near(a, b) ||
            a.room !== e.room || Math.abs(a.floor - e.firstFloor) > 8 ||
            Math.abs(b.floor - e.secondFloor) > 8) {
          this.cancel(t);
          return [];
        }
        if (t < e.startedAt + EPISODE_DURATION) {
          const lines = [];
          if (t < e.startedAt + FIRST_DURATION)
            lines.push({ id: e.firstId, emote: e.firstEmote, elapsed: t - e.startedAt, reply: false });
          if (t >= e.startedAt + REPLY_DELAY)
            lines.push({ id: e.secondId, emote: e.secondEmote, elapsed: t - e.startedAt - REPLY_DELAY, reply: true });
          return lines;
        }
        this.episode = null;
      }
      if (t < this.nextAt) return [];
      const people = [...visible.values()], pairs = [];
      for (let i = 0; i < people.length; i++) {
        for (let j = i + 1; j < people.length; j++) {
          if (near(actors.get(people[i].id), actors.get(people[j].id)))
            pairs.push([people[i], people[j]]);
        }
      }
      if (!pairs.length) {
        this.nextAt = t + RETRY_DELAY;
        return [];
      }
      const index = this.episodeIndex++, pair = pairs[index % pairs.length];
      // Rotate paired original icons and alternate which family reacts first.
      const first = pair[index % 2], second = pair[1 - index % 2],
        a = actors.get(first.id), b = actors.get(second.id),
        emotes = REACTIONS[index % REACTIONS.length];
      this.episode = {
        firstId: first.id, secondId: second.id, room: a.room,
        firstFloor: a.floor, secondFloor: b.floor, startedAt: t,
        firstEmote: emotes[0], secondEmote: emotes[1],
      };
      // A deterministic 20–30 second quiet gap after each finished exchange.
      this.nextAt = t + EPISODE_DURATION + 20000 + (index * 7919) % 10001;
      return [{ id: first.id, emote: emotes[0], elapsed: 0, reply: false }];
    }
  }
  SK.FamilyChatter = FamilyChatter;
})(typeof window !== "undefined" ? window : globalThis);

</script>
<script>
/* Supplied GameApp.cs arrow presentation. Rule application stays in game.shoot;
 * this class never changes family, inventory, save memory, or RNG. Original
 * SKF1 PNG/OGG bytes and the unscaled 59.7275 fps cue/flight/burst timing remain.
 */
(function (root) {
  "use strict";
  const SK = root.SK = root.SK || {}, FPS = 59.7275;
  const CUES = [[0, 0x116], [76, 0x1c2], [131, 0x1c3], [154, 0x117], [241, 0x123]];
  const mod = (n, m) => ((n % m) + m) % m;
  const EFFECTS = [...CUES.map(x => x[1]), 0x10c, 0x10f, 0x110];
  class ArrowFx {
    constructor(art, sound, onEnd) {
      this.art = art;
      this.sound = sound;
      this.onEnd = onEnd;
      this.active = false;
      this.token = 0;
      this.images = [];
      this.ready = this.load();
    }
    async load() {
      this.arrow = this.art.image("fx_arrow");
      this.bursts = [0, 1, 2].map(i => this.art.image("fx_burst_" + i));
      try { await Promise.all([this.arrow, ...this.bursts].map(i => i.decode())); }
      catch (_) { return false; }
      try {
        this.reel = SK.IntroFrameReel.parse(SK.resourceBytes("LocalArt/arrow_shot_frames.bin"));
        for (let i = 0; i < this.reel.count; i++) {
          const blob = new Blob([this.reel.png(i)], { type: "image/png" });
          this.images.push(await root.createImageBitmap(blob));
        }
      } catch (_) {
        this.images.forEach(i => i.close?.());
        this.images = [];
        this.reel = null; // Same house-only fallback as the supplied Unity.
      }
      return true;
    }
    play(targetId, calm = false) {
      if (this.active || !SK.resourceExists("LocalArt/fx_arrow.png")) return false;
      const token = ++this.token;
      this.active = true;
      this.targetId = targetId;
      this.calm = calm;
      this.loading = true;
      this.elapsed = 0;
      this.lastTime = null;
      this.cueIndex = 0;
      this.hitAt = null;
      this.startX = null;
      this.phase = "loading";
      this.cueLog = [];
      this.overlay = document.createElement("div");
      this.overlay.id = "arrow-fx-overlay";
      this.overlay.setAttribute("role", "status");
      this.overlay.setAttribute("aria-label", "큐피트가 화살을 쏘고 있습니다.");
      this.canvas = document.createElement("canvas");
      this.canvas.width = 240;
      this.canvas.height = 160;
      this.canvas.hidden = true;
      this.overlay.append(this.canvas);
      document.body.append(this.overlay);
      document.querySelector("#app").inert = true;
      void (async () => {
        const ready = await this.ready;
        await this.sound.prepareEffects(EFFECTS);
        if (token !== this.token || !this.active) return;
        if (!ready) { this.cancel(); return; }
        this.loading = false;
        if (!this.reel) {
          this.emit(0x116, 0);
          this.cueIndex = CUES.length - 1;
          this.elapsed = (242 - 20) / FPS;
        }
      })().catch(() => { if (token === this.token) this.cancel(); });
      return true;
    }
    emit(id, frame) {
      this.cueLog.push({ id, frame });
      void this.sound.playSe(id);
    }
    resetClock() { this.lastTime = null; }
    advance(time) {
      if (!this.active) return;
      if (this.loading || document.hidden) { this.lastTime = null; return; }
      if (this.lastTime !== null) this.elapsed += Math.max(0, Math.min(.1, (time - this.lastTime) / 1000));
      this.lastTime = time;
      const f = this.frame = this.elapsed * FPS;
      while (this.cueIndex < CUES.length && f >= CUES[this.cueIndex][0]) {
        const [at, id] = CUES[this.cueIndex++];
        this.emit(id, at);
      }
      const sky = f < 245 && this.reel;
      this.phase = sky ? (f < 42 ? "fade" : "sky") : "flight";
      this.overlay.style.backgroundColor = sky ? "rgba(0,0,0," + Math.min(1, f / 42) + ")" : "transparent";
      const k = sky && f >= 42 ? this.reel.frameAt((f - 42) / FPS) : -1;
      this.canvas.hidden = k < 0;
      if (k >= 0) {
        const ctx = this.canvas.getContext("2d");
        ctx.imageSmoothingEnabled = false;
        ctx.clearRect(0, 0, 240, 160);
        ctx.drawImage(this.images[k], 0, 0, 240, 160);
      }
    }
    drawHouse(ctx, actor, view) {
      if (!this.active || this.loading || (this.reel && this.frame < 245)) return;
      if (!actor) { this.cancel(); return; }
      const f = this.frame, W = view.worldWidth, stopX = actor.x + 12;
      // Match the actual drawn figure, including the already-approved height.
      const top = actor.floor - 61 - view.rise - view.camY;
      if (this.startX === null) this.startX = stopX + (view.width - mod(actor.x - view.scrollX, W)) + 70;
      let ax = stopX;
      if (this.hitAt === null) {
        ax = this.startX - 10 * Math.max(0, f - 242);
        if (ax <= stopX) {
          ax = stopX;
          this.hitAt = f;
          this.emit(0x10c, f);
        }
      }
      let dx = mod(ax - view.scrollX, W);
      if (dx > view.width + 64) dx -= W;
      if (f >= 242) ctx.drawImage(this.arrow, Math.round(dx), Math.round(top + 36), 32, 8);
      if (this.hitAt !== null) {
        this.phase = "burst";
        const g = f - this.hitAt - 2, phase = g < 0 ? 3 : Math.floor(g / 3) % 4;
        this.burstPhase = phase;
        if (phase < 3) {
          let bx = mod(actor.x - 16 - view.scrollX, W);
          if (bx > view.width + 64) bx -= W;
          ctx.drawImage(this.bursts[phase], Math.round(bx), Math.round(top + 11), 64, 64);
        }
        if (g >= 45) {
          this.emit(this.calm ? 0x110 : 0x10f, f);
          this.finish(false);
        }
      }
    }
    finish(cancelled) {
      const wasActive = this.active;
      ++this.token;
      this.active = false;
      this.phase = cancelled ? "cancelled" : "done";
      this.overlay?.remove();
      this.overlay = this.canvas = null;
      const app = document.querySelector("#app");
      if (app) app.inert = false;
      if (cancelled && wasActive) this.sound.stopEffects();
      if (wasActive) this.onEnd?.(cancelled);
    }
    cancel() { this.finish(true); }
  }
  SK.ArrowFx = ArrowFx;
})(globalThis);

/* Native arrow outline palettes and per-person display clock. Only sprite
 * palette index1 changes; this layer never writes the original person flags,
 * gauges, rule memory or save/RNG. Supplied PNGs/C# use integer RGB15 expansion
 * (the accompanying rounded RGB8 JSON differs by one in some channels). */
(function (root) {
  "use strict";
  const SK = root.SK = root.SK || {};
  const rgb15 = rows => rows.map(row => row.map(v => Math.floor(v * 255 / 31)));
  class ArrowOutlineTint {
    static Red = rgb15([[31,13,14],[31,3,5],[21,2,3],[10,1,1],[0,0,0],[10,1,1],[21,2,3],[31,3,5]]);
    static Blue = rgb15([[13,17,31],[5,5,31],[2,2,21],[1,1,10],[0,0,0],[1,1,10],[2,2,21],[5,5,31]]);
    constructor(maxCache = 256) {
      this.cache = new WeakMap();
      this.lru = new Map();
      this.maxCache = Math.max(1, maxCache | 0);
    }
    static color(flags, phase) {
      return flags & 2 ? this.Red[phase & 7]
        : flags & 4 ? this.Blue[phase & 7] : null;
    }
    static advance(st, flags, gauge, dt = 0, blocked = false) {
      st.phase = (Number(st.phase) || 0) & 7;
      if (blocked || !(flags & 6)) { st.clock = 0; return null; }
      const red = Boolean(flags & 2), over = red ? 4 : 6;
      const speed = red ? (gauge >= 255 ? 2 : 1) : (gauge <= 0 ? 2 : 1);
      st.clock = (Number(st.clock) || 0) + (Number.isFinite(dt) ? Math.max(0, dt) : 0) * 60 * speed;
      const steps = Math.floor(st.clock / over);
      if (steps) { st.clock -= steps * over; st.phase = (st.phase + steps) & 7; }
      return this.color(flags, st.phase);
    }
    static applyRGBA(source, flags, phase, indexMask = null) {
      const pixels = new Uint8ClampedArray(source), color = this.color(flags, phase);
      if (!color || !(color[0] || color[1] || color[2])) return pixels;
      const indexed = indexMask && indexMask.length === pixels.length / 4;
      for (let o = 0, i = 0; o < pixels.length; o += 4, i++) {
        const outline = indexed ? indexMask[i]
          : pixels[o] === 0 && pixels[o + 1] === 0 && pixels[o + 2] === 0;
        if (pixels[o + 3] && outline) {
          pixels[o] = color[0]; pixels[o + 1] = color[1]; pixels[o + 2] = color[2];
        }
      }
      return pixels;
    }
    tinted(sprite, color) {
      if (!sprite || !color || !(color[0] || color[1] || color[2])) return sprite;
      const key = color.join(",");
      let variants = this.cache.get(sprite);
      const old = variants?.get(key);
      if (old) { this.lru.delete(old); this.lru.set(old, true); return old.canvas; }
      const width = sprite.width || sprite.naturalWidth, height = sprite.height || sprite.naturalHeight;
      if (!width || !height) return sprite;
      const canvas = document.createElement("canvas"); canvas.width = width; canvas.height = height;
      const ctx = canvas.getContext("2d"); ctx.imageSmoothingEnabled = false;
      try {
        ctx.drawImage(sprite, 0, 0);
        const image = ctx.getImageData(0, 0, width, height), mask = sprite.skOutlineMask;
        const indexed = mask && mask.length === width * height;
        for (let o = 0, i = 0; o < image.data.length; o += 4, i++) {
          const outline = indexed ? mask[i]
            : image.data[o] === 0 && image.data[o + 1] === 0 && image.data[o + 2] === 0;
          if (image.data[o + 3] && outline) {
            image.data[o] = color[0]; image.data[o + 1] = color[1]; image.data[o + 2] = color[2];
          }
        }
        ctx.putImageData(image, 0, 0);
      } catch (_) { return sprite; }
      if (!variants) { variants = new Map(); this.cache.set(sprite, variants); }
      const entry = { sprite, key, canvas };
      variants.set(key, entry); this.lru.set(entry, true);
      while (this.lru.size > this.maxCache) {
        const first = this.lru.keys().next().value;
        this.lru.delete(first); this.cache.get(first.sprite)?.delete(first.key);
      }
      return canvas;
    }
    apply(st, sprite, flags, gauge, dt = 0, blocked = false) {
      const color = ArrowOutlineTint.advance(st, flags, gauge, dt, blocked || !sprite);
      return this.tinted(sprite, color);
    }
  }
  SK.ArrowOutlineTint = ArrowOutlineTint;
})(globalThis);

</script>
<script>
/* UI-independent custom-family controller: uploaded FamilySetup.cs,
 * GameApp.cs setup flow, CharacterParts.cs, and original-VM job filters.
 * Pure helpers do not mutate their inputs; controller methods only mutate
 * this draft. No DOM, live-game mutation, clock, or external side effects. */
(function (root) {
  "use strict";
  const SK = (root.SK = root.SK || {});
  const copy = (v) => JSON.parse(JSON.stringify(v));
  const clamp = (v, lo, hi) => Math.max(lo, Math.min(hi, v));
  const wrap = (v, n) => (n > 0 ? ((v % n) + n) % n : 0);
  const integer = (v) => Number.isInteger(v);
  const roleNames = ["할아버지", "할머니", "아버지", "어머니", "아들", "딸"];
  const limits = Object.freeze({ surname: 8, member: 6, god: 6 });
  // Emulator evidence supplied by the user at start2005: oldest1874,
  // grandparents latest1968, parents1986, children2004. For other start years,
  // the oldest boundary uses the corresponding131-year offset (inferred).
  // These are BIRTH-YEAR bounds, not exact ages or18-year generation gaps.
  const oldestBirthOffset = 131;
  const latestBirthOffsets = Object.freeze([37, 37, 19, 19, 1]);
  const compositionError = "부모와 자녀를 함께 골라 줘. 자녀가 없다면 아버지와 어머니가 모두 필요해.";
  function compositionErrors(setup) {
    const members = setup && setup.Members || [],
      father = members.some(m => m.Role === 2), mother = members.some(m => m.Role === 3),
      child = members.some(m => m.Role === 4);
    // New-family eligibility ignores grandparents. This is an initial setup
    // rule only: loading/continuing an existing one-person family is separate.
    return ((father || mother) && child) || (father && mother) ? [] : [compositionError];
  }
  const text = (v, n) => String(v == null ? "" : v).slice(0, n).trim();
  const dateParts = (day) => ({
    year: SK.GameDate.Year(day),
    month: SK.GameDate.Month(day),
    day: SK.GameDate.Day(day),
  });
  function daysInMonth(year, month) {
    const d = new Date(0);
    d.setUTCFullYear(year, month, 0);
    return d.getUTCDate();
  }
  function makeDate(parts, start = false) {
    // Start-year bounds are the uploaded UI's bounds. Birth bounds are only
    // DateTime's supported calendar range, not an invented age restriction.
    const y = clamp(Math.trunc(parts.year), start ? 1900 : 1, start ? 2999 : 9999);
    const m = clamp(Math.trunc(parts.month), 1, 12);
    const d = clamp(Math.trunc(parts.day), 1, daysInMonth(y, m));
    if (![y, m, d].every(Number.isFinite)) throw new Error("날짜를 확인해 줘");
    return SK.GameDate.Make(y, m, d);
  }
  function shiftDate(day, field, delta, start = false) {
    if (!integer(delta)) throw new Error("날짜 이동 값이 올바르지 않습니다");
    const p = dateParts(day);
    if (field === "year") p.year += delta;
    else if (field === "year10") p.year += 10 * delta;
    else if (field === "month") p.month = wrap(p.month - 1 + delta, 12) + 1;
    else if (field === "day") p.day = wrap(p.day - 1 + delta, daysInMonth(p.year, p.month)) + 1;
    else throw new Error("날짜 항목이 올바르지 않습니다");
    return makeDate(p, start);
  }
  function ranksFromOrder(order) {
    if (!Array.isArray(order) || order.length > 4 ||
        order.some((v) => !integer(v) || v < 0 || v > 3) ||
        new Set(order).size !== order.length) throw new Error("능력 순위를 확인해 줘");
    const picked = order.slice();
    // Original flow/reference prompts 42/43/44 choose the first three;
    // the remaining stat is fourth (uploaded GameApp combines these controls).
    if (picked.length === 3) picked.push([0, 1, 2, 3].find((s) => !picked.includes(s)));
    const ranks = [0, 0, 0, 0];
    picked.forEach((stat, i) => { ranks[stat] = i + 1; });
    return ranks;
  }
  function rankOrder(ranks) {
    return [0, 1, 2, 3].filter((s) => ranks[s] > 0).sort((a, b) => ranks[a] - ranks[b]);
  }
  function normalLook(raw) {
    const l = copy(SK.normalLook(raw));
    if (l) l.noseRes = true;
    return l;
  }
  const presetIds = (parts, role) => Object.keys((parts && parts.presets) || {})
    .filter((id) => id.startsWith(role + "_")).sort();
  function presetAges(parts, id) {
    const a = parts.presets[id].age;
    if (typeof a === "number") return { body: a, face: a, hair: a, feat: a, cls: -1 };
    if (a && typeof a === "object") return {
      body: a.body === undefined ? 1 : a.body, face: a.face === undefined ? 1 : a.face,
      hair: a.hair === undefined ? 1 : a.hair, feat: a.feat === undefined ? 1 : a.feat, cls: -1,
    };
    return { body: 1, face: 1, hair: 1, feat: 1, cls: -1 };
  }
  function applyPreset(parts, raw, id) {
    const p = parts && parts.presets && parts.presets[id];
    if (!p) throw new Error("캐릭터 목록을 확인해 줘");
    const l = normalLook(raw), source = normalLook(p);
    for (const k of ["face", "hair", "eyes", "nose", "mouth", "eyesFlip", "noseFlip", "mouthFlip"])
      l[k] = source[k];
    l.palette = source.palette ? source.palette.slice() : null;
    l.hairColor = l.skinColor = l.outfitColor = -1;
    l.preset = id;
    return l;
  }
  function setBody(raw, gender, build, outfit) {
    const l = normalLook(raw);
    l.body = (gender === 1 ? 12 : 0) + 4 * wrap(build, 3) + wrap(outfit, 4);
    l.outfit = wrap(outfit, 4);
    return l;
  }
  function randomLook(parts, seed, gender) {
    const rng = new SK.Rng(seed);
    const count = (cat) => Math.max(1, parts.count(cat));
    const l = {
      body: (gender === 1 ? 12 : 0) + rng.Next(12),
      face: rng.Next(count("face")), hair: rng.Next(count("hairfront")),
      eyes: rng.Next(count("eyes")), eyesFlip: rng.Next(2) === 1,
      nose: rng.Next(count("nose")), mouth: rng.Next(count("mouth")),
      hairColor: rng.Next(Math.max(1, (parts.palettes.hair || []).length)),
      skinColor: rng.Next(Math.max(1, (parts.palettes.skin || []).length)),
      outfitColor: rng.Next(4), noseRes: true,
    };
    l.outfit = l.body % 4;
    return normalLook(l);
  }
  function initialLook(parts, member, startDay, seed) {
    if (!parts || !parts.available) return null;
    const role = SK.FamilySetup.AsksCharacter(member, startDay)
      ? SK.FamilySetup.GalleryRole(member, startDay)
      : member.Gender === 0 ? "son7" : "daughter7";
    const ids = presetIds(parts, role);
    if (!ids.length) return randomLook(parts, seed, member.Gender);
    const id = ids[new SK.Rng(seed).Next(ids.length)], l = normalLook(parts.presets[id]);
    l.preset = id;
    l.outfit = l.body % 4;
    return l;
  }

  class OwnFamilySetup {
    constructor(options = {}) {
      this.setup = new SK.FamilySetup(options.setup ? copy(options.setup) : {});
      this.setup.Members = this.setup.Members.map((m) => new SK.MemberSetup(m));
      this.parts = options.parts || null;
      this.rules = options.rules || null;
      this.jobCache = new Map();
      this.jobNames = options.jobNames || null;
      this.adultSlots = [false, false, false, false];
      this.childSlots = [0, 0, 0, 0];
      let child = 0;
      for (const m of this.setup.Members) {
        if (m.Role >= 0 && m.Role < 4) this.adultSlots[m.Role] = true;
        else if (m.Role === 4 && child < 4) this.childSlots[child++] = m.Gender + 1;
      }
      this.step = "start";
      this.memberIndex = 0;
      this.lookPage = 0;
    }
    get member() { return this.setup.Members[this.memberIndex] || null; }
    get startParts() { return dateParts(this.setup.StartDay); }
    get memberCount() { return this.setup.Members.length; }
    getMember(i = this.memberIndex) {
      const m = this.setup.Members[i];
      if (!m) throw new Error("구성원 칸을 확인해 줘");
      return m;
    }
    roleLabel(i = this.memberIndex) {
      const m = this.getMember(i);
      return roleNames[m.Role === 4 ? 4 + m.Gender : m.Role];
    }
    age(i = this.memberIndex) { return SK.GameDate.AgeYears(this.getMember(i).BirthDay, this.setup.StartDay); }
    birthYearRange(i = this.memberIndex) {
      const m = this.getMember(i), minAge = latestBirthOffsets[m.Role];
      if (minAge === undefined) throw new Error("가족 칸을 확인해 줘");
      const startYear = this.startParts.year;
      let min = Math.max(1, startYear - oldestBirthOffset);
      if (m.Role === 4) {
        const parents = this.setup.Members.filter((p) => p.Role === 2 || p.Role === 3);
        if (parents.length) min = Math.max(min, ...parents.map((p) => SK.GameDate.Year(p.BirthDay) + 1));
      }
      return { min, max: startYear - minAge, minAge };
    }
    agePolicy(i = this.memberIndex) {
      // Compatibility for callers being migrated to birthYearRange. The UI
      // must display allowed years; birthday month/day can change exact age.
      const range = this.birthYearRange(i);
      return { min: range.minAge, max: this.startParts.year - range.min,
        minYear: range.min, maxYear: range.max, label: this.roleLabel(i) };
    }
    birthValidation(i = this.memberIndex, options = {}) {
      const m = this.getMember(i), day = options.birthDay === undefined ? m.BirthDay : options.birthDay;
      if (!Number.isInteger(day)) return ["생일을 확인해 주세요."];
      if (day > this.setup.StartDay) return ["생일이 시작일보다 늦어"];
      const range = this.birthYearRange(i), year = SK.GameDate.Year(day);
      if (range.min > range.max) return ["부모님의 생일을 먼저 확인해 주세요."];
      if (year < range.min || year > range.max)
        return [this.roleLabel(i) + "의 출생 연도는 " + range.min + "~" + range.max + "년으로 정해 주세요."];
      return [];
    }
    confirmBirth(i = this.memberIndex) {
      const errors = this.birthValidation(i);
      if (errors.length) throw new Error(errors.join("; "));
      return true;
    }
    birthParts(i = this.memberIndex) { return dateParts(this.getMember(i).BirthDay); }
    setStartDate(parts) {
      return this.setup.StartDay = makeDate(parts, true);
    }
    shiftStart(field, delta) {
      return this.setup.StartDay = shiftDate(this.setup.StartDay, field, delta, true);
    }
    setSurname(value) { this.setup.Surname = text(value, limits.surname); return this.setup.Surname; }
    toggleAdult(i) {
      if (!integer(i) || i < 0 || i > 3) throw new Error("가족 칸을 확인해 줘");
      this.adultSlots[i] = !this.adultSlots[i];
      return this.adultSlots[i];
    }
    setChild(i, value) {
      if (!integer(i) || i < 0 || i > 3 || ![0, 1, 2].includes(value)) throw new Error("자녀 칸을 확인해 줘");
      this.childSlots[i] = value;
      return value;
    }
    cycleChild(i) { return this.setChild(i, wrap(this.childSlots[i] + 1, 3)); }
    applyComposition() {
      if (!((this.adultSlots[2] || this.adultSlots[3]) && this.childSlots.some(Boolean)) &&
          !(this.adultSlots[2] && this.adultSlots[3])) return [compositionError];
      const old = this.setup.Members.slice();
      this.setup.Members = [];
      const reuse = (role, gender) => {
        const index = old.findIndex((m) => m.Role === role && m.Gender === gender);
        if (index < 0) return this.setup.Add(role, gender);
        const m = old.splice(index, 1)[0];
        this.setup.Members.push(m);
        return m;
      };
      for (let i = 0; i < 4; i++) if (this.adultSlots[i]) reuse(i, i === 1 || i === 3 ? 1 : 0);
      for (let i = 0; i < 4; i++) if (this.childSlots[i]) reuse(4, this.childSlots[i] - 1);
      return this.memberCount ? [] : ["가족을 한 명 이상 골라 줘"];
    }
    setName(i, value) { return this.getMember(i).Name = text(value, limits.member); }
    setBirthDate(i, parts) {
      const m = this.getMember(i), day = makeDate(parts);
      const errors = this.birthValidation(i, { birthDay: day });
      if (errors.length) throw new Error(errors.join("; "));
      return m.BirthDay = day;
    }
    shiftBirth(i, field, delta) {
      const m = this.getMember(i);
      if (!integer(delta)) throw new Error("날짜 이동 값이 올바르지 않습니다");
      if (field === "year" || field === "year10") {
        const p = this.birthParts(i), range = this.birthYearRange(i);
        if (range.min > range.max) throw new Error("부모님의 생일을 먼저 확인해 주세요.");
        // Endpoint wrap for±1 is emulator-confirmed;±10 follows the same
        // modular stepping convention as an explicit UI extension.
        p.year = range.min + wrap(p.year - range.min + delta * (field === "year10" ? 10 : 1), range.max - range.min + 1);
        return this.setBirthDate(i, p);
      }
      const day = shiftDate(m.BirthDay, field, delta);
      const errors = this.birthValidation(i, { birthDay: day });
      if (errors.length) throw new Error(errors.join("; "));
      return m.BirthDay = day;
    }
    setBlood(i, value) {
      if (!SK.MemberSetup.Bloods.includes(value)) throw new Error("혈액형을 확인해 줘");
      return this.getMember(i).Blood = value;
    }
    setPersonality(i, value) {
      if (![0, 1, 2].includes(value)) throw new Error("성격을 확인해 줘");
      return this.getMember(i).Personality = value;
    }
    resetRanks(i = this.memberIndex) { return this.getMember(i).AbilityRank = [0, 0, 0, 0]; }
    pickRank(i, stat) {
      const m = this.getMember(i);
      if (!integer(stat) || stat < 0 || stat > 3) throw new Error("능력을 확인해 줘");
      if (m.AbilityRank[stat] > 0) return m.AbilityRank.slice();
      return m.AbilityRank = ranksFromOrder(rankOrder(m.AbilityRank).concat(stat));
    }
    loadRules() {
      if (!this.rules) {
        this.rules = SK.OrigRules.FromJson(SK.resourceJson("LocalOrig/orig_rules"));
        if (!this.rules) throw new Error("원작 규칙 자료가 없습니다");
        this.rules.TreesText = SK.resourceBytes("LocalOrig/orig_trees");
      }
      return this.rules;
    }
    jobOptions(i = this.memberIndex) {
      const m = this.getMember(i);
      // Fresh private VM, same source entry points; never mutate the live game.
      const key = [this.setup.StartDay, m.BirthDay, m.Gender, m.Role].join(":");
      if (!this.jobCache.has(key)) {
        if (this.jobCache.size >= 128) this.jobCache.delete(this.jobCache.keys().next().value);
        this.jobCache.set(key, SK.OrigJobs.Candidates(this.loadRules(), this.setup.StartDay,
          m.BirthDay, m.Gender, SK.OrigJobs.Relation(m.Role, m.Gender)).slice());
      }
      const ids = this.jobCache.get(key);
      if (ids.length && !ids.includes(m.Job)) m.Job = ids[0];
      return { ids: ids.slice(), names: ids.map((id) => this.jobName(id)),
        selected: m.Job, selectedIndex: Math.max(0, ids.indexOf(m.Job)) };
    }
    jobName(id) {
      // Setup can precede createGame()/OrigText initialization. Read the exact
      // text pack locally rather than mutating the shared OrigJobs.PackNames.
      if (!this.jobNames) this.jobNames = SK.OrigJobs.PackNames || SK.resourceJson("LocalOrig/orig_text").jobs || [];
      const name = this.jobNames[id];
      return name ? name === "없어" ? "없음" : name : SK.OrigJobs.Name(id);
    }
    cycleJob(i, delta) {
      const options = this.jobOptions(i);
      if (options.ids.length) this.getMember(i).Job = options.ids[wrap(options.selectedIndex + delta, options.ids.length)];
      return this.getMember(i).Job;
    }
    ensureLook(i = this.memberIndex) {
      const m = this.getMember(i);
      if (!m.Look) m.Look = initialLook(this.parts, m, this.setup.StartDay, (i + 1) * 7919);
      return m.Look;
    }
    lookOptions(i = this.memberIndex) {
      const m = this.getMember(i), l = this.ensureLook(i);
      const role = SK.FamilySetup.GalleryRole(m, this.setup.StartDay);
      const ids = presetIds(this.parts, role);
      return { asksCharacter: SK.FamilySetup.AsksCharacter(m, this.setup.StartDay),
        available: Boolean(this.parts && this.parts.available), role,
        ages: SK.WebAgeSlots.forAge(this.age(i)), ids, pages: Math.max(1, Math.ceil(ids.length / 12)),
        build: l ? Math.floor(wrap(normalLook(l).body, 12) / 4) : 0,
        outfit: l ? wrap(normalLook(l).body, 4) : 0,
        builds: ["얇은", "보통", "굵은"], hairColors: ((this.parts && this.parts.palettes.hair) || []).length,
        skinColors: ((this.parts && this.parts.palettes.skin) || []).length, outfitColors: 4 };
    }
    gallery(i = this.memberIndex, page = this.lookPage) {
      const options = this.lookOptions(i);
      this.lookPage = clamp(Math.trunc(page) || 0, 0, options.pages - 1);
      return { page: this.lookPage, pages: options.pages,
        entries: options.ids.slice(this.lookPage * 12, this.lookPage * 12 + 12)
          .map((id) => ({ id, look: applyPreset(this.parts, this.getMember(i).Look, id), ages: presetAges(this.parts, id) })) };
    }
    setBuild(i, build) {
      if (![0, 1, 2].includes(build)) throw new Error("체형을 확인해 줘");
      const m = this.getMember(i), l = normalLook(this.ensureLook(i));
      m.LookEdited = true;
      return m.Look = setBody(l, l.body >= 12 ? 1 : 0, build, l.body % 4);
    }
    shiftOutfit(i, delta) {
      const m = this.getMember(i), l = normalLook(this.ensureLook(i));
      m.LookEdited = true;
      return m.Look = setBody(l, l.body >= 12 ? 1 : 0, Math.floor((l.body % 12) / 4), l.body % 4 + delta);
    }
    shiftColor(i, field, delta) {
      if (!["hairColor", "skinColor", "outfitColor"].includes(field)) throw new Error("색상을 확인해 줘");
      const m = this.getMember(i), l = normalLook(this.ensureLook(i)), options = this.lookOptions(i);
      const n = field === "hairColor" ? options.hairColors : field === "skinColor" ? options.skinColors : 4;
      l[field] = wrap(l[field] + delta, n);
      m.LookEdited = true;
      return m.Look = l;
    }
    selectPreset(i, id) {
      const m = this.getMember(i);
      if (!this.lookOptions(i).ids.includes(id)) throw new Error("구성원 캐릭터 목록을 확인해 줘");
      m.LookEdited = true;
      return m.Look = applyPreset(this.parts, this.ensureLook(i), id);
    }
    randomLook(i, seed) {
      const m = this.getMember(i);
      if (!this.parts || !this.parts.available) return null;
      m.LookEdited = true;
      return m.Look = randomLook(this.parts, seed, m.Gender);
    }
    partOptions(i = this.memberIndex, field) {
      const l = normalLook(this.ensureLook(i));
      if (!l || !this.parts || !this.parts.available) throw new Error("캐릭터 파트 자료가 없습니다");
      const definitions = [
        ["hair", "머리", this.parts.count("hairfront"), 0],
        ["eyes", "눈", this.parts.count("eyes"), 0],
        ["nose", "코", this.parts.count("nose"), 0],
        ["mouth", "입", this.parts.count("mouth"), 0],
        ["face", "얼굴", this.parts.count("face"), 0],
        ["build", "체형", 3, 0],
        ["skinColor", "피부색", (this.parts.palettes.skin || []).length, -1],
        ["hairColor", "머리색", (this.parts.palettes.hair || []).length, -1],
        ["outfit", "의상", 4, 0],
        ["outfitColor", "의상색", 4, -1],
        ["extra", "수염·장식", this.parts.count("extra"), -1],
      ];
      const options = definitions.map(([key, label, count, min]) => {
        const selected = key === "build" ? Math.floor(wrap(l.body, 12) / 4)
          : key === "outfit" ? wrap(l.body, 4) : l[key];
        let values = Array.from({ length: count - min }, (_, k) => {
          const value = k + min;
          return { value, label: value === -1 ? key === "extra" ? "없음" : "기본색"
            : key === "build" ? ["얇은", "보통", "굵은"][value] : (value + 1) + "/" + count };
        });
        const emptyIndices = [];
        if (key === "nose") {
          const ages = SK.WebAgeSlots.forAge(this.age(i));
          for (let index = 0; index < count; index++) {
            const p = this.parts.part("nose", index, ages, ages.feat);
            if (!p || !p.w || !p.h || !this.parts.pixels.subarray(p.off, p.off + p.w * p.h).some((v) => v !== 0)) emptyIndices.push(index);
          }
          const none = emptyIndices[0];
          values = values.filter((v) => !emptyIndices.includes(v.value) || v.value === none)
            .map((v) => v.value === none ? { value: v.value, label: "없음" } : v);
          // Age changes may make a previously chosen resource empty. Keep the
          // exact chosen index represented; never reseed or rewrite the look.
          if (emptyIndices.includes(selected) && selected !== none)
            values.push({ value: selected, label: "없음(현재)" });
        }
        const selectedOptionValue = values.some((v) => v.value === selected) ? selected
          : emptyIndices.includes(selected) ? emptyIndices[0] : selected;
        return { field: key, label, count, min, max: count - 1, selected, selectedOptionValue,
          selectedIndex: values.findIndex((v) => v.value === selectedOptionValue),
          selectedLabel: (values.find((v) => v.value === selectedOptionValue) || {}).label || "-",
          options: values, availableCount: values.length, emptyIndices };
      });
      if (field === undefined) return options;
      const found = options.find((v) => v.field === field);
      if (!found) throw new Error("캐릭터 항목을 확인해 줘");
      return found;
    }
    setPart(i, field, index) {
      const option = this.partOptions(i, field);
      if (!integer(index) || index < option.min || index > option.max) throw new Error("캐릭터 파트 번호를 확인해 줘");
      const m = this.getMember(i), l = normalLook(m.Look);
      m.LookEdited = true;
      if (field === "build" || field === "outfit") {
        const changed = setBody(l, l.body >= 12 ? 1 : 0,
          field === "build" ? index : Math.floor(wrap(l.body, 12) / 4),
          field === "outfit" ? index : wrap(l.body, 4));
        changed.preset = "";
        return m.Look = changed;
      }
      l[field] = index;
      l.noseRes = true;
      l.preset = "";
      return m.Look = l;
    }
    shiftPart(i, field, delta) {
      if (!integer(delta)) throw new Error("캐릭터 이동 값을 확인해 줘");
      const option = this.partOptions(i, field);
      const index = option.selectedIndex;
      if (!option.options.length) throw new Error("캐릭터 파트 자료가 없습니다");
      return this.setPart(i, field, option.options[wrap(Math.max(0, index) + delta, option.options.length)].value);
    }
    flipPart(i, field) {
      if (!["eyes", "nose", "mouth"].includes(field)) throw new Error("뒤집을 캐릭터 항목을 확인해 줘");
      const m = this.getMember(i), l = normalLook(this.ensureLook(i));
      l[field + "Flip"] = !l[field + "Flip"];
      l.preset = "";
      m.LookEdited = true;
      return m.Look = l;
    }
    validateMember(i = this.memberIndex) {
      const m = this.getMember(i), e = [];
      if (!m.Name) e.push("이름을 입력해 줘");
      if (!Array.isArray(m.AbilityRank) || m.AbilityRank.length !== 4 ||
          m.AbilityRank.slice().sort().join(",") !== "1,2,3,4") e.push("능력 순위를 끝까지 골라 줘");
      e.push(...this.birthValidation(i));
      return e;
    }
    validate() {
      const e = this.setup.Validate();
      e.push(...compositionErrors(this.setup));
      if (!this.setup.Surname) e.unshift("가족 성을 입력해 줘");
      for (let i = 0; i < this.memberCount; i++) e.push(...this.birthValidation(i));
      return [...new Set(e)];
    }
    advanceMember() {
      this.memberIndex++;
      this.lookPage = 0;
      this.step = this.memberIndex >= this.memberCount ? "finish" : "member";
    }
    next() {
      let errors = [];
      if (this.step === "start") this.step = "surname";
      else if (this.step === "surname") {
        if (!this.setup.Surname) errors = ["가족 성을 입력해 줘"];
        else this.step = "composition";
      } else if (this.step === "composition") {
        errors = this.applyComposition();
        if (!errors.length) { this.memberIndex = 0; this.lookPage = 0; this.step = "member"; }
      } else if (this.step === "member") {
        errors = this.validateMember();
        if (!errors.length) {
          this.jobOptions();
          this.ensureLook();
          if (this.parts && this.parts.available && SK.FamilySetup.AsksCharacter(this.member, this.setup.StartDay)) this.step = "look";
          else this.advanceMember();
        }
      } else if (this.step === "look") this.advanceMember();
      if (this.step === "finish") {
        errors = this.validate();
        if (errors.length) { this.memberIndex = 0; this.step = "member"; }
      }
      return { ok: !errors.length, errors, step: this.step, memberIndex: this.memberIndex };
    }
    back() {
      if (this.step === "surname") this.step = "start";
      else if (this.step === "composition") this.step = "surname";
      else if (this.step === "look") this.step = "member";
      else if (this.step === "member" || this.step === "finish") {
        if (this.memberIndex <= 0) this.step = "composition";
        else {
          this.memberIndex = Math.min(this.memberCount - 1, this.memberIndex - 1);
          this.step = this.parts && this.parts.available && SK.FamilySetup.AsksCharacter(this.member, this.setup.StartDay) ? "look" : "member";
        }
      }
      this.lookPage = 0;
      return this.step;
    }
    toSetup(options = {}) {
      const e = this.validate();
      if (e.length) throw new Error(e.join("; "));
      const snapshot = new SK.FamilySetup(copy(this.setup));
      snapshot.Members = snapshot.Members.map((m) => new SK.MemberSetup(m));
      return SK.FamilyEvolution?.inheritSetup
        ? SK.FamilyEvolution.inheritSetup(snapshot, { parts: this.parts,
          seed: options.seed == null ? this.setup.StartDay : options.seed, preserveExplicitChildLook: true })
        : snapshot;
    }
  }
  Object.assign(OwnFamilySetup, { Limits: limits, RoleNames: Object.freeze(roleNames),
    CompositionErrors: compositionErrors,
    DateParts: dateParts, DaysInMonth: daysInMonth, MakeDate: makeDate, ShiftDate: shiftDate,
    RanksFromOrder: ranksFromOrder, RankOrder: rankOrder, PresetIds: presetIds, PresetAges: presetAges,
    ApplyPreset: applyPreset, SetBody: setBody, RandomLook: randomLook, InitialLook: initialLook });
  SK.OwnFamilySetup = OwnFamilySetup;
})(globalThis);

</script>
<script>
/* Recommended START draft generation. This is a separate, seed-local setup
 * layer: the original Recommended/NewCustom engine and its RNG stay intact.
 * Age preferences below are sampling choices, not extra validation limits. */
(function (root) {
  "use strict";
  const SK = (root.SK = root.SK || {});
  const surnames = [
    "김", "이", "박", "최", "정", "강", "조", "윤", "장", "임", "한", "오",
    "서", "신", "권", "황", "안", "송", "전", "홍", "유", "고", "문", "양",
    "손", "배", "백", "허", "남", "심", "노", "하", "성", "곽", "차", "주",
    "우", "구", "민", "류", "나", "진", "지", "엄", "채", "원", "천", "방",
  ];
  const givenNames = SK.KoreanNames.byGender;

  let preparedJobRules = null;
  function jobRules() {
    if (preparedJobRules) return preparedJobRules;
    const rules = SK.OrigRules.FromJson(SK.resourceJson("LocalOrig/orig_rules"));
    rules.TreesText = SK.resourceBytes("LocalOrig/orig_trees");
    // Parse the immutable original source/index/ROM once, never a live game.
    const prepared = rules.CreateVm(new SK.OrigMem());
    rules.CreateVm = function (memory) {
      memory.ShareRom(prepared.Mem);
      const vm = new SK.OrigVm(memory);
      vm.Rules = rules;
      vm.treeText = prepared.treeText;
      vm.lazy = new Map(prepared.lazy);
      vm.trees = new Map(prepared.trees);
      return vm;
    };
    preparedJobRules = rules;
    return rules;
  }

  function localRng(seed) {
    // Mulberry32 has no shared state and mixes nearby START seeds well.
    let state = Number(seed) >>> 0;
    const next = () => {
      state = (state + 0x6d2b79f5) >>> 0;
      let n = Math.imul(state ^ (state >>> 15), state | 1);
      n ^= n + Math.imul(n ^ (n >>> 7), n | 61);
      return (n ^ (n >>> 14)) >>> 0;
    };
    return {
      next,
      int: (min, max) => min + (next() % (max - min + 1)),
      pick: (items) => items[next() % items.length],
    };
  }

  function composition(rng) {
    const grandparent = () => rng.pick([[0], [1], [0, 1]]).slice();
    const parent = () => rng.pick([[2], [3], [2, 3]]).slice();
    switch (rng.int(0, 9)) {
      case 0: return { adults: [2, 3], children: rng.int(1, 4) };
      case 1: return { adults: [2], children: rng.int(1, 4) };
      case 2: return { adults: [3], children: rng.int(1, 4) };
      // Grandparents do not satisfy initial continuation. Childless starts
      // need both original parent roles; a single parent always has a child.
      case 3: return { adults: [0, 1, 2, 3], children: 0 };
      case 4: return { adults: [0, 2, 3], children: 0 };
      case 5: return { adults: [1, 2, 3], children: 0 };
      case 6: return { adults: grandparent().concat(parent()), children: rng.int(1, 4) };
      case 7: return { adults: [2, 3], children: 0 };
      case 8: return { adults: [rng.pick([2, 3])], children: rng.int(1, 4) };
      default: return { adults: grandparent().concat([rng.pick([2, 3])]), children: rng.int(1, 4) };
    }
  }

  function birthDay(rng, minYear, maxYear, preferredYear, ageOnDay = null) {
    // Only the accepted original birth-YEAR bounds constrain the result.
    let year = Math.max(minYear, Math.min(maxYear, preferredYear));
    const month = rng.int(1, 12),
      day = rng.int(1, SK.OwnFamilySetup.DaysInMonth(year, month));
    // Childless recommendations sample completed ages19–35. A birthday
    // later in the start year needs the preceding birth year for that age.
    if (ageOnDay !== null && (month > SK.GameDate.Month(ageOnDay) ||
        month === SK.GameDate.Month(ageOnDay) && day > SK.GameDate.Day(ageOnDay)))
      year = Math.max(minYear, year - 1);
    const actualDay = Math.min(day, SK.OwnFamilySetup.DaysInMonth(year, month));
    // Moving a Feb29 birthday into a non-leap year can make it Feb28, now
    // on/before the start date. Keep the sampled completed age in that case.
    if (ageOnDay !== null && SK.GameDate.AgeYears(
        SK.GameDate.Make(year, month, actualDay), ageOnDay) >
        SK.GameDate.Year(ageOnDay) - preferredYear)
      year = Math.min(maxYear, year + 1);
    return SK.GameDate.Make(year, month, actualDay);
  }

  function rankPermutation(rng) {
    const ranks = [1, 2, 3, 4];
    for (let i = ranks.length - 1; i > 0; i--) {
      const j = rng.int(0, i);
      [ranks[i], ranks[j]] = [ranks[j], ranks[i]];
    }
    return ranks;
  }

  function create(options = {}) {
    const rng = localRng(options.seed),
      startDay = SK.OwnFamilySetup.MakeDate({
        year: options.year === undefined ? 2005 : options.year,
        month: options.month === undefined ? 1 : options.month,
        day: options.day === undefined ? 1 : options.day,
      }, true),
      year = SK.GameDate.Year(startDay),
      shape = composition(rng),
      // Draw even when supplied so supplying a surname does not alter the
      // member names, composition, dates, stats, jobs, or look seeds.
      randomSurname = rng.pick(surnames),
      setup = new SK.FamilySetup({
        StartDay: startDay,
        Surname: options.surname === undefined || options.surname === null || options.surname === ""
          ? randomSurname : String(options.surname),
      }),
      names = new Set(),
      parentOffset = rng.int(30, 50),
      parentOffsets = new Map();
    for (const role of shape.adults)
      if (role === 2 || role === 3)
        parentOffsets.set(role, shape.children
          ? parentOffset + rng.int(-3, 3) : rng.int(19, 35));
    const oldestParentOffset = parentOffsets.size ? Math.max(...parentOffsets.values()) : 0;

    function add(role, gender, preferredYear) {
      const choices = givenNames[gender].filter((name) => !names.has(name)),
        name = rng.pick(choices);
      names.add(name);
      const parents = setup.Members.filter((m) => m.Role === 2 || m.Role === 3),
        minYear = role === 4 && parents.length
          ? Math.max(year - 131, ...parents.map((m) => SK.GameDate.Year(m.BirthDay) + 1))
          : year - 131,
        maxYear = year - (role < 2 ? 37 : role < 4 ? 19 : 1);
      setup.Members.push(new SK.MemberSetup({
        Role: role,
        Gender: gender,
        Name: name,
        BirthDay: birthDay(rng, minYear, maxYear, preferredYear,
          !shape.children && role >= 2 && role < 4 ? startDay : null),
        Blood: rng.pick(SK.MemberSetup.Bloods),
        Personality: rng.int(0, SK.MemberSetup.Personalities.length - 1),
        AbilityRank: rankPermutation(rng),
      }));
    }

    for (const role of shape.adults) {
      const offset = role < 2
        ? shape.children && oldestParentOffset
          ? oldestParentOffset + rng.int(20, 34)
          : rng.int(58, 85)
        : parentOffsets.get(role);
      add(role, role === 1 || role === 3 ? 1 : 0, year - offset);
    }
    for (let i = 0; i < shape.children; i++)
      add(4, rng.int(0, 1), year - rng.int(1, 17));

    // A private controller uses the original VM's exact job-candidate filter.
    // It neither owns nor receives a live game, engine memory, or RNG.
    const draft = new SK.OwnFamilySetup({ setup, parts: options.parts || null, rules: jobRules() });
    for (let i = 0; i < draft.memberCount; i++) {
      const member = draft.getMember(i), ids = draft.jobOptions(i).ids;
      if (!ids.length) throw new Error("원작 직업 후보를 찾을 수 없습니다");
      member.Job = rng.pick(ids);
      const lookSeed = rng.next();
      if (options.parts && options.parts.available &&
          typeof SK.OwnFamilySetup.RandomLook === "function")
        member.Look = SK.OwnFamilySetup.RandomLook(options.parts, lookSeed, member.Gender);
      // No available parts: null deliberately retains native engine appearance.
    }
    return draft.toSetup({ seed: options.seed });
  }

  SK.RandomFamilySetup = Object.freeze({ create });
})(globalThis);

</script>
<script>
/* Original own-family input flow, using native HTML/phone text inputs rather
 * than the supplied on-screen keyboard. This wizard edits a private draft;
 * only Finish calls the existing original NewCustom rule path through app.
 */
(function (root) {
  "use strict";
  const SK = root.SK = root.SK || {};
  const esc = value => String(value ?? "").replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const STATS = ["지력", "체력", "매력", "운"];
  const TITLES = {start:"시작년월일을 알려줘!",surname:"가족의 성을 알려줘!",composition:"가족 구성을 알려줘!",choose:"가족 모두에 대해 알려줘!",name:"이름을 알려줘!",birth:"생일을 알려줘!",blood:"혈액형을 알려줘!",personality:"성격을 알려줘!",rank:"능력 순위를 알려줘!",job:"직업을 알려줘!",build:"캐릭터 체격을 알려줘!",gallery:"캐릭터를 골라줘!",look:"이 캐릭터로 괜찮아?",colors:"캐릭터 색상을 바꿔줘!",parts:"생김새를 알려줘!",summary:"이대로 괜찮아?"};
  class OwnFamilyWizard {
    constructor(app) {
      this.app = app;
      this.model = new SK.OwnFamilySetup({parts:app.art.parts});
      this.text = app.introScene?.text || SK.OrigText.FromJson(SK.resourceJson("LocalOrig/orig_text"));
      this.done = new Set();
      this.serial = 0;
      this.page = "start";
      this.dialog = null;
      this.jobPage = 0;
      this.ready = Promise.all(["green","pink","yellow","title","panel","tree","spotlights","gallery"].map(n => app.art.image("own_setup_"+n).decode()));
    }
    start() { this.say([25,26],()=>this.open("start")); }
    role() { return this.model.memberCount ? this.model.roleLabel(this.model.memberIndex) : ""; }
    name(code) {
      return code===0x27 ? this.model.setup.Surname || "○○"
        : code===0x2c ? this.role()
        : code===0x26 ? this.app.introFlow?.playerName || "○○" : null;
    }
    pages(id) {
      const bytes = this.text.Heaven.Msgs.get(id);
      if (!bytes) throw new Error("원작 가족 입력 대사가 없습니다: "+id);
      const pages = this.text.Decode(bytes,(code,fmt)=>this.name(code),null,null);
      // Preserve the supplied story; adapt only the original D-pad/A-button
      // instructions to the controls that actually exist on a phone.
      const controls = {
        26:["십자 버튼으로 숫자를 고르고\nＡ버튼으로 결정해 줘！","＋·−로 숫자를 고르고\n다음을 눌러 줘！"],
        30:["그 집에 사는 사람들을\nＡ버튼으로 골라서 알려 줘！","그 집에 사는 사람들의\n칸을 눌러서 알려 줘！"],
        33:["십자 버튼으로 골라 줘！","구성원의 칸을 눌러 줘！"],
        34:["십자 버튼으로 골라 줘！","구성원의 칸을 눌러 줘！"],
        50:["십자 버튼의 상하좌우로 고르고\nＡ버튼으로 결정해！","캐릭터를 누르고\n결정 버튼을 눌러 줘！"],
        52:["바꾸고 싶은 항목을 고른 뒤\n십자 버튼의 좌우로 선택해 줘！","바꾸고 싶은 항목의\n◀·▶로 선택해 줘！"],
      };
      return controls[id] ? pages.map(page=>page.replace(...controls[id])) : pages;
    }
    say(ids,next,choices=null,pick=null) {
      this.dialog={ids:ids.slice(),index:0,page:0,pages:this.pages(ids[0]),next,choices,pick};
      this.serial++;
      this.render();
    }
    view() {
      const d=this.dialog;
      if (!d) return null;
      const last=d.index===d.ids.length-1 && d.page===d.pages.length-1;
      return {mode:"dialogue",messageId:d.ids[d.index],text:d.pages[d.page],speaker:"큐피트",speakerKey:"cupid",song:3,choices:last&&d.choices?d.choices.map((text,index)=>({text,index})):[],page:d.page,pages:d.pages.length};
    }
    advance() {
      const d=this.dialog;if(!d)return;
      if(d.index===d.ids.length-1&&d.page===d.pages.length-1&&d.choices)return;
      if(++d.page>=d.pages.length){d.page=0;if(++d.index<d.ids.length)d.pages=this.pages(d.ids[d.index]);else{this.dialog=null;d.next?.();return;}}
      this.serial++;this.render();
    }
    choose(index) {
      const d=this.dialog;if(!d?.choices)return;
      this.dialog=null;d.pick?.(index);
    }
    open(page) { this.dialog=null;this.page=page;this.serial++;this.render(); }
    error(message) {
      const node=document.querySelector('#own-error');
      if(node){
        node.textContent=message;node.hidden=false;
        // Reveal validation feedback in this input panel only. Keep the
        // page/scene position unchanged when a longer message overflows.
        const panel=node.closest('.own-input-panel');
        if(panel){
          const error=node.getBoundingClientRect(),view=panel.getBoundingClientRect();
          if(error.bottom>view.bottom)panel.scrollTop+=error.bottom-view.bottom;
          else if(error.top<view.top)panel.scrollTop-=view.top-error.top;
        }
      }else this.app.toast(message);
    }
    button(id,fn) { const b=document.getElementById(id);if(b)b.onclick=()=>this.app.act(fn); }
    attrs(name,max,value) {return 'id="'+name+'" class="own-native-input" type="text" inputmode="text" maxlength="'+max+'" autocomplete="off" autocapitalize="off" spellcheck="false" enterkeyhint="next" value="'+esc(value)+'"';}
    actions(back,next,label="결정",disabled=false) { return '<div class="own-actions">'+(back?'<button type="button" id="own-back" class="btn secondary small">돌아가기</button>':'')+(next?'<button id="own-next" class="btn orange small" type="submit" '+(disabled?'disabled':'')+'>'+esc(label)+'</button>':'')+'</div>'; }
    dateHtml(birth) {
      const p=birth?this.model.birthParts(this.model.memberIndex):this.model.startParts;
      const errors=birth?this.model.birthValidation():[],range=birth?this.model.birthYearRange():null,start=this.model.startParts;
      return '<div class="own-date-grid">'+[['year','연',p.year],['month','월',p.month],['day','일',p.day]].map(([field,label,value])=>'<section><span>'+label+'</span><strong>'+value+'</strong><div><button type="button" data-date="'+field+'" data-delta="-1" aria-label="'+label+' 1 감소">−</button><button type="button" data-date="'+field+'" data-delta="1" aria-label="'+label+' 1 증가">＋</button></div>'+(field==='year'?'<div><button type="button" data-date="year10" data-delta="-1">−10</button><button type="button" data-date="year10" data-delta="1">＋10</button></div>':'')+'</section>').join('')+'</div>'+(birth?'<div class="own-date-status"><span>'+this.model.age()+'세 · 시작일 '+start.year+'.'+start.month+'.'+start.day+'</span><span>'+esc(this.role())+' 생년 '+range.min+'~'+range.max+'</span></div>'+(errors.length?'<p class="own-date-age invalid" role="status">'+errors.map(esc).join('<br>')+'</p>':''):'');
    }
    compositionHtml() {
      const labels=['할아버지','할머니','아버지','어머니'];
      return '<div class="own-tree">'+labels.map((label,i)=>'<button type="button" data-adult="'+i+'" class="own-role role-'+i+'" aria-pressed="'+this.model.adultSlots[i]+'">'+label+'</button>').join('')+this.model.childSlots.map((v,i)=>'<button type="button" data-child="'+i+'" class="own-role child-'+i+'" aria-pressed="'+Boolean(v)+'">'+(v===1?'아들':v===2?'딸':'아들·딸')+'</button>').join('')+'</div><p class="own-help">자녀 칸: 아들 → 딸 → 없음</p>';
    }
    membersHtml() {
      return '<div class="own-member-list">'+this.model.setup.Members.map((m,i)=>'<button type="button" data-member="'+i+'" class="own-member '+(this.done.has(i)?'complete':'')+'"><canvas width="32" height="64" data-member-look="'+i+'"></canvas><span><strong>'+esc(this.model.roleLabel(i))+'</strong><small>'+esc(m.Name||'이름을 알려줘')+' · '+this.model.age(i)+'세</small></span><b>'+ (this.done.has(i)?'✓':'?')+'</b></button>').join('')+'</div><button type="button" id="own-all-ok" class="btn orange" '+(this.done.size!==this.model.memberCount?'disabled':'')+'>모두 OK!</button>';
    }
    partControl(field) {
      const d=this.model.partOptions(this.model.memberIndex,field);
      return '<section class="own-part-control"><label for="part-'+field+'">'+esc(d.label)+'</label><div><button type="button" data-part-shift="'+field+'" data-delta="-1" aria-label="'+esc(d.label)+' 이전">◀</button><select id="part-'+field+'" data-part-select="'+field+'" aria-label="'+esc(d.label)+' 선택">'+d.options.map(o=>'<option value="'+o.value+'" '+(o.value===(d.selectedOptionValue??d.selected)?'selected':'')+'>'+esc(o.label)+'</option>').join('')+'</select><button type="button" data-part-shift="'+field+'" data-delta="1" aria-label="'+esc(d.label)+' 다음">▶</button></div></section>';
    }
    partsHtml() {
      const extra=Boolean(this.partExtra),left=extra?['face','hairColor']:['hair','nose','build'],right=extra?['outfit','outfitColor']:['eyes','mouth','skinColor'];
      return '<div class="own-parts-workspace"><div class="own-parts-column">'+left.map(f=>this.partControl(f)).join('')+'</div><div class="own-parts-hero"><div class="own-parts-display"><strong>'+esc(this.model.member.Name)+'</strong><canvas id="own-part-preview" width="32" height="48" aria-label="파츠를 조합한 캐릭터 미리보기"></canvas></div><button type="button" id="own-part-turn">'+(this.partPose===0?'앞모습':'뒷모습')+'</button></div><div class="own-parts-column">'+right.map(f=>this.partControl(f)).join('')+'</div></div><div class="own-parts-footer"><button type="button" id="own-part-extra" class="btn secondary small" aria-pressed="'+extra+'">'+(extra?'기본 파츠':'추가 파츠')+'</button>'+this.actions(true,true,'이 조합으로 OK!')+'</div>';
    }
    summaryHtml() {
      const i=this.model.memberIndex,m=this.model.member,p=this.model.birthParts(i);
      return '<div class="own-summary"><canvas width="32" height="64" id="own-look-preview"></canvas><dl><dt>이름 · 성별</dt><dd>'+esc(m.Name)+' · '+(m.Gender?'여':'남')+'</dd><dt>생일 · 나이</dt><dd>'+p.year+'. '+p.month+'. '+p.day+' · '+this.model.age(i)+'세</dd><dt>혈액형 · 성격</dt><dd>'+esc(m.Blood)+' · '+esc(SK.MemberSetup.Personalities[m.Personality])+'</dd><dt>능력 순위</dt><dd>'+STATS.map((_,s)=>s).sort((a,b)=>m.AbilityRank[a]-m.AbilityRank[b]).map(s=>STATS[s]).join(' → ')+'</dd><dt>직업</dt><dd>'+esc(this.model.jobName(m.Job))+'</dd></dl></div>';
    }
    content() {
      const m=this.model.member,i=this.model.memberIndex;
      switch(this.page){
        case 'start':return this.dateHtml(false)+this.actions(false,true,'다음');
        case 'surname':return '<form id="own-text-form"><label for="own-surname">가족의 성</label><input '+this.attrs('own-surname',8,this.model.setup.Surname)+' placeholder="예: 김, 이, 박, 최 등">'+this.actions(true,true,'다음')+'</form>';
        case 'composition':return this.compositionHtml()+this.actions(true,true,'OK');
        case 'choose':return this.membersHtml()+this.actions(true,false);
        case 'name':return '<form id="own-text-form"><label for="own-name">'+esc(this.role())+'의 이름</label><input '+this.attrs('own-name',6,m.Name)+' placeholder="이름을 입력해 주세요">'+this.actions(true,true)+'</form>';
        case 'birth':return this.dateHtml(true)+this.actions(true,true,'결정',this.model.birthValidation().length>0);
        case 'blood':return '<div class="own-choice-row">'+SK.MemberSetup.Bloods.map(b=>'<button type="button" data-blood="'+b+'" aria-pressed="'+(m.Blood===b)+'">'+b+'</button>').join('')+'</div>'+this.actions(true,true);
        case 'personality':return '<div class="own-choice-row">'+SK.MemberSetup.Personalities.map((p,j)=>'<button type="button" data-personality="'+j+'" aria-pressed="'+(m.Personality===j)+'">'+p+'</button>').join('')+'</div>'+this.actions(true,true);
        case 'rank':return '<p class="own-rank-heading">'+(m.AbilityRank.filter(v=>v>0).length+1)+'번째로 높은 능력</p><div class="own-choice-row">'+STATS.map((s,j)=>'<button type="button" data-stat="'+j+'" '+(m.AbilityRank[j]?'disabled':'')+'>'+s+(m.AbilityRank[j]?' '+m.AbilityRank[j]+'위':'')+'</button>').join('')+'</div><p class="own-help">먼저 고른 능력부터 1위 · 남은 능력은 4위</p><button type="button" id="own-rank-reset" class="btn secondary small">다시 고르기</button>'+this.actions(true,false);
        case 'job':{const jobs=this.model.jobOptions(i),pages=Math.max(1,Math.ceil(jobs.ids.length/8));this.jobPage=Math.min(this.jobPage,pages-1);return '<div class="own-job-list">'+jobs.ids.slice(this.jobPage*8,this.jobPage*8+8).map(id=>'<button type="button" data-job="'+id+'" aria-pressed="'+(m.Job===id)+'">'+esc(this.model.jobName(id))+'</button>').join('')+'</div><div class="own-job-footer"><div class="own-page-controls"><button type="button" id="own-prev-page">◀</button><span>'+(this.jobPage+1)+' / '+pages+'쪽</span><button type="button" id="own-next-page">▶</button></div>'+this.actions(true,true)+'</div>';}
        case 'parts':return this.partsHtml();
        case 'summary':return this.summaryHtml()+'<div class="own-actions"><button type="button" id="own-edit" class="btn secondary small">정보 수정</button><button type="button" id="own-edit-look" class="btn secondary small">외형 수정</button><button type="button" id="own-confirm" class="btn orange small">예</button></div>';
      }
      return '';
    }
    render() {
      const app=this.app,view=this.view(),title=view?'내가 아는 가족':TITLES[this.page]||'내가 아는 가족';
      app.el.innerHTML='<section class="intro-screen own-setup-screen"><header class="intro-header"><span>내가 아는 가족'+(!view&&this.model.memberCount?' · '+this.model.memberCount+'명':'')+'</span><button id="intro-cancel" class="intro-cancel">타이틀로</button></header><section class="scene-shell intro-scene own-scene '+(view?'own-dialogue-scene':'')+'"><canvas id="intro-canvas" class="house-canvas" width="240" height="160" aria-label="원작 가족 만들기 배경"></canvas><h2 class="own-scene-title">'+esc(title)+'</h2>'+(view?app.dialogueHtml(view,true):'')+(!view?'<section class="own-input-panel" data-own-step="'+this.page+'"><div class="own-input-content">'+this.content()+'<p id="own-error" class="own-error" role="alert" hidden></p></div></section>':'')+'</section></section>';
      this.button('intro-cancel',()=>app.cancelIntro());
      if(view){this.button('intro-next',()=>this.advance());app.el.querySelectorAll('[data-intro-choice]').forEach(b=>b.onclick=()=>app.act(()=>this.choose(Number(b.dataset.introChoice))));}
      else this.bindControls();
      this.draw(performance.now());
      this.ready.then(()=>{if(app.ownWizard===this)this.draw(performance.now());});
      app.updateSceneDialog();app.syncMusic();app.syncDialogueVoice();
      this.paintPreviews();
    }
    bindControls() {
      const i=this.model.memberIndex;
      this.button('own-back',()=>this.back());
      const form=document.querySelector('#own-text-form');
      if(form){
        this.composing=false;
        const input=form.querySelector('input');
        input.addEventListener('compositionstart',()=>{this.composing=true;});
        input.addEventListener('compositionend',()=>{this.composing=false;});
        input.oninput=()=>{document.querySelector('#own-error').hidden=true;};
        form.onsubmit=e=>{e.preventDefault();if(!this.composing)this.app.act(()=>this.next());};
      }else this.button('own-next',()=>this.next());
      // Only commit native input on next/submit. IME composition is never redrawn.
      for(const [attribute,fn] of [
        ['adult',b=>{this.model.toggleAdult(+b.dataset.adult);this.render();}],
        ['child',b=>{this.model.cycleChild(+b.dataset.child);this.render();}],
        ['date',b=>{
          if(this.page==='birth'){
            // A combined character keeps its chosen part IDs when age changes;
            // the original compositor picks each part's age variant at draw time.
            this.model.shiftBirth(i,b.dataset.date,+b.dataset.delta);
          }else this.model.shiftStart(b.dataset.date,+b.dataset.delta);
          for(const n of [...this.done])if(this.model.birthValidation(n).length)this.done.delete(n);
          this.render();
        }],
        ['member',b=>this.beginMember(+b.dataset.member)],
        ['blood',b=>{this.model.setBlood(i,b.dataset.blood);this.render();}],
        ['personality',b=>{this.model.setPersonality(i,+b.dataset.personality);this.render();}],
        ['stat',b=>{const ranks=this.model.pickRank(i,+b.dataset.stat),count=ranks.filter(v=>v>0).length;if(count===4)this.say([45],()=>{this.jobPage=0;this.open('job');});else this.say([count===1?43:44],()=>this.open('rank'));}],
        ['job',b=>{this.model.member.Job=+b.dataset.job;this.render();}],
      ])document.querySelectorAll('[data-'+attribute+']').forEach(b=>b.onclick=()=>this.app.act(()=>fn(b)));
      this.button('own-rank-reset',()=>{this.model.resetRanks(i);this.say([42],()=>this.open('rank'));});
      this.button('own-prev-page',()=>this.changePage(-1));this.button('own-next-page',()=>this.changePage(1));
      document.querySelectorAll('[data-part-shift]').forEach(b=>b.onclick=()=>this.app.act(()=>{this.model.shiftPart(i,b.dataset.partShift,+b.dataset.delta);this.updateParts();}));
      document.querySelectorAll('[data-part-select]').forEach(e=>e.onchange=()=>this.app.act(()=>{this.model.setPart(i,e.dataset.partSelect,+e.value);this.updateParts();}));
      this.button('own-part-turn',()=>{this.partPose=this.partPose===0?2:0;document.querySelector('#own-part-turn').textContent=this.partPose===0?'앞모습':'뒷모습';this.paintPreviews();});
      this.button('own-part-extra',()=>{this.partExtra=!this.partExtra;this.render();});
      this.button('own-edit-look',()=>{this.done.delete(i);this.startParts();});
      this.button('own-edit',()=>{this.done.delete(i);this.say([37,38],()=>this.open('name'));});
      this.button('own-confirm',()=>{const errors=this.model.validateMember(i);if(errors.length)return this.error(errors[0]);this.done.add(i);this.say([54],()=>this.say([34],()=>this.open('choose')));});
      this.button('own-all-ok',()=>this.say([55],null,['모두 OK!','돌아가기'],choice=>{if(choice===0){const errors=this.model.validate();if(errors.length){this.open('choose');this.error(errors[0]);return;}this.app.finishOwnFamily(this.model.toSetup());}else this.open('choose');}));
    }
    next() {
      const i=this.model.memberIndex,m=this.model.member;
      switch(this.page){
        case 'start':this.say([27,28],()=>this.open('surname'));break;
        case 'surname':this.model.setSurname(document.querySelector('#own-surname').value);if(!this.model.setup.Surname)return this.error('가족 성을 입력해 줘');this.say([29,30],()=>this.open('composition'));break;
        case 'composition':{const errors=this.model.applyComposition();if(errors.length)return this.error(errors[0]);this.say([31],null,['예','아니오'],choice=>{if(choice===0){this.done.clear();this.say([32,33],()=>this.open('choose'));}else this.open('composition');});break;}
        case 'name':this.model.setName(i,document.querySelector('#own-name').value);if(!m.Name)return this.error('이름을 입력해 줘');this.say([39],()=>this.open('birth'));break;
        case 'birth':{const errors=this.model.birthValidation();if(errors.length)return this.error(errors[0]);this.model.confirmBirth(i);this.say([40],()=>this.open('blood'));break;}
        case 'blood':this.say([41],()=>this.open('personality'));break;
        case 'personality':this.model.resetRanks(i);this.say([42],()=>this.open('rank'));break;
        case 'job':this.model.ensureLook(i);if(SK.FamilySetup.AsksCharacter(m,this.model.setup.StartDay))this.say([46],()=>this.startParts());else this.say([47],()=>this.memberSummary());break;
        case 'parts':this.memberSummary();break;
      }
    }
    startParts() {this.model.ensureLook(this.model.memberIndex);this.partPose=2;this.partExtra=false;this.open('parts');}
    updateParts() {
      // Keep native selections/focus/details/scroll in place while changing only
      // the selected part and the original composed preview.
      document.querySelectorAll('[data-part-select]').forEach(e=>{const d=this.model.partOptions(this.model.memberIndex,e.dataset.partSelect);e.value=String(d.selectedOptionValue??d.selected);});
      this.paintPreviews();
    }
    beginMember(i) {this.done.delete(i);this.model.memberIndex=i;this.model.lookPage=0;this.say([35,36],()=>this.open('name'));}
    memberSummary() {this.say([53],()=>this.open('summary'));}
    back() {
      const previous={surname:'start',composition:'surname',choose:'composition',name:'choose',birth:'name',blood:'birth',personality:'blood',rank:'personality',job:'rank',parts:'job'}[this.page];
      if(this.page==='name')this.model.setName(this.model.memberIndex,document.querySelector('#own-name').value);
      if(this.page==='surname')this.model.setSurname(document.querySelector('#own-surname').value);
      if(previous==='rank')this.model.resetRanks(this.model.memberIndex);
      if(previous)this.open(previous);
    }
    changePage(delta) {
      if(this.page==='gallery'){const g=this.model.gallery();this.model.lookPage=(g.page+delta+g.pages)%g.pages;}
      else{const n=Math.max(1,Math.ceil(this.model.jobOptions().ids.length/8));this.jobPage=(this.jobPage+delta+n)%n;}
      this.render();
    }
    paintPreviews() {
      const art=this.app.art,i=this.model.memberIndex;
      const paint=(canvas,look,ages)=>{if(!look)return;const im=art.look(look,ages,2,0);if(im){const ctx=canvas.getContext('2d');ctx.imageSmoothingEnabled=false;ctx.clearRect(0,0,32,canvas.height);if(canvas.height===48)ctx.drawImage(im,0,16,32,48,0,0,32,48);else ctx.drawImage(im,0,0);}};
      document.querySelectorAll('[data-member-look]').forEach(c=>{const n=+c.dataset.memberLook;paint(c,this.model.setup.Members[n].Look,SK.WebAgeSlots.forAge(this.model.age(n)));});
      const main=document.querySelector('#own-look-preview');if(main)paint(main,this.model.ensureLook(i),this.model.lookOptions(i).ages);
      const combo=document.querySelector('#own-part-preview');
      if(combo){const im=art.look(this.model.ensureLook(i),this.model.lookOptions(i).ages,this.partPose??2,0);if(im){const ctx=combo.getContext('2d');ctx.imageSmoothingEnabled=false;ctx.clearRect(0,0,32,48);ctx.drawImage(im,0,16,32,48,0,0,32,48);}}

    }
    slice(ctx,image,box,x,y,w,h,b=7) {
      if(!image?.complete||!image.naturalWidth)return;
      const [sx,sy,sw,sh]=box,xx=[x,x+b,x+w-b],yy=[y,y+b,y+h-b],ssx=[sx,sx+b,sx+sw-b],ssy=[sy,sy+b,sy+sh-b],ws=[b,w-2*b,b],hs=[b,h-2*b,b],sws=[b,sw-2*b,b],shs=[b,sh-2*b,b];
      for(let j=0;j<3;j++)for(let k=0;k<3;k++){if(j===1&&k===1)continue;ctx.drawImage(image,ssx[k],ssy[j],sws[k],shs[j],xx[k],yy[j],ws[k],hs[j]);}
    }
    draw(t) {
      const c=document.querySelector('#intro-canvas');if(!c||this.app.ownWizard!==this)return;
      const ctx=c.getContext('2d');ctx.imageSmoothingEnabled=false;
      const color=['parts'].includes(this.page)?'yellow':['name','birth','blood','personality','rank','job','summary'].includes(this.page)?'pink':'green';
      ctx.fillStyle=color==='pink'?'#ffd3e1':color==='yellow'?'#fff5a0':'#d8f29b';ctx.fillRect(0,0,240,c.height);
      const bg=this.app.art.image('own_setup_'+color);if(bg?.complete&&bg.naturalWidth)for(let y=0;y<c.height;y+=160){const height=Math.min(160,c.height-y);ctx.drawImage(bg,0,0,240,height,0,y,240,height);}
      const title=this.app.art.image('own_setup_title');
      if(title?.complete&&title.naturalWidth){
        // Retain the original inner/outer rim, then erase only its captured
        // label. A uniform nine-slice discarded the thin inner side bezel.
        ctx.drawImage(title,3,3,234,27,3,3,234,27);
        ctx.fillStyle='#deceff';ctx.fillRect(15,10,210,13);
      }
      if(this.dialog){
        // The dialogue grows with its actual text/choices. Keep the entire
        // original sprite above it instead of anchoring to the old short box.
        const bubble=c.closest('.scene-shell').querySelector('.dialogue-frame'),scale=c.clientWidth/240,
          top=bubble?(bubble.getBoundingClientRect().top-c.getBoundingClientRect().top)/scale:c.height-62,
          y=Math.max(30,Math.min(64,Math.floor(top)-34));
        this.app.draw(ctx,this.app.art.cupid(Math.floor(t/170)),8,y,32,32);
        this.app.dialogueAnchor={speaker:'큐피트',x:24,y:y+16,width:c.width,height:c.height};
        c.skCupidAnchor=this.app.dialogueAnchor;
      }
      else{
        this.app.dialogueAnchor=null;
        c.skCupidAnchor=null;
        // Empty original orange frame: only its perimeter is sampled, never
        // the screenshot's fixed member name, numbers, or captured labels.
        ctx.fillStyle='#fff';ctx.fillRect(7,43,226,c.height-55);this.slice(ctx,this.app.art.image('own_setup_panel'),[0,32,240,96],4,38,232,c.height-46,7);
      }
      const scene=c.closest('.scene-shell');scene.style.setProperty('--pixel-scale',c.clientWidth/240);
    }
  }
  SK.OwnFamilyWizard=OwnFamilyWizard;
})(globalThis);

</script>
<script>
/* Original recommended-family review: a staged introduction, never a live
 * house or save. Dialogue IDs/order and role tokens come from supplied capture. */
(function (root) {
  "use strict";
  const SK = root.SK = root.SK || {};
  const esc = (value) => String(value ?? "").replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]);
  const roleNames = ["할아버지", "할머니", "아버지", "어머니", "아들", "딸"];
  const titles = { date: "시작년월일을 알려줘!", summary: "위대한 신님이 아는 가족 정보!", list: "가족 모두의 상세 정보!" };
  class RecommendedFamilyReview {
    constructor(app) {
      this.app = app;
      this.text = app.introScene.text;
      this.stage = "intro";
      this.dialog = null;
      this.serial = 0;
      this.generation = 0;
      this.seed = null;
      this.startDay = SK.GameDate.Make(2005, 1, 1);
      this.setup = null;
      this.previewState = null;
      this.previewMembers = [];
      this.memberIds = [];
      this.memberIndex = 0;
      this.rejectedSurname = "";
      this.song = 3;
      this.angerStartedAt = null;
      this.ready = Promise.all(["green", "pink", "title", "panel"].map((name) => app.art.image("own_setup_" + name).decode()));
    }
    active() { return this.app.recommendedReview === this && this.app.introFlow?.read().mode === "family"; }
    nextReady(button) {
      const app = this.app, view = this.view();
      return this.active() && !app.introLoading && !app.ownWizard && !app.modalOpen &&
        !document.hidden && !app.offlineBackground && !app.offlineReturnBlocked && !app.arrowFx?.active &&
        view?.mode === "dialogue" && view.canAdvance === true && !view.choices.length &&
        button === document.getElementById('intro-next') && button?.isConnected && app.el.contains(button) &&
        !button.disabled && !button.closest('[hidden],[inert],[aria-hidden="true"]') &&
        getComputedStyle(button).visibility === "visible" && !!button.getClientRects().length;
    }
    updateAdvanceButton() {
      const button = document.getElementById('event-advance');
      if (button && this.app.el.contains(button))
        button.disabled = !this.nextReady(document.getElementById('intro-next'));
    }
    role(index = this.memberIndex) {
      const m = this.setup?.Members[index];
      return m ? roleNames[m.Role === 4 ? 4 + m.Gender : m.Role] : "";
    }
    name(code) {
      return code === 0x27 ? (this.dialog?.ids.includes(579) ? this.rejectedSurname : this.setup?.Surname) || "○○"
        : code === 0x2c ? this.role()
        : code === 0x26 ? this.app.introFlow?.playerName || "○○" : null;
    }
    pages(id) {
      const bytes = this.text.Heaven.Msgs.get(id);
      if (!bytes) throw new Error("원작 가족 소개 대사가 없습니다: " + id);
      const pages = this.text.Decode(bytes, (code) => this.name(code), null, null);
      return id === 264 ? pages.map((page) => page.replace("십자 버튼으로 숫자를 고르고\nＡ버튼으로 결정해 줘！", "＋·−로 숫자를 고르고\n결정을 눌러 줘！")) : pages;
    }
    say(ids, next, options = {}) {
      this.song = options.song || 3;
      this.dialog = { ids: ids.slice(), index: 0, page: 0, pages: [], next,
        choices: options.choices || null, pick: options.pick || null, anger: Boolean(options.anger) };
      this.dialog.pages = this.pages(ids[0]);
      if (options.anger) this.angerStartedAt = performance.now();
      this.serial++;
      this.render();
    }
    view() {
      const d = this.dialog;
      if (!d) return null;
      const last = d.index === d.ids.length - 1 && d.page === d.pages.length - 1,
        id = d.ids[d.index], god = id === 579 || id === 571 || id === 578;
      return { mode: "dialogue", messageId: id, text: d.pages[d.page], page: d.page, pages: d.pages.length,
        speaker: god ? "높으신 신" : "큐피트", speakerKey: god ? "god" : "cupid", song: this.song,
        choices: last && d.choices ? d.choices.map((text, index) => ({ text, index })) : [],
        canAdvance: !(last && d.choices), anger: d.anger && id === 579, angerStartedAt: this.angerStartedAt };
    }
    read() {
      return { ...(this.view() || { mode: "review", messageId: -1, text: "", song: this.song }),
        stage: this.stage, generation: this.generation, seed: this.seed, startDay: this.startDay,
        familyName: this.setup?.Surname || "", rejectedSurname: this.rejectedSurname, memberIndex: this.memberIndex };
    }
    start() { this.say([263, 264], () => this.open("date")); }
    open(stage) { this.stage = stage; this.dialog = null; this.song = 3; this.serial++; this.render(); }
    advance() {
      const d = this.dialog;
      if (!this.active() || !d || (d.index === d.ids.length - 1 && d.page === d.pages.length - 1 && d.choices)) return;
      if (++d.page >= d.pages.length) {
        d.page = 0;
        if (++d.index < d.ids.length) {
          if (d.ids[d.index] === 264) this.stage = "date";
          d.pages = this.pages(d.ids[d.index]);
        }
        else { this.dialog = null; d.next?.(); return; }
      }
      this.serial++; this.render();
    }
    choose(index) {
      const d = this.dialog;
      if (!this.active() || !d?.choices || d.index !== d.ids.length - 1 || d.page !== d.pages.length - 1) return;
      if (!Number.isInteger(index) || index < 0 || index >= d.choices.length) return;
      this.dialog = null; d.pick?.(index);
    }
    nextSeed() { return (Date.now() ^ Math.floor(Math.random() * 0xffffffff)) >>> 0; }
    generate() {
      let seed = this.nextSeed();
      if (seed === this.seed) seed = (Math.imul(seed, 0x6d) + 0x3fd) >>> 0;
      const date = SK.OwnFamilySetup.DateParts(this.startDay), setup = SK.RandomFamilySetup.create({
        seed, ...date, parts: this.app.art.parts,
      }), game = SK.createGame({ seed, setup, playerName: this.app.introFlow.playerName || "신님" });
      // Atomic candidate replacement: previousGame and its house/RNG stay intact.
      const state = game.state(), matched = setup.Members.map((member) => {
        const person = state.members.find((p) => p.name === member.Name);
        if (!person) throw new Error("소개할 가족의 정보를 확인하지 못했어요.");
        return person;
      });
      // NewCustom can reorder native slots. Unique setup names bind once to
      // actual gene IDs; every portrait/detail thereafter uses that identity.
      this.seed = seed; this.setup = setup; this.previewState = state;
      this.previewMembers = matched; this.memberIds = matched.map((p) => p.id);
      this.app.game = game; this.app.state = this.previewState;
      this.app.introRecommendedStaged = true;
      this.generation++; this.memberIndex = 0;
    }
    confirmDate() {
      if (this.dialog || this.stage !== "date") return;
      this.say([265], () => { this.generate(); this.summary(); });
    }
    summary() { this.stage = "summary"; this.say([266], () => this.open("summary")); }
    list(first = true) { this.stage = "list"; this.say([first ? 267 : 268], () => this.open("list")); }
    selectMember(index) {
      if (this.dialog || this.stage !== "list" || !this.setup.Members[index]) return;
      this.memberIndex = index;
      this.say([269], () => { this.stage = "detail"; this.say([271], () => this.open("detail")); });
    }
    reject() {
      if (this.dialog || this.stage !== "list") return;
      this.rejectedSurname = this.setup.Surname;
      this.say([563], () => {
        this.stage = "heaven";
        this.say([579], null, { song: 1, anger: true, choices: ["네, 알겠습니다!", "저기… 잠깐…"], pick: (index) => {
          if (index === 1) {
            // Original capture does not establish this branch. Preserve the
            // already supported own-family question instead of inventing it.
            this.app.recommendedReview = null;
            this.app.introFlow._play([573, 574], 1, null, ["네", "아니오"], (choice) => {
              if (choice === 0) this.app.introFlow._play([576, 577], 1, () => this.app.introFlow._create(true));
              else {
                this.app.introFlow.mode = "family";
                this.app.introFlow.song = 3;
                this.app.recommendedReview = this;
                this.repeat([578, 572]);
              }
            });
            this.app.renderIntro();
          } else this.repeat([571, 572]);
        } });
      });
    }
    repeat(ids) {
      this.say(ids, () => {
        this.generate(); this.stage = "intro";
        this.say([263], () => this.summary());
      }, { song: 1 });
    }
    accept() {
      if (this.dialog || this.stage !== "list") return;
      this.app.recommendedReview = null;
      this.app.introFlow.familyReady({ ...this.previewState, recommendedReviewed: true });
      this.app.renderIntro();
    }
    button(id, fn) { const b = document.getElementById(id); if (b) b.onclick = () => this.app.act(() => { if (this.active()) fn(); }); }
    dateHtml() {
      const p = SK.OwnFamilySetup.DateParts(this.startDay);
      return '<div class="own-date-grid">' + [["year", "연", p.year], ["month", "월", p.month], ["day", "일", p.day]].map(([field, label, value]) =>
        '<section><span>' + label + '</span><strong>' + value + '</strong><div><button type="button" data-rec-date="' + field + '" data-delta="-1" aria-label="' + label + ' 1 감소">−</button><button type="button" data-rec-date="' + field + '" data-delta="1" aria-label="' + label + ' 1 증가">＋</button></div>' +
        (field === "year" ? '<div><button type="button" data-rec-date="year10" data-delta="-1">−10</button><button type="button" data-rec-date="year10" data-delta="1">＋10</button></div>' : '') + '</section>').join('') +
        '</div><div class="own-actions"><button type="button" id="recommended-date-ok" class="btn orange small">결정</button></div>';
    }
    summaryHtml() {
      const p = SK.OwnFamilySetup.DateParts(this.startDay);
      return '<p class="recommended-start-date">' + p.year + '년 ' + p.month + '월 ' + p.day + '일부터</p><dl class="recommended-family-summary"><dt>지켜볼 집</dt><dd>' + esc(this.setup.Surname) + '가</dd><dt>가족 구성</dt><dd class="recommended-roles">' + this.setup.Members.map((m, i) => '<span>' + esc(this.role(i)) + '</span>').join('') +
        '</dd></dl><div class="own-actions"><button type="button" id="recommended-summary-ok" class="btn orange small">OK</button></div>';
    }
    listHtml() {
      const slots = Math.ceil(this.setup.Members.length / 3) * 3;
      return '<div class="recommended-portraits" aria-label="가족 구성원">' + this.setup.Members.map((m, i) => '<canvas width="32" height="64" data-rec-look="' + i + '" aria-label="' + esc(m.Name) + '"></canvas>').join('') +
        '</div><section class="recommended-list-panel"><div class="recommended-names" style="--recommended-name-rows:' + Math.ceil(slots / 3) + '">' + Array.from({ length: slots }, (_, i) => {
          const m = this.setup.Members[i];
          return m ? '<button type="button" data-rec-member="' + i + '" aria-label="' + esc(m.Name) + ' 상세 정보">' + esc(m.Name) + '</button>'
            : '<span class="recommended-name-empty" aria-hidden="true"></span>';
        }).join('') +
        '</div><div class="recommended-list-actions"><button type="button" id="recommended-dislike">싫을지도…</button><button type="button" id="recommended-all-ok" class="recommended-default">모두OK</button></div></section>';
    }
    detailHtml() {
      const m = this.setup.Members[this.memberIndex], p = SK.OwnFamilySetup.DateParts(m.BirthDay),
        blood = m.Blood, personality = m.Personality;
      return '<canvas class="recommended-detail-portrait" width="32" height="40" data-rec-look="' + this.memberIndex + '"></canvas><button type="button" id="recommended-detail-ok" class="btn orange small">OK</button>' +
        '<section class="recommended-detail-data"><div class="recommended-detail-row recommended-detail-identity" data-rec-field="identity"><p class="recommended-detail-name"><span class="recommended-field"><span class="recommended-field-label">이름 </span><strong>' + esc(m.Name) + '</strong></span> <span class="recommended-field"><span class="recommended-field-label">성별 </span><span class="recommended-field-value">' + (m.Gender ? '여' : '남') + '</span></span></p></div>' +
        '<div class="recommended-detail-row recommended-detail-birthday" data-rec-field="birthday"><span class="recommended-field"><span class="recommended-field-label">생일 </span><span class="recommended-field-value">' + p.year + '년 ' + p.month + '월 ' + p.day + '일</span></span> <span class="recommended-field"><span class="recommended-field-label">나이 </span><span class="recommended-field-value">' + SK.GameDate.AgeYears(m.BirthDay, this.startDay) + '세</span></span></div>' +
        '<div class="recommended-detail-row recommended-detail-traits" data-rec-field="traits"><span class="recommended-field"><span class="recommended-field-label">혈액형 </span><span class="recommended-field-value">' + esc(blood) + '형</span></span> <span class="recommended-field"><span class="recommended-field-label">성격 </span><span class="recommended-field-value">' + esc(SK.MemberSetup.Personalities[personality] || SK.MemberSetup.Personalities[m.Personality]) + '</span></span></div>' +
        '<div class="recommended-detail-row recommended-detail-abilities" data-rec-field="abilities"><div class="recommended-ranks">' + ['지력', '체력', '매력', '운'].map((label, i) => '<span class="recommended-field"><span class="recommended-field-label">' + label + ' </span><b class="rank-' + i + '">' + m.AbilityRank[i] + '위</b></span>').join('') + '</div></div>' +
        '<div class="recommended-detail-row recommended-detail-job" data-rec-field="job"><span class="recommended-field-label">직업 </span><span class="recommended-field-value">' + esc(this.previewMembers[this.memberIndex]?.jobName || SK.OrigJobs.Name(m.Job)) + '</span></div></section>';
    }
    render() {
      if (!this.active()) return;
      const view = this.view(), heaven = this.stage === "heaven", title = this.stage === "detail" ? this.role() + '캐릭터 정보' : titles[this.stage] || '신님이 아는 가족';
      let content = this.stage === "date" ? '<section class="own-input-panel recommended-date-panel"><div class="own-input-content">' + this.dateHtml() + '</div></section>'
        : this.stage === "summary" ? '<section class="recommended-summary-panel"><div class="own-input-content">' + this.summaryHtml() + '</div></section>'
