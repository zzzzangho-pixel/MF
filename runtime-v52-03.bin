      car: { id: carId === 255 ? -1 : carId, name: carId === 255 ? query.Text.UiText(387, '없음') : query.Text.UiText(298 + carId, '—') },
      mood: moodInfo(rawMood), diagnosis: rows.map(({ ids, ...row }) => ({ ...row, word: query.DiagnosisWord(row.value), advice: ids.map(id => messageIn(query, id)) })),
