    if (!saved || saved.version !== 1) return meta;
    const ids = new Set(), names = new Set();
    for (const item of Array.isArray(saved.entries) ? saved.entries : []) {
      if (!item || !entryId(item.id) || ids.has(item.id) || validateName(item.name) ||
