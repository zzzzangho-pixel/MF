      if (out.width !== width) out.width = width; if (out.height !== height) out.height = height;
      const c = out.getContext('2d'); c.setTransform(1, 0, 0, 1, 0, 0);
      c.imageSmoothingEnabled = false; c.clearRect(0, 0, out.width, out.height); c.drawImage(s.image, 0, 0);
      const cupid = this.images[cell[2]];
      if (cupid?.complete && cupid.naturalWidth) {
        c.save(); c.scale(renderScale, renderScale);
        c.drawImage(cupid, Math.round(x), Math.round(y), 32 * s.zoom, 32 * s.zoom); c.restore();
      }
      const level = NATIVE_ITEM.brightness[frame];
      if (level) {
        const pixels = c.getImageData(0, 0, out.width, out.height), data = pixels.data;
        // Match native16step 8bit brighten:channel+floor((255-channel)*n/16).
        for (let i = 0; i < data.length; i += 4) for (let k = 0; k < 3; k++) data[i + k] += ((255 - data[i + k]) * level) >> 4;
        c.putImageData(pixels, 0, 0);
      }
      ctx.imageSmoothingEnabled = false;
      ctx.drawImage(out, 0, 0, s.width, s.height); return true;
    }
    paint(active) {
      const page = active.pages[active.page], copy = root.document.getElementById('item-feedback-copy'),
        counter = root.document.getElementById('item-feedback-counter'), next = root.document.getElementById('item-feedback-next');
      copy.innerHTML = page.runs.map(run => '<span style="color:' + run.color + '">' + escape(run.text).replaceAll('\n', '<br>') + '</span>').join('');
      counter.textContent = (active.page + 1) + '/' + active.pages.length + (page.adapted ? ' · 웹판 저장 안내' : '');
      next.textContent = active.page + 1 >= active.pages.length ? '완료' : '다음';
    }
  }
