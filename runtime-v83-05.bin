        canvas = $("house-canvas");
      this.cameraZoom = next;
      if (canvas) {
        // Keep the current viewport center for a manually panned camera.
        const H = this.art.house.height || 160;
        this.scrollX = this.houseCameraX(this.scrollX + canvas.width / (2 * old) - canvas.width / (2 * next), canvas.width, next);
        this.camY = clamp(this.camY + canvas.height / (2 * old) - canvas.height / (2 * next),
