          '<section class="error-screen"><p class="overline">실행 오류</p><h1>게임을 열지 못했어요.</h1><p>아래 오류가 발생했습니다. 새로고침 후에도 계속되면 이 내용을 함께 알려 주세요.</p><pre>' +
          escape(text) +
          "</pre></section>";
      } else {
        let b = $("runtime-error");
        if (!b) {
          b = document.createElement("div");
          b.id = "runtime-error";
          b.className = "error-banner";
          this.el.prepend(b);
        }
        b.textContent = "진행을 멈췄어요: " + text;
        this.toast(
          "오류가 발생해 진행을 멈췄습니다. 저장 내보내기는 사용할 수 있어요.",
        );
      }
    }
    button(id, fn) {
      const b = $(id);
      if (b) b.onclick = () => this.act(fn);
    }
    showTitle() {
      this.closeWideDrawer(false);
      this.skillHelpClose?.(false);
      this.resetDialogueAuto();
      this.ownWizard = null;
      this.arrowFx?.cancel();
      this.voice.stop();
      this.voiceLineKey = null;
      this.fast = false;
      this.playing = false;
      this.resetCupidTips();
      this.closeModal();
      this.titleStart = performance.now();
      this.resetTitleCrowd();
      const saved = slotInfo("auto");
      this.el.innerHTML =
        '<section class="title-screen"><div class="title-top"><p class="overline">MILLENNIAL FAMILY</p><h1>천년가족</h1><p class="subtitle">작은 하루가 모여, 천 년의 이야기가 됩니다.<br>우리 가족을 지켜보는 신님이 되어 주세요.</p></div><div class="title-art-wrap"><canvas id="title-canvas" class="title-art" width="240" height="160" aria-label="원작 첫 타이틀 화면의 집과 하늘"></canvas></div><div class="title-actions"><button id="continue" class="btn" ' +
        (!saved || saved.corrupt ? "disabled" : "") +
        ">이어하기" +
        (!saved ? " · 저장 없음" : "") +
        '</button><button id="new-game" class="btn orange">새 가족의 이야기</button><div class="button-row"><button id="title-slots" class="btn secondary">저장 / 불러오기</button></div></div></section>';
      this.button("continue", () => this.loadSlot("auto"));
      this.button("new-game", () => this.newGameDialog());
      this.button("title-slots", () => this.saveDialog());
      const soundButton = document.createElement("button");
      soundButton.id = "title-sound";
      soundButton.className = "btn secondary";
      soundButton.textContent = "♪ 원작 소리 · 음량 설정";
      this.el.querySelector(".title-actions").append(soundButton);
      this.button("title-sound", () => this.soundDialog());
      this.syncMusic();
    }
    newGameDialog() {
      this.startIntro();
    }
    async startIntro() {
      if (this.introLoading || this.introFlow) return;
      this.voice.stop();
      this.voiceLineKey = null;
      this.introLoading = true;
      this.introPreviousGame = this.game;
      this.introRecommendedStaged = false;
      this.playing = false;
      this.closeModal();
      this.running = true;
      this.resetDialogueAuto();
      const token = ++this.introToken;
      this.el.innerHTML = '<section class="intro-screen"><p class="overline">새 가족의 이야기</p><p>천계로 가는 중…</p><button id="intro-cancel" class="btn secondary">타이틀로</button></section>';
      this.button("intro-cancel", () => this.cancelIntro());
      try {
        if (!this.introScene) this.introScene = await SK.IntroScene.load({ art: this.art });
        await this.bubbles.ready;
        if (token !== this.introToken) return;
        this.introLoading = false;
        this.introSceneTime = 0;
        this.introScene.reset(0);
        this.introFlow = new SK.IntroFlow({ text: this.introScene.text,
          savedPlayerName: "",
          onAction: (action) => this.handleIntroAction(action) });
        this.introFlow.start();
        this.renderIntro();
      } catch (error) {
        this.introLoading = false;
        this.showError(error);
      }
    }
    handleIntroAction(action) {
      if (action.type === "create-family") {
        if (action.own) {
          this.recommendedReview = null;
          this.introRecommendedStaged = false;
          this.customDialog();
        } else {
          this.closeModal();
          this.recommendedReview = new SK.RecommendedFamilyReview(this);
          this.recommendedReview.start();
        }
      } else if (action.type === "player-name") {
        this.game.setPlayerName(action.name);
        if (action.persist) storeSet("player-name", action.name);
      } else if (action.type === "finish") {
        if (this.introRecommendedStaged) {
          this.selectedId = -1;
          this.dayFraction = 0;
          this.actors.clear();
          this.fast = false;
          this.actorTime = 0;
        }
        this.recommendedReview = null;
        this.introRecommendedStaged = false;
        this.introFlow = null;
        this.introPreviousGame = null;
        this.modalOpen = false;
        $("modal-root").innerHTML = "";
        this.musicOverride = -1;
        this.enterGame();
        this.saveSlot("auto", true);
      }
    }
    cancelIntro() {
      this.ownWizard = null;
      this.recommendedReview = null;
      this.introRecommendedStaged = false;
      this.introToken++;
      this.introFlow?.cancel();
      this.introFlow = null;
      this.introLoading = false;
      this.game = this.introPreviousGame;
      this.state = this.game ? this.game.state() : null;
      this.introPreviousGame = null;
      this.showTitle();
    }
    advanceIntro(button = null) {
      if (!this.introFlow) return;
      if (button && !this.introNextReady(this.introFlow.read(), button)) return;
      this.resetDialogueAuto();
      this.introFlow.advance();
      if (this.introFlow?.read().mode === "dialogue") this.renderIntro();
      else if (this.introFlow?.read().mode === "name") this.renderIntro();
    }
    renderIntro() {
      if (!this.introFlow) return;
      const view = this.introFlow.read();
      if (view.mode === "family") return;
      this.resetDialogueAuto();
      this.el.innerHTML = '<section class="intro-screen"><header class="intro-header"><span>천년가족 · 도입부</span><button id="intro-cancel" class="intro-cancel">타이틀로</button></header><section class="scene-shell intro-scene"><canvas id="intro-canvas" class="house-canvas" width="240" height="160" aria-label="원작 천계의 신님과 큐피트"></canvas>' +
        this.dialogueHtml(view, true) + '</section>' +
        '<div class="day-line intro-playback" role="group" aria-label="도입부 재생"><button id="run" class="btn secondary small">' +
        (this.running ? 'Ⅱ 멈춤' : '▶ 진행') + '</button><span class="intro-playback-buttons"><button id="fast" class="fast-btn" aria-pressed="' +
        this.fast + '" aria-label="배속 ' + this.speedMultiplier() + '배">' +
        (this.fast ? '» 배속 ' + this.speedMultiplier() + '배' : '» 배속 OFF') + '</button><button id="dialog-auto" class="btn secondary small" aria-pressed="' +
        this.dialogueAuto + '" aria-label="대사 자동 넘기기 ' + (this.dialogueAuto ? '켜짐' : '꺼짐') + '">Auto</button></span></div>' +
        (view.mode === "dialogue" ? this.eventAdvanceHtml() : '') +
        (view.mode === "name" ? '<form id="intro-name-form" class="intro-name-form"><label class="form-label" for="intro-player-name">' + escape(view.title) + '</label><input id="intro-player-name" class="input" type="text" inputmode="text" maxlength="6" enterkeyhint="done" autocomplete="off" value=""><button class="btn orange" type="submit">이 이름으로 할래!</button></form>' : '') + '</section>';
      this.button("intro-cancel", () => this.cancelIntro());
      this.button("run", () => this.toggleRun());
      this.button("fast", () => this.toggleFast());
      this.button("dialog-auto", () => this.toggleDialogueAuto());
      const next = $("intro-next");
      this.button("intro-next", () => this.advanceIntro(next));
      const advance = $("event-advance");
      if (advance) advance.onclick = () => {
        this.updateIntroAdvanceButton();
        if (!advance.isConnected || advance !== $("event-advance") || advance.disabled) return;
        advance.disabled = true;
        $("intro-next").click();
      };
      document.querySelectorAll("[data-intro-choice]").forEach((button) => {
        button.onclick = () => this.act(() => {
          this.introFlow.choose(Number(button.dataset.introChoice));
          if (this.introFlow?.read().mode !== "family") this.renderIntro();
        });
      });
      if (view.mode === "name") $("intro-name-form").onsubmit = (event) => {
        event.preventDefault();
        this.act(() => {
          const name = $("intro-player-name").value.trim();
          if (!name) return;
          this.introFlow.setPlayerName(name);
          this.renderIntro();
        });
      };
      this.renderIntroScene(performance.now());
      this.updateSceneDialog();
      this.updateIntroAdvanceButton();
      this.syncMusic();
      this.syncDialogueVoice();
    }
    renderIntroScene(t) {
      if (this.recommendedReview) this.recommendedReview.draw(t);
      else if (this.ownWizard) this.ownWizard.draw(t);
      else if (this.introFlow && this.introScene) {
        this.introScene.draw($("intro-canvas"), this.introSceneTime, this.introFlow.read());
        this.dialogueAnchor = $("intro-canvas")?.skCupidAnchor || null;
      }
      const canvas = $("intro-canvas"), box = canvas?.closest(".scene-shell")?.querySelector(".dialogue-frame");
      if (box) this.paintDialogueTail(box, canvas, canvas.clientWidth / 240);
    }
    recommendedFamilyDialog() {
      this.openModal(
        "신님이 아는 가족",
        '<p>“내가 아는 가족을 지켜봐 주지 않겠느냐?”</p><label class="form-label" for="family-name">가족의 성</label><input id="family-name" class="input" type="text" inputmode="text" maxlength="8" autocomplete="off" value="" placeholder="예: 김, 이, 박, 최 등"><label class="form-label" for="player-name">신님의 이름</label><input id="player-name" class="input" maxlength="12" value="신님"><p class="form-help">가족의 성을 입력하면 이름과 가족 구성을 랜덤으로 정해 시작합니다. 예: 김, 이, 박, 최 등.</p><div class="form-actions"><button id="create-family" class="btn orange">네, 알겠습니다! · 시작</button><button id="custom-family" class="btn secondary">내가 아는 가족 만들기</button></div>',
      );
      this.button("create-family", () => this.createFamily());
      this.button("custom-family", () => this.customDialog());
      if (this.introFlow) {
        $("custom-family")?.remove();
        const input = $("player-name");
        input?.previousElementSibling?.remove();
        input?.remove();
      }
      this.musicOverride = 1;
      this.syncMusic();
    }
    createFamily(setup) {
      const familyName =
          ($("family-name") && $("family-name").value.trim()) || "",
        playerName = this.introFlow ? "신님" :
          ($("player-name") && $("player-name").value.trim()) || "신님";
      if (!setup && !familyName) {
        this.toast("가족의 성을 입력해 주세요. 예: 김, 이, 박, 최");
        $("family-name")?.focus();
        return;
      }
      const seed = (Date.now() ^ Math.floor(Math.random() * 0xffffffff)) >>> 0;
      // Random/recommended START is a new setup, not a reshuffle of an
      // existing save. The explicit own-family wizard remains untouched.
      const startSetup = setup || SK.RandomFamilySetup.create({
        seed, surname: familyName, parts: this.art.parts,
      });
      this.game = SK.createGame({
        familyName,
        playerName,
        seed,
        setup: startSetup,
      });
      // Keep the private wizard available if NewCustom throws; release it only
      // after the original rule path has returned a concrete family.
      this.ownWizard = null;
      this.selectedId = -1;
      this.dayFraction = 0;
      this.actors.clear();
      this.fast = false;
      this.fastTier = 0;
      this.actorTime = 0;
      this.closeModal();
      if (this.introFlow) {
        this.introFlow.familyReady(this.game.state());
        this.renderIntro();
        return;
      }
      this.enterGame();
      this.saveSlot("auto", true);
      this.toast(
        "이제 " + this.familyTitle(this.state.family.name) + "의 이야기가 시작됩니다.",
      );
    }
    customDialog() {
      this.closeModal();
      this.musicOverride = 3;
      this.ownWizard = new SK.OwnFamilyWizard(this);
      this.ownWizard.start();
    }
    finishOwnFamily(setup) {
      const errors = setup.Validate();
      if (errors.length) { this.ownWizard.error(errors[0]); return; }
      const wizard = this.ownWizard, previousGame = this.game;
      try { this.createFamily(setup); }
      catch (error) {
        this.ownWizard = wizard;
        this.game = previousGame;
        wizard.open("choose");
        wizard.error("가족 만들기를 완료하지 못했어요: " + error.message);
      }
    }
    enterGame() {
      this.arrowFx.cancel();
      this.playing = true;
      if (this.offlineGame !== this.game) {
        this.offlineGame = this.game;
        this.offlineAnchor = null;
        this.offlineReturnBlocked = false;
      }
      this.offlineBackground = false;
      this.offlineCheckpointAt = Date.now();
      this.resetCupidTips();
      this.chatter.reset();
      this.state = this.game.state();
      const alive = this.state.members.filter((p) => p.alive !== false);
      if (!alive.some((p) => p.id === this.selectedId))
        this.selectedId =
          this.state.family.headId !== undefined
            ? this.state.family.headId
            : (alive[0] || {}).id;
      if (this.returnToTitleAfterClosure()) return;
      // A completed absence report owns presentation before any saved live
      // event. Opening it never advances the original event or its choices.
      this.maybeOfflineHistory();
      this.renderGame();
    }
    returnToTitleAfterClosure() {
      const state = this.state, session = this.game?.session;
      // A missing head alone is not the end: finish the native death/Heaven
      // pages and any bookmark question first. SceneExit(5) is the actual
      // completed lineage boundary; do not invent an Ended bit or run a rule.
      if (!this.playing || !state?.lineageEnded || state.endMenu !== 5 ||
          state.event || state.paused || state.bookmarkAskPending || session?.HasPending)
        return false;
      this.showTitle();
      return true;
    }
    familyHeirId() {
      const memory = this.game?.session?.Game?.Mem, familyBase = SK.OrigMem?.Fam;
      if (!memory || typeof memory.R16 !== "function" || !Number.isInteger(familyBase)) return null;
      let id;
      try { id = memory.R16(familyBase + 0x66e); }
      catch (_) { return null; }
      return Number.isInteger(id) && id >= 0 && id < 65535 &&
        this.state?.members?.some((member) => member.id === id && member.alive !== false) ? id : null;
    }
    heirTag(p) {
      const id = this.familyHeirId();
      return id !== null && p?.id === id
        ? '<span class="heir-tag" data-native-heir-id="' + id + '">후계자</span>' : "";
    }
    selected() {
      return (
        this.state &&
        (this.state.members.find((x) => x.id === this.selectedId) ||
          this.state.members.find((x) => x.alive !== false))
      );
    }
    familyTitle(name) {
      // Format the surname only at presentation sites. Native family names,
      // literal surname inputs, save labels and exported data stay untouched.
      const surname = String(name == null ? "" : name).trim();
      return surname ? surname + "씨 가족" : "우리 가족";
    }
    avatar(p) {
      const im = this.art.figure(
        p,
        2,
        (this.state && this.state.family.era) || 0,
      );
      if (!im) return "";
      if (im instanceof HTMLCanvasElement) return im.toDataURL();
      return im.src;
    }
    memberPortrait(p) {
      const figure = this.art.figure(p, 2, (this.state && this.state.family.era) || 0);
      let portrait = this.avatar(p);
      if (figure && (figure instanceof HTMLCanvasElement || figure.complete)) {
        this.memberPortraitCache ||= new WeakMap();
        portrait = this.memberPortraitCache.get(figure);
        if (!portrait) {
          const width = figure.naturalWidth || figure.width, height = figure.naturalHeight || figure.height;
          if (width && height) {
            const canvas = document.createElement("canvas");
            canvas.width = width; canvas.height = height;
            const ctx = canvas.getContext("2d");
            ctx.drawImage(figure, 0, 0);
            const pixels = ctx.getImageData(0, 0, width, height).data;
            let left = width, top = height, right = -1, bottom = -1;
            for (let y = 0; y < height; y++) for (let x = 0; x < width; x++) {
              if (!pixels[(y * width + x) * 4 + 3]) continue;
              left = Math.min(left, x); right = Math.max(right, x);
              top = Math.min(top, y); bottom = Math.max(bottom, y);
            }
            if (right >= left) {
              // Center the visible sprite, not the native32×64transparent canvas.
              canvas.width = right - left + 1; canvas.height = bottom - top + 1;
              ctx.imageSmoothingEnabled = false;
              ctx.drawImage(figure, left, top, canvas.width, canvas.height, 0, 0, canvas.width, canvas.height);
              portrait = canvas.toDataURL();
              this.memberPortraitCache.set(figure, portrait);
            }
          }
        }
      }
      return portrait || this.avatar(p);
    }
    hearts(p) {
      let html = "";
      for (let i = 0; i < 3; i++) {
        const n = Number(p.hearts || 0) - i * 96,
          key = n >= 96 ? "heart_full" : n >= 48 ? "heart_half" : "heart_empty",
          im = this.art.ui(key);
        html += im
          ? '<img class="heart" src="' +
            im.src +
            '" alt="' +
            (key === "heart_full"
              ? "하트"
              : key === "heart_half"
                ? "반 하트"
                : "빈 하트") +
            '">'
          : '<span class="heart-fallback">' +
            (n >= 96 ? "♥" : "♡") +
            "</span>";
      }
      return html;
    }
    renderGame() {
      if (!this.playing) return;
      // A read-only skill popup belongs to its original family member. A
      // routine same-person repaint may replace its trigger, not its modal.
      if (this.skillHelpContext && (this.skillHelpContext.game !== this.game ||
          this.skillHelpContext.selectedId !== this.selectedId || this.state?.event))
        this.skillHelpClose?.(false);
      this.syncInterestCard();
      this.resetDialogueAuto();
      this.syncMusic();
      const previousCanvas = $("house-canvas"),
        previousTitle = $("event-scene-title"),
        previousDrawerPanel = this.wideDrawer ? $("wide-" + this.wideDrawer + "-panel") : null,
        drawerFocusId = previousDrawerPanel?.contains(document.activeElement)
          ? document.activeElement.id || "wide-" + this.wideDrawer + "-close" : null;
      const f = this.state.family,
        p = this.selected(),
        isEvent = Boolean(this.state.event),
        // Keep normal play and events in the same native 240x160 viewport.
        sceneHeight = 160;
      this.el.innerHTML =
        '<header class="game-header"><div><p class="overline">' +
        escape(f.generation || 1) +
        "대째 이어지는 이야기</p><h1>" +
        escape(this.familyTitle(f.name)) +
        '</h1></div><button id="settings" class="icon-button" aria-label="설정">☷</button></header><div class="hud"><span class="hud-date">' +
        escape(f.year) +
        ". " +
        escape(f.month) +
        ". " +
        escape(f.day) +
        " <small>" +
        escape((SK.GameDate.WeekdayKo || [])[f.weekday] || "") +
        '</small></span><span class="hud-money">살림 <strong>' +
        money(f.money) +
        '</strong></span></div><section class="scene-shell"><canvas id="house-canvas" class="house-canvas" width="240" height="' + sceneHeight + '" aria-label="가족이 생활하는 집. 끌어서 이동하고, 두 손가락으로 확대·축소하고, 인물을 눌러 선택할 수 있습니다."></canvas><div id="family-chatter" class="family-chatter" aria-hidden="true" hidden></div><span id="event-scene-title" class="event-scene-title" hidden><span></span></span><span class="scene-note" ' +
        'hidden' +
        '></span><button id="cupid-tip-trigger" class="cupid-tip-trigger" type="button" aria-label="큐피트 팁 듣기" ' + (isEvent ? 'hidden' : '') + '></button><div id="scene-hud" class="scene-hud" ' + (isEvent ? 'hidden' : '') + '><span id="scene-time" class="scene-time"></span><span id="scene-mood" class="scene-mood"></span></div><div class="scene-bottom"><button id="follow" class="follow-btn" ' +
        (isEvent ? "hidden" : "") +
        ">" +
        (this.follow ? "◎ 따라가는 중" : "◎ 선택한 사람 찾기") +
        '</button></div>' + this.characterHudHtml(p) + '<div class="scene-zoom" ' + (isEvent || this.game?.session?.cur ? 'hidden' : '') + '><div class="scene-zoom-track"><input id="house-zoom" type="range" aria-orientation="vertical" min="0" max="2" step="1" value="' + this.cameraZoomIndex(this.cameraZoom) + '" aria-label="집 화면 확대" aria-valuetext="' + this.cameraZoomLabel(this.cameraZoom) + '"><div class="scene-zoom-labels" aria-hidden="true"><span>멀리</span><span>보통</span><span>확대</span></div></div><output id="house-zoom-value" for="house-zoom">' + this.cameraZoomLabel(this.cameraZoom) + '</output></div>' + (isEvent ? this.eventHtml() : "") + '</section><div class="day-line"><button id="run" class="btn secondary small">' +
        (this.running ? "Ⅱ 멈춤" : "▶ 진행") +
        '</button><span class="speed-label" id="progress-label">' +
        (isEvent ? "사건이 진행 중이에요." : "가족의 하루를 지켜보고 있어요.") +
        '</span><button id="fast" class="fast-btn" aria-pressed="' +
        this.fast + '" aria-label="배속 ' + this.speedMultiplier() + '배">' +
        (this.fast ? '» 배속 ' + this.speedMultiplier() + '배' : '» 배속 OFF') +
        '</button><button id="dialog-auto" class="btn secondary small" aria-pressed="' +
        this.dialogueAuto + '" aria-label="대사 자동 넘기기 ' +
        (this.dialogueAuto ? '켜짐' : '꺼짐') + '">Auto</button></div>' +
        (isEvent ? this.eventAdvanceHtml() : this.memberHtml(p)) +
        '<nav id="wide-menu-panel" class="game-tools"><button id="arrows" class="tool-button orange">' + toolIcon('arrow', '➶') + '화살</button><button id="items" class="tool-button">' + toolIcon('items', '✧') + '아이템</button><button id="family-tree" class="tool-button">' + toolIcon('family', '♧') + '가족</button><button id="cupid-menu" class="tool-button">' + toolIcon('cupid', '♡') + '큐피트</button><button id="save-exit" class="tool-button exit-tool" aria-label="저장 후 종료">' + toolIcon('save', '⏻') + '종료</button><button id="wide-menu-close" class="wide-panel-close" type="button" aria-label="메뉴 닫기">×</button></nav>' +
        '<button id="wide-family-tab" class="wide-drawer-tab" type="button" aria-controls="wide-family-panel" aria-expanded="false" ' + (isEvent ? 'hidden disabled' : '') + '>가족</button><button id="wide-menu-tab" class="wide-drawer-tab" type="button" aria-controls="wide-menu-panel" aria-expanded="false">메뉴</button><button id="wide-drawer-backdrop" class="wide-drawer-backdrop" type="button" aria-label="패널 닫기" tabindex="-1" hidden></button><footer class="game-footer"><span>천년가족 · 브라우저 에디션</span><span id="save-status">브라우저 자동 저장</span></footer>';
      // Keep the last composed scene while the new event's local images decode.
      // Replacing the UI must not expose an empty canvas between animation frames.
      if (previousCanvas) {
        $("house-canvas").getContext("2d").drawImage(previousCanvas, 0, 0);
        if (isEvent && previousTitle && !previousTitle.hidden)
          $("event-scene-title").replaceWith(previousTitle.cloneNode(true));
      }
      this.button("settings", () => this.settingsDialog());
      const zoomControl = $("house-zoom");
      if (zoomControl) zoomControl.oninput = () => {
        if (zoomControl !== $("house-zoom") || !this.playing || this.state?.event ||
            this.modalOpen || document.hidden || this.offlineBackground ||
            this.offlineReturnBlocked || this.arrowFx.active) return;
        this.setHouseZoom(HOUSE_ZOOM_RATIOS[Number(zoomControl.value)]);
        this.persistSettings();
      };
      this.button("follow", () => {
        this.focusHousePerson();
        this.persistSettings();
        this.renderGame();
      });
      this.button("run", () => this.toggleRun());
      this.button("dialog-auto", () => this.toggleDialogueAuto());
      this.button("arrows", () => this.toolsDialog("arrow"));
      this.button("items", () => this.toolsDialog("item"));
      this.button("family-tree", () => this.treeDialog());
      this.button("cupid-menu", () => SK.CupidMenu.open(this));
      this.button("save-exit", () => this.requestSaveAndExit());
      if (this.offlineReturnBlocked) {
        document.querySelectorAll('.game-tools button:not(#save-exit), #run, #fast, #dialog-auto, #person-detail')
          .forEach(button => { button.disabled = true; });
        $("progress-label").textContent = "부재중 기록의 저장을 기다리고 있어요.";
      }
      this.button("previous-person", () => this.cycle(-1));
      this.button("next-person", () => this.cycle(1));
      this.bindCharacterHud();
      this.button("person-detail", () => this.detailDialog(this.selected()));
      this.bindMemberSkills(p);
      this.bindMemberSwipe();
      this.button("event-next", () => this.eventNext());
      const eventAdvance = $("event-advance");
      if (eventAdvance) eventAdvance.onclick = () => {
        this.updateEventAdvanceButton();
        // A detached control from the previous page must not activate the
        // next page on a second click. Forward only the live dialogue button.
        if (!eventAdvance.isConnected || eventAdvance !== $("event-advance") || eventAdvance.disabled) return;
        const next = $("event-next");
        eventAdvance.disabled = true;
        next.click();
      };
      document
        .querySelectorAll("[data-choice]")
        .forEach(
          (b) =>
            (b.onclick = () =>
              this.act(() => this.eventChoice(Number(b.dataset.choice)))),
        );
      this.button("fast", () => this.toggleFast());
      this.bindCanvas();
      this.updateSceneDialog();
      this.updateCupidTip();
      this.updateFamilyChatter();
      this.paintToolIcons();
      // renderGame replaces the time HUD even while paused. Repaint from the
      // retained fraction immediately, without waiting for another clock tick.
      this.updateClock();
      this.syncDialogueVoice();
      const bow = this.art.ui("btn_bow");
      if (bow && !root.SK_UI_ICONS?.arrow) {
        const span = $("arrows").querySelector(".tool-icon");
        span.innerHTML = '<img src="' + bow.src + '" alt="">';
      }
      this.bindWideDrawers();
      this.syncWideDrawers();
      if (drawerFocusId && this.wideDrawer) {
        const focus = $(drawerFocusId), panel = $("wide-" + this.wideDrawer + "-panel");
        if (focus && !focus.disabled && panel?.contains(focus)) focus.focus({ preventScroll: true });
      }
    }
    wideDrawersAvailable() {
      return this.wideDrawerMedia.matches && this.playing && this.game &&
        !this.introFlow && !this.introLoading && !this.modalOpen &&
        !this.offlineBackground && !this.offlineReturnBlocked && !document.hidden;
    }
    bindWideDrawers() {
      const game = this.game;
      const live = (button) => button && button.isConnected &&
        button === $(button.id) && this.el.contains(button) && game === this.game;
      for (const name of ["family", "menu"]) {
        const tab = $("wide-" + name + "-tab"), close = $("wide-" + name + "-close");
        if (tab) tab.onclick = () => {
          if (!live(tab) || tab.disabled || !this.wideDrawersAvailable() ||
              this.arrowFx?.active || (name === "family" && this.state?.event)) return;
          if (this.wideDrawer === name) { this.closeWideDrawer(); return; }
          this.wideDrawer = name;
          this.wideDrawerGame = game;
          this.syncWideDrawers();
          $("wide-" + name + "-close")?.focus({ preventScroll: true });
        };
        if (close) close.onclick = () => {
          if (live(close) && this.wideDrawer === name) this.closeWideDrawer();
        };
      }
      const backdrop = $("wide-drawer-backdrop");
      if (backdrop) backdrop.onclick = () => {
        if (live(backdrop)) this.closeWideDrawer();
      };
    }
    syncWideDrawers() {
      const wide = this.wideDrawerMedia.matches && this.playing && !this.introFlow && !this.introLoading;
      if (!this.wideDrawersAvailable() || this.wideDrawerGame !== this.game ||
          (this.wideDrawer === "family" && (this.state?.event || !$("wide-family-panel")))) {
        this.wideDrawer = "";
        this.wideDrawerGame = null;
      }
      this.el.dataset.wideDrawer = this.wideDrawer;
      for (const name of ["family", "menu"]) {
        const tab = $("wide-" + name + "-tab"), panel = $("wide-" + name + "-panel"),
          open = wide && this.wideDrawer === name;
        if (tab) {
          tab.hidden = name === "family" && Boolean(this.state?.event);
          tab.disabled = Boolean(this.offlineReturnBlocked || (name === "family" && this.state?.event));
          tab.setAttribute("aria-expanded", String(open));
        }
        if (panel) {
          panel.inert = wide && !open;
          if (wide) panel.setAttribute("aria-hidden", String(!open));
          else { panel.removeAttribute("inert"); panel.removeAttribute("aria-hidden"); }
        }
      }
      const backdrop = $("wide-drawer-backdrop");
      if (backdrop) backdrop.hidden = !wide || !this.wideDrawer;
      $("character-family")?.setAttribute("aria-expanded", String(wide && this.wideDrawer === "family"));
    }
    closeWideDrawer(restoreFocus = true) {
      const name = this.wideDrawer;
      this.wideDrawer = "";
      this.wideDrawerGame = null;
      this.syncWideDrawers();
      const tab = name && $("wide-" + name + "-tab");
      if (restoreFocus && this.wideDrawerMedia.matches && this.playing && !this.modalOpen &&
          tab && !tab.hidden && !tab.disabled) tab.focus({ preventScroll: true });
    }
    paintToolIcons() {
      this.menuArt ||= new Map();
      for (const canvas of this.el.querySelectorAll("canvas[data-tool-icon]")) {
        const key = canvas.dataset.toolIcon;
        let entry = this.menuArt.get(key);
        if (!entry) {
          const image = new Image();
          const spec = root.SK_UI_ICONS[key];
          image.src = typeof spec === "string" ? spec : spec.src;
          entry = { image, bounds: spec.bounds, ready: image.decode() };
          this.menuArt.set(key, entry);
        }
        const paint = () => {
          if (!canvas.isConnected) return;
          const image = entry.image, ctx = canvas.getContext("2d");
          const bounds = entry.bounds || [0, 0, image.naturalWidth, image.naturalHeight];
          const [left, top, right, bottom] = bounds;
          const sourceWidth = right - left, sourceHeight = bottom - top;
          const resolution = canvas.width, targetSize = resolution * 26 / 32;
          const scale = Math.min(targetSize / sourceWidth, targetSize / sourceHeight);
          const width = sourceWidth * scale, height = sourceHeight * scale;
          ctx.clearRect(0, 0, resolution, resolution);
          // Keep smooth artwork high-resolution while preserving its aspect
          // and an equal visual size inside the fixed square menu slot.
          ctx.imageSmoothingEnabled = true;
          ctx.imageSmoothingQuality = "high";
          ctx.drawImage(image, left, top, sourceWidth, sourceHeight,
            (resolution - width) / 2, (resolution - height) / 2, width, height);
          canvas.dataset.ready = "1";
        };
        entry.ready.then(paint).catch(() => { canvas.dataset.ready = "error"; });
      }
    }
    characterHudBlocked() {
      const session = this.game?.session, prelude = this.nativeEventPresentation?.current;
      return !this.wideDrawerMedia.matches || !this.playing || !this.game || !this.selected() || this.introFlow || this.introLoading ||
        this.state?.event || session?.cur || session?.heavenCur || session?.memo || this.modalOpen ||
        this.offlineBackground || this.offlineReturnBlocked || document.hidden || this.arrowFx?.active ||
        Boolean(prelude && !prelude.done && session?.cur === prelude.occurrence);
    }
    characterHudHtml(p) {
      if (!p) return "";
      // Reuse the family card's held activity title and native heart
      // DTO. Reading this panel must not run the VM or change game/save state.
      const card = this.interestCardFor(p), canCycle = this.state.members.some(member =>
        member.alive !== false && member.id !== p.id), disabled = canCycle ? "" : " disabled",
        activity = currencyText(card.activity),
        thought = currencyText(String(card.description?.body || "").replace(/\s*\n\s*/g, " ")),
        hint = card.description?.hintRuns?.length ? card.description.hintRuns.map(run => {
          const code = run.nativeColorCode ?? run.color, color = SK.InterestDescription.palette?.[code];
          return '<span' + ([10, 11, 12, 13].includes(code) && /^#[0-9a-f]{6}$/i.test(color || "")
            ? ' style="color:' + color + '" data-native-color="' + code + '"' : '') + '>' + escape(currencyText(run.text)) + '</span>';
        }).join("") : escape(currencyText(card.description?.hint || ""));
      return '<section id="character-hud" class="character-hud" data-person-id="' + escape(p.id) +
        '" aria-label="선택한 가족의 하트와 현재 생각"' + (this.characterHudBlocked() ? ' hidden' : '') +
        '><button id="character-previous" class="character-hud-nav" type="button" aria-label="이전 가족 선택"' + disabled +
        '><span aria-hidden="true">‹</span></button><button id="character-family" class="character-hud-open" type="button" aria-label="' +
        escape(p.name + ' 가족창 열기') + '" aria-controls="wide-family-panel" aria-expanded="' + String(this.wideDrawer === "family") +
        '"><span class="character-hud-top"><strong class="character-hud-name" title="' + escape(p.name) + '">' + escape(p.name) +
        '</strong><span class="character-hud-hearts" aria-label="현재 하트">' + this.hearts(p) +
        '</span></span><strong class="character-hud-activity" aria-label="현재 활동">' + escape(activity) +
        '</strong>' + (thought || hint ? '<span class="character-hud-thought" data-interest-key="' + escape(card.description?.key || "") +
        '"><span class="character-hud-thought-body">' + escape(thought) + '</span>' +
        (hint ? '<span class="character-hud-thought-hint">(' + hint + ')</span>' : '') + '</span>' : '') +
        '</button><button id="character-next" class="character-hud-nav" type="button" aria-label="다음 가족 선택"' + disabled +
        '><span aria-hidden="true">›</span></button></section>';
    }
    bindCharacterHud() {
      const game = this.game, selectedId = this.selectedId, panel = $("character-hud");
      if (panel) panel.onclick = event => {
        if (event.target.closest('.character-hud-nav') || panel !== $("character-hud") || !panel.isConnected ||
            this.game !== game || this.selectedId !== selectedId || this.characterHudBlocked() ||
            !this.wideDrawersAvailable()) return;
        this.wideDrawer = "family";
        this.wideDrawerGame = game;
        this.syncWideDrawers();
        $("wide-family-close")?.focus({ preventScroll: true });
      };
      for (const [id, direction] of [["character-previous", -1], ["character-next", 1]]) {
        const button = $(id);
        if (!button) continue;
        button.onclick = event => {
          event.stopPropagation();
          if (button !== $(id) || !button.isConnected || button.disabled ||
              this.game !== game || this.characterHudBlocked()) return;
          const keyboard = document.activeElement === button;
          this.cycle(direction);
          if (keyboard) $(id)?.focus({ preventScroll: true });
        };
      }
    }
    updateCharacterHudVisibility() {
      const panel = $("character-hud");
      if (!panel) return;
      const hidden = Boolean(this.characterHudBlocked());
      if (panel.hidden !== hidden) panel.hidden = hidden;
      $("character-family")?.setAttribute("aria-expanded", String(this.wideDrawer === "family"));
    }
    memberHtml(p) {
      if (!p)
        return '<div id="wide-family-panel" class="member-panel empty">현재 집에 있는 가족이 없어요.<button id="wide-family-close" class="wide-panel-close" type="button" aria-label="가족 정보 닫기">×</button></div>';
      const portrait = this.memberPortrait(p);
      const interestCard = this.interestCardFor(p), roleTags =
        (p.id === this.state.family.headId ? '<span class="head-tag">가장</span>' : "") + this.heirTag(p);
      return (
        '<section id="wide-family-panel" class="member-panel" aria-label="가족 카드. 좌우로 쓸어 가족을 바꿀 수 있습니다."><button id="previous-person" class="nav-arrow" aria-label="이전 가족"><span class="nav-chevron" aria-hidden="true">‹</span></button><div class="member-content"><div class="member-nav"><div class="member-portrait-stack">' +
        (roleTags ? '<div class="member-role-tags">' + roleTags + '</div>' : '') + '<img class="portrait" data-sex="' +
        (p.gender === 1 ? "female" : "male") + '" src="' + portrait +
        '" alt="' +
        escape(p.name) +
        '"></div><div class="member-id"><div class="member-identity"><div class="member-name">' +
        escape(p.name) +
        ' <span class="member-age">' +
        escape(p.age) +
        '세</span></div><div class="member-job">' +
        escape(p.jobName || "직업 " + p.job) +
        '</div></div><div class="member-hearts">' +
        this.hearts(p) +
        '</div>' + this.memberArrowStatusHtml(p) + '</div><div class="member-right"><button id="person-detail" class="member-more">자세히 ↗</button></div></div>' + this.memberSummaryHtml(p) + '<div class="activity"><span class="label">지금</span><span class="activity-text">' +
        escape(currencyText(
          interestCard.activity,
        )) +
        '</span></div>' + this.interestDescriptionHtml(p, interestCard.description) + this.focusGaugeHtml(p) + '</div><button id="next-person" class="nav-arrow" aria-label="다음 가족"><span class="nav-chevron" aria-hidden="true">›</span></button><button id="wide-family-close" class="wide-panel-close" type="button" aria-label="가족 정보 닫기">×</button></section>'
      );
    }
    memberSummaryHtml(p) {
      // Current DTO only; use exactly the detail screen's skills/rank mapping.
      const skills = this.detailSkills(p),
        stats = p.stats || [p.intelligence, p.health, p.charm, p.luck];
      return '<section class="member-summary" aria-label="현재 스킬과 능력 등급"><div class="member-skills"><span class="member-summary-label">스킬</span><div class="member-skill-list" role="list">' +
        (skills.length ? skills.map((skill, index) => '<span role="listitem"><button type="button" class="member-skill-name" data-member-skill-index="' + index +
          '" aria-label="' + escape(skill.name + ' 스킬 설명') + '" aria-haspopup="dialog" aria-expanded="false">' +
          escape(skill.name) + '</button></span>').join('') : '<span class="member-skills-empty">없음</span>') +
        '</div></div><div class="member-stat-ranks" aria-label="능력 등급">' +
        ['지력', '체력', '매력', '운'].map((label, i) => {
          const grade = SK.Stat.Rank(stats[i] || 0);
          return '<div class="member-stat" data-grade="' + escape(grade) + '"><span>' + label +
            '</span><strong>' + escape(grade) + '</strong></div>';
        }).join('') + '</div></section>';
    }
    bindMemberSkills(p) {
      if (!p) return;
      const game = this.game, selectedId = p.id, skills = this.detailSkills(p);
      this.el.querySelectorAll('[data-member-skill-index]').forEach(button => {
        button.disabled = Boolean(this.offlineReturnBlocked);
        if (this.skillHelpContext?.game === game && this.skillHelpContext.selectedId === selectedId &&
            this.skillHelpContext.skillIndex === button.dataset.memberSkillIndex)
          button.setAttribute("aria-expanded", "true");
        button.onclick = e => {
          e.stopPropagation();
          // Detached buttons and a gesture from a previous card cannot open
          // a popup for the new selection or bypass a covered/event screen.
          if (!button.isConnected || !this.el.contains(button) || button.disabled ||
              !this.playing || this.modalOpen || this.game !== game ||
              this.selectedId !== selectedId || this.state?.event ||
              this.offlineReturnBlocked || this.arrowFx?.active || document.hidden) return;
          this.skillDescriptionDialog(skills[Number(button.dataset.memberSkillIndex)], button);
        };
      });
    }
    memberArrowStatusHtml(p) {
      // Snapshot-only presentation: no native writes, timer updates or VM calls.
      const effects = p.arrowEffects || [];
      if (!effects.length) return "";
      return '<div class="member-arrow-status" aria-label="적용 중인 화살">' +
        effects.map(effect => {
          const timed = Number.isInteger(effect.durationYears) && Number.isInteger(effect.remainingDays),
            label = effect.name + (timed ? ' · ' + effect.durationYears + '년' : ''),
            remaining = timed ? '남은 ' + effect.remainingDays + '일' : '',
            full = label + (remaining ? ' · ' + remaining : ' 적용 중');
          return '<span class="member-arrow-chip" data-arrow-effect="' + escape(effect.id) +
            '" title="' + escape(full) + '" aria-label="' + escape(full) + '"><span>' +
            escape(label) + '</span>' + (remaining ? '<small>' + escape(remaining) + '</small>' : '') + '</span>';
        }).join('') + '</div>';
    }
    focusPercent(p) {
      // Gauge is current-interest focus; Immersion remains the native heart
      // source. The latter is only a fallback for older incomplete DTOs.
      return Math.round(clamp(Number(p.gauge ?? p.immersion ?? 0) * 100 / 255, 0, 100));
    }
    focusGaugeHtml(p) {
      const percent = this.focusPercent(p), band = percent >= 100 ? "full" :
        percent >= 75 ? "high" : percent >= 50 ? "steady" : percent >= 25 ? "rising" : "low";
      return '<div class="gauge-wrap"><div class="gauge-label"><span>몰입도</span><span>' +
        percent + '%</span></div><div class="gauge" role="progressbar" aria-label="몰입도" ' +
        'aria-valuemin="0" aria-valuemax="100" aria-valuenow="' + percent + '"><div class="gauge-fill" ' +
        'data-focus-band="' + band + '" style="width:' + percent + '%"></div></div></div>';
    }
    interestCardSnapshot(p) {
      const description = SK.InterestDescription?.get(p, { ...this.state,
        origNames: this.game?.session?.Family?.OrigNames });
      return { id: p.id, activity: p.plannedTitle || p.currentTitle || p.interest || p.dream ||
        '가족의 하루를 보내고 있어요.', description: description ? {
          key: description.key, body: description.body, hint: description.hint,
          hintRuns: (description.hintRuns || []).map(run => ({ text: run.text,
            nativeColorCode: run.nativeColorCode ?? run.color })) } : null };
    }
    syncInterestCard() {
      let hold = this.interestCardHold;
      if (!hold || hold.game !== this.game)
        hold = this.interestCardHold = { game: this.game, shown: new Map(), latest: new Map(), token: null };
      const session = this.game?.session,
        token = session?.cur || session?.heavenCur || session?.memo || session?.pending?.[0] ||
          this.state.event?.eventId || this.state.event?.title || null,
        unread = [session?.cur, ...(session?.pending || [])].filter(Boolean),
        affected = new Set(unread.flatMap(e => [e.PersonId, ...(e.Slots || []).slice(23, 27)])
          .filter(id => Number.isInteger(id) && id >= 0 && id < 65535)), event = Boolean(token),
        current = new Map(this.state.members.map(p => [p.id, this.interestCardSnapshot(p)]));
      if (!event) { hold.shown = current; hold.token = null; }
      else {
        // TickDay applies an entire queue before its scenes are read. Release
        // each member only after their last unread scene, not on a cur switch.
        for (const [id, card] of current)
          if (affected.size && !affected.has(id) && !session?.memo && !session?.heavenCur) hold.shown.set(id, card);
        hold.token = token;
      }
      hold.latest = current;
    }
    interestCardFor(p) {
      const hold = this.interestCardHold;
      return (hold?.token ? hold.shown : hold?.latest)?.get(p.id) ||
        (hold?.token ? { activity: '사건이 진행 중이에요.', description: {
          key: 'event-pending', body: '새 이야기는 사건이 끝난 뒤 표시돼요.', hint: '', hintRuns: [] } }
          : this.interestCardSnapshot(p));
    }
    savedInterestCard(game) {
      const hold = this.interestCardHold;
      if (!hold?.token || hold.game !== this.game) return null;
      const identity = g => {
        const s = g.session, f = g.state().family;
        return JSON.stringify([f.name, f.year, f.month, f.day, s?.cur?.Data, s?.cur?.PersonId,
          (s?.pending || []).map(e => [e.Data, e.PersonId]), s?.heavenCur?.length || 0, Boolean(s?.memo)]);
      };
      if (game !== this.game && identity(game) !== identity(this.game)) return null;
      return { version: 1, entries: [...hold.shown.values()] };
    }
    restoreInterestCard(game, saved) {
      const entries = saved?.version === 1 && Array.isArray(saved.entries) && saved.entries.length <= 64
        ? saved.entries : [];
      const valid = entries.filter(p => Number.isInteger(p?.id) && p.id >= 0 && p.id < 65535 &&
        typeof p.activity === 'string' && p.activity.length <= 500 &&
        (p.description == null || typeof p.description.key === 'string' && p.description.key.length <= 128 &&
          typeof p.description.body === 'string' && p.description.body.length <= 4000 &&
          typeof p.description.hint === 'string' && p.description.hint.length <= 1000 &&
          Array.isArray(p.description.hintRuns) && p.description.hintRuns.length <= 128 &&
          p.description.hintRuns.every(run => typeof run?.text === 'string' && run.text.length <= 1000)));
      this.interestCardHold = { game, shown: new Map(valid.map(p => [p.id, JSON.parse(JSON.stringify(p))])),
        latest: new Map(), token: null };
    }
    interestDescriptionHtml(p, override) {
      const description = override === undefined ? SK.InterestDescription?.get(p, { ...this.state,
        origNames: this.game?.session?.Family?.OrigNames }) : override;
      if (!description) return "";
      const text = value => escape(currencyText(String(value || "").replace(/\s*\n\s*/g, " ")));
      const hint = description.hintRuns?.length
        ? description.hintRuns.map((run) => {
          const code = run.nativeColorCode ?? run.color,
            color = [10, 11, 12, 13].includes(code) ? SK.InterestDescription.palette?.[code] : null;
          return '<span class="interest-hint-run"' + (color && /^#[0-9a-f]{6}$/i.test(color)
            ? ' style="color:' + color + '" data-native-color="' + code + '"' : '') + '>' + text(run.text) + '</span>';
        }).join("") : text(description.hint?.replace(/\s*([↑↓]+)\s*/g, ' $1 '));
      return '<div class="interest-description" data-interest-key="' + escape(description.key) +
        '" aria-label="현재 관심사 설명"><p class="interest-description-body">' + text(description.body) +
        '</p>' + (description.hint ? '<p class="interest-description-hint">(' + hint + ')</p>' : "") + '</div>';
    }
    eventHtml() {
      return this.dialogueHtml(this.state.event, false).replace(
        'class="scene-dialog"',
        'class="scene-dialog" data-event-visual="pending" style="visibility:hidden" inert aria-hidden="true"',
      );
    }
    eventAdvanceHtml() {
      return '<div class="event-advance-area"><button id="event-advance" class="event-advance-button" type="button" aria-label="다음 대사" disabled><span class="event-advance-icon" aria-hidden="true">▶</span><span class="event-advance-label">Touch</span></button></div>';
    }
    updateEventAdvanceButton() {
      const button = $("event-advance");
      if (!button) return;
      const event = this.state?.event, next = $("event-next"),
        advance = event && !(event.choices || []).length && event.mode !== "name" && event.canAdvance !== false &&
          (event.eventId || event.EventId) !== "memo-progress";
      button.disabled = !this.playing || !this.game || !advance || this.modalOpen ||
        this.offlineBackground || this.offlineReturnBlocked || document.hidden || this.arrowFx?.active ||
        !!this.eventDialoguePending() || !next || !this.el.contains(next) || next.disabled ||
        !!next.closest('[hidden],[inert],[aria-hidden="true"]') ||
        getComputedStyle(next).visibility !== "visible" || !next.getClientRects().length;
    }
    resetDialogueAuto() {
      this.dialogueAutoTimer = null;
    }
    toggleFast() {
      if (!this.fast) { this.fast = true; this.fastTier = 1; }
      else if (this.fastTier !== 2) this.fastTier = 2;
      else { this.fast = false; this.fastTier = 0; }
      const button = $("fast");
      if (!button) return;
      button.setAttribute("aria-pressed", String(this.fast));
      button.setAttribute("aria-label", "배속 " + this.speedMultiplier() + "배");
      button.textContent = this.fast ? "» 배속 " + this.speedMultiplier() + "배" : "» 배속 OFF";
    }
    speedMultiplier() {
      return this.fast ? FAST_FACTOR * (this.fastTier === 2 ? 2 : 1) : 1;
    }
    cameraZoomRatio(value, fallback = 1) {
      const ratio = typeof value === "number" && Number.isFinite(value) ? value :
        typeof fallback === "number" && Number.isFinite(fallback) ? fallback : 1;
      // Old continuous preferences migrate to the nearest supported view;
      // an exact midpoint chooses the larger view (for example 1.5 -> 2).
      return HOUSE_ZOOM_RATIOS.reduce((nearest, zoom) =>
        Math.abs(zoom - ratio) <= Math.abs(nearest - ratio) ? zoom : nearest, .5);
    }
    cameraZoomIndex(value) {
      return HOUSE_ZOOM_RATIOS.indexOf(this.cameraZoomRatio(value));
    }
    cameraZoomLabel(value) {
      return HOUSE_ZOOM_LABELS[this.cameraZoomIndex(value)];
    }
    houseZoom() {
      // Native event/replay framing is unchanged; retain the house preference.
