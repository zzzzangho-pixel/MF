              e.preventDefault();
              (e.shiftKey ? last : first).focus({ preventScroll: true });
            }
          }
          // Focused buttons retain browser activation. Native play/advance
          // shortcuts must not act on the scene behind an open drawer.
          return;
        }
        if (this.arrowFx.active) { e.preventDefault(); return; }
        if (e.key === "Escape") {
          if (this.introFlow?.read().mode === "family") this.cancelIntro();
          else this.closeModal();
          return;
        }
        if (e.target.closest("input,textarea,select")) return;
        if (this.modalOpen) return;
        if (!this.playing) return;
        // Focused buttons own their native Space/Enter activation, including fast.
        if (e.target.closest("button") && (e.key === " " || e.key === "Enter"))
          return;
        if (e.key === "ArrowLeft") {
          e.preventDefault();
          this.cycle(-1);
        }
        if (e.key === "ArrowRight") {
          e.preventDefault();
          this.cycle(1);
        }
        if (e.key === " ") {
          e.preventDefault();
          this.toggleRun();
        }
        if (e.key === "Enter" && this.state.event) {
          e.preventDefault();
          this.eventNext();
        }
      });
      document.addEventListener("click", (e) => {
        if (!this.wideDrawer || !this.wideDrawerMedia.matches ||
            e.target.closest("#wide-family-panel,#wide-menu-panel,.wide-drawer-tab")) return;
        this.closeWideDrawer();
      }, true);
      document.addEventListener("visibilitychange", () => {
        this.resetDialogueAuto();
        if (document.hidden) this.suspendOffline("hidden");
        else this.resumeOffline();
        if (this.journalPlayback) this.journalPlayback.last = 0;
        this.lastFrame = 0;
        this.titleLastFrame = null;
        this.arrowFx.resetClock();
        this.updateCupidTip();
        this.updateFamilyChatter();
        this.syncDialogueVoice();
      });
