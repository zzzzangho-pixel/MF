        }
        // Center the complete visible copy (speaker, dialogue and choices)
        // inside the original flat panel, excluding the11px tail. Range
        // rectangles are font boxes; use native font ink metrics so Korean
        // glyphs do not look top-heavy within those boxes. Real overflow
        // remains in the same scrollable text viewport and LEFT-aligned.
