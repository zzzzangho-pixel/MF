        walkPeriod = 5 + mod((Number(p.id) || 0) * 937, 4000) / 1000,
        plan = this.game.dayPlan
          ? this.game.dayPlan(
              p.id,
              SK.WebHouseClock.fromFraction(this.dayFraction),
            )
          : null;
      let ri = plan
        ? Number(v(plan, "room", 0))
        : mod(Number(p.id) || 0, rooms.length);
      ri = clamp(ri, 0, rooms.length - 1);
      const r = rooms[ri],
