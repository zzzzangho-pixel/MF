      return false;
    }
  }
  function compactStoredSaves() {
    if (!SK.SaveStorageCodec) return;
    // Replace each legacy value atomically with an exact lossless encoding.
    // No slot, backup, history row, setting, or unrelated origin key is deleted.
    for (const slot of ["auto", "1", "2", "3"])
      for (const suffix of ["", ":backup"]) {
        const key = STORE + slot + suffix;
        try {
          const raw = localStorage.getItem(key);
          if (!raw || SK.SaveStorageCodec.isEncoded(raw)) continue;
          const parsed = JSON.parse(raw);
          if (parsed?.format !== "sennen-kazoku-web-save" || parsed.version !== 1 || !parsed.data) continue;
