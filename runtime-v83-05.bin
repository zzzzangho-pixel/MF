      this.wideDrawerMedia.addEventListener("change", () => { this.closeWideDrawer(false); this.updateCharacterHudVisibility(); });
      this.cupidTip = { index: -1, text: "", until: 0, nextAt: 0 };
      this.lastFrame = 0;
      this.lastHudSecond = -1;
      this.eventKey = "";
      this.eventStart = 0;
      this.titleStart = performance.now();
      this.fatal = false;
      this.storageWarned = false;
      this.offlineAnchor = null;
      this.offlineGame = null;
      this.offlineBackground = false;
      this.offlineCheckpointAt = 0;
      this.offlineSummaryOpen = false;
      this.offlineReplayReturn = null;
      this.offlineReturnBlocked = false;
      this.settings = this.readSettings();
      this.cameraZoom = this.cameraZoomRatio(this.settings.cameraZoom);
      this.dialogueAuto = this.settings.dialogueAuto === true;
      this.dialogueAutoTimer = null;
      this.bgmVolume = clamp(Number(this.settings.bgmVolume ?? 0.8) || 0, 0, 1);
      this.seVolume = clamp(Number(this.settings.seVolume ?? 0.8) || 0, 0, 1);
      this.musicOverride = -1;
