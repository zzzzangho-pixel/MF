    updateSceneDialog() {
      this.updateEventAdvanceButton();
      const scene = this.el.querySelector(".scene-shell");
      if (!scene) return;
      const canvas = scene.querySelector(".house-canvas"), scale = canvas.clientWidth / 240;
      scene.style.setProperty("--pixel-scale", scale);
      const box = scene.querySelector(".dialogue-frame");
      if (box) {
        const text = box.querySelector(".dialog-text"), art = box.querySelector(".bubble-art");
        box.classList.remove("single-line", "short-dialogue");
        box.style.removeProperty("--dialog-copy-offset");
        box.style.width = "";
