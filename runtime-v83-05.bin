      this.updateCharacterHudVisibility();
      const state = this.cupidTip, tip = this.el.querySelector(".scene-note, .scene-tip"), button = $("cupid-tip-trigger"),
        blocked = !this.playing || !this.game || this.state?.event || this.modalOpen || document.hidden || this.arrowFx.active;
      if (button) button.hidden = Boolean(blocked);
      if (blocked) {
        if (!state.blocked) state.nextAt = t + CUPID_TIP_INTERVAL;
        state.blocked = true;
        state.until = 0;
        if (tip) tip.hidden = true;
        return;
      }
      state.blocked = false;
      if (state.until && t >= state.until) state.until = 0;
      if (!state.until && t >= state.nextAt) return this.showCupidTip(t);
      if (!tip) return;
      if (!state.until) { tip.hidden = true; return; }
      const changed = tip.hidden || tip.querySelector("span")?.textContent !== state.text;
      tip.hidden = false;
      if (changed) {
        tip.className = "scene-tip";
        tip.setAttribute("role", "status");
        tip.innerHTML = '<canvas aria-hidden="true"></canvas><span></span>';
        tip.querySelector("span").textContent = state.text;
        this.updateSceneDialog();
      }
    }
    bindMemberSwipe() {
      if (this.memberSwipeBound) return;
      this.memberSwipeBound = true;
      let gesture = null, suppressClick = null;
      const pointers = new Set(), interactive =
        'button,a,input,select,textarea,[role="button"],[contenteditable="true"]';
      const available = () => this.playing && this.game && !this.modalOpen &&
        !this.state?.event && !this.offlineReturnBlocked && !this.arrowFx?.active &&
        !document.hidden && this.el.querySelector('.member-panel:not(.empty)');
      const reset = () => { gesture = null; pointers.clear(); suppressClick = null; };
      // Listen on the stable document: the ordinary day refresh replaces the
      // card's DOM during play. A gesture still belongs to its original game
      // and selected person, never to a newly opened event, menu or family.
      document.addEventListener('pointerdown', e => {
        // A new deliberate gesture is not the prior swipe's compatibility
        // click, even when a pen/browser reuses that pointer's identifier.
        suppressClick = null;
        pointers.add(e.pointerId);
        if (gesture || pointers.size !== 1) { gesture = null; return; }
        if (!['touch', 'pen'].includes(e.pointerType) || e.isPrimary === false ||
            e.button !== 0 || !available()) return;
        const panel = e.target.closest?.('.member-panel:not(.empty)');
        if (!panel || !this.el.contains(panel) || e.target.closest(interactive)) return;
        gesture = { id: e.pointerId, x: e.clientX, y: e.clientY,
          game: this.game, selected: this.selectedId };
      }, true);
      document.addEventListener('pointermove', e => {
        if (!gesture || e.pointerId !== gesture.id) return;
        const dx = Math.abs(e.clientX - gesture.x), dy = Math.abs(e.clientY - gesture.y);
        // Native vertical scrolling/pinch owns those gestures. No pointer
        // capture or preventDefault here, so scrolling and zoom keep working.
        if (dy > 12 && dy >= dx) gesture = null;
      }, true);
      document.addEventListener('pointerup', e => {
        pointers.delete(e.pointerId);
        if (!gesture || e.pointerId !== gesture.id) return;
        const start = gesture;
        gesture = null;
        const dx = e.clientX - start.x, dy = e.clientY - start.y;
        if (pointers.size || !available() || this.game !== start.game ||
            this.selectedId !== start.selected || Math.abs(dx) < 56 ||
            Math.abs(dx) < Math.abs(dy) * 1.35 ||
            this.state.members.filter(p => p.alive !== false).length < 2) return;
        if (e.cancelable) e.preventDefault();
        // A completed swipe must not also activate the control under its end.
        // Match its pointer, leaving a new deliberate tap/keyboard click alone.
        suppressClick = { id: e.pointerId, until: performance.now() + 400 };
        const dir = dx < 0 ? 1 : -1;
        this.cycle(dir);
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches)
          this.el.querySelector('.member-content')?.animate?.([
            { opacity: .65, transform: 'translateX(' + (dir * 10) + 'px)' },
            { opacity: 1, transform: 'translateX(0)' },
          ], { duration: 150, easing: 'ease-out' });
      }, true);
      document.addEventListener('pointercancel', e => {
        pointers.delete(e.pointerId);
        gesture = null;
      }, true);
      document.addEventListener('click', e => {
        if (!suppressClick || performance.now() > suppressClick.until) return;
        if (e.pointerId === suppressClick.id || (e.pointerId === undefined &&
            e.detail > 0 && e.sourceCapabilities?.firesTouchEvents)) {
          suppressClick = null;
          e.preventDefault();
          e.stopImmediatePropagation();
        }
      }, true);
      window.addEventListener('blur', reset);
      document.addEventListener('visibilitychange', reset);
    }
    cycle(dir) {
      const a = this.state.members.filter((p) => p.alive !== false);
      if (!a.length) return;
      this.selectedId =
        a[mod(a.findIndex((p) => p.id === this.selectedId) + dir, a.length)].id;
      this.focusHousePerson();
      this.renderGame();
    }
    refresh(state = null) {
      this.state = state || this.game.state();
      const alive = this.state.members.filter((p) => p.alive !== false);
      if (!alive.some((p) => p.id === this.selectedId))
        this.selectedId = (alive[0] || {}).id;
      this.maybeOfflineHistory();
      this.renderGame();
    }
    toggleRun() {
      this.running = !this.running;
      this.resetDialogueAuto();
      if (this.introFlow) {
        const button = $("run");
        if (button) button.textContent = this.running ? "Ⅱ 멈춤" : "▶ 진행";
        return;
      }
      this.persistSettings();
      this.renderGame();
    }
    tickDay() {
      if (this.offlineReturnBlocked) { this.toast("부재중 진행의 저장이 완료된 뒤 진행할 수 있어요."); return; }
      if (!this.game || this.state.paused || this.state.event) {
        this.toast("사건을 마친 뒤에 하루를 넘길 수 있어요.");
        return;
      }
      const state = this.game.tickDay();
      this.dayFraction = 0;
      this.refresh(state);
      this.saveSlot("auto", true);
      this.returnToTitleAfterClosure();
    }
    eventNext() {
      this.resetDialogueAuto();
      if (this.offlineReturnBlocked) { this.toast("부재중 진행의 저장이 완료된 뒤 진행할 수 있어요."); return; }
      if (this.eventDialoguePending()) return;
      this.refresh(this.game.advanceEvent());
      this.saveSlot("auto", true);
      this.returnToTitleAfterClosure();
      this.maybeOfflineHistory();
    }
    eventChoice(i) {
      if (this.offlineReturnBlocked) { this.toast("부재중 진행의 저장이 완료된 뒤 진행할 수 있어요."); return; }
      if (this.eventDialoguePending()) return;
      this.refresh(this.game.choose(i));
      this.saveSlot("auto", true);
      this.returnToTitleAfterClosure();
      this.maybeOfflineHistory();
    }
    openModal(title, html, initialFocusId = null) {
      this.closeWideDrawer(false);
      this.itemFeedback?.cancel();
      this.skillHelpClose?.(false);
      this.slotDeleteConfirmation = null;
      this.resetDialogueAuto();
      this.stopJournalReplay();
      this.musicOverride = -1;
      this.syncMusic();
      this.modalOpen = true;
      this.updateEventAdvanceButton();
      this.syncDialogueVoice();
      this.updateCupidTip();
      this.updateFamilyChatter();
      $("modal-root").innerHTML =
        '<div class="modal-overlay" id="modal-overlay"><section class="modal" role="dialog" aria-modal="true" aria-label="' +
        escape(title) +
        '"><header class="modal-header"><h2>' +
        escape(title) +
        '</h2><button id="modal-close" class="close-button" aria-label="닫기">×</button></header><div class="modal-body">' +
        html +
        "</div></section></div>";
      this.button("modal-close", () => this.introFlow?.read().mode === "family" ? this.cancelIntro() : this.closeModal());
      $("modal-overlay").onclick = (e) => {
        if (e.target.id === "modal-overlay") {
          if (this.introFlow?.read().mode === "family") this.cancelIntro();
          else this.closeModal();
        }
      };
      setTimeout(() => {
        const f = (initialFocusId && $(initialFocusId)) || $("modal-root").querySelector("input,button,select");
        if (f) f.focus();
      }, 20);
    }
    closeModal() {
      this.itemFeedback?.cancel();
      this.skillHelpClose?.(false);
      if (this.slotDeleteConfirmation) {
        this.slotDeleteConfirmation = null;
        this.saveDialog();
        return;
      }
      const exitReturnId = this.exitConfirmationReturnId;
      this.exitConfirmationReturnId = null;
      const offlineIds = this.offlineSummaryOpen || this.offlineReplayReturn
        ? this.offlineSummaryIds?.slice() : null;
      this.offlineSummaryOpen = false;
      this.offlineReplayReturn = null;
      this.stopJournalReplay();
      this.modalOpen = false;
      $("modal-root").innerHTML = "";
      this.musicOverride = -1;
      if (offlineIds?.length && this.game?.acknowledgeOffline) {
        this.game.acknowledgeOffline(offlineIds);
        this.saveSlot("auto", true, { preserveAnchor: true });
        // The live event was covered, not read. Let its voice begin only
        // after the report is dismissed; its native page remains untouched.
        this.voiceLineKey = null;
      }
      this.syncMusic();
      this.updateCupidTip();
      this.syncDialogueVoice();
      if (exitReturnId && this.playing) $(exitReturnId)?.focus();
      this.updateEventAdvanceButton();
    }
    syncMusic() {
      if (!this.sound) return;
      if (this.journalPlayback?.active) {
        this.syncJournalReplayAudio(this.journalPlayback);
        return;
      }
      let id, fadeIn = 0;
      if (this.recommendedReview && !this.modalOpen) id = this.recommendedReview.read().song;
      else if (this.introFlow && !this.modalOpen) id = this.introFlow.read().song;
      else if (this.modalOpen && this.musicOverride >= 0) id = this.musicOverride;
      else if (!this.playing) id = 132;
      else {
        const s = this.game.session;
        if (s.SceneMusic >= 0) id = s.SceneMusic;
        else if (s.EndMenu === 4) id = 4;
        else if (s.EndMenu === 5 || s.BookmarkAskPending || s.LineageEnded) id = 5;
        else {
          const f = this.state.family;
          id = 81 - 3 * clamp(f.grade & 15, 0, 3) + 12 * clamp(f.era, 0, 3);
          fadeIn = 0.5;
        }
      }
      this.sound.playBgm(id, { again: id === 132, fadeIn, fadeOut: 0.5 });
    }
    audioStatusText() {
      if (!this.sound?.available) return "이 브라우저에서 소리를 재생할 수 없어요.";
      if (this.bgmVolume === 0 && this.seVolume === 0) return "음악과 효과음이 꺼져 있어요. 음량을 올려 주세요.";
      if (this.audioAttemptFailed) return "소리를 켜지 못했어요. 다시 시도해 주세요.";
      switch (this.sound.status) {
        case "locked": return "아래 버튼을 눌러 소리를 켜 주세요.";
        case "loading": return "소리를 준비하고 있어요…";
        case "error": return "소리를 준비하지 못했어요. 다시 시도해 주세요.";
        case "paused": return "소리가 잠시 멈춰 있어요.";
        default: return "소리 재생이 준비됐어요.";
      }
    }
    updateAudioStatus() {
      const node = $("audio-status");
      if (node) node.textContent = this.audioStatusText();
    }
    async startAudio() {
      this.audioAttemptFailed = false;
      try {
        if (!await this.sound.unlock()) return;
        this.syncMusic();
        await this.sound.playSe(201);
      } catch (_) {
        this.audioAttemptFailed = true;
      } finally {
        this.updateAudioStatus();
      }
    }
    audioControls() {
      const select = (id, label, value) =>
        '<div class="setting-row"><label for="' + id + '">' + label +
        '</label><select id="' + id + '" class="audio-volume">' +
        [0, 0.25, 0.5, 0.8, 1].map((n) => '<option value="' + n + '"' +
          (n === value ? ' selected' : '') + '>' +
          (n === 0 ? '끔' : Math.round(n * 100) + '%') + '</option>').join('') + '</select></div>';
      return select('setting-bgm', '배경음악 음량', this.bgmVolume) +
        select('setting-se', '효과음 음량', this.seVolume) +
        '<div class="setting-row"><label for="setting-voice">대사 옹알이</label>' +
        '<select id="setting-voice" class="audio-volume"><option value="1"' +
        (this.voice.enabled ? ' selected' : '') + '>켬</option><option value="0"' +
        (!this.voice.enabled ? ' selected' : '') + '>끔</option></select></div>' +
        '<p id="audio-status" class="form-help" role="status">' + this.audioStatusText() + '</p><button type="button" id="audio-start" class="btn secondary small">소리 켜기 · 시험 재생</button>';
    }
    bindAudioControls() {
      $("setting-voice").onchange = (e) => {
        this.voice.setEnabled(e.target.value === "1");
        this.persistSettings();
      };
      for (const [id, key] of [['setting-bgm','bgmVolume'], ['setting-se','seVolume']]) {
        $(id).onchange = (e) => {
          this[key] = clamp(Number(e.target.value) || 0, 0, 1);
          this.sound.setVolumes(this.bgmVolume, this.seVolume);
          this.persistSettings();
          this.updateAudioStatus();
        };
      }
      this.button("audio-start", () => { void this.startAudio(); });
    }
    soundDialog() {
      this.openModal('원작 소리', this.audioControls());
      this.bindAudioControls();
    }
    detailDialog(p, returnTo = null) {
      if (!p) return;
      const game = this.game, skills = this.detailSkills(p), returnView = returnTo ||
        (this.modalOpen && $("modal-root").querySelector("[data-person]") ? "tree" : "family");
      const stats = p.stats || [p.intelligence, p.health, p.charm, p.luck],
        rank = (n) => SK.Stat.Rank(n),hit=Number(p.hitArrow??-1),
        hitName=hit>1?(SK.Interventions.Tools.find(t=>t.Kind==='arrow'&&t.OrigSlot===hit)?.Name||'화살 #'+hit):null;
      this.openModal(
        p.name + "의 이야기",
        '<div class="detail-hero"><div class="detail-profile"><img class="portrait detail-portrait" data-sex="' +
          (p.gender === 1 ? "female" : "male") + '" src="' +
          this.memberPortrait(p) +
          '" alt="' +
          escape(p.name) +
          '"><div class="detail-identity"><div class="detail-name">' +
          '<span>' + escape(p.name) + '</span><button id="rename-person" class="name-edit" aria-label="' +
          escape(p.name + ' 이름 바꾸기') + '">변경</button></div><p class="detail-sex-line">' +
          escape(p.age) +
          "세 · " +
          escape(p.gender === 1 ? "여성" : "남성") +
          '<span class="detail-hearts">' +
          this.hearts(p) +
          '</span></p><p class="detail-job">' + escape(p.jobName || "직업 " + p.job) +
          '</p></div></div><div class="detail-stats">' +
          ["지력", "체력", "매력", "운"]
            .map(
              (x, i) =>
                '<div class="stat" data-grade="' + escape(rank(stats[i] || 0)) + '"><label>' +
                x +
                "</label><strong>" +
                escape(rank(stats[i] || 0)) +
                "</strong></div>",
            )
            .join("") +
          "</div></div>" +
          this.info("기본월급", p.salaryBase === null || p.salaryBase === undefined ? "—" : money(p.salaryBase) + " / 월") +
          this.info("애인", p.loverName || (p.loverPresent ? "이름 미확인" : "없음")) +
          (p.spouseId >= 0 ? this.info("배우자", p.spouseName || "이름 미확인") : "") +
          this.info("맞은 화살", hitName || "맞은 화살 없음") +
          this.info("꿈", p.dream || "지금은 없어요.") +
          this.info("관심", p.interest === undefined ? "—" : p.interest) +
          this.info("몰입도", this.focusPercent(p) + "%") +
          this.info("숙련도", p.jobMastery === undefined ? "—" : p.jobMastery) +
          this.info("감사", p.gratitude === undefined ? "—" : p.gratitude) +
          '<div class="info-line"><label>스킬</label><div class="detail-skills">' +
          (skills.length ? skills.map((skill, index) => '<button type="button" class="skill-token" data-skill-index="' + index +
            '" aria-label="' + escape(skill.name + ' 스킬 설명') + '" aria-haspopup="dialog" aria-expanded="false">' +
            escape(skill.name) + '</button>').join('') : '<span>없음</span>') + '</div></div>' +
          '<div class="form-actions detail-navigation"><button id="detail-back" class="btn secondary" aria-label="' +
          (returnView === "tree" ? "가족 계보로 돌아가기" : "가족 화면으로 돌아가기") + '">← 뒤로</button></div>',
      );
      const back = $("detail-back");
      this.button("detail-back", () => {
        if (this.game !== game || !back.isConnected) return;
        if (returnView === "tree") { this.treeDialog(); return; }
        this.closeModal();
        if (this.wideDrawersAvailable() && !this.characterHudBlocked()) {
          this.wideDrawer = "family"; this.wideDrawerGame = game; this.syncWideDrawers();
        }
        $("person-detail")?.focus({ preventScroll: true });
      });
      this.button("rename-person", () => this.renameDialog(p, returnView));
      $("modal-root").querySelectorAll('[data-skill-index]').forEach((button) => {
        button.onclick = () => this.skillDescriptionDialog(skills[Number(button.dataset.skillIndex)], button);
      });
    }
    detailSkills(p) {
      return (p.skills || p.skillNames || []).map((skill) => {
        const id = typeof skill === "number" ? skill : skill?.id ?? skill?.Id,
          native = Number.isInteger(id) ? this.game?.session?.Text?.Skills[id] : null,
          name = typeof skill === "string" ? skill : v(skill, "name", native?.Name || "스킬 " + id),
          description = (typeof skill === "object" && (skill.description || skill.desc || skill.Desc)) ||
            (native ? this.game.session.SkillDesc(id) : "");
        return { name, description };
      });
    }
    skillDescriptionDialog(skill, trigger) {
      if (!skill || !trigger?.isConnected) return;
      this.skillHelpClose?.(false);
      const modalRoot = $("modal-root"), base = modalRoot.querySelector(".modal"),
        standalone = !base, game = this.game, selectedId = this.selectedId,
        skillIndex = trigger.dataset.memberSkillIndex, inertTarget = base || this.el,
        wasInert = inertTarget.inert, overlay = document.createElement("div");
      if (standalone) {
        // Use the same presentation-only pause as ordinary menus. Never
        // toggle running, advance the VM, or save merely to read a skill.
        if (this.modalOpen || !this.playing || skillIndex === undefined) return;
        this.resetDialogueAuto();
        this.modalOpen = true;
        this.updateEventAdvanceButton();
        this.syncDialogueVoice();
        this.updateCupidTip();
        this.updateFamilyChatter();
        modalRoot.innerHTML = '<div class="modal-overlay" id="modal-overlay"></div>';
        this.skillHelpContext = { game, selectedId, skillIndex };
      }
      const host = $("modal-overlay");
      if (!host) return;
      overlay.className = "skill-help-overlay";
      overlay.innerHTML = '<section class="skill-help-card" role="dialog" aria-modal="true" aria-labelledby="skill-help-name" aria-describedby="skill-help-text">' +
        '<header><h3 id="skill-help-name">' + escape(skill.name) + '</h3><button type="button" class="close-button" aria-label="스킬 설명 닫기">×</button></header>' +
        '<p id="skill-help-text">' + escape(currencyText(skill.description || "이 스킬의 설명 자료가 없어요.")) + '</p></section>';
      inertTarget.inert = true;
      trigger.setAttribute("aria-expanded", "true");
      host.append(overlay);
      const button = overlay.querySelector("button"),
        keepFocus = e => {
          if (overlay.isConnected && !overlay.contains(e.target)) button.focus();
        },
        close = (returnFocus = true) => {
          document.removeEventListener("focusin", keepFocus, true);
          overlay.remove();
          inertTarget.inert = wasInert;
          trigger.setAttribute("aria-expanded", "false");
          this.skillHelpClose = null;
          this.skillHelpContext = null;
          if (standalone && host === $("modal-overlay")) {
            host.remove();
            this.modalOpen = false;
            this.syncMusic();
            this.updateCupidTip();
            this.syncDialogueVoice();
            this.updateEventAdvanceButton();
          }
          const replacement = standalone && this.game === game && this.selectedId === selectedId
            ? this.el.querySelector('[data-member-skill-index="' + skillIndex + '"]') : null,
            focus = trigger.isConnected ? trigger : replacement;
          replacement?.setAttribute("aria-expanded", "false");
          if (returnFocus && focus && !focus.disabled) focus.focus();
        };
      this.skillHelpClose = close;
      document.addEventListener("focusin", keepFocus, true);
      button.onclick = () => close();
      overlay.onclick = (e) => {
        e.stopPropagation();
        if (e.target === overlay) close();
      };
      overlay.onkeydown = (e) => {
        if (e.isComposing || e.keyCode === 229) return;
        if (e.key === "Escape") { e.preventDefault(); e.stopPropagation(); close(); }
        else if (e.key === "Tab") { e.preventDefault(); button.focus(); }
      };
      button.focus();
    }
    info(label, text) {
      return (
        '<div class="info-line"><label>' +
        escape(label) +
        "</label><span>" +
        escape(currencyText(text)) +
        "</span></div>"
      );
    }
    renameDialog(p, returnTo = null) {
      this.openModal(
        "이름 바꾸기",
        '<label class="form-label">' +
          escape(p.name) +
          '의 새 이름</label><input id="rename-input" class="input" maxlength="12" value="' +
          escape(p.name) +
          '"><div class="form-actions"><button id="rename-save" class="btn">이름 저장</button></div>',
      );
      this.button("rename-save", () => {
        const name = $("rename-input").value.trim();
        if (!name) {
          this.toast("이름을 입력해 주세요.");
          return;
        }
        if (typeof this.game.rename === "function")
          this.game.rename(p.id, name);
        else {
          this.toast("현재 포팅에서 이름 편집을 지원하지 않습니다.");
          return;
        }
        this.refresh();
        this.saveSlot("auto", true);
        this.detailDialog(this.state.members.find(member => member.id === p.id) || this.selected(), returnTo);
      });
    }
    treeDialog() {
      const a = this.state.members;
      const relation = (p) => {
        const f = v(p, "fatherId", -1),
          m = v(p, "motherId", -1),
          s = v(p, "spouseId", -1),
          find = (id) => (a.find((x) => x.id === id) || {}).name;
        return [
          f >= 0 ? "아버지 " + (find(f) || f) : "",
          m >= 0 ? "어머니 " + (find(m) || m) : "",
          s >= 0 ? "배우자 " + (find(s) || s) : "",
        ]
          .filter(Boolean)
          .join(" · ");
      };
      this.openModal(
        "가족의 계보",
        a
          .map(
            (p) =>
              '<button class="tree-card" style="width:100%;text-align:left;color:inherit" data-person="' +
              p.id +
              '"><img class="portrait" data-sex="' + (p.gender === 1 ? "female" : "male") + '" src="' +
              this.memberPortrait(p) +
              '" alt=""><div><strong>' +
              escape(p.name) +
              " " +
              (p.id === this.state.family.headId ? "♛" : "") +
              this.heirTag(p) +
              "</strong><p>" +
              escape(p.age) +
              "세 · " +
              escape(p.jobName || "") +
              (p.alive === false ? " · †" : "") +
              '</p><span class="tree-meta">' +
              escape(relation(p) || "가족 관계 정보 없음") +
              "</span></div></button>",
          )
          .join("") +
          '<p class="form-help">부부·부모 관계는 원작 가족 메모리의 실제 관계 정보를 사용합니다.</p>',
      );
      document
        .querySelectorAll("[data-person]")
        .forEach(
          (b) =>
            (b.onclick = () =>
              this.act(() =>
                this.detailDialog(
                  a.find((p) => p.id === Number(b.dataset.person)),
                ),
              )),
        );
    }
    logDialog(page = 0) {
      const entries = this.game.storyJournal().slice().reverse().sort((a, b) =>
        (Number.isInteger(b.date) ? b.date : -Infinity) - (Number.isInteger(a.date) ? a.date : -Infinity)),
        pages = Math.max(1, Math.ceil(entries.length / 3));
      page = mod(page, pages);
      this.openModal(
        "우리 가족의 이야기",
        entries.length ? '<p class="form-help">사건 ' + entries.length + '개 · ' + (page + 1) + '/' + pages + '</p>' +
          entries.slice(page * 3, page * 3 + 3).map(e => '<section class="log-entry journal-row"><div class="journal-row-copy">' +
            '<p class="form-help">' + escape(Number.isInteger(e.date) && e.date >= 0 ? SK.GameDate.Format(e.date) : '날짜 기록 없음') +
            (e.personName ? ' · ' + escape(e.personName) : '') + '</p><strong>' + escape(currencyText(e.title)) + '</strong>' +
            (!e.canReplay ? '<p class="form-help">다시 볼 대사가 남아 있지 않아요.</p>' : '') + '</div>' +
            '<button class="btn secondary small journal-row-replay" data-story-replay="' + escape(e.key) + '" ' +
            'aria-label="' + escape(currencyText(e.title)) + ' 다시보기" ' + (!e.canReplay ? 'disabled' : '') + '>다시보기</button></section>').join('') +
          (pages > 1 ? '<div class="button-row"><button id="journal-prev" class="btn secondary small">◀ 이전 기록</button>' +
            '<button id="journal-next" class="btn secondary small">다음 기록 ▶</button></div>' : '')
          : '<div class="empty">아직 기록된 사건이 없어요.<br>가족에게 사건이 생기면 날짜와 함께 남아요.</div>',
      );
      document.querySelectorAll('[data-story-replay]').forEach(b =>
        b.onclick = () => this.act(() => this.journalReplayDialog(b.dataset.storyReplay, 0, page)));
      this.button('journal-prev', () => this.logDialog(page - 1));
      this.button('journal-next', () => this.logDialog(page + 1));
    }
    journalReplayDialog(key, page = 0, listPage = 0, replay = null) {
      replay ||= this.game.storyReplay(key);
      if (!replay?.views?.length) return this.logDialog(listPage);
      page = clamp(page, 0, replay.views.length - 1);
      this.openModal(currencyText(replay.title),
        '<p class="form-help">' + escape(Number.isInteger(replay.date) && replay.date >= 0 ? SK.GameDate.Format(replay.date) : '날짜 기록 없음') +
        (replay.personName ? ' · ' + escape(replay.personName) : '') + '</p>' +
        (replay.origin !== 'captured' ? '<p class="form-help">기존 기록 복원 · 당시 모습이 남아 있지 않은 기록은 지금의 가족 정보로 보여줘요.</p>' : '') +
        '<div id="journal-replay-view"><div class="scene-shell" style="width:100%;border-radius:8px;overflow:hidden"><canvas id="journal-replay-canvas" class="house-canvas" width="240" height="160" style="cursor:default"></canvas>' +
        '<div id="journal-scene-title" class="event-scene-title" hidden><span></span></div><div id="journal-replay-dialogue"></div></div></div>' +
        '<p id="journal-replay-status" class="form-help" aria-live="polite">장면 준비 중…</p>' +
        '<div class="button-row"><button id="journal-replay-prev" class="btn secondary small">이전</button>' +
        '<button id="journal-replay-toggle" class="btn secondary small">일시정지</button>' +
        '<button id="journal-replay-next" class="btn small">다음</button></div>' +
        '<div class="button-row" style="margin-top:8px"><button id="journal-replay-restart" class="btn secondary small">처음부터</button>' +
        '<button id="journal-replay-back" class="btn secondary small">기록 목록</button></div>');
      const playback = this.journalPlayback = { key, replay, page, listPage,
        elapsed: 0, pageStart: 0, last: 0, playing: true, active: true,
        released: false, ready: false, revision: 0,
        audioSong: this.journalReplaySong(replay), audioOffset: 0, audioMusicActive: false, voiceKey: null };
      this.button('journal-replay-prev', () => this.setJournalReplayPage(playback, playback.page - 1, true));
      this.button('journal-replay-next', () => this.setJournalReplayPage(playback, playback.page + 1));
      this.button('journal-replay-toggle', () => {
        playback.playing = !playback.playing; playback.last = 0;
        if (playback.playing) this.syncJournalReplayAudio(playback);
        else this.stopJournalReplayAudio(playback);
        this.updateJournalReplayStatus(playback);
      });
      this.button('journal-replay-restart', () => this.setJournalReplayPage(playback, 0, true));
      this.button('journal-replay-back', () => this.logDialog(listPage));
      void this.paintJournalReplay($('journal-replay-canvas'), replay.views[page], replay, playback);
    }
    stopJournalReplay() {
      const playback = this.journalPlayback;
      if (!playback) return;
      this.stopJournalReplayAudio(playback);
      playback.active = false;
      cancelAnimationFrame(playback.raf);
      this.journalPlayback = null;
    }
    journalReplaySong(replay) {
      // Same cartridge metadata as OrigSession.SceneMusic. Reading the ROM
      // is sufficient: no VM, native scene execution or scratch-memory write.
      const record = Number(replay.record), memory = this.game?.session?.Game?.Mem;
      if (memory && Number.isInteger(record) && record >= 0x08000000 && record < 0x0a000000 - 0x30) {
        const pointer = memory.R32(record + 0x2c);
        if (pointer >= 0x08000000 && pointer < 0x0a000000 - 4) {
          const song = memory.R32(pointer);
          if (song >= 41 && song <= 63) return song;
        }
      }
      const family = this.state.family;
      return 81 - 3 * clamp(family.grade & 15, 0, 3) + 12 * clamp(family.era, 0, 3);
    }
    stopJournalReplayAudio(playback, restart = false) {
      if (playback !== this.journalPlayback) return;
      if (playback.audioMusicActive) {
        const audio = this.sound.diagnostics;
        if (Number(audio.currentId) === playback.audioSong && audio.startTime !== null)
          playback.audioOffset = (audio.scheduledStartAt || 0) +
            Math.max(0, (this.sound.context?.currentTime || 0) - audio.startTime);
      }
      this.sound.stopEffects();
      this.sound.stopBgm(0);
      playback.audioMusicActive = false;
      if (restart) playback.audioOffset = 0;
    }
    syncJournalReplayAudio(playback) {
      if (playback !== this.journalPlayback || !playback.active) return;
      if (document.hidden || !playback.playing) {
        if (playback.audioMusicActive || this.voice.diagnostics.active || this.voice.diagnostics.pending)
          this.stopJournalReplayAudio(playback);
        return;
      }
      if (!playback.ready) return;
      if (!playback.audioMusicActive) {
        playback.audioMusicActive = true;
        void this.sound.playBgm(playback.audioSong, { startAt: playback.audioOffset, fadeOut: 0 });
      }
      if (!playback.released) return;
      const view = playback.replay.views[playback.page], key = playback.revision + ':' + playback.page;
      if (playback.voiceKey === key) return;
      // Muted/disabled dialogue is consumed, never queued for a later page.
      playback.voiceKey = key;
      if (!this.voice.enabled) return;
      const actors = view.actors || view.scene?.actors || [],
        speaker = view.speaker === '큐피트' ? 'cupid' : view.speaker === '높으신 신' ? 'god' :
          actors.find(actor => actor.name === view.speaker) ||
          (playback.replay.subject?.name === view.speaker ? playback.replay.subject : view.speaker);
      void this.voice.speak(currencyText(view.text || ''), speaker);
    }
    updateJournalReplayStatus(playback) {
      if (playback !== this.journalPlayback) return;
      const done = playback.page === playback.replay.views.length - 1 && playback.finished;
      $('journal-replay-status').textContent = (playback.page + 1) + '/' + playback.replay.views.length +
        (done ? ' · 재생 완료' : playback.playing ? ' · 자동 재생' : ' · 일시정지');
      $('journal-replay-toggle').textContent = playback.playing ? '일시정지' : '재생';
      $('journal-replay-prev').disabled = playback.page === 0;
      $('journal-replay-next').disabled = playback.page === playback.replay.views.length - 1;
    }
    setJournalReplayPage(playback, page, restart = false) {
      if (playback !== this.journalPlayback || !playback.active) return;
      if (restart) this.stopJournalReplayAudio(playback, true);
      else this.sound.stopEffects();
      const previous = playback.replay.views[playback.page],
        view = playback.replay.views[clamp(page, 0, playback.replay.views.length - 1)];
      playback.page = clamp(page, 0, playback.replay.views.length - 1);
      if (restart) {
        playback.elapsed = 0;
        playback.presentation.eventKey = '';
        playback.presentation.eventOccurrence = null;
        playback.presentation.eventReplayClock.emotion.clear();
        playback.presentation.eventReplayClock.zoom.clear();
      } else if (JSON.stringify(previous.scene) !== JSON.stringify(view.scene) &&
          (previous.scene?.pic !== view.scene?.pic || previous.scene?.back !== view.scene?.back)) {
        playback.presentation.eventKey = '';
        playback.presentation.eventOccurrence = null;
      }
      playback.pageStart = playback.elapsed; playback.last = 0;
      playback.released = false; playback.ready = false; playback.finished = false;
      playback.playing = true; playback.revision++;
      playback.presentation.state.event = view;
      $('journal-replay-dialogue').innerHTML = '';
      this.updateJournalReplayStatus(playback);
    }
    async paintJournalReplay(canvas, view, replay, playback) {
      // A detached presentation object and native scene clock. There is no
      // live event advance, VM, RNG, reward, inventory or save call in playback.
      const presentation = Object.create(this);
      presentation.el = $('journal-replay-view');
      presentation.art = Object.create(this.art);
      presentation.state = { ...this.state, family: { ...this.state.family },
        event: view, members: replay.subject ? [replay.subject] : [] };
      presentation.game = { session: { cur: { Data: replay.record }, replaying: true } };
      presentation.eventKey = ''; presentation.eventOccurrence = null; presentation.eventArt = null;
      presentation.eventReplayClock = { emotion: new Map(), zoom: new Map() };
      playback.presentation = presentation;
      presentation.renderEventTitle = (text, y, visible) => {
        const label = canvas.parentElement.querySelector('#journal-scene-title');
        if (!label) return;
        label.hidden = !visible; label.firstElementChild.textContent = currencyText(text);
        const scale = canvas.getBoundingClientRect().width / 240;
        label.style.top = y / 160 * 100 + '%';
        label.style.height = label.style.lineHeight = 30 * scale + 'px';
        label.style.fontSize = 12 * scale + 'px';
        label.firstElementChild.style.transform = 'scaleX(' +
          Math.min(1, (label.clientWidth - 2) / Math.max(1, label.firstElementChild.scrollWidth)) + ')';
      };
      presentation.selected = () => replay.subject;
      const context = canvas.getContext('2d'); context.imageSmoothingEnabled = false;
      const frame = (t) => {
        if (!playback.active || playback !== this.journalPlayback || !canvas.isConnected) return;
        try {
          if (document.hidden) playback.last = 0;
          else {
            const ready = presentation.prepareEventArt(presentation.state.event);
            if (ready && playback.playing && playback.last)
              playback.elapsed += clamp(t - playback.last, 0, 100);
            playback.last = ready ? t : 0;
            if (ready) {
              playback.ready = true;
              presentation.renderEventScene(context, playback.elapsed);
              const nativeFrame = Math.floor((playback.elapsed - presentation.eventStart) * .06),
                view = presentation.state.event;
              canvas.dataset.ready = '1'; canvas.dataset.frame = String(nativeFrame);
              canvas.dataset.page = String(playback.page); canvas.dataset.revision = String(playback.revision);
              if (!playback.released && (!view.scene?.pic || nativeFrame >= 156)) {
                playback.released = true; playback.pageStart = playback.elapsed;
                $('journal-replay-dialogue').innerHTML = presentation.dialogueHtml({ ...view, choices: [], canAdvance: true }, false)
                  .replace('id="event-next"', 'id="journal-dialogue-next"');
                $('journal-dialogue-next').onclick = () => this.act(() => {
                  if (playback.page < replay.views.length - 1) this.setJournalReplayPage(playback, playback.page + 1);
                });
                presentation.updateSceneDialog();
                this.updateJournalReplayStatus(playback);
              }
              if (playback.released) presentation.updateSceneDialog();
              this.syncJournalReplayAudio(playback);
              // Original dialogue was reader-driven, so use a readable web
              // autoplay hold; manual next/previous/pause remain available.
              const hold = Math.max(3000, Math.min(16000, currencyText(view.text || '').length * 85));
              if (playback.playing && playback.released && playback.elapsed - playback.pageStart >= hold &&
                  !(this.voice.enabled && (this.voice.diagnostics.active || this.voice.diagnostics.pending))) {
                if (playback.page < replay.views.length - 1) this.setJournalReplayPage(playback, playback.page + 1);
                else {
                  playback.finished = true; playback.playing = false;
                  this.stopJournalReplayAudio(playback);
                  this.updateJournalReplayStatus(playback);
                }
              }
            }
          }
        } catch (error) {
          playback.playing = false;
          this.stopJournalReplayAudio(playback);
          $('journal-replay-status').textContent = '장면을 재생하지 못했어요. 기록 목록에서 다시 열어 주세요.';
          console.error(error);
        }
        playback.raf = requestAnimationFrame(frame);
      };
      playback.raf = requestAnimationFrame(frame);
    }
    toolsDialog(kind) {
      const game = this.game, p = this.selected();
      const map = kind === "arrow" ? this.state.arrows : this.state.items,
        list = (SK.Interventions && SK.Interventions.Tools) || [],
        rows = Object.entries(map || {})
          .filter(([id, n]) => Number(n) > 0)
          .map(([id, n]) => {
            const def = list.find((x) => v(x, "id", "") === id) || {},
              label = v(def, "name", id),
              desc = TOOL_DESCRIPTIONS[id] || v(def, "desc", ""),
              icon = this.art.toolIcon(id);
            return (
              '<button class="inventory-tool" data-tool="' +
              escape(id) +
              '" ' +
              (!p || this.state.paused || this.state.event ? "disabled" : "") +
              '>' + (icon ? '<img class="inventory-tool-icon" src="' + escape(icon) +
                '" width="48" height="32" alt="" aria-hidden="true" data-native-tool-icon="' + escape(id) + '">' : '') +
              '<div class="inventory-tool-copy"><strong>' +
              escape(label) +
              "</strong><p>" +
              escape(desc) +
              '</p></div><span class="count">× ' +
              n +
              "</span></button>"
            );
          })
          .join("");
      this.openModal(
        (kind === "arrow" ? "화살" : "아이템") + " · 공용 보관함",
        '<p class="inventory-target">' +
          (p ? '사용 대상 · <strong class="inventory-target-name">' + escape(p.name) + '</strong>' :
            '사용하려면 가족 중 한 사람을 선택해 주세요.') + '</p>' + (rows ||
          '<div class="empty">가진 ' +
            (kind === "arrow" ? "화살" : "아이템") +
            "이 없어요.</div>"),
      );
      document.querySelectorAll("[data-tool]").forEach(
        (b) =>
          (b.onclick = () =>
            this.act(() => {
              if (!p || game !== this.game || !b.isConnected) return;
              const id = b.dataset.tool;
              if (id === "item.heart_crystal" || id === "arrow.legacy") {
                this.legacyToolDialog(id, p.id); return;
              }
              const beforeItem = kind === "item" ? JSON.parse(JSON.stringify(p)) : null,
                result =
                  kind === "arrow"
                    ? this.game.shoot(p.id, id)
                    : this.game.useItem(p.id, id);
              this.finishToolUse(kind, id, p, beforeItem, result);
            })),
      );
    }
    legacyToolDialog(id, targetId) {
      const game = this.game, p = this.state.members.find(member => member.id === targetId),
        heart = id === "item.heart_crystal", kind = heart ? "item" : "arrow";
      if (!p || !["item.heart_crystal", "arrow.legacy"].includes(id)) return;
      const rows = game.legacyOptions(id), icon = this.art.toolIcon(id),
        title = heart ? "선대의 마음" : "선대의 꿈";
      this.openModal(title + " 이어받기",
        '<p class="inventory-target">사용 대상 · <strong>' + escape(p.name) + '</strong></p>' +
        '<p class="form-help">' + (heart ? "이어받을 선대의 스킬을 골라 주세요." : "이어받을 선대의 꿈을 골라 주세요.") + '</p>' +
        '<div id="legacy-tool-options">' + (rows.map(row =>
          '<button type="button" class="inventory-tool legacy-tool-choice" data-legacy-index="' + row.index + '">' +
          (icon ? '<img class="inventory-tool-icon" src="' + escape(icon) + '" alt="" aria-hidden="true" width="48" height="32">' : '') +
          '<div class="inventory-tool-copy"><span class="legacy-ancestor">' + escape(row.ancestorName) + '</span><strong>' +
          escape(row.name) + '</strong><p>' + escape(row.description) + '</p></div></button>').join("") ||
          '<div class="empty">' + (heart ? "이어받을 선대의 마음이 없습니다." : "이어받을 선대의 꿈이 없습니다.") + '</div>') +
        '</div><p id="legacy-tool-error" class="legacy-tool-error" role="status" aria-live="polite"></p>' +
        '<div class="button-row"><button id="legacy-tool-back" class="btn secondary">보관함으로</button><button id="legacy-tool-cancel" class="btn ghost">취소</button></div>');
      const owner = $("legacy-tool-options"), live = () => this.game === game && this.modalOpen && owner.isConnected &&
        this.selectedId === targetId && !this.state.paused && !this.state.event;
      let busy = false;
      owner.querySelectorAll("[data-legacy-index]").forEach(button => {
        const row = rows[Number(button.dataset.legacyIndex)];
        button.onclick = () => this.act(() => {
          if (busy || !live()) return;
          busy = true;
          const before = heart ? JSON.parse(JSON.stringify(p)) : null,
            result = game.useLegacy(targetId, id, row.index, row);
          if (!result.ok) {
            $("legacy-tool-error").textContent = result.message || "지금은 이어받을 수 없습니다.";
            busy = false; return;
          }
          this.finishToolUse(kind, id, p, before, result);
        });
      });
      this.button("legacy-tool-back", () => { if (live()) this.toolsDialog(kind); });
      this.button("legacy-tool-cancel", () => this.closeModal());
    }
    finishToolUse(kind, id, p, beforeItem, result) {
      this.closeModal();
      this.refresh();
      const fx = kind === "arrow" && result?.ok && !this.state.event &&
        this.actors.has(p.id) && this.arrowFx.play(p.id, id === "arrow.calm");
      if (fx) {
        this.arrowTintFor(p).pending = true;
        this.actors.get(p.id).tintPending = true;
        this.selectedId = p.id;
        this.focusHousePerson();
        this.voice.stop();
        this.updateCupidTip();
        this.updateFamilyChatter();
      } else if (!(kind === "item" && result?.ok && this.itemFeedback.open(id, beforeItem,
        this.state.members.find(member => member.id === p.id)))) this.toast(
        result?.message || (result?.ok ? "사용했습니다." : "사용하지 못했습니다."),
      );
      if (result?.ok) this.saveSlot("auto", true);
    }
    settingsDialog() {
      this.openModal(
        "설정",
        '<div class="setting-row"><label>하루 자동 진행</label><input id="setting-run" type="checkbox" ' +
          (this.running ? "checked" : "") +
          '></div><div class="setting-row"><label>선택한 가족 따라가기</label><input id="setting-follow" type="checkbox" ' +
          (this.follow ? "checked" : "") +
          '></div><p class="form-help">원본과 같은 하루 약 88초. 배속 버튼을 누를 때마다 ON/OFF가 바뀌며, ON이면 시간과 가족의 걷기·걸음 동작이 약 6.5배 빨라집니다. 멈춤·사건·메뉴에서는 진행을 멈춥니다.</p><div class="form-actions"><button id="settings-save" class="btn secondary">저장 / 불러오기</button><button id="settings-title" class="btn ghost">타이틀로 돌아가기</button></div>',
      );
      $("modal-root").querySelector(".modal-body").insertAdjacentHTML("afterbegin", this.audioControls());
      this.bindAudioControls();
      $("setting-run").onchange = (e) => {
        this.running = e.target.checked;
        this.persistSettings();
        this.renderGame();
      };
      $("setting-follow").onchange = (e) => {
        this.follow = e.target.checked;
        if (this.follow) this.focusHousePerson();
        this.persistSettings();
      };
      this.button("settings-save", () => this.saveDialog());
      this.button("settings-title", () => this.requestSaveAndExit());
    }
    aboutDialog() {
      this.openModal(
        "천년가족 · 브라우저 에디션",
        '<p>제공된 Unity 소스의 원작 규칙·트리 실행기·가족 상태와 픽셀 자료를 JavaScript/Canvas로 옮긴 비공식 브라우저 버전입니다.</p><p>타이틀·가족 입력·집·사건·천계 보고에 원작 음악을 연결하고, 버튼에는 원작 효과음을 사용합니다. 음량은 설정에서 각각 바꿀 수 있어요.</p><div class="warning">원본 Unity 게임과 모든 연출·기능이 완전히 같은 것은 아닙니다. 오프닝 동영상, 기기별 백그라운드 진행, 콘텐츠 서버 업데이트와 일부 세부 설정 화면은 제공하지 않습니다. 집 인물 행동 효과음과 대사 글자 소리는 받은 소스에도 미구현입니다.</div><p class="form-help">저장은 같은 브라우저와 파일 경로에서 유지됩니다. 브라우저의 파일 저장 정책에 따라 자동 저장이 제한될 수 있으니 중요한 가족은 JSON으로 내보내 주세요. 이 화면은 어디에도 업로드하지 않습니다.</p>',
      );
    }
    requestSaveAndExit() {
      if (!this.playing || !this.game || this.introFlow || this.introLoading || this.arrowFx.active ||
          this.exitConfirmationReturnId) return false;
      this.exitConfirmationReturnId = this.modalOpen ? "settings" : "save-exit";
      this.openModal("저장 후 종료",
        '<p id="exit-confirm-message">현재 상태를 저장하고 종료할까요?</p><div class="form-actions"><button id="exit-confirm-yes" class="btn">예</button><button id="exit-confirm-no" class="btn secondary">아니오</button></div>',
        "exit-confirm-no");
      this.button("exit-confirm-yes", () => this.saveAndExit());
      this.button("exit-confirm-no", () => this.closeModal());
      const dialog = $("modal-root").querySelector(".modal");
      dialog.setAttribute("aria-describedby", "exit-confirm-message");
      // Keep keyboard navigation inside this confirmation, with the safe
      // cancellation action initially focused. Existing modal close paths
      // (Escape, backdrop and X) all cancel without recording an exit.
      dialog.onkeydown = (e) => {
        if (e.key !== "Tab") return;
        const buttons = [...dialog.querySelectorAll("button:not([disabled])")],
          first = buttons[0], last = buttons[buttons.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault(); last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault(); first.focus();
        }
      };
      return true;
    }
    saveAndExit() {
      if (!this.playing || !this.game || this.introFlow || this.introLoading || this.arrowFx.active) return false;
      if (this.offlineReturnBlocked) {
        this.applyOfflineReturn();
        if (this.offlineReturnBlocked) return false;
      }
      const now = Date.now(), candidate = SK.restoreGame(this.game.save()),
        anchor = { version: 1, atMs: now, reason: "exit" };
      candidate.recordOffline(now);
      // Commit the candidate before replacing the live session. A denied or
      // full browser store must not spend live RNG or take the user to title.
      if (!this.saveSlot("auto", true, { game: candidate, anchor, nowMs: now })) {
        this.toast("저장을 완료하지 못해 종료하지 않았어요. 저장 내보내기를 사용해 주세요.");
        return false;
      }
      this.game = candidate;
      this.state = candidate.state();
      this.offlineGame = candidate;
      this.offlineAnchor = anchor;
      this.offlineBackground = false;
      this.showTitle();
      this.toast("저장했어요. 이제 브라우저를 닫아도 괜찮아요.");
      return true;
    }
    suspendOffline(reason = "hidden") {
      if (!this.playing || !this.game || this.introFlow || this.introLoading || this.offlineBackground) return;
      this.saveSlot("auto", true, this.offlineReturnBlocked ? { preserveAnchor: true }
        : { anchor: { version: 1, atMs: Date.now(), reason } });
      // Even when the last write fails, retain the last successful anchor.
      // pagehide/beforeunload after visibilitychange must not rebase it again.
      this.offlineBackground = true;
      this.lastFrame = 0;
    }
    resumeOffline() {
      if (!this.playing || !this.offlineBackground || !this.game || document.hidden) return;
      this.offlineBackground = false;
      this.lastFrame = 0;
      // A still-live page was only paused while minimized. Actual reopening
      // restores the hidden checkpoint through restoreEnvelope instead.
      if (this.offlineReturnBlocked) {
        this.saveSlot("auto", true, { preserveAnchor: true });
      } else {
        const now = Date.now(), anchor = { version: 1, atMs: now, reason: "checkpoint" };
        // Keep the live anchor fresh even if storage is denied, so this
        // page cannot later mistake the minimized interval for an absence.
        this.offlineAnchor = anchor;
        this.offlineGame = this.game;
        this.saveSlot("auto", true, { anchor, nowMs: now });
      }
      this.refresh();
      this.maybeOfflineHistory();
    }
    applyOfflineReturn(now = Date.now()) {
      const anchor = this.offlineAnchor;
      if (!anchor || !this.game?.queueOfflineElapsed || now - anchor.atMs < 8000) return false;
      const previous = this.game, candidate = SK.restoreGame(previous.save());
      candidate.queueOfflineElapsed(anchor.atMs, now);
      const status = candidate.offlineStatus(), through = Number(status.throughMs);
      if (!Number.isFinite(through) || through < anchor.atMs) return false;
      const nextAnchor = { version: 1, atMs: through, reason: "checkpoint" };
      // Native Begin is performed on a private candidate. The resulting
      // memo/pending-window snapshot and consumed interval are one save.
      if (!this.saveSlot("auto", true, { game: candidate, anchor: nextAnchor, nowMs: now })) {
        this.offlineReturnBlocked = true;
        this.toast("부재중 진행을 저장하지 못해 적용을 보류했어요. 저장 공간을 확인하거나 내보내 주세요.");
        return false;
      }
      this.game = candidate;
      this.offlineGame = candidate;
      this.offlineAnchor = nextAnchor;
      this.offlineReturnBlocked = false;
      this.state = candidate.state();
      return true;
    }
    maybeOfflineHistory() {
      const status = this.game?.offlineStatus?.();
      // Completed batches are already committed outcomes. A later native
      // event or queued absence must not hide that unread report. Conversely,
      // pending-only windows have no report yet and never enter this path.
      if (!this.playing || !status?.completed?.length || this.modalOpen ||
          this.offlineBackground || this.offlineReturnBlocked || document.hidden) return;
      this.showOfflineHistory(status.completed.map(batch => batch.id));
    }
    historyImportanceControls(prefix) {
      const importantOnly = this.historyImportantOnly === true;
      return '<div class="history-importance-controls" role="group" aria-label="사건 보기">' +
        ['all', 'important'].map(mode => '<button type="button" id="' + prefix + '-scope-' + mode +
          '" class="history-importance-button" aria-pressed="' + ((mode === 'important') === importantOnly) + '">' +
          (mode === 'important' ? '중요한 사건만' : '전체') + '</button>').join('') + '</div>';
    }
    bindHistoryImportanceControls(prefix, render) {
      for (const mode of ['all', 'important']) {
        this.button(prefix + '-scope-' + mode, () => {
          const importantOnly = mode === 'important';
          if ((this.historyImportantOnly === true) === importantOnly) return;
          this.historyImportantOnly = importantOnly;
          render(prefix + '-scope-' + mode);
        });
      }
    }
    showOfflineHistory(batchIds, focusId = null) {
      const status = this.game.offlineStatus(), ids = new Set(batchIds || status.completed.map(batch => batch.id)),
        batches = status.completed.filter(batch => ids.has(batch.id)),
        keys = new Set(batches.flatMap(batch => batch.historyKeys || [])),
        entries = this.game.storyJournal().filter(entry => keys.has(entry.key)).sort((a, b) => a.date - b.date),
        days = batches.reduce((total, batch) => total + (batch.appliedDays ?? batch.days), 0),
        text = this.game.session.Text,
        importantOnly = this.historyImportantOnly === true,
        visible = importantOnly ? entries.filter(entry => SK.HistoryPresentation.classify(entry, text).important) : entries;
      this.offlineSummaryIds = batches.map(batch => batch.id);
      this.offlineReplayReturn = null;
      this.openModal("부재중 가족의 역사",
        '<div id="offline-history-summary">' + this.historyImportanceControls('offline-history') +
        '<p class="form-help offline-history-summary-count">부재중 ' + escape(days) + '일 · 사건 ' + entries.length + '개' +
        (importantOnly ? ' · 중요 ' + visible.length + '개 표시' : '') + '</p>' +
        visible.map(entry => {
          const kind = SK.HistoryPresentation.classify(entry, text);
          const dated = Number.isInteger(entry.date) && entry.date >= 0,
            year = dated ? SK.GameDate.Year(entry.date) : NaN,
            month = dated ? SK.GameDate.Month(entry.date) : NaN,
            day = dated ? SK.GameDate.Day(entry.date) : NaN,
            dateLabel = [year, month, day].every(Number.isFinite)
              ? [year % 100, month, day].map(n => String(n).padStart(2, "0")).join("") : "",
            fullDate = dateLabel ? SK.GameDate.Format(entry.date) : "날짜 기록 없음";
          return '<section class="offline-history-row' + (['red', 'blue'].includes(kind.colorTone) ? ' is-native-' + kind.colorTone : '') + '"><div class="offline-history-copy">' +
            '<strong class="offline-history-title">' + escape(currencyText(entry.title)) + '</strong>' +
            '<span class="offline-history-meta">' + (entry.personName ? '<span class="offline-history-person">' + escape(entry.personName) + '</span>' : '') +
            '<span class="offline-history-date" title="' + escape(fullDate) + '" aria-label="' + escape(fullDate) + '">' + (dateLabel || '—') + '</span></span></div>' +
            '<button class="btn secondary small" data-offline-replay="' + escape(entry.key) + '" aria-label="' + escape(currencyText(entry.title)) +
            ' 다시보기"' + (!entry.canReplay ? ' disabled' : '') + '>다시보기</button></section>';
        }).join('') + (visible.length ? '' : '<p class="empty">' +
          (importantOnly ? '중요한 사건이 없어요. 전체를 누르면 나머지 기록도 볼 수 있어요.' : '이 기간에는 따로 기록된 사건이 없었어요.') + '</p>') +
        '<div class="form-actions"><button id="offline-history-done" class="btn">가족 지켜보기</button></div></div>', focusId);
      this.offlineSummaryOpen = true;
      this.bindHistoryImportanceControls('offline-history', nextFocus => this.showOfflineHistory(this.offlineSummaryIds, nextFocus));
      this.button("offline-history-done", () => this.closeModal());
      document.querySelectorAll("[data-offline-replay]:not(:disabled)").forEach(button => {
        button.onclick = () => this.act(() => {
          const returnIds = this.offlineSummaryIds.slice();
          this.offlineSummaryOpen = false;
          this.offlineReplayReturn = returnIds;
          this.journalReplayDialog(button.dataset.offlineReplay);
          this.offlineReplayReturn = returnIds;
          this.button("journal-replay-back", () => this.showOfflineHistory(returnIds));
        });
      });
    }
    envelope(options = {}) {
      const game = options.game || this.game, family = game.session.Family,
        f = {name:family.Name,year:SK.GameDate.Year(family.Today),
          month:SK.GameDate.Month(family.Today),day:SK.GameDate.Day(family.Today)},
        now = Number.isFinite(options.nowMs) ? options.nowMs : Date.now(),
        anchor = options.anchor || (options.preserveAnchor || this.offlineReturnBlocked || !this.playing
          ? this.offlineAnchor : null) || { version: 1, atMs: now, reason: "checkpoint" };
      return {
        format: "sennen-kazoku-web-save",
        version: 1,
        savedAt: new Date(now).toISOString(),
        label: { name: f.name, year: f.year, month: f.month, day: f.day },
        ui: { selectedId: this.selectedId, dayFraction: this.dayFraction,
          interestCard: this.savedInterestCard(game), cameraZoom: this.cameraZoomRatio(this.cameraZoom) },
        data: game.save(),
        offlineAnchor: { version: 1, atMs: anchor.atMs, reason: anchor.reason },
      };
    }
    saveSlot(key, quiet = false, options = {}) {
      if (!this.game || (!this.state && !options.game)) return false;
      if (this.introLoading || this.introFlow || this.ownWizard ||
          this.recommendedReview || this.introRecommendedStaged) return false;
      this.offlineCheckpointAt = Date.now();
      try {
        const previousStored = {}, previous = storeGet(key, previousStored);
        if (previous) {
          try {
            if (!previousStored.validated) JSON.parse(previous);
            // The prior slot was just decoded and validated, or its exact
            // bytes match our last successfully written validated envelope. Preserve its
            // exact lossless encoded bytes instead of compressing it again
            // on every dialogue tap. Legacy JSON/memory fallback keeps the
            // existing normal encoding path and corruption never replaces
            // the last valid backup.
            const encodedBackup = SK.SaveStorageCodec?.isEncoded(previousStored.raw)
              ? previousStored.raw : undefined;
            storeSet(key + ":backup", previous, encodedBackup, true);
          } catch (_) {}
        }
        const envelope = this.envelope(options), ok = storeSet(key, JSON.stringify(envelope), undefined, true);
        if (ok && (!options.game || options.game === this.game)) {
          this.offlineAnchor = envelope.offlineAnchor;
          this.offlineGame = this.game;
          this.offlineCheckpointAt = Date.now();
        }
        if (!ok && !this.storageWarned) {
          this.storageWarned = true;
          this.toast(
            "브라우저 저장이 제한돼 임시로만 보관합니다. JSON 내보내기를 사용해 주세요.",
          );
        } else if (!quiet) this.toast("슬롯에 저장했어요.");
        const status = $("save-status");
        if (status)
          status.textContent = ok
            ? "✓ 자동 저장됨"
            : "임시 저장 · 내보내기 권장";
        return ok;
      } catch (e) {
        this.toast("저장하지 못했어요: " + e.message);
        return false;
      }
    }
    loadSlot(key) {
      let s;
      try {
        s = parseSlot(key);
        if (!s) throw new Error("저장이 없습니다.");
        this.restoreEnvelope(s);
      } catch (e) {
        const primary = e;
        try {
          s = parseSlot(key, true);
          if (!s) throw primary;
          this.restoreEnvelope(s);
          this.toast("이전 정상 백업으로 복구했어요.");
        } catch (_) {
          throw new Error("저장 파일을 불러오지 못했어요: " + primary.message);
        }
      }
    }
    restoreEnvelope(s) {
      if (s.format !== "sennen-kazoku-web-save" || s.version !== 1 || !s.data)
        throw new Error("지원하지 않는 저장 형식입니다.");
      const game = SK.restoreGame(s.data);
      this.ownWizard = null;
      this.recommendedReview = null;
      this.introRecommendedStaged = false;
      this.introFlow?.cancel();
      this.introFlow = null;
      this.introLoading = false;
      this.introToken++;
      this.game = game;
      this.state = game.state();
      this.restoreInterestCard(game, s.ui?.interestCard);
      this.offlineGame = game;
      this.offlineAnchor = s.offlineAnchor?.version === 1 &&
        Number.isFinite(s.offlineAnchor.atMs) && s.offlineAnchor.atMs > 0
        ? { version: 1, atMs: s.offlineAnchor.atMs, reason: s.offlineAnchor.reason || "checkpoint" } : null;
      this.offlineSummaryOpen = false;
      this.offlineReplayReturn = null;
      this.offlineReturnBlocked = false;
      this.selectedId = s.ui && s.ui.selectedId;
      this.dayFraction = clamp(Number(s.ui && s.ui.dayFraction) || 0, 0, 1);
      this.actors.clear();
      this.fast = false;
      this.fastTier = 0;
      this.cameraZoom = this.cameraZoomRatio(s.ui?.cameraZoom, this.cameraZoomRatio(this.cameraZoom));
      this.actorTime = 0;
      this.closeModal();
      this.applyOfflineReturn();
      this.enterGame();
      this.maybeOfflineHistory();
    }
    saveDialog() {
      const rows = ["auto", "1", "2", "3"]
        .map((key) => {
          const s = slotInfo(key),
            snapshot = manualSlotSnapshot(key),
            occupied = snapshot?.some((entry) => !entry.readable || entry.raw !== null || entry.cached),
            l = s && s.label,
            desc = !s
              ? occupied
                ? snapshot.some((entry) => !entry.readable) ? "저장 확인 불가" : "저장 데이터 있음"
                : "비어 있음"
              : s.corrupt
                ? "손상된 저장"
                : l
                  ? this.familyTitle(l.name) +
                    " · " +
                    l.year +
                    ". " +
                    l.month +
                    ". " +
                    l.day +
                    (s.recovered ? " · 백업 복구 가능" : "")
                  : "저장됨";
          return (
            '<section class="slot' + (key === "auto" ? ' slot-auto' : '') + '" data-slot="' + key + '"><h3>' +
            (key === "auto" ? "자동 저장" : "슬롯 " + key) +
            "</h3><p>" +
            escape(desc) +
            '</p><div class="button-row slot-actions' + (key === "auto" ? ' slot-auto-actions' : '') + '"><button class="btn secondary small" data-save="' +
            key +
            '" aria-label="' +
            (key === "auto" ? "자동 저장" : "슬롯 " + key + "에 저장") +
            '" ' +
            (!this.game || key === "auto" ? "disabled" : "") +
            '>저장</button><button class="btn small" data-load="' +
            key +
            '" aria-label="' +
            (key === "auto" ? "자동 저장 불러오기" : "슬롯 " + key + " 불러오기") +
            '" ' +
            (!s || s.corrupt ? "disabled" : "") +
            ">불러오기</button>" +
            (key === "auto" ? "" : '<button class="slot-delete btn secondary small" data-delete="' + key +
              '" aria-label="슬롯 ' + key + ' 삭제" ' + (!occupied ? "disabled" : "") + '>삭제</button>') +
            "</div></section>"
          );
        })
        .join("");
      this.openModal(
        "저장 / 불러오기",
        rows +
          '<div class="button-row"><button id="export-save" class="btn secondary small" ' +
          (!this.game ? "disabled" : "") +
          '>JSON 내보내기 ↓</button><button id="import-save" class="btn secondary small">JSON 가져오기 ↑</button></div><input id="import-file" class="file-input" type="file" accept=".json,application/json"><p class="form-help">덮어쓰기 전 마지막 정상 저장을 백업합니다. 저장 파일을 내보내면 브라우저나 기기를 바꿔도 이어 할 수 있어요.</p>',
      );
      document.querySelectorAll("[data-save]").forEach(
        (b) =>
          (b.onclick = () =>
            this.act(() => {
              this.saveSlot(b.dataset.save);
              this.saveDialog();
            })),
      );
      document
        .querySelectorAll("[data-load]")
        .forEach(
          (b) =>
            (b.onclick = () => this.act(() => this.loadSlot(b.dataset.load))),
        );
      $("modal-root").querySelectorAll("[data-delete]").forEach((b) => {
        b.onclick = () => {
          if (!b.disabled && b.isConnected && $("modal-root").contains(b))
            this.requestSlotDelete(b.dataset.delete);
        };
      });
      this.button("export-save", () => this.exportSave());
      this.button("import-save", () => $("import-file").click());
      $("import-file").onchange = (e) => this.importSave(e.target.files[0]);
    }
    requestSlotDelete(key) {
      const snapshot = manualSlotSnapshot(key);
      if (!snapshot || !snapshot.some((entry) => !entry.readable || entry.raw !== null || entry.cached)) return false;
      this.openModal("슬롯 " + key + " 삭제",
        '<p id="slot-delete-message">슬롯 ' + key + '을 삭제할까요?</p><p class="form-help">이 슬롯의 저장과 백업을 함께 삭제합니다. 현재 가족과 자동 저장은 그대로 유지돼요.</p><div class="form-actions"><button id="slot-delete-cancel" class="btn secondary">취소</button><button id="slot-delete-confirm" class="slot-delete btn secondary">삭제</button></div>',
        "slot-delete-cancel");
      const confirm = $("slot-delete-confirm"), dialog = $("modal-root").querySelector(".modal"),
        token = { key, snapshot };
      this.slotDeleteConfirmation = token;
      dialog.setAttribute("aria-describedby", "slot-delete-message");
      this.button("slot-delete-cancel", () => this.closeModal());
      this.button("slot-delete-confirm", () => {
        if (!confirm.isConnected || $("slot-delete-confirm") !== confirm || this.slotDeleteConfirmation !== token) return;
        const current = manualSlotSnapshot(key);
        if (!current.every((entry, i) => entry.readable === snapshot[i].readable && entry.raw === snapshot[i].raw &&
            entry.cached === snapshot[i].cached && entry.memory === snapshot[i].memory)) {
          this.slotDeleteConfirmation = null;
          this.saveDialog();
          this.requestSlotDelete(key);
          this.toast("저장 내용이 바뀌었어요. 다시 확인해 주세요.");
          return;
        }
        this.slotDeleteConfirmation = null;
        // Both removals run even if one fails; a surviving backup must stay
        // visible rather than silently resurrecting a supposedly empty slot.
        const primaryRemoved = storeRemove(key), backupRemoved = storeRemove(key + ":backup");
        this.saveDialog();
        this.toast(primaryRemoved && backupRemoved
          ? "슬롯 " + key + "을 삭제했어요."
          : "브라우저 저장 삭제를 완료하지 못했어요. 슬롯을 확인하고 다시 시도해 주세요.");
      });
      dialog.onkeydown = (e) => {
        if (e.key !== "Tab") return;
        const buttons = [...dialog.querySelectorAll("button:not([disabled])")],
          first = buttons[0], last = buttons[buttons.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault(); last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault(); first.focus();
        }
      };
      return true;
    }
    exportSave() {
      const blob = new Blob([JSON.stringify(this.envelope(), null, 2)], {
          type: "application/json",
        }),
        url = URL.createObjectURL(blob),
        a = document.createElement("a");
      a.href = url;
      a.download =
        "천년가족-" +
        this.state.family.name +
        "-" +
        new Date().toISOString().slice(0, 10) +
        ".json";
      document.body.append(a);
      a.click();
      a.remove();
