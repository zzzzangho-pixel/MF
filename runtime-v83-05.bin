    const name = canonical(value);
    if (/\s|\p{Cc}|\p{Cf}/u.test(name)) return '이름에는 공백이나 제어 문자를 넣을 수 없어요.';
    if (Array.from(name).length > 12) return '이름은 12글자 이내로 입력해주세요.';
    return null;
  }
  function normalize(saved) {
