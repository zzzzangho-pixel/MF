    introNextReady(view, button) {
      return !!this.introFlow && !this.introLoading && !this.ownWizard && !this.recommendedReview &&
        !this.modalOpen && !document.hidden && !this.offlineBackground && !this.arrowFx?.active &&
        view.mode === "dialogue" && view.canAdvance === true && !(view.choices || []).length &&
        button === $("intro-next") && button?.isConnected && this.el.contains(button) &&
        !button.disabled && !button.closest('[hidden],[inert],[aria-hidden="true"]') &&
        getComputedStyle(button).visibility === "visible" && !!button.getClientRects().length;
