        this.scrollX += (target - this.scrollX) * Math.min(1, dt * 5);
        const cy = clamp(sel.floor - c.height * .7 / zoom, 0, Math.max(0, H - c.height / zoom));
        this.camY += (cy - this.camY) * Math.min(1, dt * 5);
