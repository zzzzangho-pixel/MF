          a.walking = false;
          if (previousRoom >= 0 && !outside && Number(v(plan, "kind", -1)) !== 0) {
            const lo = r[0], hi = Math.max(lo, r[1] - 32),
              side = a.anchor - lo < hi - a.anchor ? 1 : -1;
            a.x = clamp(a.anchor + side * 40, lo, hi);
            a.walking = Math.abs(a.target - a.x) > .5;
          }
        } else {
          a.spot = -1;
