","bounds":[66,70,1187,1153]},"title_house_day":"data:image/png;base64,","title_house_evening":"data:image/png;base64,","title_house_dusk":"data:image/png;base64,","title_house_night":"data:image/png;base64,","arrow":{"src":"data:image/png;base64,","bounds":[77,88,1197,1165]},"items":{"src":"data:image/png;base64,","bounds":[84,216,1173,1040]},"family":{"src":"data:image/png;base64,","bounds":[255,193,998,1087]},"story":{"src":"data:image/png;base64,","bounds":[225,173,1051,1112]},"save":{"src":"data:image/png;base64,","bounds":[220,243,1034,1015]}};

