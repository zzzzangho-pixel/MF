      };
      const pair = () => {
        const [a, b] = [...pointers.values()];
        return { middle: point({ x: (a.x + b.x) / 2, y: (a.y + b.y) / 2 }),
          distance: Math.max(1, Math.hypot(a.x - b.x, a.y - b.y)) };
      };
      const stopFollowing = () => {
        this.follow = false;
