      if (this.eventDialoguePending()) {
        if (this.voice.diagnostics.active || this.voice.diagnostics.pending) this.voice.stop();
        return;
      }
      let key = null, text = "", speaker = "narrator";
      const box = this.el.querySelector(".dialogue-frame");
      if (box && this.recommendedReview) {
        const view = this.recommendedReview.view();
        key = view ? JSON.stringify(["recommended", this.recommendedReview.serial, view.messageId, view.page, view.text]) : null;
        text = view?.text || "";
        speaker = view?.speakerKey || "cupid";
      } else if (box && this.ownWizard) {
        const view = this.ownWizard.view();
        key = view ? JSON.stringify(["own-family", this.ownWizard.serial, view.messageId, view.page, view.text]) : null;
        text = view?.text || "";
        speaker = "cupid";
      } else if (box && this.introFlow) {
        const view = this.introFlow.read();
        key = JSON.stringify(["intro", view.sequence, view.mode, view.messageId,
          view.messageIndex, view.page, view.text]);
        text = view.text;
        speaker = view.speakerKey;
      } else if (box && this.playing && this.state?.event) {
        const view = this.state.event, session = this.game.session;
        const memo = session.memo && !session.replaying ? session.memo : null;
        const occurrence = session.heavenCur || memo || session.cur || session;
        if (!this.voiceOccurrences.has(occurrence))
