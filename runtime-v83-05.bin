</script>
<script>
/* Cupid menu: native-memory queries and the supplied Unity MAX/MIN forecast.
 * The GBA's own forecast algorithm is not verified. Predictions show one
 * possible native branch, not a guaranteed outcome. Native menu tables that
 * are absent from the existing pack use new summaries, not copied reference
 * screenshots/transcripts. Every VM call owns private memory and metadata. */
(function (root) {
  'use strict';
  const SK = root.SK = root.SK || {}, banks = ['Ewram', 'Iwram', 'Frames', 'Io'];
  // Display only: native cash/monthly pay stay in 10,000-yen units. A fixed
  // 1 yen = 10 won is applied here, never to the VM, saves or translation pack.
  const cashDigits = Object.freeze({영:0,공:0,일:1,이:2,삼:3,사:4,오:5,육:6,칠:7,팔:8,구:9}),
    cashUnits = Object.freeze({경:10000000000000000n,조:1000000000000n,억:100000000n,만:10000n}),
    cashPattern = /(?:[+＋\-−－][ \t\r\n]*)?(?:[0-9０-９]|(?<![가-힣])[영공일이삼사오육칠팔구십백천만억조경十百千万億兆])[0-9０-９,，.．영공일이삼사오육칠팔구십백천만억조경十百千万億兆 \t\r\n]*[ \t\r\n]*(엔|円)(?=$|[\s.,!?…！？。，、：:;'"「」()（）\[\]{}<>／/]|으로|이라고|이라|부터|까지|보다|짜리|정도|씩|이나|은|는|이|가|을|를|과|와|의|도|에|만)/gu;
  const cashNormalize = value => String(value).replace(/[０-９]/g,c=>String(c.charCodeAt(0)-0xff10))
    .replace(/[，．＋−－十百千万億兆]/g,c=>({'，':',','．':'.','＋':'+','−':'-','－':'-','十':'십','百':'백','千':'천','万':'만','億':'억','兆':'조'})[c]);
  function cashDecimal(value) {
    if (typeof value === 'bigint') return { n:value, scale:0 };
    if (value == null || value === '' || typeof value === 'boolean' ||
        typeof value === 'number' && (!Number.isFinite(value) || Number.isInteger(value) && !Number.isSafeInteger(value))) return null;
    const s=cashNormalize(value).trim(),m=/^([+-]?)(\d+)(?:\.(\d+))?(?:e([+-]?\d+))?$/i.exec(s);
    if(!m)return null;
    const exponent=Number(m[4]||0);if(!Number.isSafeInteger(exponent)||Math.abs(exponent)>308)return null;
    let n=BigInt(m[2]+(m[3]||'')),scale=(m[3]||'').length-exponent;
    if(scale<0){n*=10n**BigInt(-scale);scale=0;}
    return {n:m[1]==='-'?-n:n,scale};
  }
  function cashSmall(value) {
    if(!value)return {n:1n,scale:0};
    if(/^[0-9]+(?:\.[0-9]+)?$/.test(value))return cashDecimal(value);
    if(Object.hasOwn(cashDigits,value))return {n:BigInt(cashDigits[value]),scale:0};
    let total=0n,last=10000,at=0;
    const units={천:1000,백:100,십:10};
    for(let i=0;i<value.length;i++)if(Object.hasOwn(units,value[i])){
      const unit=units[value[i]],part=value.slice(at,i),digit=part?cashSmall(part):{n:1n,scale:0};
      if(unit>=last||!digit||digit.scale||/[천백십]/.test(part))return null;
      total+=digit.n*BigInt(unit);last=unit;at=i+1;
    }
    if(!at)return null;
    const tail=value.slice(at),digit=tail?cashSmall(tail):{n:0n,scale:0};
    return digit&&!digit.scale&&!/[천백십]/.test(tail)?{n:total+digit.n,scale:0}:null;
  }
  function cashExpression(value) {
    // Native line wrapping may split a number, its magnitude or the yen unit.
    let s=cashNormalize(value).replace(/[ \t\r\n]/g,''),sign=1n;
    if(/^[+-]/.test(s)){if(s[0]==='-')sign=-1n;s=s.slice(1);}
    if([...s.matchAll(/[0-9][0-9,]*(?:\.[0-9]+)?/g)].some(match=>match[0].includes(',')&&!/^\d{1,3}(?:,\d{3})+(?:\.\d+)?$/.test(match[0])))return null;
    s=s.replaceAll(',','');let result={n:0n,scale:0},last=null,at=0;
    const add=(part,unit)=>{const scale=Math.max(result.scale,part.scale);result={n:result.n*10n**BigInt(scale-result.scale)+part.n*unit*10n**BigInt(scale-part.scale),scale};};
    for(let i=0;i<s.length;i++)if(Object.hasOwn(cashUnits,s[i])){
      const unit=cashUnits[s[i]],part=cashSmall(s.slice(at,i));
      if(last!==null&&unit>=last||!part)return null;
      add(part,unit);last=unit;at=i+1;
    }
    const tail=s.slice(at),part=tail?cashSmall(tail):{n:0n,scale:0};
    if(!part||!s)return null;add(part,1n);result.n*=sign;return result;
  }
  function cashWon(value) {
    const parsed=value&&typeof value==='object'&&typeof value.n==='bigint'?value:cashDecimal(value);
    if(!parsed)return '—';
    const negative=parsed.n<0n,n=negative?-parsed.n:parsed.n,den=10n**BigInt(parsed.scale);
    let whole=n/den;const parts=[];
    for(const [label,unit] of Object.entries(cashUnits))if(whole>=unit){parts.push(String(whole/unit)+label);whole%=unit;}
    const fraction=parsed.scale?String(n%den).padStart(parsed.scale,'0').replace(/0+$/,''):'';
    if(whole||fraction||!parts.length)parts.push(String(whole)+(fraction?'.'+fraction:''));
    return (negative?'-':'')+parts.join('')+'원';
  }
  function cashMultiply(value,factor) {
    const parsed=cashDecimal(value);return parsed?cashWon({n:parsed.n*factor,scale:parsed.scale}):'—';
  }
  function cashMatches(value) {
    const text=String(value??''),matches=[];
    for(const match of text.matchAll(cashPattern)){
      const expression=match[0].slice(0,-match[1].length).trimEnd();
      let lead=0,parsed=cashExpression(expression);
      // A standalone determiner ("이 50만 엔") is not part of the amount.
      if(!parsed)for(const gap of expression.matchAll(/[ \t\r\n]+(?=\S)/g)){
        const offset=gap.index+gap[0].length,candidate=cashExpression(expression.slice(offset));
        if(candidate){lead=offset;parsed=candidate;break;}
      }
      // A numeric yen suffix is a unit; 엔진/엔딩/엔지니어 are not.
      if(!parsed)continue;
      matches.push({start:match.index+lead,end:match.index+match[0].length,unitStart:match.index+match[0].length-match[1].length,
        text:cashWon({n:parsed.n*10n,scale:parsed.scale})});
    }
    return {text,matches};
  }
  function cashText(value) {
    const {text,matches}=cashMatches(value);let out='',at=0;
    for(const match of matches){out+=text.slice(at,match.start)+match.text;at=match.end;}
    return out+text.slice(at);
  }
  function cashRuns(runs) {
    if(!Array.isArray(runs)||runs.some(run=>typeof run?.text!=='string'))return runs;
    const {text,matches}=cashMatches(runs.map(run=>run.text).join('')),out=[];
    const append=(value,run)=>{if(!value)return;const previous=out.at(-1);if(previous&&previous.color===run.color)previous.text+=value;else out.push({...run,text:value});};
    const range=(start,end)=>{let at=0;for(const run of runs){const next=at+run.text.length;if(next>start&&at<end)append(run.text.slice(Math.max(0,start-at),Math.min(run.text.length,end-at)),run);at=next;if(at>=end)break;}};
    const owner=index=>{let at=0;for(const run of runs){at+=run.text.length;if(index<at)return run;}return runs.at(-1)||{};};
    let at=0;
    for(const match of matches){range(at,match.start);append(match.text.slice(0,-1),owner(match.start));append('원',owner(match.unitStart));at=match.end;}
    range(at,text.length);return out;
  }
  SK.Currency=Object.freeze({formatWon:cashWon,formatYen:value=>cashMultiply(value,10n),
    formatNative:value=>cashMultiply(value,100000n),text:cashText,runs:cashRuns});
  // Measured rule thresholds, not reference artwork/transcript assets. The
  // original packed rank table is truncated after rank41 in this web pack.
  const rankThresholds = [0,1,12,25,40,60,80,100,120,140,170,200,250,300,350,400,450,500,600,700,800,900,1000,1150,1300,1450,1600,1750,1900,2050,2200,2350,2500,2700,2900,3100,3300,3500,3750,4000,4250,4500,4750,5000,5500,6500,8000,10000,13000,16000,20000];
  const jsonClone = value => JSON.parse(JSON.stringify(value));
  const bounded = (value, low, high) => Math.max(low, Math.min(high, Number(value) || 0));
  function graphClone(value, seen = new Map()) {
    if (value === null || typeof value !== 'object') return value;
    if (seen.has(value)) return seen.get(value);
    if (ArrayBuffer.isView(value)) return value.slice();
    if (value instanceof Set) return new Set([...value].map(x => graphClone(x, seen)));
    if (value instanceof Map) return new Map([...value].map(([k, v]) => [k, graphClone(v, seen)]));
    const out = Array.isArray(value) ? [] : Object.create(Object.getPrototypeOf(value));
    seen.set(value, out);
    for (const [key, item] of Object.entries(value)) out[key] = graphClone(item, seen);
    return out;
  }
  function sourceOf(gameOrSession) {
    const session = gameOrSession?.session || gameOrSession;
    if (!session?.Game?.Mem || !session.Rules) throw new Error('가족 정보가 없습니다.');
    return session;
  }
  function privateSession(gameOrSession) {
    const source = sourceOf(gameOrSession), memory = new SK.OrigMem();
    memory.ShareRom(source.Game.Mem);
    for (const key of banks) memory[key].set(source.Game.Mem[key]);
    const query = Object.create(Object.getPrototypeOf(source));
    for (const [key, value] of Object.entries(source)) {
      if (['Game', 'Rules', 'Text', 'memo', '_familyEvolution'].includes(key)) continue;
      query[key] = graphClone(value);
    }
    query.Rules = source.Rules;
    // Decode can add missing characters to Text.Missing; isolate that too.
    query.Text = Object.assign(Object.create(Object.getPrototypeOf(source.Text)), source.Text,
      { Missing: new Set(source.Text.Missing) });
    query.memo = null;
    query.Game = new SK.OrigGame(memory, source.Rules);
    for (const [key, value] of Object.entries(source.Game))
      if (!['Mem', 'Vm', 'Rules', 'TextOverride'].includes(key)) query.Game[key] = graphClone(value);
    query.Game.TextOverride = address => query.Text.Overrides[address] !== undefined;
    query._cupidQuery = true;
    if (SK.FamilyEvolution?.attachQuery)
      SK.FamilyEvolution.attachQuery(query, source._familyEvolution);
    if (SK.NameBook?.attachQuery) SK.NameBook.attachQuery(query, source._nameBook);
    // Pending web interventions are synchronized only on the clone.
    query.SyncIn();
    return query;
  }
  function person(query, id) {
    if (id === 65535 || id < 0) return { id: -1, name: '—' };
    return { id, name: query.Family.Get(id)?.Name || query.NameOf(id, -1) || '—' };
  }
  function readMessage(memory, pointer) {
    const bytes = [];
    // Zero-valued name/number-format operands are not string terminators.
    for (let at = 0; at < 4096;) {
      const byte = memory.R8(pointer + at);
      if (!byte) break;
