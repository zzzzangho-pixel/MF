  }
  const nameOf = SK.OrigSession.prototype.NameOf;
  SK.OrigSession.prototype.NameOf = function (id, gender) {
    // Existing aliases win even after registry removal or a later registration.
    if (this.Family.OrigNames[id]) return this.Family.OrigNames[id];
    const meta = this._nameBook, trace = meta?.births[id], actual = trace && !meta.known[id] && newborn(this, Number(id), trace);
    if (actual && (gender < 0 || gender === actual.gender)) {
      const pool = meta.entries.filter(e => e.gender === actual.gender && trace.eligibleIds.includes(e.id));
      if (pool.length) {
        const used = new Set(Object.values(this.Family.OrigNames));
        for (const person of this.Family.Members || []) if (person.Name) used.add(person.Name);
        let selected = pool.find(e => !used.has(e.name));
        if (!selected) {
