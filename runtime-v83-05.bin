      this.introFlow = null;
      this.introScene = null;
      this.introSceneTime = 0;
      this.introLoading = false;
      this.introToken = 0;
      this.introPreviousGame = null;
      this.introRecommendedStaged = false;
      this.recommendedReview = null;
      this.ownWizard = null;
      this.game = null;
      this.state = null;
      this.selectedId = -1;
      this.playing = false;
      this.running = true;
      this.follow = true;
      this.fast = false;
      this.fastTier = 0;
      this.cameraZoom = 1;
      this.actorTime = 0;
      this.dayFraction = 0;
      this.scrollX = 0;
      this.camY = 0;
      this.actors = new Map();
      this.arrowTintStates = new Map();
      this.arrowTintGame = null;
      this.actorHouseKey = null;
      this.chatter = new SK.FamilyChatter();
