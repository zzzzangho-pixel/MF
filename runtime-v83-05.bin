      c.dataset.titleCrowdCount = String(this.titleActors.length);
      c.dataset.titleActorKeys = this.titleActors.map(actor => actor.key).join(",");
      c.dataset.titlePositions = JSON.stringify(this.titleActors.map(actor => [actor.key, Math.round(actor.x * 100) / 100, actor.dir, actor.pose]));
      c.dataset.cupidX = cupid.x.toFixed(2);
      c.dataset.peopleScale = "0.625";
    }
    arrowTintFor(p) {
