(function () {
  "use strict";
  const SK = (globalThis.SK = globalThis.SK || {}),
    gzip = globalThis.pako,
    prefix = "sennen-kazoku-gzip:1:",
    chunksPrefix = "sennen-kazoku-gzip-chunks:1:",
    chunkChars = 256 * 1024, chunkThreshold = 2 * chunkChars;
