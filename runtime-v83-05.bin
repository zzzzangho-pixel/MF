          memo?.familyShown, view.speaker, view.text]);
        text = view.text;
        speaker = view.speaker === "큐피트" ? "cupid" : view.speaker === "높으신 신" ? "god" :
          this.state.members.find(p => p.name === view.speaker || p.id === view.personId) || view.speaker;
      } else if (this.playing) {
