  }
  function resolverLog(callbacks){
    const log={name:[],person:[],number:[]}, wrapped={};
    for(const kind of Object.keys(log)){const fn=callbacks[kind];wrapped[kind]=typeof fn==="function"?function(...args){const value=fn.apply(this,args);log[kind].push({args,value});return value;}:fn;}
    const cursor={name:0,person:0,number:0};
