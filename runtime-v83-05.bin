      }
    }
    showCupidTip(t = performance.now()) {
      if (!this.playing || !this.game || this.state?.event || this.modalOpen || document.hidden || this.arrowFx.active) return;
      const tip = this.cupidTip;
      const original = this.game.session?.Text.Heaven?.Tips;
      const messages = original
        ? [CUPID_TIPS[0], ...[1, 2, 4, 5].map(i => original[i]).filter(s => typeof s === "string" && /[가-힣]/.test(s) && !/[\u3040-\u30ff□]/.test(s))]
        : CUPID_TIPS;
      tip.index = (tip.index + 1) % messages.length;
      tip.text = messages[tip.index];
      tip.until = t + Math.max(5200, tip.text.length * 180);
      tip.nextAt = tip.until + CUPID_TIP_INTERVAL;
      this.updateCupidTip(t);
    }
    updateCupidTip(t = performance.now()) {
      // Cheap visibility-only sync also covers a native prelude or arrow that
