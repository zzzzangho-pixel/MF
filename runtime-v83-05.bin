        tip.classList.toggle("single-line", text.scrollHeight <= Math.ceil(line) + 1);
        const art = tip.querySelector("canvas"), paint = () => this.bubbles.draw(art, "tip", Math.round(tip.clientWidth / scale), Math.ceil(tip.clientHeight / scale));
        if (!paint()) this.bubbles.ready.then(() => { if (art.isConnected) paint(); });
