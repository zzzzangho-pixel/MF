      }
    }
    persistSettings() {
      storeSet(
        "settings",
        JSON.stringify({ running: this.running, follow: this.follow,
          cameraZoom: this.cameraZoomRatio(this.cameraZoom),
          bgmVolume: this.bgmVolume, seVolume: this.seVolume,
          dialogueVoice: this.voice.enabled, dialogueAuto: this.dialogueAuto }),
      );
    }
    toast(s) {
      const el = $("toast");
      el.textContent = String(s);
      el.hidden = false;
