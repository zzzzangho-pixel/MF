<script>
/* Web naming extension, NOT a verified original-cartridge naming-book port.
 * Registry/aliases live only in web metadata. Native names/genes, VM memory
 * and original RNG are never rewritten or consumed by registry operations.
 * Newborn aliases require an observed native birth call and valid parent
 * genes; existing people and newly generated outside partners are untouched. */
(function (root) {
  'use strict';
  const SK = root.SK = root.SK || {};
  if (SK.NameBook) return;
  const clone = value => JSON.parse(JSON.stringify(value));
  const sessionOf = value => value?.session || value;
  const fresh = () => ({ version: 1, nextId: 1, entries: [], known: {}, births: {}, assignments: {} });
  const validId = id => Number.isInteger(id) && id >= 0 &&
    SK.OrigMem.GeneAddr(id) + SK.OrigMem.GeneSize <= SK.OrigMem.Slots;
  const entryId = id => /^name:[1-9]\d*$/.test(String(id));
  const canonical = name => name.normalize('NFC');
  const duplicateKey = name => canonical(name).toLocaleLowerCase('und');
  function validateName(value) {
