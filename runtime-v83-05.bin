  function decodeStyled(bytes,text,resolved,initialColor=10){const b=new StyledBuilder(initialColor);byteRun(b,bytes,text,resolved);b.flush();return b.pages;}
  function sceneStyled(script,resolved){
    const b=new StyledBuilder();let pending=[],i=0;
    const process=()=>{byteRun(b,pending,null,resolved,true);pending=[];};
    while(i<script.length){const a=script.indexOf("{{HEX:",i),literal=a<0?script.slice(i):script.slice(i,a);if(literal){process();b.emit(literal);}if(a<0)break;const end=script.indexOf("}}",a);if(end<0)break;pending.push(...script.slice(a+6,end).trim().split(/\s+/).filter(Boolean).map(h=>parseInt(h,16)));i=end+2;}
    process();b.flush();return b.pages;
  }
  function register(original,styled,input){
    if(!Array.isArray(original)||!Array.isArray(styled)||original.length!==styled.length||original.some((p,i)=>p!==styled[i]?.text)){diagnostics.rejectedStyles++;return;}
    arrayStyles.set(original,styled);if(input&&typeof input==="object")rawStyles.set(input,styled);
    for(const p of styled){const signature=JSON.stringify(p.runs);let variants=textStyles.get(p.text);if(!variants)textStyles.set(p.text,variants=new Map());variants.set(signature,p.runs);diagnostics.colorPages++;}
    if(textStyles.size>1024)textStyles.delete(textStyles.keys().next().value);
  }
  function installDecoders(){
    const Text=SK.OrigText, Heaven=SK.OrigHeaven;if(!Text||Text.prototype._nativeColorInstalled)return;
    Text.prototype._nativeColorInstalled=true;
    const decode=Text.prototype.Decode;
    Text.prototype.Decode=function(bytes,name,person,number,...rest){
      const r=resolverLog({name,person,number}), result=decode.call(this,bytes,r.wrapped.name,r.wrapped.person,r.wrapped.number,...rest);
      try{register(result,decodeStyled(bytes,this,r),bytes);}catch{diagnostics.rejectedStyles++;}return result;
    };
    const scene=Text.ScenePages;
    Text.ScenePages=function(script,name,...rest){const r=resolverLog({name}),result=scene.call(this,script,r.wrapped.name,...rest);try{register(result,sceneStyled(script,r));}catch{diagnostics.rejectedStyles++;}return result;};
    if(Heaven?.prototype.HelpPages){
      const help=Heaven.prototype.HelpPages;
      Heaven.prototype.HelpPages=function(k){
        const family=[],personName=this.personName;
        this.personName=function(...args){const value=personName.apply(this,args);family.push(value);return value;};
        let result;try{result=help.call(this,k);}finally{this.personName=personName;}
        try{
          const bytes=this.data.Help.get(k),b=new StyledBuilder();let run=[],fi=0;
          const flush=()=>{if(!run.length)return;const segment=new StyledBuilder(b.color);byteRun(segment,run,this.text,{take(){return"○○";}});const fixed=normalized(segment.chars);for(const r of fixed.runs){b.color=r.color;b.emit(r.text);}run=[];};
          for(let i=0;i<bytes.length;){
            if(bytes[i]===37&&i+1<bytes.length){flush();const op=String.fromCharCode(bytes[i+1]);i+=2;if(op==='e')break;if(op==='n')b.emit('\n');else if(op==='p')b.flush(false);else if(op==='u')b.emit(this.player);else if(op==='f')b.emit(family[fi++]??'○○');else if({k:10,r:11,b:12,g:13}[op])b.color={k:10,r:11,b:12,g:13}[op];}
            else if(bytes[i]>=128&&i+1<bytes.length){run.push(bytes[i],bytes[i+1]);i+=2;}else i++;
          }
          flush();b.flush(false);if(result.length===b.pages.length&&result.every((p,i)=>p.Text===b.pages[i].text)){for(let i=0;i<result.length;i++)pageStyles.set(result[i],b.pages[i].runs);register(result.map(p=>p.Text),b.pages,bytes);}else diagnostics.rejectedStyles++;
        }catch{diagnostics.rejectedStyles++;}return result;
      };
    }
  }
  function validRuns(text,runs){return Array.isArray(runs)&&runs.length>0&&runs.every(r=>typeof r.text==='string'&&PALETTE[r.color])&&runs.map(r=>r.text).join('')===text;}
  // Old saves contain plain pages, not color metadata. Align only source-coded
  // literal glyphs and explicitly marked name/number operands against that exact
  // captured text. This never searches for "important" words or reruns a VM.
  function abstractPages(input,text,help=false,scene=false){
    const pages=[];let color=10,parts=[];
    const emit=(value,dynamic=false)=>{const last=parts.at(-1);if(!dynamic&&last&&!last.dynamic&&last.color===color)last.text+=value;else parts.push({text:value,color,dynamic});},
      flush=()=>{if(parts.length)pages.push(parts);parts=[];},bytes=(b)=>{
        for(let i=0;i<b.length;){const c=b[i];if(c===0||c===255){i++;continue;}
          if(help&&c===37&&i+1<b.length){const op=String.fromCharCode(b[i+1]);i+=2;if(op==='e')break;if(op==='p')flush();else if(op==='n')emit('\n');else if(op==='u'||op==='f')emit('',true);else if({k:10,r:11,b:12,g:13}[op])color={k:10,r:11,b:12,g:13}[op];continue;}
          if(c===26&&i+1<b.length){const op=b[i+1],len=op===134?4:op===135?6:SK.OrigText.TokenLen(b,i);if(op===255||scene&&op===18)break;if(op===1)emit('\n');else if(op===2||op===9)flush();else if(op===3&&PALETTE[b[i+2]])color=b[i+2];else if([5,6,134,135].includes(op))emit('',true);i+=len>0?len:2;continue;}
          if(scene){i++;continue;}const code=c>=128&&i+1<b.length?(c<<8)|b[i+1]:c;i+=c>=128&&i+1<b.length?2:1;if(!help||c>=128)emit(CHARSET(text)[code]??'□');
        }
      };
    if(scene){let i=0,pending=[];while(i<input.length){const a=input.indexOf('{{HEX:',i),literal=a<0?input.slice(i):input.slice(i,a);if(literal){bytes(pending);pending=[];emit(literal);}if(a<0)break;const end=input.indexOf('}}',a);if(end<0)break;pending.push(...input.slice(a+6,end).trim().split(/\s+/).filter(Boolean).map(h=>parseInt(h,16)));i=end+2;}bytes(pending);}
    else bytes(input);flush();return pages;
  }
  function alignRaw(parts,plain){
    if(!parts?.length)return null;parts=parts.map(p=>({...p}));
    if(!parts[0].dynamic)parts[0].text=parts[0].text.trimStart();if(!parts.at(-1).dynamic)parts.at(-1).text=parts.at(-1).text.trimEnd();
    if(parts.some((p,i)=>p.dynamic&&parts[i+1]?.dynamic&&p.color!==parts[i+1].color))return null;
    const literal=s=>{let out='',i=0;const markers={'은/는':'(?:은|는)','이/가':'(?:이|가)','을/를':'(?:을|를)','과/와':'(?:과|와)','와/과':'(?:과|와)','(으)로':'(?:으로|로)','⑦':'(?:이)?'};while(i<s.length){const key=Object.keys(markers).find(k=>s.startsWith(k,i));if(key){out+=markers[key];i+=key.length;}else out+=s[i++].replace(/[.*+?^${}()|[\]\\]/g,'\\$&');}return out;},
      pattern='^'+parts.map(p=>'('+(p.dynamic?'[\\s\\S]*?':literal(p.text))+')').join('')+'$',match=new RegExp(pattern,'u').exec(plain);
    if(!match)return null;const runs=parts.map((p,i)=>({text:match[i+1],color:p.color})).filter(r=>r.text);return validRuns(plain,runs)?runs:null;
  }
  function runsFor(view,app){
    const text=String(view.text??''),s=app?.game?.session;let runs=view.textRuns;
    if(!validRuns(text,runs)&&s&&view===app.state?.event){
      if(s.heavenCur){const hp=s.heavenCur[s.heavenPage];runs=pageStyles.get(hp);if(!runs){const help=hp.State===-2,raw=(help?s.Text.Heaven.Help:s.Text.Heaven.Msgs).get(help?hp.MsgId-1000:hp.MsgId),styles=raw&&rawStyles.get(raw),index=s.heavenCur.slice(0,s.heavenPage).filter(p=>p.MsgId===hp.MsgId).length;runs=styles?.[index]?.runs;if(!validRuns(text,runs)&&raw)runs=alignRaw(abstractPages(raw,s.Text,help)[index],text);if(runs)pageStyles.set(hp,runs);}}
      else {runs=arrayStyles.get(s.pages)?.[s.page]?.runs;const script=s.Text.Records[s.cur?.Data]?.Script;if(!validRuns(text,runs)&&script)runs=alignRaw(abstractPages(script,s.Text,false,true)[s.page],text);}
    }
    if(!validRuns(text,runs)&&Number.isInteger(view.messageId)){const t=app?.ownWizard?.text||app?.introScene?.text,raw=t?.Heaven?.Msgs?.get(view.messageId);runs=raw&&rawStyles.get(raw)?.[view.page||0]?.runs;}
    if(!validRuns(text,runs)){const variants=textStyles.get(text);if(variants?.size===1)runs=variants.values().next().value;}
    return validRuns(text,runs)?runs:null;
  }
  // Page-local display layout only. Native decoded pages, controls and color
  // metadata stay untouched. Single hard breaks before closing punctuation
  // belong after that closing cluster; page-leading/double breaks stay as-is.
  const CLOSING = /^[」』）)\]｝］〉》】〕〗〙〛”’]$/u,
    hardBreak = c => c === "\n" || c === "\r" || c === "\r\n",
    horizontal = c => /^[^\S\r\n]+$/u.test(c);
  function closingLayout(text,runs) {
    const source=validRuns(text,runs)?runs:[{text:String(text??""),color:null}],chars=[];
    for(const r of source)for(const c of r.text.match(/\r\n|[\s\S]/gu)||[])chars.push({text:c,color:r.color});
    for(let i=1;i<chars.length;i++){
