        return;
      }
      const button = $("event-advance");
      if (button) button.disabled = !this.introFlow || !this.introNextReady(this.introFlow.read(), $("intro-next"));
    }
    updateIntroDialogueAuto(dt) {
      const flow = this.introFlow, view = flow?.read(), next = $("intro-next");
      if (!this.dialogueAuto || !this.running || !view || !this.introNextReady(view, next)) {
        this.resetDialogueAuto();
        return;
      }
      const key = JSON.stringify([view.sequence, view.mode, view.messageId, view.messageIndex,
        view.page, view.speaker, view.text]), timer = this.dialogueAutoTimer;
      if (!timer || timer.button !== next || timer.flow !== flow || timer.key !== key) {
