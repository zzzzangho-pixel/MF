          this.cameraZoom = zoom;
          this.syncHouseZoomControl();
          this.scrollX = this.houseCameraX(pinch.wx - current.middle.x / zoom, c.width, zoom);
          this.camY = clamp(pinch.wy - current.middle.y / zoom, 0, Math.max(0, H - c.height / zoom));
          return;
        }
        if (!drag) return;
        const dx = (e.clientX - drag.x) / drag.scaleX,
          dy = (e.clientY - drag.y) / drag.scaleY;
        if (drag.moved || Math.abs(e.clientX - drag.x) + Math.abs(e.clientY - drag.y) > 4) {
          drag.moved = true;
          stopFollowing();
          this.scrollX = this.houseCameraX(drag.sx - dx, c.width);
          this.camY = clamp(drag.sy - dy, 0, Math.max(0, H - c.height / this.houseZoom()));
        }
