      this.app.el.querySelectorAll('[data-rec-member]').forEach((b) => b.onclick = () => this.app.act(() => this.selectMember(Number(b.dataset.recMember))));
      this.app.el.querySelectorAll('[data-rec-choice]').forEach((b) => b.onclick = () => this.app.act(() => this.choose(Number(b.dataset.recChoice))));
      this.draw(performance.now()); this.paintPreviews();
      this.ready.then(() => { if (this.active()) { this.draw(performance.now()); this.paintPreviews(); } });
      this.app.updateSceneDialog(); this.app.syncMusic(); this.app.syncDialogueVoice();
