        Boolean(this.cupidTip.until && t < this.cupidTip.until);
      const scale = canvas.clientWidth / 240,
        zoom = this.houseZoom(), figureScale = scale * zoom;
      canvas.closest(".scene-shell").style.setProperty("--pixel-scale", scale);
      const screen = new Map(), members = (this.state?.members || []).filter(p => {
        const actor = this.actors.get(p.id);
        if (p.alive === false || !actor || actor.hidden) return false;
        const x = actor.x - this.scrollX;
        const sx = (x + 16) * zoom, y = (actor.floor - 61 - CHARACTER_RISE - this.camY) * zoom;
        if (sx < 12 || sx > 228 || y < 12 || y > canvas.height - 8) return false;
        screen.set(p.id, { x: sx, y });
        return true;
      });
      const speech = this.chatter.update(t, members, this.actors, blocked);
      if (!speech.length) {
        layer.hidden = true;
        layer.replaceChildren();
