    async importSave(file) {
      if (!file) return;
      try {
        if (file.size > 16 * 1024 * 1024)
          throw new Error("저장 파일이 너무 큽니다.");
        const s = JSON.parse(await file.text());
        this.restoreEnvelope(s);
        this.saveSlot("auto", true);
        this.toast("저장 파일을 가져왔어요.");
      } catch (e) {
        this.toast("가져오지 못했어요: " + e.message);
      }
