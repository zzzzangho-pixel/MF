  ItemFeedback.skillName = skillName;
  ItemFeedback.source = SOURCE;
  ItemFeedback.legacyReplacement = LEGACY_REPLACEMENT;
  ItemFeedback.nativeMovie = NATIVE_ITEM;
  SK.ItemFeedback = ItemFeedback;
})(globalThis);

</script>
<script>
