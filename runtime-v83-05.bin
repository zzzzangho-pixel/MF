  }

  function replayInfo(entry) {
    if (!entry?.canReplay) return { label: "재생 자료 없음", captured: false,
      detail: "다시 볼 장면과 대사 자료가 남아 있지 않아요." };
    if (entry.origin === "captured") return { label: "당시 장면", captured: true,
      detail: "저장된 당시 장면과 대사를 다시 보여줘요." };
    return { label: "장면 복원", captured: false,
      detail: "남아 있는 가족·족보 정보로 장면과 대사를 복원해요. 당시 선택 정보가 남지 않은 인물은 표시하지 않아요." };
  }

  SK.HistoryPresentation = Object.freeze({ classify, replayInfo,
    replayLabel: entry => replayInfo(entry).label });
})(globalThis);

</script>
