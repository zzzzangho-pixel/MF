  }
  function byteRun(builder,bytes,text,resolved,scene=false){
    const cs=CHARSET(text);
    for(let i=0;i<bytes.length;){
      const c=bytes[i];if(c===0||c===255){i++;continue;}
      if(c===0x1a&&i+1<bytes.length){
        const op=bytes[i+1], len=op===0x86?4:op===0x87?6:SK.OrigText.TokenLen(bytes,i);
        if(op===255||scene&&op===0x12)break;
        if(op===1)builder.emit("\n");
        else if(op===2||op===9)builder.flush();
        else if(op===3&&PALETTE[bytes[i+2]])builder.color=bytes[i+2];
        else if(op===6)builder.emit(resolved.take("name","○○"));
        else if(op===0x86)builder.emit(resolved.take("person","○○"));
        else if(op===5)builder.emit(resolved.take("number","?"));
        else if(op===0x87&&i+5<bytes.length){
          const address=(bytes[i+2]|bytes[i+3]<<8|bytes[i+4]<<16|bytes[i+5]<<24)>>>0, override=text.Overrides?.[address];
          if(override!==undefined){
            const player=resolved.take("person","○○"),family=resolved.take("person","○○"),value=String(override)
              .replaceAll("{플레이어}",player).replaceAll("{가문}",family).replaceAll("{이가}","이/가")
              .replaceAll("{은는}","은/는").replaceAll("{을를}","을/를").replaceAll("{과와}","과/와");
            value.split("|").forEach((p,n)=>{if(n)builder.flush();const fixed=SK.OrigText.FixJosa(p).replaceAll("/","\n");builder.emit(fixed);});builder.flush();
