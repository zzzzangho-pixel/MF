      if (!Number.isFinite(a.motionTime)) a.motionTime = 0;
      if (!Number.isFinite(a.gaitTime)) a.gaitTime = mod((Number(p.id) || 0) * .173, .5);
      if (!Number.isInteger(a.gaitPose)) a.gaitPose = Math.floor(a.gaitTime * 4) % 2;
