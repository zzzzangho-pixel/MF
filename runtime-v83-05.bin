      const sceneRect = canvas.getBoundingClientRect(), placed = [];
      const hud = $("scene-hud"), hudRect = hud && !hud.hidden ? hud.getBoundingClientRect() : null;
      // Give the responding icon priority if two figures stand almost together.
      for (const bubble of [...layer.children].sort((a, b) => Number(b.dataset.reply) - Number(a.dataset.reply))) {
        const id = Number(bubble.dataset.speakerId), anchor = screen.get(id);
        if (!anchor) { bubble.hidden = true; continue; }
        const reaction = speech.find(line => line.id === id);
        const frame = this.art.frame(this.art.houseEmotion, String(reaction.emote), reaction.elapsed * .06);
        const name = "house_emo_" + reaction.emote + "_" + frame;
        const image = frame >= 0 ? this.art.image(name) : null;
        if (!image?.complete || !image.naturalWidth) { bubble.hidden = true; continue; }
        if (bubble.dataset.asset !== name) {
          bubble.src = image.src;
          bubble.dataset.asset = name;
