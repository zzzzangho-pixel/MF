    resetCupidTips(t = performance.now()) {
      this.cupidTip = { index: -1, text: "", until: 0, nextAt: t + CUPID_FIRST_DELAY, blocked: false };
    }
    updateFamilyChatter(t = performance.now()) {
      const layer = $("family-chatter"), canvas = $("house-canvas");
      if (!layer || !canvas || !this.chatter) return;
