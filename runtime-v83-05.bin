    frame(t) {
      if (this.fatal) return;
      const dt = this.lastFrame
        ? clamp((t - this.lastFrame) / 1000, 0, 0.1)
        : 0;
      this.lastFrame = t;
      try {
        if (this.introFlow) {
          // Intro controls own presentation only: never tick the prior family.
          // Hidden/paused intervals do not catch up when the screen returns.
          if (this.running && !document.hidden && !this.modalOpen && !this.ownWizard && !this.recommendedReview)
            this.introSceneTime += dt * 1000 * this.speedMultiplier();
          this.renderIntroScene(t);
          this.updateIntroAdvanceButton();
        }
        else if (this.playing && this.game) {
          this.arrowFx.advance(t);
          // Like the supplied native GameApp, run one original 25-day bundle
          // per frame only during the memo's Progress screen. Other native
          // greeting/report/choice pages remain readable and user-controlled.
          if (!document.hidden && !this.offlineBackground && !this.offlineReturnBlocked && !this.modalOpen &&
              !this.arrowFx.active && this.state.event?.eventId === "memo-progress") {
            this.refresh(this.game.advanceEvent());
            if (this.state.event?.eventId !== "memo-progress") this.saveSlot("auto", true);
          }
          if (!document.hidden && !this.offlineBackground && !this.journalPlayback &&
              Date.now() - this.offlineCheckpointAt >= 5000) {
            this.offlineCheckpointAt = Date.now();
            if (this.offlineReturnBlocked) {
              if (this.applyOfflineReturn()) this.refresh();
            }
            else this.saveSlot("auto", true);
          }
          this.maybeOfflineHistory();
          if (
            this.running &&
            !this.offlineBackground &&
            !this.offlineReturnBlocked &&
            !this.arrowFx.active &&
            !this.modalOpen &&
            !document.hidden &&
            !this.state.paused &&
            !this.state.event
          ) {
            this.dayFraction += (dt * this.speedMultiplier()) / 88;
            if (this.dayFraction >= 1) {
              this.tickDay();
            }
          }
          if (
            typeof this.game.showDue === "function" &&
            !document.hidden &&
            !this.offlineBackground &&
            !this.offlineReturnBlocked &&
            !this.arrowFx.active &&
            !this.modalOpen &&
            !this.state.event
          ) {
            const changed = this.game.showDue(
              Math.trunc(1800 + this.dayFraction * 7200),
            );
            if (changed) {
              this.refresh();
              this.saveSlot("auto", true);
            }
          }
          // Do not present a live event behind its earlier completed report
          // (or that report's read-only replay). Resume the same scene on close.
          if (!this.offlineSummaryOpen && !this.offlineReplayReturn)
            this.renderScene(t, dt);
          const sec = Math.floor(this.dayFraction * 24 * 60);
          if (sec !== this.lastHudSecond) {
            this.lastHudSecond = sec;
            this.updateClock();
          }
        } else this.renderTitle(t);
        this.syncDialogueVoice();
        this.updateDialogueAuto(dt);
      } catch (e) {
        this.showError(e, false);
      }
      this.raf = requestAnimationFrame((x) => this.frame(x));
    }
    updateClock() {
      const el = $("scene-time");
      if (!el) return;
      const units = SK.WebHouseClock.fromFraction(this.dayFraction),
        h = Math.floor(units / 300),
        m = Math.floor((units % 300) / 5),
        slot = SK.WebHouseClock.slot(units),
        label =
          slot === 4 ? "밤" : slot === 6 ? "새벽" : slot === 2 ? "저녁" : "낮";
      el.textContent =
        String(h).padStart(2, "0") +
        ":" +
        String(m).padStart(2, "0") +
        " · " +
        label;
      const moodEl = $("scene-mood");
      if (moodEl && this.state?.family) {
        const mood = SK.CupidData.moodInfo(this.state.family.mood);
        if (moodEl.dataset.level !== String(mood.index) || !moodEl.querySelector(".scene-mood-state"))
          moodEl.innerHTML = '가족의 무드 <span class="scene-mood-state">' + escape(mood.label) + '</span>';
        moodEl.dataset.level = String(mood.index);
      }
    }
    draw(ctx, im, x, y, w, h) {
      if (!im) return;
      if (im instanceof HTMLImageElement && !im.complete) return;
      if (im instanceof HTMLImageElement && !im.naturalWidth) return;
      ctx.drawImage(
        im,
        Math.round(x),
        Math.round(y),
        Math.round(w === undefined ? im.width : w),
        Math.round(h === undefined ? im.height : h),
      );
    }
    titleViewRandom() {
      let seed = this.titleMotionSeed;
      seed ^= seed << 13; seed ^= seed >>> 17; seed ^= seed << 5;
      this.titleMotionSeed = seed >>> 0;
      return this.titleMotionSeed / 4294967296;
    }
    resetTitleCrowd() {
      // Decorative title actors have their own RNG and clock, never a native
      // family/session RNG, save field, or offline checkpoint.
      this.titleMotionSeed = (Math.floor(Math.random() * 4294967296) ^ Date.now()) >>> 0 || 1;
      this.titleMotionTime = 0;
      this.titleLastFrame = null;
      this.titleActors = [];
      this.titlePresetKeys = Object.keys(this.art.parts.presets);
      this.titleRoles = [...new Set(this.titlePresetKeys.map(key => this.art.parts.presets[key].role || key.split("_")[0]))];
      for (let i = this.titleRoles.length - 1; i > 0; i--) {
        const j = Math.floor(this.titleViewRandom() * (i + 1));
        [this.titleRoles[i], this.titleRoles[j]] = [this.titleRoles[j], this.titleRoles[i]];
      }
      for (let i = 0; i < Math.min(6, this.titlePresetKeys.length); i++) this.titleActors.push(this.makeTitleActor(i, true));
    }
    makeTitleActor(index, initial = false) {
      const role = initial ? this.titleRoles[index % this.titleRoles.length]
          : this.titleRoles[Math.floor(this.titleViewRandom() * this.titleRoles.length)],
        used = new Set(this.titleActors.map(actor => actor.key)),
        sameRole = this.titlePresetKeys.filter(key => !used.has(key) &&
          (this.art.parts.presets[key].role || key.split("_")[0]) === role),
        available = sameRole.length ? sameRole : this.titlePresetKeys.filter(key => !used.has(key)),
        keys = available.length ? available : this.titlePresetKeys,
        key = keys[Math.floor(this.titleViewRandom() * keys.length)], raw = this.art.parts.presets[key];
      return { key, look: SK.normalLook(raw), age: /^grand/.test(role) ? 72 : /7$/.test(role) ? 7 : /13$/.test(role) ? 13 : /18$/.test(role) ? 18 : 40,
        x: initial ? (index + .5) * 240 / Math.min(6, this.titlePresetKeys.length) - 10 : 0,
        dir: index % 2 ? -1 : 1, speed: 10 + this.titleViewRandom() * 10,
        gaitTime: this.titleViewRandom() * .5, pose: 2 };
    }
    titleRenderContext(canvas) {
      let detail = $("title-detail-canvas");
      if (!detail) {
        detail = document.createElement("canvas");
        detail.id = "title-detail-canvas";
        detail.className = "title-detail-canvas";
        detail.setAttribute("aria-hidden", "true");
        canvas.after(detail);
      }
      const scale = clamp(Math.ceil(canvas.getBoundingClientRect().width *
        (root.devicePixelRatio || 1) / canvas.width), 2, 4),
        width = canvas.width * scale, height = canvas.height * scale;
      if (detail.width !== width || detail.height !== height) {
        detail.width = width;
        detail.height = height;
      }
      const context = detail.getContext("2d");
      context.setTransform(1, 0, 0, 1, 0, 0);
      context.clearRect(0, 0, width, height);
      context.setTransform(scale, 0, 0, scale, 0, 0);
      context.imageSmoothingEnabled = false;
      return context;
    }
    renderTitle(t) {
      const c = $("title-canvas");
      if (!c) return;
      const ctx = c.getContext("2d");
      ctx.imageSmoothingEnabled = false;
      // These are the supplied, complete native 240x160 title backgrounds.
      // The 8-second palette cycle is a web presentation, not the original
      // title movie: keep the first view daytime and never scroll/crop art.
      const times = ["day", "evening", "dusk", "night"];
      this.titleArt ||= new Map();
      for (const time of times) {
        if (this.titleArt.has(time)) continue;
        const spec = root.SK_UI_ICONS?.["title_house_" + time];
        if (!spec) continue;
        const im = new Image();
        im.src = typeof spec === "string" ? spec : spec.src;
        this.titleArt.set(time, im);
      }
      const dt = document.hidden || this.modalOpen || this.titleLastFrame === null ? 0
        : clamp((t - this.titleLastFrame) / 1000, 0, .05);
      this.titleLastFrame = t;
      this.titleMotionTime += dt;
      const elapsed = this.titleMotionTime * 1000,
        time = times[Math.floor(elapsed / 8000) % times.length],
        im = this.titleArt.get(time);
      ctx.clearRect(0, 0, c.width, c.height);
      ctx.fillStyle = "#e9e6c9";
      ctx.fillRect(0, 0, c.width, c.height);
      c.dataset.timeOfDay = time;
      c.dataset.ready = "0";
      if (im && im.complete && im.naturalWidth) {
        this.draw(ctx, im, 0, 0, c.width, c.height);
        c.dataset.ready = "1";
      }
      // Preserve the native background. Only the smaller moving foreground
      // needs more pixels before its original 32x64 artwork becomes 20x40.
      const foreground = this.titleRenderContext(c);
      this.titleActors.forEach((actor, i) => {
        actor.x += actor.dir * actor.speed * dt;
        actor.gaitTime += dt;
        if (actor.x < -22 || actor.x > 242) {
          const dir = actor.x < 0 ? 1 : -1, replacement = this.makeTitleActor(i);
          replacement.dir = dir; replacement.x = dir > 0 ? -20 : 240;
          this.titleActors[i] = actor = replacement;
        }
        // Native Front A/B face left, Back A/B face right, as in the house.
        actor.pose = (actor.dir < 0 ? 2 : 0) + (Math.floor(actor.gaitTime * 4) % 2);
        this.draw(foreground, this.art.look(actor.look, actor.age, actor.pose, 0), actor.x, 98, 20, 40);
      });
      const cupid = this.titleCupid = { x: 104 - Math.cos(this.titleMotionTime * Math.PI / 5) * 86,
        y: 18 + Math.sin(elapsed / 600) * 3 };
