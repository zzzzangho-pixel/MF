    if (id >= 165 && id <= 170) return '가족의 관심과 무드를 지켜보고 다음 세대를 이끌어 주세요.';
    if (id >= 173 && id <= 180) return id <= 177 ? '이번 달은 수입이 생활비보다 많을 것 같아요.' : '이번 달은 생활비가 더 많아요. 일에 힘쓰도록 이끌어 주세요.';
    if (id === 181) return '관찰할 때 큐피트의 글이 자동으로 넘어가는 속도를 정해 주세요.';
