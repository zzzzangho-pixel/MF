        bubble.hidden = false;
        const w = 32 * figureScale, h = 32 * figureScale;
        bubble.style.width = w + "px";
        bubble.style.height = h + "px";
        // The original 32x32 bubble already includes its tail and icon.
        // Keep its original position over the figure's transparent upper area.
        const left = anchor.x * scale - w / 2, top = anchor.y * scale;
        if (left < 0 || top < 0 || left + w > width || top + h > height ||
            (hudRect && left + w > hudRect.left - sceneRect.left - gap &&
             left < hudRect.right - sceneRect.left + gap &&
